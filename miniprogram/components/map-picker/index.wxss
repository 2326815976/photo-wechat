.map-picker {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  font-family: "ZQKNNY", "YouYuan", "幼圆", "Microsoft YaHei", sans-serif;
  z-index: 3200;
  padding: 32rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  opacity: 0;
  animation: map-mask-in 0.3s ease-out forwards;
}

.panel {
  position: relative;
  width: 100%;
  max-width: 1344rpx;
  height: 90vh;
  max-height: 90vh;
  display: flex;
  flex-direction: column;
  background: #ffffff;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 32rpx 80rpx rgba(0, 0, 0, 0.26);
  transform-origin: center;
  animation: map-panel-in 0.3s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  z-index: 1;
}

@keyframes map-mask-in {
  0% {
    opacity: 0;
  }
  100% {
    opacity: 1;
  }
}

@keyframes map-panel-in {
  0% {
    opacity: 0;
    transform: scale(0.9);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}

.panel-header {
  flex: none;
  padding: 32rpx;
  border-bottom: 2rpx solid rgba(17, 24, 39, 0.10);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.panel-title-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.panel-title-icon {
  width: 40rpx;
  height: 40rpx;
}

.panel-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #5d4037;
}

.close-btn {
  width: 64rpx;
  min-width: 0;
  height: 64rpx;
  border-radius: 999rpx;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  transition: background-color 0.16s ease, transform 0.12s ease;
}

.close-btn--hover {
  background: rgba(17, 24, 39, 0.06);
}

.close-btn:active {
  background: rgba(17, 24, 39, 0.06);
  transform: scale(0.9);
}

.close-icon {
  width: 36rpx;
  height: 36rpx;
}

.search-wrap {
  flex: none;
  position: relative;
  padding: 24rpx 32rpx;
  border-bottom: 2rpx solid rgba(17, 24, 39, 0.10);
  z-index: 20;
}

.search-input-wrap {
  height: 84rpx;
  border: 2rpx solid #d1d5db;
  border-radius: 16rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  padding: 0 18rpx;
  box-sizing: border-box;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.search-input-wrap--focused {
  border-color: #FFC857;
  box-shadow: 0 0 0 6rpx rgba(255, 200, 87, 0.20);
}

.search-icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 14rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  color: #5d4037;
}

.search-spinner {
  width: 26rpx;
  height: 26rpx;
  border-radius: 999rpx;
  border: 4rpx solid rgba(255, 200, 87, 0.45);
  border-top-color: #ffc857;
  animation: map-spin 0.9s linear infinite;
}

.search-clear-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 999rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 8rpx;
}

.search-clear-btn--hover {
  background: rgba(17, 24, 39, 0.08);
}

.search-clear-icon {
  width: 30rpx;
  height: 30rpx;
  opacity: 0.8;
}

@keyframes map-spin {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

.search-results {
  position: relative;
  margin-top: 16rpx;
  max-height: 400rpx;
  border: 2rpx solid rgba(17, 24, 39, 0.12);
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(17, 24, 39, 0.15);
  z-index: 60;
  pointer-events: auto;
}

.search-results::-webkit-scrollbar {
  width: 0;
  height: 0;
  background: transparent;
}

.result-item {
  display: block;
  width: 100%;
  text-align: left;
  background: transparent;
  padding: 18rpx 18rpx;
  border-bottom: 1rpx solid rgba(17, 24, 39, 0.08);
  transition: background-color 0.16s ease;
}

.result-item--hover {
  background: #f9fafb;
}

.result-item:active {
  background: #f3f4f6;
}

.result-item:last-child {
  border-bottom: none;
}

.result-title {
  display: block;
  font-size: 30rpx;
  color: #5d4037;
  font-weight: 700;
  line-height: 1.4;
  white-space: normal;
}

.result-title-line {
  display: block;
  word-break: break-all;
  overflow-wrap: anywhere;
}

.result-address {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: rgba(93, 64, 55, 0.55);
  line-height: 1.45;
  white-space: normal;
}

.result-address-line {
  display: block;
  word-break: break-all;
  overflow-wrap: anywhere;
}

.map-wrap {
  flex: 1;
  min-height: 0;
  position: relative;
  height: auto;
  z-index: 1;
}

.map {
  position: relative;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.map-loading {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.82);
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.map-loading-text {
  font-size: 26rpx;
  color: rgba(93, 64, 55, 0.7);
}

.locate-btn {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  z-index: 25;
  min-width: 188rpx;
  height: 64rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 2rpx solid rgba(255, 200, 87, 0.60);
  box-shadow: 0 10rpx 24rpx rgba(17, 24, 39, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  box-sizing: border-box;
  transition: transform 0.12s ease, background-color 0.16s ease, opacity 0.16s ease;
}

.locate-btn--hover {
  background: #fff7e0;
}

.locate-btn:active {
  transform: scale(0.98);
}

.locate-btn--loading {
  opacity: 0.8;
}

.locate-btn-icon {
  width: 28rpx;
  height: 28rpx;
  flex: none;
}

.locate-btn-text {
  font-size: 24rpx;
  line-height: 1;
  color: #5d4037;
  font-weight: 600;
}

.address-wrap {
  flex: none;
  padding: 24rpx 32rpx;
  border-top: 2rpx solid rgba(17, 24, 39, 0.10);
  background: #f9fafb;
}

.address-label {
  display: block;
  font-size: 24rpx;
  color: rgba(93, 64, 55, 0.55);
  margin-bottom: 6rpx;
}

.address-value {
  display: block;
  font-size: 28rpx;
  color: #5d4037;
  font-weight: 500;
  line-height: 1.45;
}

.actions {
  flex: none;
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid rgba(17, 24, 39, 0.10);
  background: #ffffff;
}

.btn-cancel,
.btn-confirm {
  flex: 1;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 0.16s ease, transform 0.12s ease;
}

.btn-cancel {
  border: 2rpx solid #d1d5db;
  color: #4b5563;
  background: #ffffff;
}

.btn-cancel--hover {
  background: #f9fafb;
}

.btn-cancel:active {
  background: #f3f4f6;
  transform: none;
}

.btn-confirm {
  background: #ffc857;
  color: #5d4037;
}

.btn-confirm--hover {
  background: #FFB347;
}

.btn-confirm:active {
  background: #FFB347;
  transform: none;
}

.btn-confirm--disabled {
  opacity: 0.55;
  pointer-events: none;
}
