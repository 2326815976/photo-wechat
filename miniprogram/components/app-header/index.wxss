.header {
  position: sticky;
  top: 0;
  left: 0;
  right: 0;
  z-index: 900;
  background: rgba(255, 251, 240, 0.95);
  /* Web: backdrop-blur-md（12px） */
  backdrop-filter: blur(12px);
  border-bottom: 4rpx dashed rgba(93, 64, 55, 0.15);
  box-shadow: 0 4rpx 24rpx rgba(93, 64, 55, 0.08);
}

.header-inner {
  /* Web: px-4 py-3 */
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx; /* gap-2 */
  box-sizing: border-box;
}

/* 返回 + 标题（无副标题）时，贴近 Web 端的简洁页头布局 */
.header-inner--simple {
  justify-content: flex-start;
  gap: 24rpx;
}

.header-inner--simple .title-wrap {
  flex: none;
}

.header-inner--simple .title {
  font-size: 48rpx;
  font-weight: 700; /* Web: font-bold */
  font-family: "ZQKNNY", "YouYuan", "幼圆", "Microsoft YaHei", sans-serif;
  line-height: 1;
}

/* Web: 带返回 + 带副标题的页头使用 py-2 */
.header-inner--back-sub {
  padding-top: 16rpx;
  padding-bottom: 16rpx;
}

/* 首页样式：左右布局 */
.header-inner--home {
  justify-content: space-between;
}

.header-inner--home-enter {
  animation: home-header-in 300ms ease-out both;
}

.back-wrap {
  flex: none;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 999rpx;
  background: rgba(255, 200, 87, 0.20);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 0.2s ease;
}

.back-btn--active {
  background: rgba(255, 200, 87, 0.30);
}

.back-icon {
  width: 40rpx;
  height: 40rpx;
}

.title-wrap {
  flex: 1;
  min-width: 0;
}

/* 首页标题：左对齐 */
.title-wrap--home {
  flex: 1;
  min-width: 0;
  text-align: left;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #5D4037;
  line-height: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-family: "ZQKNNY", "YouYuan", "幼圆", "Microsoft YaHei", sans-serif;
}

/* 首页大标题 */
.title--home {
  font-size: 40rpx;
  font-weight: 700;
  font-family: "ZQKNNY", "YouYuan", "幼圆", "Microsoft YaHei", sans-serif;
  line-height: 1;
}

.tag {
  flex: none;
  /* Web: px-2.5 py-0.5 */
  padding: 4rpx 20rpx;
  background: rgba(255, 200, 87, 0.30);
  border-radius: 999rpx;
  transform: rotate(-1deg);
}

/* 首页副标题标签 */
.tag--home {
  padding: 4rpx 20rpx;
  transform: rotate(-1deg);
}

.tag-text {
  font-size: 20rpx;
  font-weight: 700;
  color: #8D6E63;
  letter-spacing: 1rpx;
  white-space: nowrap;
}

@keyframes home-header-in {
  0% {
    opacity: 0;
    transform: translateY(-20rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}
