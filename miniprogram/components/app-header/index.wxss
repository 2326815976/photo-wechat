.header {
  position: sticky;
  top: 0;
  left: 0;
  right: 0;
  z-index: 900;
  background: rgba(255, 251, 240, 0.95);
  backdrop-filter: blur(12px);
  border-bottom: 4rpx dashed rgba(93, 64, 55, 0.15);
  box-shadow: 0 4rpx 24rpx rgba(93, 64, 55, 0.08);
}

.header-inner {
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  box-sizing: border-box;
}

.header-inner--with-tag {
  align-items: flex-start;
}

.header-inner--simple {
  justify-content: flex-start;
  gap: 24rpx;
}

.header-inner--simple .title-wrap {
  flex: none;
}

.header-inner--simple .title {
  font-size: 48rpx;
  font-weight: 700;
  font-family: "ZQKNNY", "YouYuan", "幼圆", "Microsoft YaHei", sans-serif;
  line-height: 1;
}

.header-inner--back-sub {
  padding-top: 16rpx;
  padding-bottom: 16rpx;
}

.header-inner--home {
  justify-content: space-between;
}

.header-inner--home-enter {
  animation: home-header-in 300ms ease-out both;
}

.back-wrap {
  flex: none;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 999rpx;
  background: rgba(255, 200, 87, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 0.2s ease;
}

.back-btn--active {
  background: rgba(255, 200, 87, 0.3);
}

.back-icon {
  width: 40rpx;
  height: 40rpx;
}

.title-wrap {
  flex: 1;
  min-width: 0;
}

.header-inner--with-tag .title-wrap {
  padding-top: 2rpx;
}

.title-wrap--home {
  flex: 1;
  min-width: 0;
  text-align: left;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #5D4037;
  line-height: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-family: "ZQKNNY", "YouYuan", "幼圆", "Microsoft YaHei", sans-serif;
}

.title--home {
  font-size: 40rpx;
  font-weight: 700;
  font-family: "ZQKNNY", "YouYuan", "幼圆", "Microsoft YaHei", sans-serif;
  line-height: 1;
}

.tag {
  flex: none;
  padding: 4rpx 20rpx;
  background: rgba(255, 200, 87, 0.3);
  border-radius: 999rpx;
  transform: rotate(-1deg);
}

.header-inner--with-tag .tag {
  min-height: 36rpx;
  padding: 0 20rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.tag--home {
  padding: 4rpx 20rpx;
  transform: rotate(-1deg);
}

.tag-text {
  font-size: 20rpx;
  font-weight: 700;
  color: #8D6E63;
  letter-spacing: 1rpx;
  white-space: nowrap;
}

.header-inner--with-tag .tag-text {
  display: block;
  line-height: 1;
}

@keyframes home-header-in {
  0% {
    opacity: 0;
    transform: translateY(-20rpx);
  }

  100% {
    opacity: 1;
    transform: translateY(0);
  }
}
