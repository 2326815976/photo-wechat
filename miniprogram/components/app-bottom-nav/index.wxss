.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  min-height: 136rpx;
  height: auto;
  padding-top: 8rpx;
  padding-bottom: 12rpx;
  padding-bottom: calc(12rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  background: rgba(255, 251, 240, 0.96);
  border-top: 4rpx dashed rgba(93, 64, 55, 0.15);
  box-shadow: 0 -4rpx 24rpx rgba(93, 64, 55, 0.08);
  z-index: 999;
  box-sizing: border-box;
}

.tab-scroll {
  width: 100%;
  min-height: 116rpx;
  height: auto;
  white-space: normal;
}

.tab-inner {
  width: 100%;
  min-height: 116rpx;
  height: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  padding: 0 24rpx 8rpx;
}

.tab-item {
  flex: 1 1 0;
  min-width: 0;
  min-height: 100rpx;
  padding: 0 8rpx;
  padding-top: 4rpx;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  overflow: hidden;
  border-radius: 28rpx;
  transition: transform 0.2s ease, color 0.2s ease;
  box-sizing: border-box;
}

.tab-item--selected {
  transform: translateY(-2rpx);
}

.tab-item--active {
  transform: scale(0.96);
}

.tab-glow {
  position: absolute;
  top: -4px;
  left: 50%;
  width: 96rpx;
  height: 96rpx;
  margin-left: -48rpx;
  background: rgba(255, 200, 87, 0.3);
  border-radius: 999rpx;
  filter: blur(16px);
  opacity: 0;
  pointer-events: none;
  transform: scale(0.8);
  animation: tab-glow-in 0.3s ease-out both;
}

.tab-icon-wrap {
  position: relative;
  z-index: 1;
  pointer-events: none;
}

.tab-icon-wrap--active {
  animation: tab-icon-rise 0.5s ease-out;
}

.tab-icon {
  width: 48rpx;
  height: 48rpx;
  pointer-events: none;
}

.tab-icon--active {
  filter: drop-shadow(0 4rpx 8rpx rgba(255, 200, 87, 0.3));
}

.tab-text {
  position: relative;
  z-index: 1;
  font-size: 20rpx;
  font-weight: 500;
  color: rgba(93, 64, 55, 0.6);
  pointer-events: none;
  transition: color 0.2s ease;
  max-width: 100%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tab-text--active {
  color: #ffc857;
  font-weight: 700;
}

@keyframes tab-glow-in {
  0% {
    opacity: 0;
    transform: scale(0.8);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes tab-icon-rise {
  0% {
    transform: translateY(0);
  }
  60% {
    transform: translateY(-6rpx);
  }
  100% {
    transform: translateY(0);
  }
}
