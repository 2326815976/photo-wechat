<view class="secondary-page-shell shell-class">
  <view wx:if="{{!hidden}}" class="secondary-page-shell__header" style="padding-top: {{resolvedSafeTop}}px;">
    <view class="secondary-page-shell__header-inner">
      <view class="secondary-page-shell__back-wrap" bindtap="onBack">
        <view class="secondary-page-shell__back-btn" hover-class="secondary-page-shell__back-btn--active" hover-stay-time="80">
          <image class="secondary-page-shell__back-icon" src="/images/icons/arrow-left.svg" mode="aspectFit" />
        </view>
      </view>

      <view class="secondary-page-shell__title-wrap">
        <text class="secondary-page-shell__title">{{displayedTitle}}</text>
      </view>
    </view>
  </view>

  <scroll-view
    wx:if="{{useScrollView}}"
    class="secondary-page-shell__content secondary-page-shell__content--scroll content-class"
    scroll-y="{{scrollY}}"
    enable-flex="{{enableFlex}}"
    show-scrollbar="{{showScrollbar}}"
  >
    <slot />
  </scroll-view>

  <view wx:else class="secondary-page-shell__content content-class">
    <slot />
  </view>
</view>
