.ip {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  font-family: "ZQKNNY", "YouYuan", "幼圆", "Microsoft YaHei", sans-serif;
  z-index: 2000;
  overflow: hidden;
}

.ip-bg {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.95);
}

.ip-close {
  position: absolute;
  right: 32rpx; /* 16px */
  width: 80rpx; /* 40px */
  height: 80rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.10);
  /* Web: backdrop-blur-sm（4px） */
  backdrop-filter: blur(4px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  transition: background-color 0.16s ease, transform 0.12s ease;
}

.ip-close--hover {
  background: rgba(255, 255, 255, 0.20);
}

.ip-close:active {
  background: rgba(255, 255, 255, 0.20);
  transform: scale(0.96);
}

.ip-close-icon {
  width: 48rpx; /* 24px */
  height: 48rpx;
}

.ip-tip {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  padding: 16rpx 32rpx; /* px-4 py-2 */
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.10);
  /* Web: backdrop-blur-sm（4px） */
  backdrop-filter: blur(4px);
  z-index: 10;
}

.ip-tip-text {
  font-size: 22rpx; /* text-xs */
  color: #FFFFFF;
  font-weight: 500;
  white-space: nowrap;
}

.ip-counter {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  padding: 8rpx 24rpx; /* px-3 py-1 */
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.10);
  /* Web: backdrop-blur-sm（4px） */
  backdrop-filter: blur(4px);
  z-index: 10;
}

.ip-counter-text {
  font-size: 22rpx; /* text-xs */
  color: #FFFFFF;
  font-weight: 700;
  white-space: nowrap;
}

.ip-scale {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.10);
  /* Web: backdrop-blur-sm（4px） */
  backdrop-filter: blur(4px);
  z-index: 10;
}

.ip-scale-text {
  font-size: 28rpx; /* text-sm */
  color: #FFFFFF;
  font-weight: 700;
  white-space: nowrap;
}

.ip-download {
  position: absolute;
  right: 32rpx;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  height: 72rpx;
  border-radius: 999rpx;
  padding: 0 28rpx;
  background: rgba(255, 255, 255, 0.10);
  /* Web: backdrop-blur-sm（4px） */
  backdrop-filter: blur(4px);
  z-index: 10;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  transition: background-color 0.16s ease, transform 0.12s ease;
}

.ip-download--hover {
  background: rgba(255, 255, 255, 0.20);
}

.ip-download:active {
  background: rgba(255, 255, 255, 0.20);
  transform: scale(0.96);
}

.ip-download-icon {
  width: 32rpx;
  height: 32rpx;
}

.ip-download-text {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 700;
  white-space: nowrap;
}

.ip-swiper {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
}

.ip-area {
  width: 100%;
  height: 100%;
}

.ip-view {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ip-image {
  width: 100%;
  height: 100%;
}

.ip-longpress {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.ip-longpress-canvas {
  width: 128rpx;
  height: 128rpx;
}
