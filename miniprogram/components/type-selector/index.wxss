.type-selector {
  width: 100%;
  position: relative;
  font-family: "ZQKNNY", "YouYuan", "幼圆", "Microsoft YaHei", sans-serif;
}

.select-btn {
  position: relative;
  width: 100%;
  min-height: 96rpx;
  padding: 24rpx 80rpx 24rpx 32rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  border: 4rpx solid rgba(93, 64, 55, 0.20);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease,
    transform 0.12s ease;
}

.select-btn--open {
  border-color: #FFC857;
  box-shadow: 0 0 0 6rpx rgba(255, 200, 87, 0.20);
}

.select-btn--pressed {
  background: #FFFEFA;
  transform: scale(0.998);
}

.select-text {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  color: #5D4037;
  font-weight: 500;
  line-height: 1.5;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.select-placeholder {
  color: rgba(93, 64, 55, 0.40);
  font-weight: 400;
}

.select-arrow {
  position: absolute;
  right: 24rpx;
  top: 50%;
  width: 40rpx;
  height: 40rpx;
  transform: translateY(-50%) rotate(0deg);
  transition: transform 0.2s ease;
}

.select-arrow--up {
  transform: translateY(-50%) rotate(180deg);
}

.select-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 998;
  background: transparent;
}

.select-panel {
  position: absolute;
  left: 0;
  right: 0;
  top: calc(100% + 16rpx);
  z-index: 999;
  background: #FFFFFF;
  border: 4rpx solid rgba(93, 64, 55, 0.20);
  border-radius: 32rpx;
  box-shadow: 0 12rpx 36rpx rgba(93, 64, 55, 0.16);
  overflow: hidden;
  transform-origin: top center;
  animation: select-panel-in 0.2s ease-out;
}

@keyframes select-panel-in {
  0% {
    opacity: 0;
    transform: translateY(-20rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

.select-option {
  width: 100%;
  min-height: 96rpx;
  padding: 24rpx 32rpx;
  box-sizing: border-box;
  background: #FFFFFF;
  color: #5D4037;
  border-radius: 0;
  border-bottom: 2rpx solid rgba(93, 64, 55, 0.08);
  text-align: left;
  display: flex;
  align-items: center;
  transition: background-color 0.16s ease;
}

.select-option:last-child {
  border-bottom: none;
}

.select-option--active {
  background: rgba(255, 200, 87, 0.20);
  color: #5D4037;
  font-weight: 600;
}

.select-option--hover:not(.select-option--active) {
  background: rgba(93, 64, 55, 0.05);
}

.select-option-text {
  font-size: 32rpx;
  line-height: 1.4;
}
