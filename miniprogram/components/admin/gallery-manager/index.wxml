<view class="album-detail-page">
  <view wx:if="{{loading}}" class="loading-container">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <view wx:else class="main-content">
    <view class="header-section">
      <view wx:if="{{!isSelectionMode}}" class="toolbar-actions toolbar-actions--normal">
        <button class="toolbar-btn toolbar-btn--soft" bindtap="onShowNewFolderModal">
          <image class="toolbar-btn__icon" src="/images/icons/plus-brown.svg" mode="aspectFit" />
          <text class="toolbar-btn__text">新建文件夹</text>
        </button>
        <button class="toolbar-btn toolbar-btn--ghost" bindtap="onEnterSelectionMode">
          <image class="toolbar-btn__icon" src="/images/icons/trash-red.svg" mode="aspectFit" />
          <text class="toolbar-btn__text">批量删除</text>
        </button>
        <button class="toolbar-btn toolbar-btn--primary" bindtap="onShowUploadModal">
          <image class="toolbar-btn__icon" src="/images/icons/square-brown.svg" mode="aspectFit" />
          <text class="toolbar-btn__text">上传照片</text>
        </button>
      </view>

      <view wx:else class="toolbar-actions toolbar-actions--selection">
        <button class="toolbar-btn toolbar-btn--ghost toolbar-btn--select-toggle" bindtap="onSelectAll">
          {{selectedPhotoIds.length === filteredPhotos.length && filteredPhotos.length > 0 ? '取消全选' : ('全选(' + selectedPhotoIds.length + '/' + filteredPhotos.length + ')')}}
        </button>
        <button class="toolbar-btn toolbar-btn--primary {{selectedPhotoIds.length === 0 ? 'toolbar-btn--disabled' : ''}}" bindtap="onShowMoveModal" disabled="{{selectedPhotoIds.length === 0}}">
          <image class="toolbar-btn__icon" src="/images/icons/chevrons-right-brown.svg" mode="aspectFit" />
          <text class="toolbar-btn__text">迁移({{selectedPhotoIds.length}})</text>
        </button>
        <button class="toolbar-btn toolbar-btn--danger {{selectedPhotoIds.length === 0 ? 'toolbar-btn--disabled' : ''}}" bindtap="onBatchDelete" disabled="{{selectedPhotoIds.length === 0}}">
          <image class="toolbar-btn__icon" src="/images/icons/trash-red.svg" mode="aspectFit" />
          <text class="toolbar-btn__text">删除({{selectedPhotoIds.length}})</text>
        </button>
        <button class="toolbar-btn toolbar-btn--ghost" bindtap="onExitSelectionMode">取消</button>
      </view>
    </view>

    <scroll-view class="folder-tabs" scroll-x="{{true}}" scroll-with-animation="{{true}}">
      <view class="folder-tab-wrap">
        <view
          class="folder-tab {{selectedFolder === null ? 'folder-tab--active' : ''}}"
          bindtap="onSelectFolder"
          data-folder-id="__ROOT__"
        >
          <text class="folder-tab__text">{{rootFolderName}} ({{rootPhotoCount}})</text>
        </view>
      </view>

      <view wx:for="{{folders}}" wx:key="id" class="folder-tab-wrap">
        <view
          class="folder-tab {{selectedFolder == item.id ? 'folder-tab--active' : ''}}"
          bindtap="onSelectFolder"
          data-folder-id="{{item.id}}"
        >
          <image class="folder-tab__icon" src="/images/icons/square-brown.svg" mode="aspectFit" />
          <text class="folder-tab__text">{{item.name}} ({{item.photoCount}})</text>
        </view>
      </view>
    </scroll-view>

    <view class="folder-current-actions" wx:if="{{!isSelectionMode}}">
      <button
        wx:if="{{selectedFolder === null}}"
        class="folder-current-action-btn folder-current-action-btn--edit folder-current-action-btn--single"
        bindtap="onShowEditRootModal"
      >
        编辑根目录
      </button>
      <block wx:elif="{{selectedFolderName}}">
        <button
          class="folder-current-action-btn folder-current-action-btn--edit"
          bindtap="onShowEditFolderModal"
          data-folder-id="{{selectedFolder}}"
          data-folder-name="{{selectedFolderName}}"
        >
          编辑文件夹
        </button>
        <button
          class="folder-current-action-btn folder-current-action-btn--danger"
          bindtap="onDeleteFolder"
          data-folder-id="{{selectedFolder}}"
        >
          删除文件夹
        </button>
      </block>
    </view>

    <view wx:if="{{filteredPhotos.length === 0}}" class="empty-state">
      <text class="empty-icon">🖼️</text>
      <text class="empty-text">暂无照片</text>
    </view>

    <view wx:else class="photos-grid">
      <view
        wx:for="{{filteredPhotos}}"
        wx:key="id"
        class="photo-card {{isSelectionMode && item.selected ? 'photo-card--selected' : ''}} {{item.story_highlight ? 'photo-card--story-highlight' : ''}}"
        bindtap="onPhotoCardTap"
        data-photo-id="{{item.id}}"
      >
        <view class="photo-card__image-wrap">
          <image
            class="photo-card__image"
            src="{{item.thumbnail_url || item.preview_url || item.original_url}}"
            mode="aspectFill"
            lazy-load="{{true}}"
          />

          <view wx:if="{{isSelectionMode}}" class="photo-card__check {{item.selected ? 'photo-card__check--active' : ''}}">
            <text wx:if="{{item.selected}}">✓</text>
          </view>

          <view wx:if="{{!isSelectionMode}}" class="photo-card__actions">
            <view
              wx:if="{{isSystemAlbum}}"
              class="photo-card__action photo-card__action--visibility {{item.isPublic ? 'photo-card__action--visible' : 'photo-card__action--hidden'}}"
              catchtap="onTogglePhotoVisibility"
              data-photo-id="{{item.id}}"
            >
              <image
                class="photo-card__action-icon"
                src="{{item.isPublic ? '/images/icons/eye-off-muted.svg' : '/images/icons/eye-brown.svg'}}"
                mode="aspectFit"
              />
            </view>
            <view class="photo-card__action photo-card__action--story" catchtap="onOpenStoryModal" data-photo-id="{{item.id}}">
              <text class="photo-card__story-icon">↻</text>
            </view>
            <view class="photo-card__action photo-card__action--date" catchtap="onOpenShotDateModal" data-photo-id="{{item.id}}">
              <text class="photo-card__date-icon">📅</text>
            </view>
            <view class="photo-card__action photo-card__action--move" catchtap="onMovePhoto" data-photo-id="{{item.id}}">
              <image class="photo-card__action-icon" src="/images/icons/chevrons-right-brown.svg" mode="aspectFit" />
            </view>
            <view class="photo-card__action photo-card__action--danger" catchtap="onDeletePhoto" data-photo-id="{{item.id}}">
              <image class="photo-card__action-icon" src="/images/icons/trash-red.svg" mode="aspectFit" />
            </view>
          </view>
        </view>

        <view class="photo-card__meta">
          <view class="photo-card__shot-time">
            <text class="photo-card__shot-time-icon">📅</text>
            <text class="photo-card__shot-time-text">{{item.dateText}}</text>
          </view>
          <view class="photo-card__shot-location">
            <text class="photo-card__shot-location-icon">📍</text>
            <text class="photo-card__shot-location-text">{{item.shotLocationText || '未知'}}</text>
          </view>
          <view class="photo-card__meta-bottom">
            <view class="photo-card__stat" wx:if="{{isSystemAlbum}}">
              <text>❤ {{item.likeCount}}</text>
            </view>
            <view class="photo-card__stat" wx:if="{{isSystemAlbum}}">
              <text>👁 {{item.viewCount}}</text>
            </view>
            <view class="photo-card__visibility {{item.visibilityClass}}" wx:if="{{isSystemAlbum}}">
              <text>{{item.visibilityText}}</text>
            </view>
            <text class="photo-card__story-badge" wx:if="{{item.has_story}}">故事</text>
            <text class="photo-card__story-badge photo-card__story-badge--highlight" wx:elif="{{item.story_highlight}}">高亮</text>
          </view>
        </view>

        <view class="photo-card__sort-actions" wx:if="{{!isSelectionMode}}">
          <button class="photo-card__sort-btn {{actionLoading ? 'photo-card__sort-btn--disabled' : ''}}" data-photo-id="{{item.id}}" catchtap="onMovePhotoTop" disabled="{{actionLoading}}">置顶</button>
          <button class="photo-card__sort-btn {{(index === 0 || actionLoading) ? 'photo-card__sort-btn--disabled' : ''}}" data-photo-id="{{item.id}}" data-direction="up" catchtap="onMovePhotoSort" disabled="{{index === 0 || actionLoading}}">上移</button>
          <button class="photo-card__sort-btn {{(index === filteredPhotos.length - 1 || actionLoading) ? 'photo-card__sort-btn--disabled' : ''}}" data-photo-id="{{item.id}}" data-direction="down" catchtap="onMovePhotoSort" disabled="{{index === filteredPhotos.length - 1 || actionLoading}}">下移</button>
        </view>
      </view>
    </view>

    <view class="pagination">
      <button class="pagination__btn {{currentPage === 1 ? 'pagination__btn--disabled' : ''}}" bindtap="onPrevPage" disabled="{{currentPage === 1}}">
        上一页
      </button>
      <text class="pagination__info">第 {{currentPage}} 页 / 共 {{totalPages}} 页</text>
      <button class="pagination__btn {{currentPage >= totalPages ? 'pagination__btn--disabled' : ''}}" bindtap="onNextPage" disabled="{{currentPage >= totalPages}}">
        下一页
      </button>
    </view>
  </view>

  <view wx:if="{{showNewFolderModal}}" class="modal-mask" bindtap="onCloseNewFolderModal">
    <view class="modal-container" catchtap="onStopPropagation">
      <view class="modal-header">
        <text class="modal-title">新建文件夹</text>
      </view>
      <view class="modal-body">
        <input
          class="modal-input"
          value="{{newFolderName}}"
          bindinput="onNewFolderNameInput"
          placeholder="输入文件夹名称"
          maxlength="50"
          focus="{{showNewFolderModal}}"
        />
      </view>
      <view class="modal-footer">
        <button class="modal-btn modal-btn--ghost" bindtap="onCloseNewFolderModal">取消</button>
        <button class="modal-btn modal-btn--primary {{actionLoading ? 'modal-btn--disabled' : ''}}" bindtap="onCreateFolder" disabled="{{actionLoading}}">
          {{actionLoading ? '创建中...' : '创建'}}
        </button>
      </view>
    </view>
  </view>

  <view wx:if="{{showEditRootModal}}" class="modal-mask" bindtap="onCloseEditRootModal">
    <view class="modal-container" catchtap="onStopPropagation">
      <view class="modal-header">
        <text class="modal-title">修改根目录名称</text>
      </view>
      <view class="modal-body">
        <input
          class="modal-input"
          value="{{newRootFolderName}}"
          bindinput="onNewRootFolderNameInput"
          placeholder="输入根目录名称"
          maxlength="30"
          focus="{{showEditRootModal}}"
        />
        <text class="modal-hint">建议 2-12 个字，最多 30 个字符</text>
      </view>
      <view class="modal-footer">
        <button class="modal-btn modal-btn--ghost {{actionLoading ? 'modal-btn--disabled' : ''}}" bindtap="onCloseEditRootModal" disabled="{{actionLoading}}">取消</button>
        <button class="modal-btn modal-btn--primary {{actionLoading ? 'modal-btn--disabled' : ''}}" bindtap="onUpdateRootFolderName" disabled="{{actionLoading}}">
          {{actionLoading ? '保存中...' : '保存'}}
        </button>
      </view>
    </view>
  </view>

  <view wx:if="{{showEditFolderModal}}" class="modal-mask" bindtap="onCloseEditFolderModal">
    <view class="modal-container" catchtap="onStopPropagation">
      <view class="modal-header">
        <text class="modal-title">修改文件夹名称</text>
      </view>
      <view class="modal-body">
        <input
          class="modal-input"
          value="{{editingFolderName}}"
          bindinput="onEditFolderNameInput"
          placeholder="输入文件夹名称"
          maxlength="50"
          focus="{{showEditFolderModal}}"
        />
        <text class="modal-hint">建议 2-12 个字，最多 50 个字符</text>
      </view>
      <view class="modal-footer">
        <button class="modal-btn modal-btn--ghost {{actionLoading ? 'modal-btn--disabled' : ''}}" bindtap="onCloseEditFolderModal" disabled="{{actionLoading}}">取消</button>
        <button class="modal-btn modal-btn--primary {{actionLoading ? 'modal-btn--disabled' : ''}}" bindtap="onUpdateFolderName" disabled="{{actionLoading}}">
          {{actionLoading ? '保存中...' : '保存'}}
        </button>
      </view>
    </view>
  </view>

  <view wx:if="{{showUploadModal}}" class="booking-modal-mask" bindtap="onCloseUploadModal">
    <view class="booking-modal booking-modal--form gallery-upload-modal" catchtap="onStopPropagation">
      <view class="booking-modal__head">
        <text class="booking-modal__title">上传照片</text>
        <view class="booking-modal__close" bindtap="onCloseUploadModal">
          <text>✕</text>
        </view>
      </view>
      <view class="booking-modal__body">
        <view class="upload-mode-tabs">
          <view class="upload-mode-tab {{uploadMode === 'single' ? 'upload-mode-tab--active' : ''}}" bindtap="onUploadModeChange" data-mode="single">
            <text>单图</text>
          </view>
          <view class="upload-mode-tab {{uploadMode === 'batch' ? 'upload-mode-tab--active' : ''}}" bindtap="onUploadModeChange" data-mode="batch">
            <text>批量</text>
          </view>
        </view>

        <view class="gallery-upload-picker" catchtap="onChooseImages">
          <text class="gallery-upload-picker__icon">📤</text>
          <text class="gallery-upload-picker__text" wx:if="{{uploadMode === 'single' && singleImage}}">
            已选择 1 张图片
          </text>
          <text class="gallery-upload-picker__text" wx:elif="{{uploadMode === 'batch' && batchImages.length}}">
            已选择 {{batchImages.length}} 张图片
          </text>
          <text class="gallery-upload-picker__text" wx:else>{{uploadMode === 'single' ? '点击选择单张图片' : '点击选择多张图片'}}</text>
        </view>

        <view class="single-upload-config" wx:if="{{uploadMode === 'single'}}">
          <view class="single-upload-preview" wx:if="{{singleImage}}">
            <text class="single-upload-preview__title">{{singleImage.name}}</text>
            <text class="single-upload-preview__meta">{{singleImage.sizeText}}</text>
            <view class="gallery-upload-list-clear" bindtap="onClearImages">
              <text>清空</text>
            </view>
          </view>

          <view class="single-date-row">
            <text class="single-date-row__label">拍摄日期（单图可选）</text>
            <picker mode="date" value="{{singleShotDate}}" bindchange="onSingleShotDateChange">
              <view class="single-date-row__value">{{singleShotDate}}</view>
            </picker>
          </view>

          <view class="booking-modal__field">
            <text class="booking-modal__label">拍摄地点（单图可选）</text>
            <input
              class="shot-location-input"
              type="text"
              maxlength="255"
              placeholder="例如：成都·人民公园"
              value="{{singleShotLocation}}"
              bindinput="onSingleShotLocationInput"
            />
          </view>

          <view class="booking-modal__field">
            <text class="booking-modal__label">关于此刻（单图可选）</text>
            <textarea
              class="booking-modal__textarea"
              placeholder="写下这张照片的故事"
              maxlength="800"
              value="{{singleStoryText}}"
              bindinput="onSingleStoryInput"
              auto-height="{{true}}"
            />
          </view>

          <view class="single-highlight-row">
            <text class="single-highlight-row__label">高亮该照片（无文案也可高亮）</text>
            <switch checked="{{singleHighlight}}" color="#FFC857" bindchange="onSingleHighlightChange" />
          </view>
        </view>

        <view class="gallery-upload-list-wrap" wx:if="{{uploadMode === 'batch' && batchImages.length}}">
          <view class="gallery-upload-list-head">
            <text class="gallery-upload-list-title">已选择 {{batchImages.length}} 张</text>
            <view class="gallery-upload-list-clear" bindtap="onClearImages">
              <text>清空</text>
            </view>
          </view>
          <scroll-view class="gallery-upload-list" scroll-y="true">
            <view class="gallery-upload-item" wx:for="{{batchImages}}" wx:key="path">
              <view class="gallery-upload-item__main">
                <text class="gallery-upload-item__name">{{index + 1}}. {{item.name}}</text>
                <text class="gallery-upload-item__meta">{{item.sizeText || '待上传'}}</text>
              </view>
              <view class="gallery-upload-item__remove" data-index="{{index}}" bindtap="onRemoveUploadImage" wx:if="{{!uploading}}">
                <text>✕</text>
              </view>
            </view>
          </scroll-view>
        </view>

        <view class="single-date-row" wx:if="{{uploadMode === 'batch'}}">
          <text class="single-date-row__label">拍摄日期（批量统一）</text>
          <picker mode="date" value="{{batchShotDate}}" bindchange="onBatchShotDateChange">
            <view class="single-date-row__value">{{batchShotDate}}</view>
          </picker>
        </view>

        <view class="booking-modal__field" wx:if="{{uploadMode === 'batch'}}">
          <text class="booking-modal__label">拍摄地点（批量统一，可选）</text>
          <input
            class="shot-location-input"
            type="text"
            maxlength="255"
            placeholder="例如：成都·人民公园"
            value="{{batchShotLocation}}"
            bindinput="onBatchShotLocationInput"
          />
        </view>

        <view class="gallery-upload-progress" wx:if="{{uploading && uploadProgress.total > 0}}">
          <view class="gallery-upload-progress__head">
            <text class="gallery-upload-progress__title">上传进度</text>
            <text class="gallery-upload-progress__text">{{uploadProgress.current}} / {{uploadProgress.total}}</text>
          </view>
          <view class="gallery-upload-progress__bar">
            <view class="gallery-upload-progress__bar-fill" style="width: {{(uploadProgress.current * 100 / uploadProgress.total)}}%;"></view>
          </view>
        </view>

        <button
          class="booking-modal__submit {{(uploading || (uploadMode === 'single' ? !singleImage : !batchImages.length)) ? 'booking-modal__submit--disabled' : ''}}"
          catchtap="onUploadPhotos"
          hover-class="booking-modal__submit--active"
          loading="{{uploading}}"
          disabled="{{uploading || (uploadMode === 'single' ? !singleImage : !batchImages.length)}}"
        >
          <text wx:if="{{uploading}}">上传中 ({{uploadProgress.current}}/{{uploadProgress.total}})...</text>
          <text wx:elif="{{uploadMode === 'single'}}">上传单张照片</text>
          <text wx:else>批量上传 ({{batchImages.length}} 张)</text>
        </button>

        <text class="upload-mode-tip" wx:if="{{uploadMode === 'batch'}}">批量上传可统一设置拍摄日期与地点，不支持“关于此刻”，可在列表中后续编辑。</text>
        <text class="upload-mode-tip" wx:elif="{{uploadMode === 'single'}}">单图上传可设置拍摄日期、地点、“关于此刻”和高亮。</text>
      </view>
    </view>
  </view>

  <view wx:if="{{showStoryModal}}" class="modal-mask" bindtap="onCloseStoryModal">
    <view class="modal-container" catchtap="onStopPropagation">
      <view class="modal-header">
        <text class="modal-title">编辑关于此刻</text>
      </view>
      <view class="modal-body">
        <textarea
          class="booking-modal__textarea"
          placeholder="写下这张照片的故事（可留空）"
          maxlength="800"
          value="{{editingStoryText}}"
          bindinput="onEditingStoryInput"
          auto-height="{{true}}"
        />
        <view class="single-highlight-row">
          <text class="single-highlight-row__label">高亮该照片（可独立于文案）</text>
          <switch checked="{{editingStoryHighlight}}" color="#FFC857" bindchange="onEditingStoryHighlightChange" />
        </view>
      </view>
      <view class="modal-footer">
        <button class="modal-btn modal-btn--ghost {{actionLoading ? 'modal-btn--disabled' : ''}}" bindtap="onCloseStoryModal" disabled="{{actionLoading}}">取消</button>
        <button class="modal-btn modal-btn--primary {{actionLoading ? 'modal-btn--disabled' : ''}}" bindtap="onSaveStory" disabled="{{actionLoading}}">
          {{actionLoading ? '保存中...' : '保存'}}
        </button>
      </view>
    </view>
  </view>

  <view wx:if="{{showShotDateModal}}" class="modal-mask" bindtap="onCloseShotDateModal">
    <view class="modal-container" catchtap="onStopPropagation">
      <view class="modal-header">
        <text class="modal-title">修改拍摄信息</text>
      </view>
      <view class="modal-body">
        <view class="booking-modal__field">
          <text class="booking-modal__label">拍摄日期</text>
          <picker mode="date" value="{{editingShotDateValue}}" bindchange="onEditingShotDateChange">
            <view class="shot-date-picker">{{editingShotDateValue}}</view>
          </picker>
        </view>
        <view class="booking-modal__field">
          <text class="booking-modal__label">拍摄地点</text>
          <input
            class="shot-location-input"
            type="text"
            maxlength="255"
            placeholder="拍摄地点（可留空）"
            value="{{editingShotLocationValue}}"
            bindinput="onEditingShotLocationInput"
          />
        </view>
      </view>
      <view class="modal-footer">
        <button class="modal-btn modal-btn--ghost {{actionLoading ? 'modal-btn--disabled' : ''}}" bindtap="onCloseShotDateModal" disabled="{{actionLoading}}">取消</button>
        <button class="modal-btn modal-btn--primary {{actionLoading ? 'modal-btn--disabled' : ''}}" bindtap="onSaveShotDate" disabled="{{actionLoading}}">
          {{actionLoading ? '保存中...' : '保存'}}
        </button>
      </view>
    </view>
  </view>

  <view wx:if="{{showMoveModal}}" class="modal-mask" bindtap="onCloseMoveModal">
    <view class="modal-container modal-container--move" catchtap="onStopPropagation">
      <view class="modal-header-center">
        <view class="modal-icon-wrap">
          <image class="modal-icon-wrap__icon" src="/images/icons/chevrons-right-brown.svg" mode="aspectFit" />
        </view>
        <text class="modal-title">迁移照片</text>
        <text class="modal-subtitle">选择目标文件夹，将 {{movingPhotoIds.length}} 张照片迁移过去</text>
      </view>

      <view class="modal-body">
        <scroll-view class="move-folder-list" scroll-y="{{true}}">
          <view
            class="move-folder-item {{moveTargetFolder === '__ROOT__' ? 'move-folder-item--active' : ''}}"
            bindtap="onSelectMoveTarget"
            data-folder-id="__ROOT__"
          >
            <view class="move-folder-item__left">
              <image class="move-folder-item__icon" src="/images/icons/square-brown.svg" mode="aspectFit" />
              <text class="move-folder-item__name">{{rootFolderName}}</text>
            </view>
            <text class="move-folder-item__count">{{rootPhotoCount}}</text>
          </view>

          <view
            wx:for="{{folders}}"
            wx:key="id"
            class="move-folder-item {{moveTargetFolder == item.id ? 'move-folder-item--active' : ''}}"
            bindtap="onSelectMoveTarget"
            data-folder-id="{{item.id}}"
          >
            <view class="move-folder-item__left">
              <image class="move-folder-item__icon" src="/images/icons/square-brown.svg" mode="aspectFit" />
              <text class="move-folder-item__name">{{item.name}}</text>
            </view>
            <text class="move-folder-item__count">{{item.photoCount}}</text>
          </view>
        </scroll-view>
      </view>

      <view class="modal-footer">
        <button class="modal-btn modal-btn--ghost {{actionLoading ? 'modal-btn--disabled' : ''}}" bindtap="onCloseMoveModal" disabled="{{actionLoading}}">取消</button>
        <button class="modal-btn modal-btn--primary {{(actionLoading || movingPhotoIds.length === 0) ? 'modal-btn--disabled' : ''}}" bindtap="onConfirmMove" disabled="{{actionLoading || movingPhotoIds.length === 0}}">
          {{actionLoading ? '迁移中...' : '确认迁移'}}
        </button>
      </view>
    </view>
  </view>

  <view wx:if="{{deletingFolder}}" class="modal-mask" bindtap="onCancelDeleteFolder">
    <view class="modal-container modal-container--confirm" catchtap="onStopPropagation">
      <view class="modal-header-center">
        <view class="modal-icon-wrap modal-icon-wrap--warn">
          <image class="modal-icon-wrap__icon" src="/images/icons/alert-triangle-red.svg" mode="aspectFit" />
        </view>
        <text class="modal-title">删除文件夹</text>
        <text class="modal-subtitle">确定要删除文件夹 <text class="text-strong">{{deletingFolder.name}}</text> 吗？</text>
      </view>
      <view class="modal-body">
        <view class="warning-box">
          <text class="warning-box__text">文件夹内的照片将移至根目录</text>
        </view>
      </view>
      <view class="modal-footer">
        <button class="modal-btn modal-btn--ghost {{actionLoading ? 'modal-btn--disabled' : ''}}" bindtap="onCancelDeleteFolder" disabled="{{actionLoading}}">取消</button>
        <button class="modal-btn modal-btn--danger {{actionLoading ? 'modal-btn--disabled' : ''}}" bindtap="onConfirmDeleteFolder" disabled="{{actionLoading}}">
          {{actionLoading ? '删除中...' : '确认删除'}}
        </button>
      </view>
    </view>
  </view>

  <view wx:if="{{deletingPhoto}}" class="modal-mask" bindtap="onCancelDeletePhoto">
    <view class="modal-container modal-container--confirm" catchtap="onStopPropagation">
      <view class="modal-header-center">
        <view class="modal-icon-wrap modal-icon-wrap--danger">
          <image class="modal-icon-wrap__icon" src="/images/icons/trash-red.svg" mode="aspectFit" />
        </view>
        <text class="modal-title">删除照片</text>
        <text class="modal-subtitle">确定要删除这张照片吗？此操作不可撤销。</text>
      </view>
      <view class="modal-footer">
        <button class="modal-btn modal-btn--ghost {{actionLoading ? 'modal-btn--disabled' : ''}}" bindtap="onCancelDeletePhoto" disabled="{{actionLoading}}">取消</button>
        <button class="modal-btn modal-btn--danger {{actionLoading ? 'modal-btn--disabled' : ''}}" bindtap="onConfirmDeletePhoto" disabled="{{actionLoading}}">
          {{actionLoading ? '删除中...' : '确认删除'}}
        </button>
      </view>
    </view>
  </view>

  <view wx:if="{{showBatchDeleteConfirm}}" class="modal-mask" bindtap="onCancelBatchDelete">
    <view class="modal-container modal-container--confirm" catchtap="onStopPropagation">
      <view class="modal-header-center">
        <view class="modal-icon-wrap modal-icon-wrap--danger">
          <image class="modal-icon-wrap__icon" src="/images/icons/trash-red.svg" mode="aspectFit" />
        </view>
        <text class="modal-title">批量删除照片</text>
        <text class="modal-subtitle">确定要删除选中的 <text class="text-strong text-danger">{{selectedPhotoIds.length}}</text> 张照片吗？</text>
      </view>
      <view class="modal-body">
        <view class="warning-box warning-box--danger">
          <text class="warning-box__text warning-box__text--danger">此操作不可撤销</text>
        </view>
      </view>
      <view class="modal-footer">
        <button class="modal-btn modal-btn--ghost" bindtap="onCancelBatchDelete">取消</button>
        <button class="modal-btn modal-btn--danger" bindtap="onConfirmBatchDelete">确认删除</button>
      </view>
    </view>
  </view>

  <view wx:if="{{previewPhoto}}" class="preview-mask" bindtap="onClosePreview">
    <view class="preview-container" catchtap="onStopPropagation">
      <view class="preview-tape"></view>
      <view class="preview-close" bindtap="onClosePreview">
        <image class="preview-close__icon" src="/images/icons/x-white.svg" mode="aspectFit" />
      </view>

      <view class="preview-image-wrap">
        <image
          class="preview-image"
          src="{{previewPhoto.original_url || previewPhoto.preview_url || previewPhoto.thumbnail_url}}"
          mode="aspectFit"
        />
      </view>

      <view class="preview-info">
        <image class="preview-info__icon" src="/images/icons/eye-brown.svg" mode="aspectFit" />
        <text class="preview-info__text">照片预览</text>
      </view>
    </view>
  </view>

  <view wx:if="{{showToast}}" class="toast toast--{{toastType}}">
    <text class="toast__icon">{{toastType === 'success' ? '✓' : (toastType === 'warning' ? '!' : '✕')}}</text>
    <text class="toast__text">{{toastMessage}}</text>
  </view>
</view>
