<view class="page-center-panel">
  <view class="page-shell {{embedded ? 'page-shell--embedded' : ''}}">
    <view class="panel-card" wx:if="{{loading}}">
      <view class="empty-box">正在读取页面管理数据...</view>
    </view>

    <view class="panel-card" wx:elif="{{!pageSections.length}}">
      <view class="empty-box">当前没有可管理的页面。</view>
    </view>

    <block wx:else>
      <view class="page-section" wx:for="{{pageSections}}" wx:key="key">
        <view class="page-card panel-card" wx:for="{{item.rows}}" wx:for-item="group" wx:key="key">
          <view class="page-card__layout page-card__layout--simple">
            <view class="page-card__main">
              <view class="page-card__head">
                <view class="page-card__title-row">
                  <view class="page-card__title">{{group.parent.pageName}}</view>
                  <text class="status-pill status-pill--{{group.parent.statusType}}">{{group.parent.statusLabel}}</text>
                  <text class="tag-pill">{{group.parent.pageKey}}</text>
                  <text class="tag-pill tag-pill--soft" wx:if="{{group.parent.isBuiltIn}}">内置页</text>
                </view>
                <text class="page-card__desc" wx:if="{{group.parent.pageDescription}}">{{group.parent.pageDescription}}</text>
              </view>
            </view>

            <view class="action-grid action-grid--triple page-card__actions">
              <button class="action-btn action-btn--view" bindtap="onQuickAction" data-page-key="{{group.parent.pageKey}}" data-action="edit">编辑</button>
              <button class="action-btn {{group.parent.quickActionClassName}}" bindtap="onQuickAction" data-page-key="{{group.parent.pageKey}}" data-action="{{group.parent.quickActionType}}" disabled="{{(savingKey ? true : false) || group.parent.quickActionDisabled}}">{{savingKey === (group.parent.pageKey + ':state:' + group.parent.quickActionType) ? group.parent.quickActionLoadingLabel : group.parent.quickActionLabel}}</button>
              <button class="action-btn action-btn--view" bindtap="onQuickAction" data-page-key="{{group.parent.pageKey}}" data-action="view" disabled="{{!group.parent.supportsPreview || !group.parent.currentPreviewRoutePath}}">查看</button>
            </view>
          </view>

          <view class="page-card__subtree" wx:if="{{group.childCount}}">
            <view class="page-card__subtree-head" bindtap="onToggleExpand" data-page-key="{{group.parent.pageKey}}">
              <view class="page-card__subtree-copy">
                <view class="page-card__subtree-title">所属二级菜单</view>
                <text class="page-card__subtree-desc">这些入口会展示在“{{group.parent.pageName}}”页内，可单独编辑标题、显示或隐藏。</text>
              </view>
              <view class="page-card__subtree-meta">
                <text class="tag-pill page-card__subtree-count">{{group.childCount}} 个入口</text>
                <text class="tag-pill page-card__subtree-toggle">{{group.isExpanded ? '收起' : '展开'}}</text>
              </view>
            </view>

            <view class="page-card__subtree-list" wx:if="{{group.isExpanded}}">
              <view class="page-card__subtree-group" wx:for="{{group.childGroups}}" wx:for-item="childGroup" wx:key="key">
                <view class="page-card__subtree-group-head" wx:if="{{childGroup.title || childGroup.description}}">
                  <view class="page-card__subtree-group-title" wx:if="{{childGroup.title}}">{{childGroup.title}}</view>
                  <text class="page-card__subtree-group-desc" wx:if="{{childGroup.description}}">{{childGroup.description}}</text>
                </view>

                <view class="page-card page-card--child" wx:for="{{childGroup.rows}}" wx:for-item="row" wx:key="pageKey">
                  <view class="page-card__layout page-card__layout--simple">
                    <view class="page-card__main">
                      <view class="page-card__head">
                        <view class="page-card__title-row">
                          <view class="page-card__title page-card__title--child">{{row.pageName}}</view>
                          <text class="status-pill status-pill--{{row.statusType}}">{{row.statusLabel}}</text>
                        </view>
                        <text class="page-card__desc">{{row.entryHint}}</text>
                      </view>
                    </view>

                    <view class="action-grid action-grid--triple page-card__actions">
                      <button class="action-btn action-btn--view" bindtap="onQuickAction" data-page-key="{{row.pageKey}}" data-action="edit">编辑</button>
                      <button class="action-btn {{row.quickActionClassName}}" bindtap="onQuickAction" data-page-key="{{row.pageKey}}" data-action="{{row.quickActionType}}" disabled="{{(savingKey ? true : false) || row.quickActionDisabled}}">{{savingKey === (row.pageKey + ':state:' + row.quickActionType) ? row.quickActionLoadingLabel : row.quickActionLabel}}</button>
                      <button class="action-btn action-btn--view" bindtap="onQuickAction" data-page-key="{{row.pageKey}}" data-action="view" disabled="{{!row.supportsPreview || !row.currentPreviewRoutePath}}">查看</button>
                    </view>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </block>

    <view class="modal-mask" wx:if="{{dialogRow && dialogMode}}" bindtap="closeActionDialog">
      <view class="modal-card {{dialogMode === 'offline' ? 'modal-card--confirm' : 'modal-card--editor'}}" catchtap="noop">
        <view class="modal-head">
          <view class="modal-head__main">
            <view class="modal-title">{{dialogMode === 'offline' ? ((dialogRow.isSecondaryPage ? '确认隐藏 · ' : '确认下线 · ') + dialogRow.pageName) : '编辑页面 · ' + dialogRow.pageName}}</view>
            <text class="modal-desc" wx:if="{{dialogMode === 'offline'}}">{{dialogRow.isSecondaryPage ? '隐藏后普通用户将无法从所属一级页进入，管理员仍可通过“查看”无底栏进入。' : '下线后普通用户无法访问该页面，管理员仍可通过“查看”无底栏进入。'}}</text>
          </view>
          <view class="modal-close" bindtap="closeActionDialog">×</view>
        </view>

        <view class="modal-body {{dialogMode === 'offline' ? 'modal-body--confirm' : 'modal-body--editor'}}">
          <block wx:if="{{dialogMode === 'offline'}}">
            <view class="impact-card impact-card--danger">
              <view class="impact-card__title">{{dialogRow.isSecondaryPage ? '隐藏影响' : '下线影响'}}</view>
              <text class="impact-card__desc">{{dialogRow.isSecondaryPage ? '• 普通用户将无法从所属一级页进入该二级页面。' : '• 普通用户无法通过正式路由访问该页面。'}}</text>
              <text class="impact-card__desc">{{dialogRow.isSecondaryPage ? '• 当前入口名称与页面顶部标题会一起对普通用户隐藏。' : '• 如果页面当前在底栏中，会立即从底部菜单移除。'}}</text>
              <text class="impact-card__desc">• 管理员仍可通过“查看”无底栏预览该页面。</text>
            </view>

            <view class="field-grid field-grid--two">
              <view class="info-card info-card--plain">
                <view class="info-card__title">正式路由</view>
                <text class="info-card__desc info-card__desc--mono">{{dialogRow.currentRoutePath || '未配置'}}</text>
              </view>
              <view class="info-card info-card--plain">
                <view class="info-card__title">查看路由</view>
                <text class="info-card__desc info-card__desc--mono">{{dialogRow.currentPreviewRoutePath || '未配置'}}</text>
              </view>
            </view>

            <view class="modal-actions">
              <button class="modal-btn modal-btn--ghost" bindtap="closeActionDialog">取消</button>
              <button class="modal-btn modal-btn--danger" bindtap="onDialogSubmit" data-action="offline" disabled="{{savingKey ? true : false}}">{{dialogRow.isSecondaryPage ? '确认隐藏' : '确认下线'}}</button>
            </view>
          </block>

          <block wx:else>
            <view class="modal-section">
              <view class="modal-section__head">
                <view>
                  <view class="modal-section__title">{{dialogRow.editSectionTitle}}</view>
                  <text class="modal-section__desc">{{dialogRow.editSectionDesc}}</text>
                </view>
              </view>
              <view class="field-grid field-grid--two modal-section__form-grid" wx:if="{{dialogRow.showPrimaryFullEdit}}">
                <view class="field-card">
                  <text class="field-label">顶部大标题</text>
                  <input class="field-input" value="{{dialogRow.currentRule.headerTitle}}" data-page-key="{{dialogRow.pageKey}}" data-field="headerTitle" bindinput="onRuleInput" placeholder="如：拾光谣" />
                </view>
                <view class="field-card">
                  <text class="field-label">顶部小标题</text>
                  <input class="field-input" value="{{dialogRow.currentRule.headerSubtitle}}" data-page-key="{{dialogRow.pageKey}}" data-field="headerSubtitle" bindinput="onRuleInput" placeholder="如：定格美好瞬间" />
                </view>
                <view class="field-card field-card--full">
                  <text class="field-label">底部菜单名称</text>
                  <input class="field-input" value="{{dialogRow.currentRule.navText}}" data-page-key="{{dialogRow.pageKey}}" data-field="navText" bindinput="onRuleInput" placeholder="如：首页" />
                </view>
              </view>
              <view class="modal-section__form-grid" wx:elif="{{dialogRow.showPrimaryBetaTitleEdit}}">
                <view class="field-card">
                  <text class="field-label">顶部标题</text>
                  <input class="field-input" value="{{dialogRow.currentRule.headerTitle}}" data-page-key="{{dialogRow.pageKey}}" data-field="headerTitle" bindinput="onRuleInput" placeholder="如：拾光谣" />
                </view>
              </view>
              <view class="modal-section__form-grid" wx:else>
                <view class="field-card">
                  <text class="field-label">{{dialogRow.pageKey === 'album-detail' ? '默认名称（无相册名时使用）' : '入口名称 / 顶部标题'}}</text>
                  <input class="field-input" value="{{dialogRow.currentRule.navText}}" data-page-key="{{dialogRow.pageKey}}" data-field="navText" bindinput="onRuleInput" placeholder="如：专属返图空间" />
                </view>
              </view>
              <view class="modal-section__actions">
                <button class="mini-btn mini-btn--strong modal-section__save-btn" bindtap="onSaveTitleRule" data-page-key="{{dialogRow.pageKey}}" disabled="{{savingKey ? true : false}}">{{savingKey === (dialogRow.pageKey + ':rule:title') ? '保存中...' : dialogRow.editSaveButtonText}}</button>
              </view>
            </view>

            <view class="modal-section" wx:if="{{dialogRow.supportsBeta}}">
              <view class="modal-section__head">
                <view>
                  <view class="modal-section__title">内测设置</view>
                  <text class="modal-section__desc">{{dialogRow.betaSectionDesc}}</text>
                </view>
              </view>

              <view class="field-grid field-grid--two modal-section__form-grid">
                <view class="field-card">
                  <text class="field-label">内测码名称</text>
                  <input class="field-input" value="{{dialogRow.betaDraft.betaName}}" data-page-key="{{dialogRow.pageKey}}" data-field="betaName" bindinput="onBetaInput" focus="{{betaEditorFocusPageKey === dialogRow.pageKey}}" placeholder="如：4 月摄影伙伴" />
                </view>
                <view class="field-card">
                  <text class="field-label">到期日期</text>
                  <picker mode="date" value="{{dialogRow.betaDraft.expiresAt}}" data-page-key="{{dialogRow.pageKey}}" data-field="expiresAt" bindchange="onBetaInput">
                    <view class="field-picker {{dialogRow.betaDraft.expiresAt ? '' : 'field-picker--placeholder'}}">{{dialogRow.betaDraft.expiresAt || '请选择日期'}}</view>
                  </picker>
                </view>
                <view class="field-card field-card--full">
                  <text class="field-label">内测码（留空则自动生成）</text>
                  <view class="beta-code-row">
                    <input class="field-input field-input--upper beta-code-input" value="{{dialogRow.betaDraft.betaCode}}" data-page-key="{{dialogRow.pageKey}}" data-field="betaCode" bindinput="onBetaInput" placeholder="如：SGY2026" />
                    <button class="mini-btn beta-code-generate-btn" bindtap="onGenerateBetaCode" data-page-key="{{dialogRow.pageKey}}">随机生成</button>
                  </view>
                </view>
              </view>

              <text class="helper-text">{{dialogRow.betaDraftHelperText}}</text>

              <view class="inline-actions beta-actions">
                <button class="mini-btn mini-btn--strong inline-actions__btn" bindtap="onSaveBetaCode" data-page-key="{{dialogRow.pageKey}}" disabled="{{savingKey ? true : false}}">{{dialogRow.betaSaveButtonText}}</button>
                <button class="mini-btn mini-btn--soft-primary inline-actions__btn" bindtap="onDialogSubmit" data-action="beta" disabled="{{(savingKey ? true : false) || !dialogRow.betaCodesAvailable.length}}">切换为内测</button>
              </view>

              <text class="beta-codes-summary" wx:if="{{dialogRow.betaCodesAvailable.length}}">当前可用内测码 {{dialogRow.betaCodesAvailable.length}} 个</text>

              <view class="code-list">
                <view class="code-card" wx:for="{{dialogRow.betaCodesVisible}}" wx:key="id">
                  <view class="code-card__head">
                    <view class="code-card__main">
                      <view class="code-card__title-row">
                        <view class="code-card__title">{{item.betaName}}</view>
                        <text class="code-pill code-pill--{{item.lifecycleKey}}">{{item.lifecycleLabel}}</text>
                        <text class="code-pill code-pill--compat" wx:if="{{item.readOnly}}">旧体系兼容</text>
                      </view>
                      <text class="code-card__code">{{item.betaCode}}</text>
                      <text class="code-card__hint" wx:if="{{item.readOnly && item.manageHint}}">{{item.manageHint}}</text>
                    </view>
                    <view class="inline-actions inline-actions--compact code-card__actions">
                      <button class="mini-btn" bindtap="onEditBetaCode" data-page-key="{{dialogRow.pageKey}}" data-code-id="{{item.id}}">{{item.editActionText}}</button>
                      <button class="mini-btn mini-btn--danger" bindtap="onDestroyBetaCode" data-page-key="{{dialogRow.pageKey}}" data-code-id="{{item.id}}" data-beta-name="{{item.betaName}}" disabled="{{savingKey ? true : false}}">删除</button>
                    </view>
                  </view>
                </view>
                <view class="empty-box empty-box--light" wx:if="{{!dialogRow.betaCodesVisible.length}}">{{dialogRow.betaEmptyStateText}}</view>
              </view>
            </view>

            <view class="modal-section">
              <view class="modal-section__head">
                <view>
                  <view class="modal-section__title">上线设置</view>
                  <text class="modal-section__desc">{{dialogRow.isSecondaryPage ? (dialogRow.pageKey === 'album-detail' ? (dialogRow.statusType === 'online' ? '当前动态详情页已启用。实际页面顶部优先显示相册名；相册未命名时，才回退使用这里的默认名称。' : '显示后允许进入动态详情页。实际页面顶部优先显示相册名；相册未命名时，才回退使用这里的默认名称。') : (dialogRow.statusType === 'online' ? '当前入口正在所属一级页中展示，保存后会同步更新页面顶部标题。' : '显示后会出现在所属一级页中，页面顶部标题会与入口名称保持一致。')) : (dialogRow.navSupported ? (dialogRow.statusType === 'online' ? '维护当前底部菜单顺序与上线状态。' : '满足上线条件，保存后会进入底部菜单。') : '当前页面不是底栏候选，不能直接上线到菜单。')}}</text>
                </view>
              </view>

              <view class="info-card info-card--plain" wx:if="{{dialogRow.isSecondaryPage}}">
                <view class="info-card__title">{{dialogRow.pageKey === 'album-detail' ? '默认名称预览' : '入口名称预览'}}</view>
                <text class="info-card__desc info-card__desc--strong">{{dialogRow.loginNavLabel}}</text>
                <text class="helper-text">{{dialogRow.pageKey === 'album-detail' ? '这里只维护无相册名时的默认名称，实际页面顶部优先使用相册名。' : '显示后会同步作为页面顶部标题，隐藏后所属一级页不再展示。'}}</text>
              </view>

              <view class="order-pills" wx:if="{{!dialogRow.isSecondaryPage || dialogRow.supportsSecondaryOrder}}">
                <text class="{{item.pageKey === dialogRow.pageKey ? 'order-pill order-pill--active' : 'order-pill'}}" wx:for="{{dialogRow.supportsSecondaryOrder ? profileAuthenticatedSecondaryRows : navRows}}" wx:key="pageKey">{{index + 1}}. {{item.displayLabel}}</text>
                <text class="order-empty" wx:if="{{dialogRow.supportsSecondaryOrder && !profileAuthenticatedSecondaryRows.length}}">当前还没有可排序的登录后入口。</text>
              </view>

              <text class="helper-text" wx:if="{{dialogRow.supportsSecondaryOrder}}">这里的顺序会同步到登录后的「我的」页；只有登录后菜单会参与这里的排序。</text>

              <view class="online-actions {{(!dialogRow.isSecondaryPage || dialogRow.supportsSecondaryOrder) ? '' : 'online-actions--single'}}">
                <view class="online-actions__item" wx:if="{{!dialogRow.isSecondaryPage || dialogRow.supportsSecondaryOrder}}">
                  <button class="mini-btn online-actions__btn online-actions__move-btn" bindtap="onMoveNav" data-page-key="{{dialogRow.pageKey}}" data-direction="up" data-scope="{{dialogRow.supportsSecondaryOrder ? 'profile-authenticated-secondary' : 'primary-nav'}}" disabled="{{savingKey ? true : (dialogRow.supportsSecondaryOrder ? dialogRow.secondaryNavRank <= 1 : (dialogRow.forcedHomeEntry || dialogRow.navRank <= 1))}}">前移</button>
                </view>
                <view class="online-actions__item" wx:if="{{!dialogRow.isSecondaryPage || dialogRow.supportsSecondaryOrder}}">
                  <button class="mini-btn online-actions__btn online-actions__move-btn" bindtap="onMoveNav" data-page-key="{{dialogRow.pageKey}}" data-direction="down" data-scope="{{dialogRow.supportsSecondaryOrder ? 'profile-authenticated-secondary' : 'primary-nav'}}" disabled="{{savingKey ? true : (dialogRow.supportsSecondaryOrder ? (!dialogRow.secondaryNavRank || dialogRow.secondaryNavRank >= dialogRow.secondaryNavTotal) : (dialogRow.forcedHomeEntry || !dialogRow.navRank || dialogRow.navRank >= dialogRow.navTotal))}}">后移</button>
                </view>
                <view class="online-actions__item">
                  <button class="mini-btn mini-btn--strong online-actions__btn online-actions__save-btn" bindtap="onDialogSubmit" data-action="online" disabled="{{(savingKey ? true : false) || (!dialogRow.isSecondaryPage && !dialogRow.navSupported)}}">{{dialogRow.isSecondaryPage ? '保存并显示' : '保存'}}</button>
                </view>
              </view>
            </view>

          </block>
        </view>
      </view>
    </view>

    <view class="notice notice--{{noticeType}}" wx:if="{{noticeText}}">{{noticeText}}</view>
  </view>
</view>
