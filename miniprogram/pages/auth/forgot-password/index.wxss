.page {
  min-height: 100vh;
  background: #FFFBF0;
  padding: 0 64rpx 160rpx;
  box-sizing: border-box;
  position: relative;
}

.back {
  position: absolute;
  left: 48rpx;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 999rpx;
  background: rgba(255, 200, 87, 0.20);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 0.2s ease, transform 0.2s ease;
}

.back-btn--active {
  background: rgba(255, 200, 87, 0.30);
  transform: scale(0.95);
}

.back-icon {
  width: 40rpx;
  height: 40rpx;
}

.content {
  padding-top: 96rpx;
}

.title-wrap {
  text-align: center;
  margin-top: 64rpx;
  margin-bottom: 96rpx;
}

.title {
  display: block;
  font-size: 60rpx;
  font-weight: 700;
  color: #5D4037;
  margin-bottom: 10rpx;
  font-family: "ZQKNNY", "YouYuan", "幼圆", "Microsoft YaHei", sans-serif;
}

.sub {
  display: block;
  font-size: 28rpx;
  color: rgba(93, 64, 55, 0.60);
}

.card {
  max-width: 896rpx;
  margin: 0 auto;
  background: #FFFFFF;
  border-radius: 32rpx;
  border: 2rpx solid rgba(93, 64, 55, 0.10);
  box-shadow: 0 12rpx 32rpx rgba(93, 64, 55, 0.08);
  padding: 48rpx 40rpx;
  box-sizing: border-box;
}

.card-icon-wrap {
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 200, 87, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-icon {
  width: 56rpx;
  height: 56rpx;
}

.card-title {
  display: block;
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
  color: #5D4037;
  margin-bottom: 16rpx;
  font-family: "ZQKNNY", "YouYuan", "幼圆", "Microsoft YaHei", sans-serif;
}

.card-desc {
  display: block;
  text-align: center;
  font-size: 28rpx;
  line-height: 1.7;
  color: rgba(93, 64, 55, 0.72);
}

.note-box {
  margin-top: 28rpx;
  border-radius: 24rpx;
  background: #FFF7E8;
  border: 2rpx solid rgba(255, 200, 87, 0.45);
  padding: 24rpx;
}

.note-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.note-icon {
  width: 32rpx;
  height: 32rpx;
  margin-top: 4rpx;
  flex-shrink: 0;
}

.note-text {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.7;
  color: rgba(93, 64, 55, 0.82);
}

.actions {
  margin-top: 32rpx;
  display: flex;
  gap: 20rpx;
}

.btn-primary,
.btn-secondary {
  flex: 1;
  height: 88rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1;
  transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
}

.btn-primary {
  background: #FFC857;
  color: #5D4037;
  border: 4rpx solid #5D4037;
  box-shadow: 6rpx 6rpx 0 #5D4037;
}

.btn-primary--active {
  transform: translate(4rpx, 4rpx);
  box-shadow: 2rpx 2rpx 0 #5D4037;
}

.btn-secondary {
  background: #FFFFFF;
  color: #5D4037;
  border: 4rpx solid rgba(93, 64, 55, 0.18);
}

.btn-secondary--active {
  background: #FFF9EC;
}
