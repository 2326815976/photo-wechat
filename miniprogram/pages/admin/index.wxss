.page {
  height: 100vh;
  background: #f8fafc;
}

button {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  border: none;
  line-height: 1;
  text-align: center;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

button::after {
  border: none;
}

.topbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1200;
  background: #fffbf0;
  border-bottom: 2rpx solid rgba(93, 64, 55, 0.12);
}

.topbar-inner {
  height: 112rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 16rpx;
  box-sizing: border-box;
}

.brand {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.brand-logo {
  width: 64rpx;
  height: 64rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ffc857 0%, #ffb347 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(255, 184, 71, 0.35);
  flex: none;
}

.brand-logo__icon {
  width: 34rpx;
  height: 34rpx;
  display: block;
}

.brand-title {
  min-width: 0;
  font-size: 38rpx;
  font-weight: 700;
  color: #5d4037;
  font-family: "ZQKNNY", "YouYuan", "幼圆", "Microsoft YaHei", sans-serif;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.menu-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #5d4037;
  background: rgba(93, 64, 55, 0.08);
  transition: transform 0.2s ease, background-color 0.2s ease;
  flex: none;
}

.menu-btn:active {
  transform: scale(0.95);
  background: rgba(93, 64, 55, 0.14);
}

.menu-btn__text {
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1;
}

.drawer-mask {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1090;
  background: rgba(15, 23, 42, 0.36);
}

.drawer {
  position: fixed;
  left: 0;
  right: auto;
  width: 560rpx;
  max-width: 82%;
  bottom: 0;
  z-index: 1100;
  background: #fffbf0;
  border-top: 0;
  border-right: 2rpx solid rgba(93, 64, 55, 0.12);
  box-shadow: 18rpx 0 40rpx rgba(15, 23, 42, 0.2);
  display: flex;
  flex-direction: column;
}

.drawer-nav {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: 18rpx;
  box-sizing: border-box;
}

.drawer-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  border-radius: 24rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 8rpx;
  background: transparent;
  transition: background-color 0.2s ease, transform 0.2s ease;
}

.drawer-item:active {
  transform: scale(0.99);
}

.drawer-item--active {
  background: rgba(255, 200, 87, 0.22);
}

.drawer-item__icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  background: rgba(93, 64, 55, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex: none;
}

.drawer-item--active .drawer-item__icon {
  background: rgba(255, 200, 87, 0.42);
}

.drawer-item__main {
  flex: 1;
  min-width: 0;
}

.drawer-item__title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #5d4037;
}

.drawer-item__desc {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: rgba(93, 64, 55, 0.6);
}

.drawer-footer {
  border-top: 2rpx solid rgba(93, 64, 55, 0.1);
  padding: 20rpx 20rpx calc(20rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #fffbf0;
}

.drawer-user {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
  border-radius: 22rpx;
  border: 2rpx solid rgba(93, 64, 55, 0.12);
  background: #ffffff;
  padding: 14rpx 16rpx;
  box-shadow: 0 6rpx 16rpx rgba(93, 64, 55, 0.06);
}

.drawer-user__avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ffc857 0%, #ffb347 100%);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.drawer-user__main {
  flex: 1;
  min-width: 0;
}

.drawer-user__label {
  display: block;
  font-size: 20rpx;
  color: rgba(93, 64, 55, 0.56);
}

.drawer-user__name {
  display: block;
  margin-top: 4rpx;
  font-size: 32rpx;
  color: #5d4037;
  font-weight: 700;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.drawer-plain-btn,
.drawer-danger-btn {
  width: 100%;
  height: 76rpx;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1;
  border: 2rpx solid transparent;
}

.drawer-plain-btn {
  margin-bottom: 10rpx;
  background: #ebe6dd;
  border-color: rgba(93, 64, 55, 0.08);
  color: #5d4037;
}

.drawer-danger-btn {
  background: #f3dbd2;
  border-color: rgba(220, 38, 38, 0.1);
  color: #dc2626;
}

.drawer-plain-btn:active,
.drawer-danger-btn:active {
  opacity: 0.92;
  transform: scale(0.98);
}

.content {
  height: 100vh;
  box-sizing: border-box;
}

.content-inner {
  min-height: 100%;
  padding: 0 24rpx 28rpx;
  box-sizing: border-box;
}

.module-intro {
  padding: 6rpx 4rpx 10rpx;
  margin-bottom: 14rpx;
}

.module-title {
  display: block;
  font-size: 46rpx;
  font-weight: 700;
  color: #5d4037;
  font-family: "ZQKNNY", "YouYuan", "幼圆", "Microsoft YaHei", sans-serif;
  margin-bottom: 6rpx;
}

.module-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(93, 64, 55, 0.6);
}

.stats-page {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.stats-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.stats-header__main {
  flex: 1;
  min-width: 0;
}

.stats-header__title {
  display: block;
  font-size: 46rpx;
  line-height: 1.25;
  font-weight: 700;
  color: #5d4037;
  font-family: "ZQKNNY", "YouYuan", "幼圆", "Microsoft YaHei", sans-serif;
}

.stats-header__desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(93, 64, 55, 0.6);
}

.stats-maint-btn {
  min-width: 160rpx;
  height: 66rpx;
  padding: 0 18rpx;
  border-radius: 14rpx;
  background: #3b82f6;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
  box-shadow: 0 8rpx 18rpx rgba(59, 130, 246, 0.3);
  flex: none;
}

.stats-maint-btn--active {
  opacity: 0.92;
  transform: scale(0.98);
}

.stats-section {
  margin-top: 4rpx;
}

.stats-section__head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 14rpx;
}

.stats-section__icon {
  font-size: 30rpx;
  line-height: 1;
}

.stats-section__title {
  font-size: 34rpx;
  font-weight: 700;
  color: #5d4037;
}

.stats-cards-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.stats-cards-grid--spaced {
  margin-top: 14rpx;
}

.stats-card {
  background: #ffffff;
  border: 2rpx solid rgba(93, 64, 55, 0.1);
  border-radius: 24rpx;
  padding: 22rpx;
  box-shadow: 0 6rpx 16rpx rgba(93, 64, 55, 0.06);
}

.stats-card__icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14rpx;
}

.stats-card__icon-text {
  font-size: 32rpx;
  line-height: 1;
}

.stats-card__title {
  display: block;
  font-size: 24rpx;
  color: rgba(93, 64, 55, 0.62);
  margin-bottom: 6rpx;
}

.stats-card__value {
  display: block;
  font-size: 46rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #5d4037;
}

.stats-card__subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: rgba(93, 64, 55, 0.5);
}

.stats-extra-card {
  margin-top: 14rpx;
  background: #ffffff;
  border: 2rpx solid rgba(93, 64, 55, 0.1);
  border-radius: 24rpx;
  padding: 20rpx;
  box-shadow: 0 6rpx 16rpx rgba(93, 64, 55, 0.06);
}

.stats-extra-card__title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #5d4037;
  margin-bottom: 14rpx;
}

.stats-mini-grid {
  display: grid;
  grid-template-columns: repeat(1, minmax(0, 1fr));
  gap: 10rpx;
}

.stats-mini-item {
  background: #fffbf0;
  border-radius: 16rpx;
  padding: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.stats-mini-item__name {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: #5d4037;
}

.stats-mini-item__value {
  font-size: 38rpx;
  line-height: 1;
  font-weight: 700;
  color: #ffc857;
  flex: none;
}

.stats-tag-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
}

.stats-tag-item {
  background: #fffbf0;
  border-radius: 16rpx;
  padding: 14rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.stats-tag-item__rank {
  font-size: 28rpx;
  line-height: 1;
  font-weight: 700;
  color: #ffc857;
  flex: none;
}

.stats-tag-item__main {
  flex: 1;
  min-width: 0;
}

.stats-tag-item__name {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: #5d4037;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.stats-tag-item__count {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: rgba(93, 64, 55, 0.6);
}

.stats-version-row {
  background: #fffbf0;
  border-radius: 16rpx;
  padding: 16rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 14rpx;
}

.stats-version-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ffc857 0%, #ffb347 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  line-height: 1;
  flex: none;
}

.stats-version-main {
  flex: 1;
  min-width: 150rpx;
}

.stats-version-main__label {
  display: block;
  font-size: 20rpx;
  color: rgba(93, 64, 55, 0.58);
}

.stats-version-main__value {
  display: block;
  margin-top: 4rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #5d4037;
}

.stats-version-meta {
  min-width: 130rpx;
}

.stats-version-meta__label {
  display: block;
  font-size: 20rpx;
  color: rgba(93, 64, 55, 0.58);
}

.stats-version-meta__value {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #5d4037;
}

.stats-trend-grid {
  display: grid;
  grid-template-columns: repeat(1, minmax(0, 1fr));
  gap: 14rpx;
}

.stats-trend-card {
  background: #ffffff;
  border: 2rpx solid rgba(93, 64, 55, 0.1);
  border-radius: 24rpx;
  padding: 20rpx;
  box-shadow: 0 6rpx 16rpx rgba(93, 64, 55, 0.06);
}

.stats-trend-card__title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #5d4037;
  margin-bottom: 12rpx;
}

.stats-trend-row {
  background: #fffbf0;
  border-radius: 14rpx;
  padding: 14rpx 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.stats-trend-row:last-child {
  margin-bottom: 0;
}

.stats-trend-row__date {
  font-size: 22rpx;
  color: rgba(93, 64, 55, 0.62);
}

.stats-trend-row__value {
  font-size: 34rpx;
  line-height: 1;
  font-weight: 700;
}

.stats-trend-row__value--users {
  color: #ffc857;
}

.stats-trend-row__value--active {
  color: #ffb347;
}

.stats-trend-row__value--bookings {
  color: #20b2aa;
}

.pose-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.pose-header {
  padding: 8rpx 2rpx 4rpx;
}

.pose-header__title {
  display: block;
  font-size: 48rpx;
  line-height: 1.25;
  font-weight: 700;
  color: #5d4037;
  font-family: "ZQKNNY", "YouYuan", "幼圆", "Microsoft YaHei", sans-serif;
}

.pose-header__desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(93, 64, 55, 0.6);
}

.pose-tabs {
  display: flex;
  align-items: stretch;
  border-bottom: 2rpx solid rgba(93, 64, 55, 0.12);
  margin-bottom: 4rpx;
  overflow-x: auto;
}

.pose-tab-item {
  position: relative;
  flex: none;
  padding: 18rpx 28rpx;
}

.pose-tab-item__text {
  font-size: 26rpx;
  font-weight: 600;
  color: rgba(93, 64, 55, 0.46);
  white-space: nowrap;
}

.pose-tab-item--active .pose-tab-item__text {
  color: #5d4037;
}

.pose-tab-item__line {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  bottom: 0;
  height: 4rpx;
  border-radius: 999rpx;
  background: #ffc857;
}

.pose-toolbar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
  flex-wrap: wrap;
}

.pose-filter-scroll {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.pose-filter-row {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 2rpx 0;
}

.pose-filter-row__icon {
  font-size: 24rpx;
  line-height: 1;
  color: rgba(93, 64, 55, 0.6);
}

.pose-filter-chip {
  flex: none;
  min-height: 44rpx;
  border-radius: 999rpx;
  padding: 0 16rpx;
  background: #ffffff;
  border: 2rpx solid rgba(93, 64, 55, 0.1);
  color: rgba(93, 64, 55, 0.64);
  font-size: 20rpx;
  line-height: 1;
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
}

.pose-filter-chip--active {
  background: #ffc857;
  border-color: #ffc857;
  color: #5d4037;
  box-shadow: 0 6rpx 12rpx rgba(255, 200, 87, 0.35);
}

.pose-toolbar-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: nowrap;
  gap: 10rpx;
}

.pose-toolbar-btn {
  min-width: 128rpx;
  width: auto !important;
  flex: none;
  height: 60rpx;
  border-radius: 999rpx;
  padding: 0 24rpx !important;
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
  line-height: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.pose-toolbar-btn--ghost {
  background: #ffffff;
  color: #5d4037;
  border: 2rpx solid rgba(93, 64, 55, 0.2);
}

.pose-toolbar-btn--primary {
  background: #ffc857;
  color: #5d4037;
  box-shadow: 0 6rpx 14rpx rgba(255, 200, 87, 0.35);
}

.pose-toolbar-btn--danger {
  background: #ef4444;
  color: #ffffff;
}

.pose-toolbar-btn[disabled] {
  opacity: 0.5;
}

.pose-loading {
  padding: 60rpx 0;
  text-align: center;
}

.pose-loading__spinner {
  width: 74rpx;
  height: 74rpx;
  margin: 0 auto 18rpx;
  border-radius: 999rpx;
  border: 6rpx solid #ffc857;
  border-top-color: transparent;
  animation: pose-spin 0.9s linear infinite;
  box-sizing: border-box;
}

.pose-loading__text {
  display: block;
  font-size: 24rpx;
  color: rgba(93, 64, 55, 0.6);
}

@keyframes pose-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.pose-empty-card {
  background: #ffffff;
  border: 2rpx solid rgba(93, 64, 55, 0.1);
  border-radius: 22rpx;
  padding: 40rpx 24rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: rgba(93, 64, 55, 0.6);
}

.pose-empty-card__icon {
  font-size: 72rpx;
  line-height: 1;
  opacity: 0.2;
}

.pose-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.pose-card {
  background: #ffffff;
  border: 2rpx solid rgba(93, 64, 55, 0.1);
  border-radius: 22rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 16rpx rgba(93, 64, 55, 0.06);
}

.pose-card--selected {
  border-color: #ffc857;
  background: rgba(255, 200, 87, 0.08);
}

.pose-card-image-wrap {
  position: relative;
  width: 100%;
  height: 0;
  padding-top: 133.333%;
  overflow: hidden;
  background: rgba(93, 64, 55, 0.08);
}

.pose-card-image {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.pose-select-dot-wrap {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  z-index: 3;
}

.pose-select-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  border: 3rpx solid rgba(93, 64, 55, 0.35);
  background: #ffffff;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pose-select-dot--active {
  background: #ffc857;
  border-color: #ffc857;
  color: #ffffff;
}

.pose-card-actions {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  z-index: 3;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.pose-card-action-btn {
  width: 72rpx !important;
  min-width: 72rpx !important;
  max-width: 72rpx !important;
  height: 72rpx !important;
  min-height: 72rpx !important;
  max-height: 72rpx !important;
  flex: none;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  line-height: 1;
  color: #ffffff;
  box-shadow: 0 8rpx 16rpx rgba(15, 23, 42, 0.2);
}

.pose-card-actions .pose-card-action-btn {
  margin: 0 !important;
}

.pose-card-action-btn--disabled {
  opacity: 0.55;
}

.pose-card-action-btn--edit {
  background: #3b82f6;
}

.pose-card-action-btn--delete {
  background: #ef4444;
}

.pose-card-action-btn__icon {
  font-size: 28rpx;
  line-height: 1;
}

.pose-card-body {
  padding: 16rpx 16rpx 18rpx;
}

.pose-card-meta {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-bottom: 10rpx;
}

.pose-card-meta__icon {
  font-size: 18rpx;
  line-height: 1;
  color: rgba(93, 64, 55, 0.6);
}

.pose-card-view {
  font-size: 20rpx;
  color: rgba(93, 64, 55, 0.72);
}

.pose-card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.pose-card-tag {
  background: rgba(255, 200, 87, 0.2);
  color: #5d4037;
  font-size: 18rpx;
  line-height: 32rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
}

.pose-pagination {
  margin-top: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
