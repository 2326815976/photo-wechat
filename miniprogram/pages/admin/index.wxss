  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: rgba(93, 64, 55, 0.6);
}

.release-form {
  background: #ffffff;
  border: 2rpx solid rgba(93, 64, 55, 0.1);
  border-radius: 32rpx;
  padding: 48rpx;
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.04);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 48rpx;
}

.release-field {
  width: 100%;
  display: flex;
  flex-direction: column;
}

.release-field__label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #5d4037;
  margin-bottom: 16rpx;
}

.release-required {
  color: #ef4444;
  font-weight: 700;
}

.release-input,
.release-textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 90rpx;
  padding: 24rpx 28rpx;
  border: 4rpx solid rgba(93, 64, 55, 0.2);
  border-radius: 24rpx;
  font-size: 32rpx;
  color: #5d4037;
  background: #ffffff;
  transition: border-color 0.18s ease;
}

.release-input:focus,
.release-textarea:focus {
  border-color: #ffc857;
}

.release-textarea {
  min-height: 280rpx;
  line-height: 1.6;
}

.release-select {
  width: 100%;
  box-sizing: border-box;
  min-height: 90rpx;
  padding: 24rpx 28rpx;
  border: 4rpx solid rgba(93, 64, 55, 0.2);
  border-radius: 24rpx;
  font-size: 32rpx;
  color: #5d4037;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.release-select__text {
  flex: 1;
  min-width: 0;
}

.release-select__chevron {
  width: 34rpx;
  height: 34rpx;
  opacity: 0.65;
  flex: none;
}

.release-force {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 32rpx;
  background: rgba(255, 200, 87, 0.1);
  border: 4rpx solid rgba(255, 200, 87, 0.3);
  border-radius: 24rpx;
  box-sizing: border-box;
}

.release-force__main {
  flex: 1;
  min-width: 0;
}

.release-force__title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #5d4037;
  margin-bottom: 8rpx;
}

.release-force__desc {
  display: block;
  font-size: 24rpx;
  color: rgba(93, 64, 55, 0.6);
  line-height: 1.4;
}

.release-toggle {
  width: 112rpx;
  height: 64rpx;
  border-radius: 999rpx;
  background: rgba(93, 64, 55, 0.2);
  padding: 8rpx;
  box-sizing: border-box;
  transition: background-color 0.18s ease;
  flex: none;
}

.release-toggle--on {
  background: #ffc857;
}

.release-toggle__thumb {
  width: 48rpx;
  height: 48rpx;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 18rpx rgba(15, 23, 42, 0.18);
  transition: transform 0.18s ease;
  transform: translateX(0);
}

.release-toggle__thumb--on {
  transform: translateX(48rpx);
}

.release-upload-btn {
  display: flex;
  align-self: stretch;
  width: 100%;
  max-width: none;
  min-height: 128rpx;
  border-radius: 28rpx;
  border: 4rpx dashed rgba(93, 64, 55, 0.2);
  background: transparent;
  color: rgba(93, 64, 55, 0.6);
  font-size: 32rpx;
  font-weight: 600;
  transition: transform 0.18s ease, border-color 0.18s ease, opacity 0.18s ease;
  padding: 0 32rpx;
  line-height: 1.2;
  gap: 16rpx;
  box-sizing: border-box;
}

.release-upload-btn:active {
  transform: scale(0.99);
  border-color: rgba(255, 200, 87, 0.9);
}

.release-upload-btn__icon {
  width: 44rpx;
  height: 44rpx;
  opacity: 0.7;
  flex: none;
}

.release-upload-btn__text {
  display: block;
  flex: 1;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.release-help {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: rgba(93, 64, 55, 0.6);
  word-break: break-all;
}

.release-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1350;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
}

.release-modal {
  width: 100%;
  max-width: 560rpx;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 32rpx;
  box-sizing: border-box;
}

.release-modal__icon {
  width: 128rpx;
  height: 128rpx;
  border-radius: 999rpx;
  background: #fee2e2;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 32rpx;
}

.release-modal__icon-img {
  width: 64rpx;
  height: 64rpx;
}

.release-modal__title {
  display: block;
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
  color: #5d4037;
  margin-bottom: 16rpx;
}

.release-modal__desc {
  display: block;
  text-align: center;
  font-size: 28rpx;
  color: rgba(93, 64, 55, 0.8);
  line-height: 1.55;
  margin-bottom: 48rpx;
}

.release-modal__highlight {
  font-weight: 700;
  color: #5d4037;
}

.release-modal__actions {
  display: flex;
  gap: 16rpx;
}

.release-ghost-btn,
.release-danger-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 600;
  transition: transform 0.18s ease, background-color 0.18s ease, opacity 0.18s ease;
  padding: 0 32rpx;
  line-height: 1;
  white-space: nowrap;
}

.release-ghost-btn {
  border: 4rpx solid rgba(93, 64, 55, 0.2);
  background: transparent;
  color: #5d4037;
}

.release-ghost-btn:active {
  transform: scale(0.99);
  background: rgba(93, 64, 55, 0.05);
}

.release-danger-btn {
  background: #dc2626;
  color: #ffffff;
}

.release-danger-btn:active {
  transform: scale(0.99);
  background: #b91c1c;
}

.release-toast {
  position: fixed;
  right: 48rpx;
  bottom: 48rpx;
  z-index: 1400;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 48rpx;
  border-radius: 32rpx;
  color: #ffffff;
  box-shadow: 0 18rpx 36rpx rgba(15, 23, 42, 0.18);
  box-sizing: border-box;
}

.release-toast__icon {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1;
  flex: none;
}

.release-toast__text {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.35;
  max-width: 520rpx;
  word-break: break-word;
}

.release-toast--success {
  background: rgba(34, 197, 94, 0.95);
}

.release-toast--warning,
.release-toast--info {
  background: rgba(249, 115, 22, 0.95);
}

.release-toast--error {
  background: rgba(239, 68, 68, 0.95);
}

.release-primary-btn[disabled],
.release-icon-btn[disabled],
.release-back-btn[disabled],
.release-upload-btn[disabled],
.release-ghost-btn[disabled],
.release-danger-btn[disabled] {
  opacity: 0.55;
}
