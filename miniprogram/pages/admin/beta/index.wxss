.page {
  min-height: 100vh;
  background: #fffbf0;
  display: flex;
  flex-direction: column;
}

.content {
  flex: 1;
  padding: 24rpx 24rpx calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.loading {
  padding-top: 180rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.loading-spinner {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  border: 8rpx solid rgba(255, 200, 87, 0.25);
  border-top-color: #ffc857;
  animation: spin 0.9s linear infinite;
}

.loading-text {
  font-size: 24rpx;
  color: rgba(93, 64, 55, 0.6);
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.tabs {
  display: flex;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.tab-item {
  flex: 1;
  height: 72rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 2rpx solid rgba(93, 64, 55, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #5d4037;
  font-size: 26rpx;
  font-weight: 700;
}

.tab-item--active {
  background: #ffc857;
  border-color: #ffc857;
}

.toolbar {
  margin-bottom: 14rpx;
  display: flex;
  justify-content: flex-end;
}

.toolbar-btn {
  min-width: 176rpx;
  height: 68rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.toolbar-btn--primary {
  background: #ffc857;
  color: #5d4037;
}

.empty {
  margin-top: 20rpx;
  background: #ffffff;
  border: 2rpx solid rgba(93, 64, 55, 0.1);
  border-radius: 22rpx;
  padding: 80rpx 20rpx;
  text-align: center;
}

.empty-icon {
  display: block;
  font-size: 54rpx;
  opacity: 0.55;
}

.empty-text {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(93, 64, 55, 0.6);
}

.cards {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.card {
  background: #ffffff;
  border: 2rpx solid rgba(93, 64, 55, 0.1);
  border-radius: 22rpx;
  padding: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(93, 64, 55, 0.08);
}

.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.card-main {
  flex: 1;
  min-width: 0;
}

.card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #5d4037;
  line-height: 1.35;
}

.card-path {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(93, 64, 55, 0.62);
  word-break: break-all;
}

.card-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
  color: rgba(93, 64, 55, 0.7);
  line-height: 1.45;
}

.route-state,
.version-state {
  flex: none;
  min-width: 104rpx;
  height: 44rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
  padding: 0 12rpx;
}

.route-state--active,
.version-state--active {
  background: rgba(34, 197, 94, 0.16);
  color: #15803d;
}

.route-state--inactive,
.version-state--inactive {
  background: rgba(148, 163, 184, 0.22);
  color: #475569;
}

.version-state--expired {
  background: rgba(248, 113, 113, 0.16);
  color: #b91c1c;
}

.card-actions {
  margin-top: 16rpx;
  display: flex;
  gap: 10rpx;
}

.action-btn {
  flex: 1;
  height: 58rpx;
  border-radius: 14rpx;
  font-size: 23rpx;
  font-weight: 700;
}

.action-btn--edit {
  background: rgba(93, 64, 55, 0.08);
  color: #5d4037;
}

.action-btn--delete {
  background: rgba(248, 113, 113, 0.14);
  color: #b91c1c;
}

.version-code-row {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.version-code {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #5d4037;
  word-break: break-all;
}

.version-expire {
  display: block;
  margin-top: 8rpx;
  font-size: 21rpx;
  color: rgba(93, 64, 55, 0.58);
}

.mini-btn {
  flex: none;
  height: 52rpx;
  border-radius: 12rpx;
  padding: 0 16rpx;
  background: rgba(255, 200, 87, 0.25);
  color: #5d4037;
  font-size: 21rpx;
  font-weight: 700;
}

.modal-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.42);
  z-index: 1200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx;
  box-sizing: border-box;
}

.modal,
.confirm-modal {
  width: 100%;
  max-width: 680rpx;
  background: #fffbf0;
  border-radius: 24rpx;
  border: 2rpx solid rgba(93, 64, 55, 0.12);
  box-shadow: 0 16rpx 34rpx rgba(15, 23, 42, 0.24);
}

.modal {
  max-height: 84vh;
  display: flex;
  flex-direction: column;
}

.modal-head {
  padding: 20rpx 20rpx 10rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #5d4037;
}

.modal-body {
  padding: 8rpx 20rpx;
}

.modal-body--scroll {
  max-height: 56vh;
}

.field {
  margin-bottom: 14rpx;
}

.field-label {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #5d4037;
  margin-bottom: 8rpx;
}

.field-input,
.field-textarea,
.picker-value {
  width: 100%;
  border-radius: 12rpx;
  border: 2rpx solid rgba(93, 64, 55, 0.18);
  background: #ffffff;
  color: #5d4037;
  font-size: 24rpx;
  box-sizing: border-box;
}

.field-input,
.picker-value {
  height: 72rpx;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
}

.field-textarea {
  min-height: 130rpx;
  padding: 14rpx 16rpx;
  line-height: 1.45;
}

.field-placeholder {
  color: rgba(93, 64, 55, 0.42);
}

.picker-hint {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: rgba(93, 64, 55, 0.55);
  word-break: break-all;
}

.code-input-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.field-input--code {
  flex: 1;
  min-width: 0;
}

.switch-row {
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.switch-row__label {
  font-size: 24rpx;
  color: #5d4037;
}

.modal-foot {
  padding: 12rpx 20rpx 20rpx;
  display: flex;
  gap: 10rpx;
}

.modal-btn {
  flex: 1;
  height: 64rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.modal-btn--ghost {
  background: #ffffff;
  border: 2rpx solid rgba(93, 64, 55, 0.14);
  color: #5d4037;
}

.modal-btn--primary {
  background: #ffc857;
  color: #5d4037;
}

.modal-btn--danger {
  background: #fda4af;
  color: #7f1d1d;
}

.confirm-modal {
  padding: 24rpx 20rpx 20rpx;
}

.confirm-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #5d4037;
}

.confirm-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(93, 64, 55, 0.72);
}

.confirm-actions {
  margin-top: 18rpx;
  display: flex;
  gap: 10rpx;
}

button[disabled] {
  opacity: 0.55;
}
