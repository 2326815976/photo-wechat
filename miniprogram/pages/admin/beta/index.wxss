@import "../../../styles/secondary-page-frame.wxss";

.content {
  padding: 0;
  background-image: none;
  min-height: 0;
}

.beta-legacy-redirect {
  min-height: calc(100vh - 240rpx - env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
  background: #fffbf0;
  color: #5d4037;
  font-size: 28rpx;
  text-align: center;
}
