                      hover-class="booking-config-btn--edit-active"
                      disabled="{{bookingTypeSaving || bookingTypeDeletingId !== 0 || bookingTypeTogglingId !== 0}}"
                    >
                      编辑
                    </button>
                    <button
                      class="booking-config-btn booking-config-btn--delete"
                      data-id="{{item.id}}"
                      bindtap="onOpenBookingTypeDeleteConfirm"
                      hover-class="booking-config-btn--delete-active"
                      loading="{{bookingTypeDeletingId === item.id}}"
                      disabled="{{bookingTypeDeletingId === item.id || bookingTypeSaving || bookingTypeTogglingId !== 0}}"
                    >
                      删除
                    </button>
                    <button
                      class="booking-config-btn {{item.is_active ? 'booking-config-btn--disable' : 'booking-config-btn--enable'}}"
                      data-id="{{item.id}}"
                      bindtap="onToggleBookingType"
                      hover-class="{{item.is_active ? 'booking-config-btn--disable-active' : 'booking-config-btn--enable-active'}}"
                      loading="{{bookingTypeTogglingId === item.id}}"
                      disabled="{{bookingTypeTogglingId !== 0 || bookingTypeDeletingId !== 0 || bookingTypeSaving}}"
                    >
                      {{item.is_active ? "禁用" : "启用"}}
                    </button>
                  </view>
                </view>
              </view>
            </view>
          </block>

          <block wx:if="{{bookingPanelTab === 'cities'}}">
            <view class="booking-panel motion-fade-up">
              <view class="booking-toolbar booking-toolbar--right">
                <button
                  class="booking-pill-btn booking-pill-btn--primary"
                  bindtap="onOpenCityCreateModal"
                  hover-class="booking-pill-btn--primary-active"
                  disabled="{{citySaving || cityDeletingId !== 0 || cityTogglingId !== 0}}"
                >
                  ＋ 添加城市
                </button>
              </view>

              <view class="pose-loading" wx:if="{{citiesLoading}}">
                <view class="pose-loading__spinner"></view>
                <text class="pose-loading__text">加载中...</text>
              </view>

              <view class="empty booking-empty-card" wx:elif="{{!allowedCities.length}}">
                <text class="booking-empty-card__icon">📍</text>
                <text>暂无允许的城市</text>
              </view>

              <view class="booking-config-grid" wx:else>
                <view class="booking-config-card" wx:for="{{allowedCities}}" wx:key="id">
                  <view class="booking-config-card__head">
                    <view class="booking-config-card__main">
                      <text class="booking-config-card__title">{{item.city_name}}</text>
                      <text class="booking-config-card__desc" wx:if="{{item.province}}">{{item.province}}</text>
                      <text class="booking-config-card__meta" wx:if="{{item.city_code}}">代码：{{item.city_code}}</text>
                      <text class="booking-config-card__meta" wx:if="{{item.locationText}}">{{item.locationText}}</text>
                    </view>
                    <view class="booking-config-state {{item.is_active ? 'booking-config-state--active' : 'booking-config-state--inactive'}}">
                      <text>{{item.activeText}}</text>
                    </view>
                  </view>
                  <view class="booking-config-card__actions">
                    <button
                      class="booking-config-btn booking-config-btn--edit"
                      data-id="{{item.id}}"
                      bindtap="onEditAllowedCity"
                      hover-class="booking-config-btn--edit-active"
                      disabled="{{citySaving || cityDeletingId !== 0 || cityTogglingId !== 0}}"
                    >
                      编辑
                    </button>
                    <button
                      class="booking-config-btn booking-config-btn--delete"
                      data-id="{{item.id}}"
                      bindtap="onOpenCityDeleteConfirm"
                      hover-class="booking-config-btn--delete-active"
                      loading="{{cityDeletingId === item.id}}"
                      disabled="{{cityDeletingId === item.id || citySaving || cityTogglingId !== 0}}"
                    >
                      删除
                    </button>
                    <button
                      class="booking-config-btn {{item.is_active ? 'booking-config-btn--disable' : 'booking-config-btn--enable'}}"
                      data-id="{{item.id}}"
                      bindtap="onToggleAllowedCity"
                      hover-class="{{item.is_active ? 'booking-config-btn--disable-active' : 'booking-config-btn--enable-active'}}"
                      loading="{{cityTogglingId === item.id}}"
                      disabled="{{cityTogglingId !== 0 || cityDeletingId !== 0 || citySaving}}"
                    >
                      {{item.is_active ? "禁用" : "启用"}}
                    </button>
                  </view>
                </view>
              </view>
            </view>
          </block>
        </block>

        <block wx:if="{{activeSection === 'about'}}">
          <view class="booking-panel about-panel motion-fade-up">
            <view class="pose-loading" wx:if="{{aboutLoading}}">
              <view class="pose-loading__spinner"></view>
              <text class="pose-loading__text">加载中...</text>
            </view>

            <view class="about-grid" wx:else>
              <view class="about-card about-card--form">
                <view class="booking-modal__body">
                  <view class="booking-modal__field">
                    <text class="booking-modal__label">作者名称</text>
                    <input
                      class="booking-modal__input"
                      value="{{aboutSettings.author_name}}"
                      data-field="author_name"
                      bindinput="onAboutInput"
                      placeholder="例如：拾光谣作者"
                      placeholder-class="booking-modal__placeholder"
                      maxlength="60"
                    />
                  </view>

                  <view class="booking-modal__field">
                    <text class="booking-modal__label">手机号（选填）</text>
                    <input
                      class="booking-modal__input"
                      value="{{aboutSettings.phone}}"
                      data-field="phone"
                      bindinput="onAboutInput"
                      placeholder="请输入手机号"
                      placeholder-class="booking-modal__placeholder"
                      maxlength="32"
                    />
                  </view>

                  <view class="booking-modal__field">
                    <text class="booking-modal__label">微信号（选填）</text>
                    <input
                      class="booking-modal__input"
                      value="{{aboutSettings.wechat}}"
                      data-field="wechat"
                      bindinput="onAboutInput"
                      placeholder="请输入微信号"
                      placeholder-class="booking-modal__placeholder"
                      maxlength="64"
                    />
                  </view>

                  <view class="booking-modal__field">
                    <text class="booking-modal__label">邮箱（选填）</text>
                    <input
                      class="booking-modal__input"
                      value="{{aboutSettings.email}}"
                      data-field="email"
                      bindinput="onAboutInput"
                      placeholder="请输入邮箱"
                      placeholder-class="booking-modal__placeholder"
                      maxlength="255"
                    />
                  </view>

                  <view class="booking-modal__field">
                    <text class="booking-modal__label">赞赏码图片（选填）</text>
                    <view class="album-upload-preview" wx:if="{{aboutSettings.donation_qr_code}}">
                      <text class="album-upload-preview__label">当前赞赏码</text>
                      <image class="album-upload-preview__qr" src="{{aboutSettings.donation_qr_code}}" mode="aspectFit" />
                    </view>
                    <view class="album-upload-preview album-upload-preview--empty" wx:else>
                      <text>当前未上传赞赏码，上传后将展示在用户端关于页面。</text>
                    </view>
                    <button
                      class="booking-modal__submit"
                      bindtap="onOpenAboutDonationModal"
                      hover-class="booking-modal__submit--active"
                      disabled="{{aboutDonationUploading || aboutSaving || aboutLoading}}"
                    >
                      {{aboutSettings.donation_qr_code ? "更换赞赏码" : "上传赞赏码"}}
                    </button>
                    <button
                      wx:if="{{aboutSettings.donation_qr_code}}"
                      class="booking-pill-btn booking-pill-btn--ghost"
                      bindtap="onClearAboutDonationQr"
                      hover-class="booking-pill-btn--ghost-active"
                      disabled="{{aboutDonationUploading || aboutSaving || aboutLoading}}"
                    >
                      清空赞赏码
                    </button>
                  </view>

                  <view class="booking-modal__field">
                    <text class="booking-modal__label">作者留言</text>
                    <textarea
                      class="booking-modal__textarea about-textarea"
                      value="{{aboutSettings.author_message}}"
                      data-field="author_message"
                      bindinput="onAboutInput"
                      placeholder="写给用户的一段话"
                      placeholder-class="booking-modal__placeholder"
                      maxlength="2000"
                    />
                  </view>
                </view>

                <view class="about-save-wrap">
                  <button
                    class="booking-pill-btn booking-pill-btn--primary about-save-btn"
                    bindtap="onSaveAboutSettings"
                    hover-class="booking-pill-btn--primary-active"
                    loading="{{aboutSaving}}"
                    disabled="{{aboutSaving || aboutLoading || aboutDonationUploading}}"
                  >
                    {{aboutSaving ? "保存中..." : "保存设置"}}
                  </button>
                </view>
              </view>

              <view class="about-card about-card--preview">
                <view class="about-preview-head">
                  <text class="about-preview-title">{{aboutSettings.author_name || "作者"}}</text>
                  <text class="about-preview-sub">用户端“关于”预览</text>
                </view>

                <view class="about-preview-message">
                  <text>{{aboutSettings.author_message || "暂无留言"}}</text>
                </view>

                <view class="about-preview-contact" wx:if="{{aboutSettings.phone || aboutSettings.wechat || aboutSettings.email}}">
                  <view class="about-preview-row" wx:if="{{aboutSettings.phone}}">
                    <text class="about-preview-label">手机号</text>
                    <text class="about-preview-value">{{aboutSettings.phone}}</text>
                  </view>
                  <view class="about-preview-row" wx:if="{{aboutSettings.wechat}}">
                    <text class="about-preview-label">微信号</text>
                    <text class="about-preview-value">{{aboutSettings.wechat}}</text>
                  </view>
                  <view class="about-preview-row" wx:if="{{aboutSettings.email}}">
                    <text class="about-preview-label">邮箱</text>
                    <text class="about-preview-value about-preview-value--break">{{aboutSettings.email}}</text>
                  </view>
                </view>

                <view class="about-preview-empty" wx:if="{{!aboutSettings.phone && !aboutSettings.wechat && !aboutSettings.email}}">
                  <text>未填写联系方式</text>
                </view>

                <view class="about-preview-qr-wrap" wx:if="{{aboutSettings.donation_qr_code}}">
                  <image class="about-preview-qr" src="{{aboutSettings.donation_qr_code}}" mode="widthFix" />
                </view>
              </view>
            </view>
          </view>
        </block>

        <block wx:if="{{activeSection === 'poses'}}">
          <view class="pose-page motion-fade-up">
            <view class="pose-header">
              <text class="pose-header__title">摆姿管理 📸</text>
              <text class="pose-header__desc">管理拍照姿势库和标签</text>
            </view>

