                bindtap="onPosePanelTabChange"
              >
                <text class="pose-tab-item__text">摆姿列表</text>
                <view class="pose-tab-item__line" wx:if="{{posePanelTab === 'poses'}}"></view>
              </view>
              <view
                class="pose-tab-item {{posePanelTab === 'tags' ? 'pose-tab-item--active' : ''}}"
                data-key="tags"
                bindtap="onPosePanelTabChange"
              >
                <text class="pose-tab-item__text">标签管理</text>
                <view class="pose-tab-item__line" wx:if="{{posePanelTab === 'tags'}}"></view>
              </view>
            </view>

            <block wx:if="{{posePanelTab === 'poses'}}">
              <view class="pose-toolbar">
                <scroll-view class="pose-filter-scroll" scroll-x="true" enable-flex="true">
                  <view class="pose-filter-row">
                    <text class="pose-filter-row__icon">🏷️</text>
                    <view
                      class="pose-filter-chip {{item.filterActive ? 'pose-filter-chip--active' : ''}}"
                      wx:for="{{poseTagStats}}"
                      wx:key="name"
                      data-tag="{{item.name}}"
