            取消
          </button>
          <button
            class="booking-confirm-modal__btn album-modal__btn--primary"
            bindtap="onSubmitAlbumTitle"
            loading="{{albumTitleSaving}}"
            disabled="{{albumTitleSaving}}"
          >
            {{albumTitleSaving ? "保存中..." : "确认修改"}}
          </button>
        </view>
      </view>
    </view>
  </view>

  <view class="booking-modal-mask" wx:if="{{activeSection === 'albums' && albumKeyModalOpen}}" bindtap="onCloseAlbumKeyModal">
