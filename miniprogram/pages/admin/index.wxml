                  wx:key="id"
                  data-id="{{item.id}}"
                  bindtap="onToggleBookingSelection"
                >
                  <view class="booking-card__head">
                    <view class="booking-card__user-wrap">
                      <view class="booking-card__check {{item.selected ? 'booking-card__check--active' : ''}}" wx:if="{{bookingSelectionMode && item.isDeletable}}">
                        <text wx:if="{{item.selected}}">✓</text>
                      </view>
                      <view class="booking-card__avatar">
                        <text>👤</text>
                      </view>
                      <view class="booking-card__user">
                        <text class="booking-card__name">{{item.userDisplay}}</text>
                        <text class="booking-card__email" wx:if="{{item.userEmail}}">{{item.userEmail}}</text>
                      </view>
                    </view>
                    <view class="booking-status-chip {{item.statusClass}}">
                      <text>{{item.statusText}}</text>
                    </view>
                  </view>

                  <view class="booking-card__grid">
                    <view class="booking-info-row">
                      <text class="booking-info-row__icon">📅</text>
                      <text class="booking-info-row__text">{{item.bookingDateDisplay || "未设置日期"}}</text>
                    </view>
                    <view class="booking-info-row">
                      <text class="booking-info-row__icon">📞</text>
                      <text class="booking-info-row__text">{{item.phoneDisplay}}</text>
                    </view>
                    <view class="booking-info-row booking-info-row--location">
                      <text class="booking-info-row__icon">📍</text>
                      <text class="booking-info-row__text">{{item.locationDisplay}}</text>
                    </view>
                    <view class="booking-info-row booking-info-row--full">
                      <text class="booking-info-row__icon">💬</text>
                      <text class="booking-info-row__text">{{item.wechatDisplay}}</text>
                    </view>
                  </view>

                  <view class="booking-type-chip" wx:if="{{item.typeDisplay}}">
                    <text>{{item.typeDisplay}}</text>
                  </view>

                  <view class="booking-notes" wx:if="{{item.notesDisplay}}">
                    <text class="booking-notes__text">{{item.notesDisplay}}</text>
                  </view>

                  <text class="booking-card__meta">{{item.createdAtText}}</text>

                  <view class="booking-card__actions" wx:if="{{!bookingSelectionMode}}">
                    <button
                      class="booking-action-btn booking-action-btn--confirm"
                      wx:if="{{item.canConfirm}}"
                      data-id="{{item.id}}"
                      catchtap="onBookingConfirmAction"
                      hover-class="booking-action-btn--confirm-active"
                      loading="{{bookingUpdatingId === item.id}}"
                      disabled="{{bookingActionLoading || bookingUpdatingId === item.id}}"
                    >
                      确认预约
                    </button>
                    <button
                      class="booking-action-btn booking-action-btn--start"
                      wx:if="{{item.canStart}}"
                      data-id="{{item.id}}"
                      catchtap="onBookingStartAction"
                      hover-class="booking-action-btn--start-active"
                      loading="{{bookingUpdatingId === item.id}}"
                      disabled="{{bookingActionLoading || bookingUpdatingId === item.id}}"
                    >
                      开始拍摄
                    </button>
                    <button
                      class="booking-action-btn booking-action-btn--start"
                      wx:if="{{item.canFinish}}"
                      data-id="{{item.id}}"
                      catchtap="onBookingFinishAction"
                      hover-class="booking-action-btn--start-active"
                      loading="{{bookingUpdatingId === item.id}}"
                      disabled="{{bookingActionLoading || bookingUpdatingId === item.id}}"
                    >
                      完成预约
                    </button>
                    <button
                      class="booking-action-btn booking-action-btn--cancel"
                      wx:if="{{item.canCancel}}"
                      data-id="{{item.id}}"
                      catchtap="onOpenBookingCancelConfirm"
                      hover-class="booking-action-btn--cancel-active"
                      disabled="{{bookingActionLoading || bookingUpdatingId === item.id}}"
                    >
                      取消预约
                    </button>
                    <button
                      class="booking-action-btn booking-action-btn--map"
                      wx:if="{{item.hasCoordinate}}"
                      data-id="{{item.id}}"
                      catchtap="onOpenBookingLocation"
                      hover-class="booking-action-btn--map-active"
                      disabled="{{bookingActionLoading || bookingUpdatingId === item.id}}"
                    >
                      查看定位
                    </button>
                    <button
                      class="booking-action-btn booking-action-btn--delete"
                      wx:if="{{item.isDeletable}}"
                      data-id="{{item.id}}"
                      catchtap="onOpenBookingDeleteConfirm"
                      hover-class="booking-action-btn--delete-active"
                      loading="{{bookingUpdatingId === item.id}}"
                      disabled="{{bookingActionLoading || bookingUpdatingId === item.id}}"
                    >
                      删除订单
                    </button>
                  </view>
                </view>
              </view>

              <view class="booking-pagination" wx:if="{{bookingFilteredList.length}}">
                <text class="booking-page-indicator" wx:if="{{bookingHasMoreVisible}}">已加载 {{bookingRows.length}} / {{bookingFilteredList.length}} 条，下滑继续加载</text>
                <text class="booking-page-indicator" wx:else>已全部加载，共 {{bookingFilteredList.length}} 条</text>
              </view>
            </view>
          </block>

          <block wx:if="{{bookingPanelTab === 'types'}}">
            <view class="booking-panel motion-fade-up">
              <view class="booking-toolbar booking-toolbar--right booking-toolbar--triple-inline" wx:if="{{!bookingTypeSelectionMode}}">
                <button
                  class="booking-pill-btn booking-pill-btn--ghost"
                  bindtap="onRefreshBookingSection"
                  hover-class="booking-pill-btn--ghost-active"
                  disabled="{{bookingTypesLoading || bookingTypesRefreshing || bookingTypeSaving || bookingTypeDeletingId !== 0 || bookingTypeTogglingId !== 0 || bookingTypeBatchDeleting}}"
                >
                  {{bookingTypesRefreshing ? "刷新中..." : "刷新"}}
                </button>
                <button
                  class="booking-pill-btn booking-pill-btn--danger"
                  bindtap="onEnterBookingTypeSelectionMode"
                  hover-class="booking-pill-btn--danger-active"
                  disabled="{{bookingTypesLoading || bookingTypesRefreshing || bookingTypeSaving || bookingTypeDeletingId !== 0 || bookingTypeTogglingId !== 0 || bookingTypeBatchDeleting || !bookingTypes.length}}"
                >
