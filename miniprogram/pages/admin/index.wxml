  <view class="booking-modal-mask" wx:if="{{activeSection === 'albums' && albumRecipientModalOpen}}" bindtap="onCloseAlbumRecipientModal">
    <view class="booking-modal booking-modal--form album-modal" catchtap="onPoseModalTap">
      <view class="booking-modal__head">
        <text class="booking-modal__title">编辑收件人和信内容</text>
        <view class="booking-modal__close" bindtap="onCloseAlbumRecipientModal">
          <text>✕</text>
        </view>
      </view>
      <view class="booking-modal__body">
        <text class="album-modal__subtitle">空间：{{albumEditingRecipientTitle}}</text>
        <view class="booking-modal__field">
          <text class="booking-modal__label">收件人名称</text>
          <input
            class="booking-modal__input"
            value="{{albumEditingRecipientName}}"
            bindinput="onAlbumRecipientNameInput"
            placeholder="例如：小美、拾光者"
            placeholder-class="booking-modal__placeholder"
