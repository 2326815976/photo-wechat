                    上一页
                  </button>
                  <text class="pose-page-indicator">第 {{poseCurrentPage}} 页 / 共 {{poseTotalPages}} 页</text>
                  <button
                    class="pose-page-btn pose-page-btn--ghost"
                    bindtap="onPoseNextPage"
                    disabled="{{poseCurrentPage >= poseTotalPages}}"
