                      bindtap="onCloseReleaseDeleteModal"
                      disabled="{{releaseDeletingId}}"
                    >
                      取消
                    </button>
                    <button
                      class="release-danger-btn"
                      bindtap="onConfirmDeleteRelease"
                      disabled="{{releaseDeletingId}}"
                    >
                      {{releaseDeletingId ? "删除中..." : "确认删除"}}
                    </button>
                  </view>
                </view>
              </view>
            </block>

            <block wx:elif="{{releaseMode === 'create'}}">
              <view class="release-new-header">
                <button
                  class="release-back-btn"
                  bindtap="onBackReleaseList"
                  disabled="{{releaseCreating}}"
                >
                  <image class="release-back-btn__icon" src="/images/icons/arrow-left.svg" mode="aspectFit" />
                </button>
                <view class="release-new-header__main">
                  <text class="release-new-header__title">发布新版本 🚀</text>
                  <text class="release-new-header__desc">上传应用安装包</text>
                </view>
              </view>

              <view class="release-form">
                <view class="release-field">
                  <text class="release-field__label">
                    版本号 <text class="release-required">*</text>
                  </text>
                  <input
                    class="release-input"
                    value="{{releaseVersion}}"
                    placeholder="例如: 1.0.0"
                    bindinput="onReleaseVersionInput"
                  />
                </view>

                <view class="release-field">
                  <text class="release-field__label">
                    平台 <text class="release-required">*</text>
                  </text>
                  <picker
                    mode="selector"
                    range="{{releasePlatformOptions}}"
                    value="{{releasePlatformIndex}}"
                    bindchange="onReleasePlatformChange"
                  >
                    <view class="release-select">
                      <text class="release-select__text">{{releasePlatformOptions[releasePlatformIndex]}}</text>
                      <image class="release-select__chevron" src="/images/icons/chevron-down-brown.svg" mode="aspectFit" />
                    </view>
                  </picker>
                </view>

                <view class="release-field">
                  <text class="release-field__label">更新日志</text>
                  <textarea
                    class="release-textarea"
                    value="{{releaseUpdateLog}}"
                    placeholder="描述本次更新的内容..."
                    maxlength="1000"
                    bindinput="onReleaseUpdateLogInput"
                  />
                </view>

                <view class="release-force">
                  <view class="release-force__main">
                    <text class="release-force__title">强制更新 🔒</text>
                    <text class="release-force__desc">开启后，用户必须更新才能继续使用应用（弹窗不可关闭）</text>
                  </view>
                  <view
                    class="release-toggle {{releaseForceUpdate ? 'release-toggle--on' : ''}}"
                    bindtap="onToggleReleaseForceUpdate"
                  >
                    <view class="release-toggle__thumb {{releaseForceUpdate ? 'release-toggle__thumb--on' : ''}}"></view>
                  </view>
                </view>

                <view class="release-field">
                  <text class="release-field__label">
                    安装包文件 <text class="release-required">*</text>
                  </text>
                  <button
                    class="release-upload-btn"
                    catchtap="chooseReleaseFile"
                    disabled="{{releaseCreating}}"
                  >
                    <image class="release-upload-btn__icon" src="/images/icons/upload-brown.svg" mode="aspectFit" />
                    <text class="release-upload-btn__text">{{releaseFileName || "点击选择文件"}}</text>
                  </button>
                  <text class="release-help" wx:if="{{releaseFileName}}">
                    文件大小: {{releaseFileSizeText || "未知大小"}}
                  </text>
                </view>

                <button
                  class="release-primary-btn release-primary-btn--full"
                  bindtap="createRelease"
                  hover-class="release-primary-btn--active"
                  loading="{{releaseCreating}}"
                  disabled="{{releaseCreating}}"
                >
                  {{releaseCreating ? "发布中..." : "发布版本"}}
                </button>
              </view>
            </block>
          </view>
        </block>
      </view>
    </view>
  </scroll-view>

