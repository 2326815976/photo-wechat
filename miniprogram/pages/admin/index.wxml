                  <button
                    class="booking-pill-btn booking-pill-btn--ghost booking-pill-btn--compact"
                    bindtap="onCancelCitySelectionMode"
                    hover-class="booking-pill-btn--ghost-active"
                    disabled="{{cityBatchDeleting}}"
                  >
                    取消
                  </button>
                </view>
              </view>

              <view class="admin-loading-card admin-loading-card--inline" wx:if="{{citiesLoading}}">
                <view class="admin-loading-card__orb">
                  <view class="admin-loading-card__spinner"></view>
                </view>
                <text class="admin-loading-card__title">拾光中...</text>
                <text class="admin-loading-card__desc">正在同步可预约城市配置，请稍候。</text>
              </view>

              <view class="empty booking-empty-card" wx:elif="{{!allowedCities.length}}">
                <text class="booking-empty-card__icon">📍</text>
                <text>暂无允许的城市</text>
              </view>

              <view class="booking-config-grid" wx:else>
                <view class="booking-config-card {{citySelectionMode ? (item.selected ? 'booking-config-card--selected' : 'booking-config-card--selectable') : ''}}" wx:for="{{allowedCities}}" wx:key="id" data-id="{{item.id}}" bindtap="onToggleCitySelection">
                  <view class="booking-config-card__head">
                    <view class="booking-config-card__main">
                      <view class="booking-config-card__title-row">
                        <view class="booking-config-card__check {{item.selected ? 'booking-config-card__check--active' : ''}}" wx:if="{{citySelectionMode}}">
                          <text wx:if="{{item.selected}}">✓</text>
                        </view>
                        <text class="booking-config-card__title">{{item.city_name}}</text>
                      </view>
                      <text class="booking-config-card__desc" wx:if="{{item.province}}">{{item.province}}</text>
                      <text class="booking-config-card__meta" wx:if="{{item.city_code}}">代码：{{item.city_code}}</text>
                      <text class="booking-config-card__meta" wx:if="{{item.locationText}}">{{item.locationText}}</text>
                    </view>
                    <view class="booking-config-state {{item.is_active ? 'booking-config-state--active' : 'booking-config-state--inactive'}}">
                      <text>{{item.activeText}}</text>
                    </view>
                  </view>
                  <view class="booking-config-card__actions" wx:if="{{!citySelectionMode}}">
                    <button
                      class="booking-config-btn booking-config-btn--edit"
                      data-id="{{item.id}}"
                      bindtap="onEditAllowedCity"
                      hover-class="booking-config-btn--edit-active"
                      disabled="{{citySaving || cityDeletingId !== 0 || cityTogglingId !== 0 || cityBatchDeleting}}"
                    >
                      编辑
                    </button>
                    <button
                      class="booking-config-btn booking-config-btn--delete"
                      data-id="{{item.id}}"
                      bindtap="onOpenCityDeleteConfirm"
                      hover-class="booking-config-btn--delete-active"
                      loading="{{cityDeletingId === item.id}}"
                      disabled="{{cityDeletingId === item.id || citySaving || cityTogglingId !== 0 || cityBatchDeleting}}"
                    >
                      删除
                    </button>
                    <button
                      class="booking-config-btn {{item.is_active ? 'booking-config-btn--disable' : 'booking-config-btn--enable'}}"
                      data-id="{{item.id}}"
                      bindtap="onToggleAllowedCity"
                      hover-class="{{item.is_active ? 'booking-config-btn--disable-active' : 'booking-config-btn--enable-active'}}"
                      loading="{{cityTogglingId === item.id}}"
                      disabled="{{cityTogglingId !== 0 || cityDeletingId !== 0 || citySaving || cityBatchDeleting}}"
                    >
                      {{item.is_active ? "禁用" : "启用"}}
                    </button>
                  </view>
                </view>
              </view>
            </view>
          </block>
        </block>

        <block wx:if="{{activeSection === 'about'}}">
          <view class="booking-panel about-panel motion-fade-up">
            <view class="admin-loading-card admin-loading-card--inline" wx:if="{{aboutLoading}}">
              <view class="admin-loading-card__orb">
                <view class="admin-loading-card__spinner"></view>
              </view>
              <text class="admin-loading-card__title">拾光中...</text>
              <text class="admin-loading-card__desc">正在同步关于页内容与赞赏码配置，请稍候。</text>
            </view>

            <block wx:else>
              <view class="about-grid">
              <view class="about-card about-card--form">
                <view class="booking-modal__body">
                  <view class="booking-modal__field about-field about-field--auto-input">
                    <text class="booking-modal__label">作者名称</text>
                    <input
                      class="booking-modal__input about-inline-input"
                      value="{{aboutSettings.author_name}}"
                      data-field="author_name"
                      bindinput="onAboutInput"
                      placeholder="例如：拾光谣作者"
                      placeholder-class="booking-modal__placeholder"
                      maxlength="60"
                    />
                  </view>

                  <view class="booking-modal__field about-field about-field--auto-input">
                    <text class="booking-modal__label">手机号（选填）</text>
                    <input
                      class="booking-modal__input about-inline-input"
                      value="{{aboutSettings.phone}}"
                      data-field="phone"
                      bindinput="onAboutInput"
                      placeholder="请输入手机号"
                      placeholder-class="booking-modal__placeholder"
                      maxlength="32"
                    />
                  </view>

                  <view class="booking-modal__field about-field about-field--auto-input">
                    <text class="booking-modal__label">微信号（选填）</text>
                    <input
                      class="booking-modal__input about-inline-input"
                      value="{{aboutSettings.wechat}}"
                      data-field="wechat"
                      bindinput="onAboutInput"
                      placeholder="请输入微信号"
                      placeholder-class="booking-modal__placeholder"
                      maxlength="64"
                    />
                  </view>

                  <view class="booking-modal__field about-field about-field--auto-input">
                    <text class="booking-modal__label">邮箱（选填）</text>
                    <input
                      class="booking-modal__input about-inline-input"
                      value="{{aboutSettings.email}}"
                      data-field="email"
                      bindinput="onAboutInput"
                      placeholder="请输入邮箱"
                      placeholder-class="booking-modal__placeholder"
                      maxlength="255"
                    />
                  </view>

                  <view class="booking-modal__field">
                    <text class="booking-modal__label">赞赏码图片（选填）</text>
                    <view class="album-upload-preview" wx:if="{{aboutSettings.donation_qr_code}}">
                      <text class="album-upload-preview__label">当前赞赏码</text>
                      <image class="album-upload-preview__qr" src="{{aboutSettings.donation_qr_code}}" mode="aspectFit" />
                    </view>
                    <view class="album-upload-preview album-upload-preview--empty" wx:else>
                      <text>当前未上传赞赏码，上传后将展示在用户端关于页面。</text>
                    </view>
                    <button
                      class="booking-modal__submit"
                      bindtap="onOpenAboutDonationModal"
                      hover-class="booking-modal__submit--active"
                      disabled="{{aboutDonationUploading || aboutSaving || aboutLoading}}"
                    >
                      {{aboutSettings.donation_qr_code ? "更换赞赏码" : "上传赞赏码"}}
                    </button>
                    <button
                      wx:if="{{aboutSettings.donation_qr_code}}"
                      class="booking-pill-btn booking-pill-btn--ghost"
                      bindtap="onClearAboutDonationQr"
                      hover-class="booking-pill-btn--ghost-active"
                      disabled="{{aboutDonationUploading || aboutSaving || aboutLoading}}"
                    >
                      清空赞赏码
                    </button>
                  </view>

                  <view class="booking-modal__field">
                    <text class="booking-modal__label">作者留言</text>
                    <view class="about-textarea-wrap">
                      <view class="booking-modal__textarea about-textarea about-textarea--mirror">{{aboutAuthorMessageMirrorText}}</view>
                      <textarea
                        class="booking-modal__textarea about-textarea about-textarea--input"
                        value="{{aboutSettings.author_message}}"
                        data-field="author_message"
                        bindinput="onAboutInput"
                        placeholder="写给用户的一段话"
                        placeholder-class="booking-modal__placeholder"
                        maxlength="2000"
                      ></textarea>
                    </view>
                  </view>
                </view>

                <view class="about-save-wrap">
                  <text class="about-save-tip">保存时会自动规范手机号，并校验邮箱格式。</text>
                  <button
                    class="booking-pill-btn booking-pill-btn--primary about-save-btn"
                    bindtap="onSaveAboutSettings"
                    hover-class="booking-pill-btn--primary-active"
                    loading="{{aboutSaving}}"
                    disabled="{{aboutSaving || aboutLoading || aboutDonationUploading}}"
                  >
                    {{aboutSaving ? "保存中..." : "保存设置"}}
                  </button>
                </view>
              </view>
              </view>
            </block>
          </view>
        </block>

        <block wx:if="{{activeSection === 'poses'}}">
          <view class="pose-page motion-fade-up">
            <view class="pose-header">
              <text class="pose-header__title">摆姿管理 📸</text>
              <text class="pose-header__desc">管理拍照姿势库和标签</text>
            </view>

            <view class="pose-tabs-bar">
              <view class="pose-tabs">
                <view
                  class="pose-tab-item {{posePanelTab === 'poses' ? 'pose-tab-item--active' : ''}}"
                  data-key="poses"
                  bindtap="onPosePanelTabChange"
                >
                  <text class="pose-tab-item__text">摆姿列表</text>
                  <view class="pose-tab-item__line" wx:if="{{posePanelTab === 'poses'}}"></view>
                </view>
                <view
                  class="pose-tab-item {{posePanelTab === 'tags' ? 'pose-tab-item--active' : ''}}"
                  data-key="tags"
                  bindtap="onPosePanelTabChange"
                >
                  <text class="pose-tab-item__text">标签管理</text>
                  <view class="pose-tab-item__line" wx:if="{{posePanelTab === 'tags'}}"></view>
                </view>
              </view>

            </view>

            <block wx:if="{{posePanelTab === 'poses'}}">
              <view class="pose-toolbar {{!poseSelectionMode ? 'pose-toolbar--with-actions' : ''}}">
                <scroll-view class="pose-filter-scroll" scroll-x="true" enable-flex="true">
                  <view class="pose-filter-row">
                    <text class="pose-filter-row__icon">🏷️</text>
                    <view
                      class="pose-filter-chip {{item.filterActive ? 'pose-filter-chip--active' : ''}}"
                      wx:for="{{poseTagStats}}"
                      wx:key="name"
                      data-tag="{{item.name}}"
                      bindtap="onTogglePoseTagFilter"
                    >
                      <text>{{item.name}} ({{item.usage_count}})</text>
                    </view>
                  </view>
                </scroll-view>

                <view class="pose-toolbar-actions pose-toolbar-actions--pair" wx:if="{{!poseSelectionMode}}">
                  <button
                    class="pose-toolbar-btn pose-toolbar-btn--danger pose-toolbar-btn--compact"
                    bindtap="onEnterPoseSelectionMode"
                  >
                    批量删除
                  </button>
                  <button
                    class="pose-toolbar-btn pose-toolbar-btn--primary pose-toolbar-btn--compact"
                    bindtap="onOpenPoseCreateModal"
                  >
                    新增摆姿
                  </button>
                </view>

                <view class="pose-toolbar-actions" wx:if="{{poseSelectionMode}}">
                  <button
                    class="pose-toolbar-btn pose-toolbar-btn--ghost"
                    bindtap="onSelectAllFilteredPoses"
                  >
                    {{poseAllSelected ? "取消全选" : "全选"}} ({{poseSelectedCount}}/{{poseTotalCount}})
                  </button>
                  <button
                    class="pose-toolbar-btn pose-toolbar-btn--danger"
                    bindtap="onBatchDeletePoses"
                    disabled="{{poseBatchDeleting || !poseSelectedCount}}"
                    loading="{{poseBatchDeleting}}"
                  >
                    删除选中 ({{poseSelectedCount}})
                  </button>
                  <button
                    class="pose-toolbar-btn pose-toolbar-btn--ghost"
                    bindtap="onCancelPoseSelectionMode"
                    disabled="{{poseBatchDeleting}}"
                  >
                    取消
                  </button>
                </view>
              </view>

              <view class="pose-inline-error" wx:if="{{posesError && posesReady}}">
                <text class="pose-inline-error__text">{{posesError}}</text>
              </view>

              <view class="admin-loading-card admin-loading-card--compact" wx:if="{{posesLoading && !posesReady}}">
                <view class="admin-loading-card__orb">
                  <view class="admin-loading-card__spinner"></view>
                </view>
                <text class="admin-loading-card__title">拾光中...</text>
                <text class="admin-loading-card__desc">正在同步最新的摆姿图片与标签数据，请稍候。</text>
              </view>

              <view class="pose-empty-card pose-empty-card--rich" wx:elif="{{!posesReady}}">
                <text class="pose-empty-card__icon">图</text>
                <text class="pose-empty-card__title">{{posesError ? "摆姿数据暂时不可用" : "暂无摆姿数据"}}</text>
                <text class="pose-empty-card__desc">{{posesError || "上传摆姿后会展示在这里。"}}</text>
                <button
                  class="pose-empty-card__action"
                  bindtap="onRefreshPoseSection"
                  hover-class="pose-empty-card__action--active"
                  disabled="{{posesLoading || posesRefreshing || poseBatchDeleting || poseCreating}}"
                >
                  {{posesLoading || posesRefreshing ? "刷新中..." : "重新加载"}}
                </button>
              </view>

              <view class="empty pose-empty-card pose-empty-card--rich" wx:elif="{{!poseFilteredList.length}}">
                <text class="pose-empty-card__icon">图</text>
                <text class="pose-empty-card__title">{{poseSelectedTags.length ? "当前筛选下暂无摆姿" : "暂无摆姿数据"}}</text>
                <text class="pose-empty-card__desc">{{poseSelectedTags.length ? "可以切换标签筛选或刷新列表。" : "上传摆姿后会展示在这里。"}}</text>
              </view>

              <block wx:else>
                <view class="pose-grid">
                  <view
                    class="pose-card {{poseSelectionMode && item.selected ? 'pose-card--selected' : ''}}"
                    wx:for="{{posePagedList}}"
                    wx:key="id"
                    data-id="{{item.id}}"
                    bindtap="onTogglePoseSelection"
                  >
                    <view class="pose-card-image-wrap">
                      <image
                        class="pose-card-image"
                        src="{{item.imageResolved}}"
                        mode="aspectFill"
                        data-url="{{item.imageResolved}}"
                        bindtap="onPreviewPoseImage"
                      />

                      <view class="pose-select-dot-wrap" wx:if="{{poseSelectionMode}}">
                        <view class="pose-select-dot {{item.selected ? 'pose-select-dot--active' : ''}}">
                          <text wx:if="{{item.selected}}">✓</text>
                        </view>
                      </view>

                      <view class="pose-card-actions" wx:if="{{!poseSelectionMode}}">
                        <view
                          class="pose-card-action-btn pose-card-action-btn--edit {{poseDeletingId === item.id || poseBatchDeleting || poseCreating ? 'pose-card-action-btn--disabled' : ''}}"
                          data-id="{{item.id}}"
                          catchtap="onOpenPoseEditModal"
                        >
                          <image class="pose-card-action-btn__img" src="/images/icons/edit-white.svg" mode="aspectFit" />
                        </view>
                        <view
                          class="pose-card-action-btn pose-card-action-btn--delete {{poseDeletingId === item.id || poseBatchDeleting ? 'pose-card-action-btn--disabled' : ''}}"
                          data-id="{{item.id}}"
                          catchtap="onDeletePose"
                        >
                          <text class="pose-card-action-btn__loading" wx:if="{{poseDeletingId === item.id}}">…</text>
                          <image wx:else class="pose-card-action-btn__img" src="/images/icons/trash-white.svg" mode="aspectFit" />
                        </view>
                      </view>
                    </view>

                    <view class="pose-card-body">
                      <view class="pose-card-meta">
                        <text class="pose-card-meta__icon">📷</text>
                        <text class="pose-card-view">浏览 {{item.viewCount}}</text>
                      </view>
                      <view class="pose-card-tags" wx:if="{{item.tags.length}}">
                        <text class="pose-card-tag" wx:for="{{item.tags}}" wx:key="*this">{{item}}</text>
                      </view>
                    </view>
                  </view>
                </view>

                <view class="pose-pagination" wx:if="{{poseTotalCount}}">
                  <text class="pose-page-indicator" wx:if="{{poseHasMoreVisible}}">已加载 {{posePagedList.length}} / {{poseTotalCount}} 个，下滑继续加载</text>
                  <text class="pose-page-indicator" wx:else>已全部加载，共 {{poseTotalCount}} 个</text>
                </view>
              </block>
            </block>

            <block wx:elif="{{posePanelTab === 'tags'}}">
              <view class="pose-tags-toolbar">
                <view class="pose-tags-toolbar__summary">
                  <text class="pose-tags-toolbar__title">共 {{poseTagStats.length}} 个标签</text>
                  <view class="pose-tags-toolbar__actions pose-tags-toolbar__actions--inline" wx:if="{{!poseTagSelectionMode}}">
                    <button
                      class="pose-toolbar-btn pose-toolbar-btn--danger pose-toolbar-btn--compact"
                      bindtap="onEnterPoseTagSelectionMode"
                    >
                      批量删除
                    </button>
                    <button
                      class="pose-toolbar-btn pose-toolbar-btn--primary pose-toolbar-btn--compact"
                      bindtap="onOpenPoseTagModal"
                    >
                      新增标签
                    </button>
                  </view>
                </view>
                <view class="pose-tags-toolbar__meta">
                  <text class="pose-tags-toolbar__desc" wx:if="{{poseTagSelectionMode}}">已选择 {{poseTagSelectedCount}} 个标签</text>
                  <text class="pose-tags-toolbar__desc" wx:else>已使用 {{poseTagUsedCount}} 个标签</text>
                </view>

                <view class="pose-tags-toolbar__actions pose-tags-toolbar__actions--selection" wx:if="{{poseTagSelectionMode}}">
                  <button
                    class="pose-toolbar-btn pose-toolbar-btn--ghost"
                    bindtap="onSelectAllPoseTags"
                  >
                    {{poseTagAllSelected ? "取消全选" : "全选"}} ({{poseTagSelectedCount}}/{{poseTagStats.length}})
                  </button>
                  <button
                    class="pose-toolbar-btn pose-toolbar-btn--danger"
                    bindtap="onBatchDeletePoseTags"
                    disabled="{{poseTagBatchDeleting || !poseTagSelectedCount}}"
                    loading="{{poseTagBatchDeleting}}"
                  >
                    删除选中 ({{poseTagSelectedCount}})
                  </button>
                  <button
                    class="pose-toolbar-btn pose-toolbar-btn--ghost"
                    bindtap="onCancelPoseTagSelectionMode"
                    disabled="{{poseTagBatchDeleting}}"
                  >
                    取消
                  </button>
                </view>
              </view>

              <view class="pose-inline-error" wx:if="{{poseTagsError && poseTagsReady}}">
                <text class="pose-inline-error__text">{{poseTagsError}}</text>
              </view>

              <view class="admin-loading-card admin-loading-card--compact" wx:if="{{poseTagsLoading && !poseTagsReady}}">
                <view class="admin-loading-card__orb">
                  <view class="admin-loading-card__spinner"></view>
                </view>
                <text class="admin-loading-card__title">拾光中...</text>
                <text class="admin-loading-card__desc">正在同步标签排序与使用情况，请稍候。</text>
              </view>

              <view class="pose-empty-card pose-empty-card--rich" wx:elif="{{!poseTagsReady}}">
                <text class="pose-empty-card__icon">标</text>
                <text class="pose-empty-card__title">{{poseTagsError ? "标签数据暂时不可用" : "暂无标签数据"}}</text>
                <text class="pose-empty-card__desc">{{poseTagsError || "创建标签后可用于摆姿筛选与管理。"}}</text>
                <button
                  class="pose-empty-card__action"
                  bindtap="onRefreshPoseSection"
                  hover-class="pose-empty-card__action--active"
                  disabled="{{poseTagsLoading || poseTagsRefreshing || poseTagCreating || poseTagUpdating || poseTagBatchDeleting || poseTagSortingId !== 0}}"
                >
                  {{poseTagsLoading || poseTagsRefreshing ? "刷新中..." : "重新加载"}}
                </button>
              </view>

              <view class="empty pose-empty-card pose-empty-card--rich" wx:elif="{{!poseTagStats.length}}">
                <text class="pose-empty-card__icon">标</text>
                <text class="pose-empty-card__title">暂无标签数据</text>
                <text class="pose-empty-card__desc">创建标签后可用于摆姿筛选与管理。</text>
              </view>

              <view class="pose-tags-grid" wx:else>
                <view
                  class="pose-tag-card {{poseTagSelectionMode && item.selectedTag ? 'pose-tag-card--selected' : ''}}"
                  wx:for="{{poseTagStats}}"
                  wx:key="id"
                  data-id="{{item.id}}"
                  bindtap="onTogglePoseTagSelection"
                >
                  <view class="pose-tag-card__head">
                    <view class="pose-tag-card__left">
                      <view class="pose-tag-check {{item.selectedTag ? 'pose-tag-check--active' : ''}}" wx:if="{{poseTagSelectionMode}}">
                        <text wx:if="{{item.selectedTag}}">✓</text>
                      </view>
                      <view class="pose-tag-card__icon">
                        <text>🏷️</text>
                      </view>
                      <view class="pose-tag-card__main">
                        <view class="pose-tag-card__title-row">
                          <text class="pose-tag-card__name">{{item.name}}</text>
                          <view class="pose-tag-order-badge">
                            <text>#{{item.sortIndex}}</text>
                          </view>
                        </view>
                        <view class="pose-tag-card__meta-row">
                          <text class="pose-tag-card__count">使用 {{item.usage_count}} 次</text>
                        </view>
                      </view>
                    </view>

                    <view class="pose-tag-card__actions" wx:if="{{!poseTagSelectionMode}}">
                      <view
                        class="pose-tag-action-btn pose-tag-action-btn--edit {{item.virtual || poseTagBatchDeleting || poseTagDeletingId !== 0 || poseTagUpdating || poseTagSortingId !== 0 ? 'pose-tag-action-btn--disabled' : ''}}"
                        data-id="{{item.id}}"
                        data-name="{{item.name}}"
                        data-virtual="{{item.virtual}}"
                        catchtap="onOpenPoseTagEditModal"
                      >
                        <text class="pose-tag-action-btn__text">编辑</text>
                      </view>
                      <view
                        class="pose-tag-action-btn pose-tag-action-btn--delete {{item.virtual || poseTagDeletingId === item.id || poseTagBatchDeleting || poseTagUpdating || poseTagSortingId !== 0 ? 'pose-tag-action-btn--disabled' : ''}}"
                        data-id="{{item.id}}"
                        data-name="{{item.name}}"
                        data-virtual="{{item.virtual}}"
                        catchtap="onAskDeletePoseTag"
                      >
                        <text class="pose-tag-action-btn__text">{{poseTagDeletingId === item.id ? "删除中" : "删除"}}</text>
                      </view>
                    </view>
                  </view>

                  <view class="pose-tag-card__sort-row" wx:if="{{!poseTagSelectionMode}}">
                    <view class="pose-tag-sort-controls">
                      <text class="pose-tag-sort-controls__label">排序</text>
                      <view class="pose-tag-sort-controls__actions">
                        <view
                          class="pose-tag-action-btn pose-tag-action-btn--move {{item.virtual || !item.canMoveTop || poseTagBatchDeleting || poseTagDeletingId !== 0 || poseTagUpdating || poseTagSortingId !== 0 ? 'pose-tag-action-btn--disabled' : ''}}"
                          data-id="{{item.id}}"
                          catchtap="onMovePoseTagTop"
                        >
                          置顶
                        </view>
                        <view
                          class="pose-tag-action-btn pose-tag-action-btn--move {{item.virtual || !item.canMoveUp || poseTagBatchDeleting || poseTagDeletingId !== 0 || poseTagUpdating || poseTagSortingId !== 0 ? 'pose-tag-action-btn--disabled' : ''}}"
                          data-id="{{item.id}}"
                          catchtap="onMovePoseTagUp"
                        >
                          上移
                        </view>
                        <view
                          class="pose-tag-action-btn pose-tag-action-btn--move {{item.virtual || !item.canMoveDown || poseTagBatchDeleting || poseTagDeletingId !== 0 || poseTagUpdating || poseTagSortingId !== 0 ? 'pose-tag-action-btn--disabled' : ''}}"
                          data-id="{{item.id}}"
                          catchtap="onMovePoseTagDown"
                        >
                          下移
                        </view>
                      </view>
                    </view>
                  </view>
                </view>
              </view>
            </block>

          </view>
        </block>

