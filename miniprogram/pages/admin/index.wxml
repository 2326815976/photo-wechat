                      <text class="booking-config-card__title">{{item.name}}</text>
                      <text class="booking-config-card__desc" wx:if="{{item.description}}">{{item.description}}</text>
                    </view>
                    <view class="booking-config-state {{item.is_active ? 'booking-config-state--active' : 'booking-config-state--inactive'}}">
                      <text>{{item.activeText}}</text>
                    </view>
                  </view>
                  <view class="booking-config-card__actions">
                    <button
                      class="booking-config-btn booking-config-btn--edit"
                      data-id="{{item.id}}"
