<view class="page">
  <view class="topbar" style="padding-top: {{safeTop}}px;">
    <view class="topbar-inner">
      <view class="menu-btn" bindtap="toggleMobileMenu">
        <text class="menu-btn__text">{{mobileMenuOpen ? "✕" : "≡"}}</text>
      </view>
      <view class="brand" data-key="stats" bindtap="onSelectSection">
        <view class="brand-logo">
          <image class="brand-logo__icon" src="/images/icons/sparkles-brown.svg" mode="aspectFit" />
        </view>
        <text class="brand-title">拾光谣管理</text>
      </view>
    </view>
  </view>

  <view class="drawer-mask" wx:if="{{mobileMenuOpen}}" style="top: {{headerOffsetPx}}px;" bindtap="closeMobileMenu"></view>
  <view class="drawer" wx:if="{{mobileMenuOpen}}" style="top: {{headerOffsetPx}}px;">
    <view class="drawer-nav">
      <view
        class="drawer-item {{activeSection === item.key ? 'drawer-item--active' : ''}}"
        wx:for="{{adminNavItems}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onSelectSection"
      >
        <text class="drawer-item__icon">{{item.icon}}</text>
        <view class="drawer-item__main">
          <text class="drawer-item__title">{{item.label}}</text>
          <text class="drawer-item__desc">{{item.desc}}</text>
        </view>
      </view>
    </view>

    <view class="drawer-footer">
      <view class="drawer-user">
        <view class="drawer-user__avatar">
          <text>👤</text>
        </view>
        <view class="drawer-user__main">
          <text class="drawer-user__label">当前管理员</text>
          <text class="drawer-user__name">{{adminName || "管理员"}}</text>
        </view>
      </view>
      <button class="drawer-plain-btn" bindtap="goBack">返回个人中心</button>
      <button class="drawer-danger-btn" bindtap="logoutFromAdmin">退出登录</button>
    </view>
  </view>

  <scroll-view class="content" scroll-y="true" enable-flex="true" style="padding-top: {{contentTopPx}}px;">
    <view class="content-inner">
      <view class="config-tip motion-fade-up" wx:if="{{serviceMissing}}">
        <text class="config-tip__title">需要配置云托管服务名</text>
        <text class="config-tip__desc">请在 miniprogram/config.js 中填写 cloudRunService（用于 X-WX-SERVICE）</text>
      </view>

      <view class="loading motion-fade-up" wx:if="{{!serviceMissing && loading}}">
        <text class="loading-title">管理数据加载中...</text>
        <text class="loading-desc">正在同步后台能力</text>
      </view>

      <view class="auth-tip motion-fade-up" wx:if="{{!serviceMissing && !loading && authDenied}}">
        <text class="auth-title">无权访问</text>
        <text class="auth-desc">当前账号不是管理员，无法使用后台管理功能。</text>
      </view>
 
      <view wx:if="{{!serviceMissing && !loading && !authDenied}}">
        <view class="notice notice--{{noticeType}} motion-pop-in" wx:if="{{noticeText && activeSection !== 'releases'}}">
          <text>{{noticeText}}</text>
        </view>

        <view class="release-toast release-toast--{{noticeType}} motion-pop-in" wx:if="{{noticeText && activeSection === 'releases'}}">
          <text class="release-toast__icon" wx:if="{{noticeType === 'success'}}">✓</text>
          <text class="release-toast__icon" wx:elif="{{noticeType === 'warning'}}">!</text>
          <text class="release-toast__icon" wx:elif="{{noticeType === 'info'}}">i</text>
          <text class="release-toast__icon" wx:else>✕</text>
          <text class="release-toast__text">{{noticeText}}</text>
        </view>

        <view class="module-intro motion-fade-up" wx:if="{{activeSection !== 'stats' && activeSection !== 'poses' && activeSection !== 'releases'}}">
          <text class="module-title">{{activeSectionTitle}}</text>
          <text class="module-desc">{{activeSectionDesc}}</text>
        </view>

        <block wx:if="{{activeSection === 'stats'}}">
          <view class="stats-page motion-fade-up">
            <view class="stats-header">
              <view class="stats-header__main">
                <text class="stats-header__title">数据统计 📊</text>
                <text class="stats-header__desc">实时查看平台运营数据</text>
              </view>
              <button
                class="stats-maint-btn"
                bindtap="runMaintenance"
                hover-class="stats-maint-btn--active"
                loading="{{maintenanceRunning}}"
                disabled="{{maintenanceRunning}}"
              >
                {{maintenanceRunning ? "执行中..." : "维护任务"}}
              </button>
            </view>

            <view class="stats-section">
              <view class="stats-section__head">
                <text class="stats-section__icon">👥</text>
                <text class="stats-section__title">用户统计</text>
              </view>
              <view class="stats-cards-grid">
                <view class="stats-card" wx:for="{{statsView.userCards}}" wx:key="key">
                  <view class="stats-card__icon" style="background: linear-gradient(135deg, {{item.colorStart}}, {{item.colorEnd}});">
                    <text class="stats-card__icon-text">{{item.icon}}</text>
                  </view>
                  <text class="stats-card__title">{{item.title}}</text>
                  <text class="stats-card__value">{{item.value}}</text>
                  <text class="stats-card__subtitle" wx:if="{{item.subtitle}}">{{item.subtitle}}</text>
                </view>
              </view>
            </view>

            <view class="stats-section">
              <view class="stats-section__head">
                <text class="stats-section__icon">📁</text>
                <text class="stats-section__title">相册统计</text>
              </view>
              <view class="stats-cards-grid">
                <view class="stats-card" wx:for="{{statsView.albumCards}}" wx:key="key">
                  <view class="stats-card__icon" style="background: linear-gradient(135deg, {{item.colorStart}}, {{item.colorEnd}});">
                    <text class="stats-card__icon-text">{{item.icon}}</text>
                  </view>
                  <text class="stats-card__title">{{item.title}}</text>
                  <text class="stats-card__value">{{item.value}}</text>
                  <text class="stats-card__subtitle" wx:if="{{item.subtitle}}">{{item.subtitle}}</text>
                </view>
              </view>
            </view>

            <view class="stats-section">
              <view class="stats-section__head">
                <text class="stats-section__icon">🖼️</text>
                <text class="stats-section__title">照片统计</text>
              </view>
              <view class="stats-cards-grid">
                <view class="stats-card" wx:for="{{statsView.photoCardsPrimary}}" wx:key="key">
                  <view class="stats-card__icon" style="background: linear-gradient(135deg, {{item.colorStart}}, {{item.colorEnd}});">
                    <text class="stats-card__icon-text">{{item.icon}}</text>
                  </view>
                  <text class="stats-card__title">{{item.title}}</text>
                  <text class="stats-card__value">{{item.value}}</text>
                  <text class="stats-card__subtitle" wx:if="{{item.subtitle}}">{{item.subtitle}}</text>
                </view>
              </view>
              <view class="stats-cards-grid stats-cards-grid--spaced">
                <view class="stats-card" wx:for="{{statsView.photoCardsSecondary}}" wx:key="key">
                  <view class="stats-card__icon" style="background: linear-gradient(135deg, {{item.colorStart}}, {{item.colorEnd}});">
                    <text class="stats-card__icon-text">{{item.icon}}</text>
                  </view>
                  <text class="stats-card__title">{{item.title}}</text>
                  <text class="stats-card__value">{{item.value}}</text>
                  <text class="stats-card__subtitle" wx:if="{{item.subtitle}}">{{item.subtitle}}</text>
                </view>
              </view>
            </view>

            <view class="stats-section">
              <view class="stats-section__head">
                <text class="stats-section__icon">📅</text>
                <text class="stats-section__title">预约统计</text>
              </view>
              <view class="stats-cards-grid">
                <view class="stats-card" wx:for="{{statsView.bookingCardsPrimary}}" wx:key="key">
                  <view class="stats-card__icon" style="background: linear-gradient(135deg, {{item.colorStart}}, {{item.colorEnd}});">
                    <text class="stats-card__icon-text">{{item.icon}}</text>
                  </view>
                  <text class="stats-card__title">{{item.title}}</text>
                  <text class="stats-card__value">{{item.value}}</text>
                  <text class="stats-card__subtitle" wx:if="{{item.subtitle}}">{{item.subtitle}}</text>
                </view>
              </view>
              <view class="stats-cards-grid stats-cards-grid--spaced">
                <view class="stats-card" wx:for="{{statsView.bookingCardsSecondary}}" wx:key="key">
                  <view class="stats-card__icon" style="background: linear-gradient(135deg, {{item.colorStart}}, {{item.colorEnd}});">
                    <text class="stats-card__icon-text">{{item.icon}}</text>
                  </view>
                  <text class="stats-card__title">{{item.title}}</text>
                  <text class="stats-card__value">{{item.value}}</text>
                  <text class="stats-card__subtitle" wx:if="{{item.subtitle}}">{{item.subtitle}}</text>
                </view>
              </view>

              <view class="stats-extra-card" wx:if="{{statsView.bookingTypeStats.length}}">
                <text class="stats-extra-card__title">预约类型分布</text>
                <view class="stats-mini-grid">
                  <view class="stats-mini-item" wx:for="{{statsView.bookingTypeStats}}" wx:key="key">
                    <text class="stats-mini-item__name">{{item.name}}</text>
                    <text class="stats-mini-item__value">{{item.count}}</text>
                  </view>
                </view>
              </view>
            </view>

            <view class="stats-section">
              <view class="stats-section__head">
                <text class="stats-section__icon">📸</text>
                <text class="stats-section__title">摆姿统计</text>
              </view>
              <view class="stats-cards-grid">
                <view class="stats-card" wx:for="{{statsView.poseCards}}" wx:key="key">
                  <view class="stats-card__icon" style="background: linear-gradient(135deg, {{item.colorStart}}, {{item.colorEnd}});">
                    <text class="stats-card__icon-text">{{item.icon}}</text>
                  </view>
                  <text class="stats-card__title">{{item.title}}</text>
                  <text class="stats-card__value">{{item.value}}</text>
                  <text class="stats-card__subtitle" wx:if="{{item.subtitle}}">{{item.subtitle}}</text>
                </view>
              </view>

              <view class="stats-extra-card" wx:if="{{statsView.poseTopTags.length}}">
                <text class="stats-extra-card__title">热门标签 Top 10</text>
                <view class="stats-tag-grid">
                  <view class="stats-tag-item" wx:for="{{statsView.poseTopTags}}" wx:key="key">
                    <text class="stats-tag-item__rank">#{{item.rank}}</text>
                    <view class="stats-tag-item__main">
                      <text class="stats-tag-item__name">{{item.tagName}}</text>
                      <text class="stats-tag-item__count">{{item.usageCount}} 次</text>
                    </view>
                  </view>
                </view>
              </view>
            </view>

            <view class="stats-section">
              <view class="stats-section__head">
                <text class="stats-section__icon">📦</text>
                <text class="stats-section__title">系统统计</text>
              </view>
              <view class="stats-cards-grid">
                <view class="stats-card" wx:for="{{statsView.systemCards}}" wx:key="key">
                  <view class="stats-card__icon" style="background: linear-gradient(135deg, {{item.colorStart}}, {{item.colorEnd}});">
                    <text class="stats-card__icon-text">{{item.icon}}</text>
                  </view>
                  <text class="stats-card__title">{{item.title}}</text>
                  <text class="stats-card__value">{{item.value}}</text>
                  <text class="stats-card__subtitle" wx:if="{{item.subtitle}}">{{item.subtitle}}</text>
                </view>
              </view>

              <view class="stats-extra-card" wx:if="{{statsView.latestVersion}}">
                <text class="stats-extra-card__title">最新版本</text>
                <view class="stats-version-row">
                  <view class="stats-version-icon">
                    <text>📦</text>
                  </view>
                  <view class="stats-version-main">
                    <text class="stats-version-main__label">版本号</text>
                    <text class="stats-version-main__value">{{statsView.latestVersion.version}}</text>
                  </view>
                  <view class="stats-version-meta" wx:if="{{statsView.latestVersion.platform}}">
                    <text class="stats-version-meta__label">平台</text>
                    <text class="stats-version-meta__value">{{statsView.latestVersion.platform}}</text>
                  </view>
                  <view class="stats-version-meta" wx:if="{{statsView.latestVersion.createdAtText}}">
                    <text class="stats-version-meta__label">发布时间</text>
                    <text class="stats-version-meta__value">{{statsView.latestVersion.createdAtText}}</text>
                  </view>
                </view>
              </view>
            </view>

            <view class="stats-section" wx:if="{{statsView.trendNewUsers.length || statsView.trendActiveUsers.length || statsView.trendNewBookings.length}}">
              <view class="stats-section__head">
                <text class="stats-section__icon">📈</text>
                <text class="stats-section__title">最近7天趋势</text>
              </view>

              <view class="stats-trend-grid">
                <view class="stats-trend-card" wx:if="{{statsView.trendNewUsers.length}}">
                  <text class="stats-trend-card__title">新增用户</text>
                  <view class="stats-trend-row" wx:for="{{statsView.trendNewUsers}}" wx:key="key">
                    <text class="stats-trend-row__date">{{item.dateLabel}}</text>
                    <text class="stats-trend-row__value stats-trend-row__value--users">{{item.count}}</text>
                  </view>
                </view>

                <view class="stats-trend-card" wx:if="{{statsView.trendActiveUsers.length}}">
                  <text class="stats-trend-card__title">活跃用户</text>
                  <view class="stats-trend-row" wx:for="{{statsView.trendActiveUsers}}" wx:key="key">
                    <text class="stats-trend-row__date">{{item.dateLabel}}</text>
                    <text class="stats-trend-row__value stats-trend-row__value--active">{{item.count}}</text>
                  </view>
                </view>

                <view class="stats-trend-card" wx:if="{{statsView.trendNewBookings.length}}">
                  <text class="stats-trend-card__title">新增预约</text>
                  <view class="stats-trend-row" wx:for="{{statsView.trendNewBookings}}" wx:key="key">
                    <text class="stats-trend-row__date">{{item.dateLabel}}</text>
                    <text class="stats-trend-row__value stats-trend-row__value--bookings">{{item.count}}</text>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </block>

        <block wx:if="{{activeSection === 'schedule'}}">
          <view class="booking-panel schedule-panel motion-fade-up">
            <view class="booking-toolbar schedule-toolbar">
              <view class="booking-toolbar-actions booking-toolbar-actions--right" wx:if="{{!scheduleSelectionMode}}">
                <button
                  class="booking-pill-btn booking-pill-btn--ghost"
                  bindtap="onEnterScheduleSelectionMode"
                  hover-class="booking-pill-btn--ghost-active"
                  disabled="{{blockedDatesLoading || !scheduleTotalCount}}"
                >
                  批量删除
                </button>
                <button
                  class="booking-pill-btn booking-pill-btn--primary"
                  bindtap="onOpenScheduleAddModal"
                  hover-class="booking-pill-btn--primary-active"
                  disabled="{{blockedDatesLoading}}"
                >
                  + 锁定档期
                </button>
              </view>

              <view class="booking-toolbar-actions booking-toolbar-actions--selection" wx:if="{{scheduleSelectionMode}}">
                <button
                  class="booking-pill-btn booking-pill-btn--ghost booking-pill-btn--compact"
                  bindtap="onToggleScheduleSelectAll"
                  hover-class="booking-pill-btn--ghost-active"
                  disabled="{{scheduleBatchDeleting}}"
                >
                  {{scheduleAllSelected ? "取消全选" : "全选"}} ({{scheduleSelectedCount}}/{{scheduleTotalCount}})
                </button>
                <button
                  class="booking-pill-btn booking-pill-btn--danger booking-pill-btn--compact"
                  bindtap="onOpenScheduleBatchDeleteConfirm"
                  hover-class="booking-pill-btn--danger-active"
                  disabled="{{scheduleBatchDeleting || !scheduleSelectedCount}}"
                  loading="{{scheduleBatchDeleting}}"
                >
                  删除 ({{scheduleSelectedCount}})
                </button>
                <button
                  class="booking-pill-btn booking-pill-btn--ghost booking-pill-btn--compact"
                  bindtap="onCancelScheduleSelectionMode"
                  hover-class="booking-pill-btn--ghost-active"
                  disabled="{{scheduleBatchDeleting}}"
                >
                  取消
                </button>
              </view>
            </view>

            <view class="pose-loading" wx:if="{{blockedDatesLoading}}">
              <view class="pose-loading__spinner"></view>
              <text class="pose-loading__text">加载中...</text>
            </view>

            <view class="empty booking-empty-card schedule-empty-card" wx:elif="{{!scheduleRows.length}}">
              <text class="booking-empty-card__icon">📅</text>
              <text>暂无锁定档期</text>
            </view>

            <view class="schedule-cards" wx:else>
              <view
                class="schedule-card {{scheduleSelectionMode ? (item.selected ? 'schedule-card--selected' : 'schedule-card--selectable') : ''}}"
                wx:for="{{scheduleRows}}"
                wx:key="id"
                data-id="{{item.id}}"
                bindtap="onToggleScheduleSelection"
              >
                <view class="schedule-card__head">
                  <view class="schedule-card__left">
                    <view class="schedule-card__check {{item.selected ? 'schedule-card__check--active' : ''}}" wx:if="{{scheduleSelectionMode}}">
                      <text wx:if="{{item.selected}}">✓</text>
                    </view>
                    <view class="schedule-card__icon">
                      <text>📅</text>
                    </view>
                    <view class="schedule-card__date-wrap">
                      <text class="schedule-card__date">{{item.dateLabel}}</text>
                      <text class="schedule-card__weekday">{{item.weekdayLabel}}</text>
                    </view>
                  </view>
                  <button
                    wx:if="{{!scheduleSelectionMode}}"
                    class="schedule-card__delete"
                    data-id="{{item.id}}"
                    catchtap="onOpenScheduleDeleteConfirm"
                    hover-class="schedule-card__delete--active"
                    disabled="{{scheduleActionLoading}}"
                  >
                    <image class="schedule-card__delete-icon" src="/images/icons/trash-red.svg" mode="aspectFit" />
                  </button>
                </view>

                <view class="schedule-card__reason" wx:if="{{item.reason}}">
                  <text class="schedule-card__reason-text">{{item.reason}}</text>
                </view>
              </view>
            </view>
          </view>
        </block>

        <block wx:if="{{activeSection === 'bookings'}}">
          <view class="booking-tabs motion-fade-up">
            <view
              class="booking-tab-item {{bookingPanelTab === item.key ? 'booking-tab-item--active' : ''}}"
              wx:for="{{bookingPanelTabs}}"
              wx:key="key"
              data-key="{{item.key}}"
              bindtap="onSelectBookingPanelTab"
            >
              <text class="booking-tab-item__text">{{item.label}}</text>
              <view class="booking-tab-item__line" wx:if="{{bookingPanelTab === item.key}}"></view>
            </view>
          </view>

          <block wx:if="{{bookingPanelTab === 'bookings'}}">
            <view class="booking-panel motion-fade-up">
              <view class="booking-toolbar">
                <scroll-view class="booking-filter-scroll" scroll-x="true" enable-flex="true" show-scrollbar="false">
                  <view class="booking-filter-list">
                    <view
                      class="booking-filter-chip {{bookingFilter === item.key ? 'booking-filter-chip--active' : ''}}"
                      wx:for="{{bookingFilterOptions}}"
                      wx:key="key"
                      data-key="{{item.key}}"
                      bindtap="onSelectBookingFilter"
                    >
                      <text>{{item.label}}</text>
                    </view>
                  </view>
                </scroll-view>

                <view class="booking-toolbar-actions" wx:if="{{!bookingSelectionMode}}">
                  <button
                    class="pose-toolbar-btn pose-toolbar-btn--ghost"
                    bindtap="onStartBookingSelection"
                    disabled="{{bookingBatchDeleting || bookingActionLoading || bookingDeletableCount <= 0}}"
                  >
                    批量删除
                  </button>
                </view>

                <view class="booking-toolbar-actions booking-toolbar-actions--selection booking-toolbar-actions--selection-row" wx:if="{{bookingSelectionMode}}">
                  <button
                    class="pose-toolbar-btn pose-toolbar-btn--ghost"
                    bindtap="onToggleSelectAllBookings"
                    disabled="{{bookingBatchDeleting}}"
                  >
                    {{bookingAllSelected ? "取消全选" : "全选"}} ({{bookingSelectedCount}}/{{bookingPageDeletableCount}})
                  </button>
                  <button
                    class="pose-toolbar-btn pose-toolbar-btn--danger"
                    bindtap="onOpenBookingBatchDeleteConfirm"
                    disabled="{{bookingBatchDeleting || !bookingSelectedCount}}"
                    loading="{{bookingBatchDeleting}}"
                  >
                    删除选中 ({{bookingSelectedCount}})
                  </button>
                  <button
                    class="pose-toolbar-btn pose-toolbar-btn--ghost"
                    bindtap="onCancelBookingSelection"
                    disabled="{{bookingBatchDeleting}}"
                  >
                    取消
                  </button>
                </view>
              </view>

              <view class="booking-search-row">
                <view class="booking-search-box">
                  <image class="booking-search-box__icon" src="/images/icons/search-gray.svg" mode="aspectFit" />
                  <input
                    class="booking-search-box__input"
                    value="{{bookingKeyword}}"
                    bindinput="onBookingKeywordInput"
                    confirm-type="search"
                    placeholder="关键词检索：ID/用户/手机号/微信/类型/城市/地点/日期"
                    placeholder-class="booking-search-box__placeholder"
                  />
                  <view class="booking-search-box__clear" wx:if="{{bookingKeyword}}" bindtap="onClearBookingKeyword">
                    <image class="booking-search-box__clear-icon" src="/images/icons/x-gray.svg" mode="aspectFit" />
                  </view>
                </view>
                <text class="booking-search-row__meta" wx:if="{{bookingKeyword && !bookingsLoading}}">
                  匹配 {{bookingFilteredList.length}} 条
                </text>
              </view>

              <view class="pose-loading" wx:if="{{bookingsLoading}}">
                <view class="pose-loading__spinner"></view>
                <text class="pose-loading__text">加载中...</text>
              </view>

              <view class="empty booking-empty-card" wx:elif="{{!bookingFilteredList.length}}">
                <text class="booking-empty-card__icon">📅</text>
                <text>暂无预约数据</text>
              </view>

              <view class="booking-cards" wx:else>
                <view
                  class="booking-card {{bookingSelectionMode && item.isDeletable ? (item.selected ? 'booking-card--selected' : 'booking-card--selectable') : ''}}"
                  wx:for="{{bookingRows}}"
                  wx:key="id"
                  data-id="{{item.id}}"
                  bindtap="onToggleBookingSelection"
                >
                  <view class="booking-card__head">
                    <view class="booking-card__user-wrap">
                      <view class="booking-card__check {{item.selected ? 'booking-card__check--active' : ''}}" wx:if="{{bookingSelectionMode && item.isDeletable}}">
                        <text wx:if="{{item.selected}}">✓</text>
                      </view>
                      <view class="booking-card__avatar">
                        <text>👤</text>
                      </view>
                      <view class="booking-card__user">
                        <text class="booking-card__name">{{item.userDisplay}}</text>
                        <text class="booking-card__email" wx:if="{{item.userEmail}}">{{item.userEmail}}</text>
                      </view>
                    </view>
                    <view class="booking-status-chip {{item.statusClass}}">
                      <text>{{item.statusText}}</text>
                    </view>
                  </view>

                  <view class="booking-card__grid">
                    <view class="booking-info-row">
                      <text class="booking-info-row__icon">📅</text>
                      <text class="booking-info-row__text">{{item.bookingDateDisplay || "未设置日期"}}</text>
                    </view>
                    <view class="booking-info-row">
                      <text class="booking-info-row__icon">📍</text>
                      <text class="booking-info-row__text">{{item.locationDisplay}}</text>
                    </view>
                    <view class="booking-info-row">
                      <text class="booking-info-row__icon">📞</text>
                      <text class="booking-info-row__text">{{item.phoneDisplay}}</text>
                    </view>
                    <view class="booking-info-row">
                      <text class="booking-info-row__icon">💬</text>
                      <text class="booking-info-row__text">{{item.wechatDisplay}}</text>
                    </view>
                  </view>

                  <view class="booking-type-chip" wx:if="{{item.typeDisplay}}">
                    <text>{{item.typeDisplay}}</text>
                  </view>

                  <view class="booking-notes" wx:if="{{item.notesDisplay}}">
                    <text class="booking-notes__text">{{item.notesDisplay}}</text>
                  </view>

