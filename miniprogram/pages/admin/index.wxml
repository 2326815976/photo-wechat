          <view class="beta-page motion-fade-up">
            <view class="pose-header">
              <text class="pose-header__title">内测管理 🧪</text>
              <text class="pose-header__desc">管理功能内测版本与内测码</text>
            </view>

            <view class="beta-toolbar">
              <view class="beta-toolbar-actions">
                <button
                  class="beta-toolbar-btn beta-toolbar-btn--primary"
                  bindtap="onOpenCreateBetaVersion"
                  disabled="{{betaRouteSaving || betaRouteDeleting || betaVersionSaving || betaVersionDeleting}}"
                >
                  新增版本
                </button>
              </view>
            </view>

            <view class="admin-loading-card admin-loading-card--inline" wx:if="{{betaVersionsLoading}}">
                <view class="admin-loading-card__orb">
                  <view class="admin-loading-card__spinner"></view>
                </view>
                <text class="admin-loading-card__title">拾光中...</text>
                <text class="admin-loading-card__desc">正在同步最新内测版本配置，请稍候。</text>
            </view>

            <view class="empty pose-empty-card" wx:elif="{{!betaVersionRows.length}}">
                <text class="pose-empty-card__icon">🔑</text>
                <text>暂无内测版本</text>
              </view>

            <view class="beta-card-list" wx:else>
                <view class="beta-card" wx:for="{{betaVersionRows}}" wx:key="id">
                  <view class="beta-card__head">
                    <view class="beta-card__main">
                      <text class="beta-card__title">{{item.feature_name}}</text>
                      <text class="beta-card__path">{{item.route_title || '未命名页面'}} · {{item.route_path || '未配置路径'}}</text>
                    </view>
                    <view class="beta-state-badge {{item.stateClass}}">
                      <text>{{item.stateText}}</text>
                    </view>
                  </view>
                  <text class="beta-card__desc" wx:if="{{item.feature_description}}">{{item.feature_description}}</text>
                  <view class="beta-code-row">
                    <text class="beta-code">内测码：{{item.feature_code}}</text>
                    <button class="beta-mini-btn beta-mini-btn--ghost beta-code-copy-btn" data-code="{{item.feature_code}}" bindtap="onCopyBetaVersionCode">复制</button>
                  </view>
                  <text class="beta-expire" wx:if="{{item.expires_text}}">有效期至：{{item.expires_text}}</text>
                  <text class="beta-expire" wx:else>有效期：长期有效</text>
                  <view class="beta-card__actions">
                    <button
                      class="beta-mini-btn beta-mini-btn--ghost"
                      data-id="{{item.id}}"
                      bindtap="onOpenEditBetaVersion"
                      disabled="{{betaVersionSaving || betaVersionDeleting}}"
                    >
                      编辑
                    </button>
                    <button
                      class="beta-mini-btn beta-mini-btn--danger"
                      data-id="{{item.id}}"
                      bindtap="onOpenBetaVersionDeleteConfirm"
                      disabled="{{betaVersionSaving || betaVersionDeleting}}"
                    >
                      {{betaVersionDeletingId === item.id ? "删除中..." : "删除"}}
                    </button>
                  </view>
                </view>
            </view>
          </view>
        </block>

        <block wx:if="{{activeSection === 'gallery'}}">
          <gallery-manager id="galleryManager" class="motion-fade-up" />
        </block>

        <block wx:if="{{activeSection === 'miniprogramPages'}}">
          <page-center-panel channel="miniprogram" embedded="{{true}}" />
        </block>

        <block wx:if="{{activeSection === 'albums'}}">
          <view class="album-panel motion-fade-up">
            <view class="booking-toolbar album-toolbar">
              <view class="booking-toolbar-actions booking-toolbar-actions--right" wx:if="{{!albumSelectionMode}}">
                <button
                  class="booking-pill-btn booking-pill-btn--danger"
                  bindtap="onEnterAlbumSelectionMode"
                  hover-class="booking-pill-btn--danger-active"
                  disabled="{{albumsLoading || !albumTotalCount || albumActionLoading || albumBatchDeleting}}"
                >
                  批量删除
                </button>
                <button
                  class="booking-pill-btn booking-pill-btn--primary"
                  bindtap="onOpenAlbumCreateModal"
                  hover-class="booking-pill-btn--primary-active"
                  disabled="{{albumActionLoading || albumBatchDeleting || albumCreating || albumTitleSaving || albumKeySaving || albumRecipientSaving || albumExpirySaving || albumCoverUpdatingId || albumDonationUpdatingId}}"
                >
                  + 新增空间
                </button>
              </view>

              <view class="booking-toolbar-actions booking-toolbar-actions--selection album-toolbar-actions--selection-row" wx:if="{{albumSelectionMode}}">
                <button
                  class="booking-pill-btn booking-pill-btn--ghost booking-pill-btn--compact"
                  bindtap="onToggleAlbumSelectAll"
                  hover-class="booking-pill-btn--ghost-active"
                  disabled="{{albumBatchDeleting}}"
                >
                  {{albumAllSelected ? "取消全选" : "全选"}} ({{albumSelectedCount}}/{{albumTotalCount}})
                </button>
                <button
                  class="booking-pill-btn booking-pill-btn--danger booking-pill-btn--compact"
                  bindtap="onOpenAlbumBatchDeleteConfirm"
                  hover-class="booking-pill-btn--danger-active"
                  disabled="{{albumBatchDeleting || !albumSelectedCount}}"
                  loading="{{albumBatchDeleting}}"
                >
                  删除 ({{albumSelectedCount}})
                </button>
                <button
                  class="booking-pill-btn booking-pill-btn--ghost booking-pill-btn--compact"
                  bindtap="onCancelAlbumSelectionMode"
                  hover-class="booking-pill-btn--ghost-active"
                  disabled="{{albumBatchDeleting}}"
                >
                  取消
                </button>
              </view>
            </view>

            <scroll-view class="booking-filter-scroll" scroll-x="{{true}}" scroll-with-animation="{{true}}">
              <view class="booking-filter-list">
                <view
                  wx:for="{{albumFilterOptions}}"
                  wx:key="key"
                  class="booking-filter-chip {{albumFilter === item.key ? 'booking-filter-chip--active' : ''}}"
                  data-key="{{item.key}}"
                  bindtap="onAlbumFilterChange"
                >
                  <text>{{item.label}}</text>
                </view>
              </view>
            </scroll-view>

            <view class="booking-search-row album-search-row">
              <view class="booking-search-box">
                <image class="booking-search-box__icon" src="/images/icons/search-gray.svg" mode="aspectFit" />
                <input
                  class="booking-search-box__input"
                  value="{{albumKeyword}}"
                  bindinput="onAlbumKeywordInput"
                  confirm-type="search"
                  placeholder="搜索空间名称 / 收件人 / 访问密钥 / 欢迎信"
                  placeholder-class="booking-search-box__placeholder"
                />
                <view class="booking-search-box__clear" wx:if="{{albumKeyword}}" bindtap="onClearAlbumKeyword">
                  <image class="booking-search-box__clear-icon" src="/images/icons/x-gray.svg" mode="aspectFit" />
                </view>
              </view>
              <text class="booking-search-row__meta" wx:if="{{(albumKeyword || albumFilter !== 'all') && !albumsLoading}}">
                匹配 {{albumRows.length}} 个空间</text>
            </view>

            <view class="admin-loading-card admin-loading-card--inline" wx:if="{{albumsLoading}}">
              <view class="admin-loading-card__orb">
                <view class="admin-loading-card__spinner"></view>
              </view>
              <text class="admin-loading-card__title">拾光中...</text>
              <text class="admin-loading-card__desc">正在同步空间列表与基础配置，请稍候。</text>
            </view>

            <view class="empty booking-empty-card album-empty-card" wx:elif="{{!albumRows.length}}">
              <text class="booking-empty-card__icon">💝</text>
              <text>{{albums.length ? '当前筛选下暂无专属空间' : '暂无专属空间'}}</text>
            </view>

            <view class="album-grid" wx:else>
              <view
                class="album-card motion-fade-up {{albumSelectionMode ? (item.selected ? 'album-card--selected' : 'album-card--selectable') : ''}}"
                wx:for="{{albumRows}}"
                wx:key="id"
                style="animation-delay: {{180 + (index % 8) * 35}}ms;"
                data-id="{{item.id}}"
                bindtap="onToggleAlbumSelection"
              >
                <view class="album-card__cover-wrap">
                  <view class="album-card__check {{item.selected ? 'album-card__check--active' : ''}}" wx:if="{{albumSelectionMode}}">
                    <text wx:if="{{item.selected}}">✓</text>
                  </view>
                  <image class="album-card__cover" src="{{item.coverResolved}}" mode="aspectFill" wx:if="{{item.hasCover}}" />
                  <view class="album-card__cover-empty" wx:else>
                    <text class="album-card__cover-empty-icon">🖼️</text>
                    <text class="album-card__cover-empty-text">暂无封面</text>
                  </view>
                  <button
                    wx:if="{{!albumSelectionMode}}"
                    class="album-card__cover-btn"
                    data-id="{{item.id}}"
                    bindtap="onOpenAlbumCoverModal"
                    hover-class="album-card__cover-btn--active"
                    loading="{{albumCoverUpdatingId === item.id}}"
                    disabled="{{albumActionLoading || albumCoverUpdatingId === item.id || albumDonationUpdatingId === item.id || albumTitleSaving || albumKeySaving || albumRecipientSaving || albumExpirySaving}}"
                  >
                    {{item.hasCover ? "更换封面" : "添加封面"}}
                  </button>
                </view>

                <view class="album-card__body">
                  <view class="album-card__title-row">
                    <view class="album-card__title-wrap">
                      <view class="album-card__title-line">
                        <text class="album-card__title">{{item.title}}</text>
                      </view>
                      <view class="album-card__meta-row">
                        <text class="album-card__meta">{{item.createdDateText}}</text>
                      </view>
                    </view>

                    <view class="album-card__head-actions" wx:if="{{item.expiresAtText || !albumSelectionMode}}">
                      <view
                        wx:if="{{item.expiresAtText}}"
                        class="album-card__expiry-badge {{item.expired ? 'album-card__expiry-badge--expired' : (item.expirySoon ? 'album-card__expiry-badge--soon' : 'album-card__expiry-badge--normal')}}"
                      >
                        <text>到期 {{item.expiresDateText}}</text>
                        <text wx:if="{{item.daysRemaining !== null}}"> · {{item.daysRemaining > 0 ? item.daysRemaining : 0}}天</text>
                      </view>

                      <view class="album-card__quick-actions" wx:if="{{!albumSelectionMode}}">
                        <button
                          class="album-mini-btn album-mini-btn--edit"
                          data-id="{{item.id}}"
                          bindtap="onOpenAlbumTitleModal"
                          hover-class="album-mini-btn--active"
                          disabled="{{albumActionLoading || albumTitleSaving || albumKeySaving || albumRecipientSaving || albumExpirySaving || albumCoverUpdatingId === item.id || albumDonationUpdatingId === item.id}}"
                        >
                          <text>✎</text>
                        </button>
                        <button
                          class="album-mini-btn album-mini-btn--danger"
                          data-id="{{item.id}}"
                          bindtap="onOpenAlbumDeleteConfirm"
                          hover-class="album-mini-btn--active"
                          disabled="{{albumActionLoading || albumTitleSaving || albumKeySaving || albumRecipientSaving || albumExpirySaving || albumCoverUpdatingId === item.id || albumDonationUpdatingId === item.id}}"
                        >
                          <image class="album-mini-btn__icon" src="/images/icons/trash-red.svg" mode="aspectFit" />
                        </button>
                      </view>
                    </view>
                  </view>

                  <view class="album-access-card">
                    <view class="album-access-card__main">
                      <text class="album-access-card__label">访问密钥</text>
                      <view class="album-access-card__content">
                        <text class="album-access-card__key">{{item.access_key}}</text>
                        <view class="album-access-card__actions" wx:if="{{!albumSelectionMode}}">
                          <button
                            class="album-icon-btn"
                            data-key="{{item.access_key}}"
                            bindtap="onCopyAlbumAccessKey"
                            hover-class="album-icon-btn--active"
                            disabled="{{albumActionLoading || albumKeySaving}}"
                          >
                            <image class="album-icon-btn__icon" src="/images/icons/clipboard-brown.svg" mode="aspectFit" />
                          </button>
                          <button
                            class="album-icon-btn"
                            data-id="{{item.id}}"
                            bindtap="onOpenAlbumKeyModal"
                            hover-class="album-icon-btn--active"
                            disabled="{{albumActionLoading || albumKeySaving || albumTitleSaving}}"
                          >
                            <image class="album-icon-btn__icon" src="/images/icons/lock-yellow.svg" mode="aspectFit" />
                          </button>
                        </view>
                      </view>
                    </view>
                  </view>

                  <view class="album-recipient-card">
                    <view class="album-recipient-card__head">
                      <view class="album-recipient-card__main">
                        <text class="album-recipient-card__label">收件人</text>
                        <text class="album-recipient-card__name">{{item.recipient_name || "拾光者"}}</text>
                      </view>
                      <button
                        wx:if="{{!albumSelectionMode}}"
                        class="album-recipient-card__edit-btn"
                        data-id="{{item.id}}"
                        bindtap="onOpenAlbumRecipientModal"
                        hover-class="album-recipient-card__edit-btn--active"
                        disabled="{{albumActionLoading || albumRecipientSaving || albumTitleSaving || albumKeySaving}}"
                      >
                        <image class="album-recipient-card__edit-icon" src="/images/icons/message-square-brown.svg" mode="aspectFit" />
                        <text class="album-recipient-card__edit-text">编辑文案</text>
                      </button>
                    </view>
                    <text class="album-recipient-card__welcome">{{item.welcome_letter || "未设置欢迎信内容"}}</text>
                    <text class="album-create-plain-tip">欢迎方式：{{item.welcome_letter_mode_label || "拆信封欢迎信"}}</text>
                  </view>

                  <view class="album-toggle-grid" wx:if="{{!albumSelectionMode}}">
                    <button
                      class="album-toggle-btn {{item.enable_freeze ? 'album-toggle-btn--freeze-on' : 'album-toggle-btn--off'}}"
                      data-id="{{item.id}}"
                      bindtap="onToggleAlbumFreeze"
                      hover-class="album-toggle-btn--active"
                      disabled="{{albumActionLoading || albumTitleSaving || albumKeySaving || albumRecipientSaving || albumExpirySaving || albumCoverUpdatingId === item.id || albumDonationUpdatingId === item.id}}"
                    >
                      <image class="album-toggle-btn__icon" src="/images/icons/sparkles-brown.svg" mode="aspectFit" />
                      <text class="album-toggle-btn__text">定格 {{item.enable_freeze ? "开启" : "关闭"}}</text>
                    </button>

                    <button
                      class="album-toggle-btn {{item.enable_tipping ? 'album-toggle-btn--tipping-on' : 'album-toggle-btn--off'}}"
                      data-id="{{item.id}}"
                      bindtap="onToggleAlbumTipping"
                      hover-class="album-toggle-btn--active"
                      disabled="{{albumActionLoading || albumTitleSaving || albumKeySaving || albumRecipientSaving || albumExpirySaving || albumCoverUpdatingId === item.id || albumDonationUpdatingId === item.id}}"
                    >
                      <image class="album-toggle-btn__icon" src="/images/icons/heart-orange.svg" mode="aspectFit" />
                      <text class="album-toggle-btn__text">打赏 {{item.enable_tipping ? "开启" : "关闭"}}</text>
                    </button>
                  </view>

                  <view class="album-donation-card" wx:if="{{!albumSelectionMode}}">
                    <view class="album-donation-card__main">
                      <text class="album-donation-card__label">赞赏码</text>
                      <text class="album-donation-card__desc">{{!item.enable_tipping ? "打赏关闭，暂不可上传" : (item.hasDonationQr ? "已上传，可随时更换" : "未上传")}}</text>
                    </view>
                    <button
                      class="album-donation-card__btn {{!item.enable_tipping ? 'album-donation-card__btn--disabled' : ''}}"
                      data-id="{{item.id}}"
                      bindtap="onOpenAlbumDonationModal"
                      hover-class="album-donation-card__btn--active"
                      loading="{{albumDonationUpdatingId === item.id}}"
                      disabled="{{!item.enable_tipping || albumActionLoading || albumDonationUpdatingId === item.id || albumCoverUpdatingId === item.id || albumTitleSaving || albumKeySaving || albumRecipientSaving || albumExpirySaving}}"
                    >
                      {{item.hasDonationQr ? "更换" : "上传"}}
                    </button>
                  </view>

                  <view class="album-action-grid" wx:if="{{!albumSelectionMode}}">
                    <button
                      class="album-action-btn album-action-btn--primary"
                      data-id="{{item.id}}"
                      data-title="{{item.title}}"
                      data-key="{{item.access_key}}"
                      bindtap="onViewAlbumDetail"
                      hover-class="album-action-btn--active"
                      disabled="{{albumActionLoading}}"
                    >
                      <image class="album-action-btn__icon" src="/images/icons/eye-brown.svg" mode="aspectFit" />
                      <text class="album-action-btn__text">查看详细</text>
                    </button>

                    <button
                      class="album-action-btn album-action-btn--ghost"
                      data-id="{{item.id}}"
                      bindtap="onOpenAlbumExpiryModal"
                      hover-class="album-action-btn--active"
                      disabled="{{albumActionLoading || albumExpirySaving}}"
                    >
                      <image class="album-action-btn__icon" src="/images/icons/calendar-brown.svg" mode="aspectFit" />
                      <text class="album-action-btn__text">改有效期</text>
                    </button>

                    <button
                      class="album-action-btn album-action-btn--ghost"
                      data-key="{{item.access_key}}"
                      bindtap="onCopyAlbumLink"
                      hover-class="album-action-btn--active"
                      disabled="{{albumActionLoading}}"
                    >
                      <image class="album-action-btn__icon" src="/images/icons/share.svg" mode="aspectFit" />
                      <text class="album-action-btn__text">复制链接</text>
                    </button>

                    <button
                      class="album-action-btn album-action-btn--qr"
                      data-key="{{item.access_key}}"
                      bindtap="onOpenAlbumQrModal"
                      hover-class="album-action-btn--active"
                      disabled="{{albumActionLoading}}"
                    >
                      <image class="album-action-btn__icon" src="/images/icons/square-brown.svg" mode="aspectFit" />
                      <text class="album-action-btn__text">二维码</text>
                    </button>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </block>

        <block wx:if="{{activeSection === 'releases'}}">
          <view class="release-page motion-fade-up">
            <view class="release-header">
              <view class="release-header__main">
                <text class="release-header__title">{{activeSectionTitle}}</text>
                <text class="release-header__desc">{{activeSectionDesc}}</text>
              </view>
              <button
                class="release-primary-btn"
                bindtap="onOpenReleaseCreate"
                disabled="{{releaseCreating || releaseDeletingId}}"
              >
                <image class="release-primary-btn__icon" src="/images/icons/plus-brown.svg" mode="aspectFit" />
                <text class="release-primary-btn__text">发布版本</text>
              </button>
            </view>

            <view class="admin-loading-card admin-loading-card--inline" wx:if="{{releasesLoading}}">
              <view class="admin-loading-card__orb">
                <view class="admin-loading-card__spinner"></view>
              </view>
              <text class="admin-loading-card__title">拾光中...</text>
              <text class="admin-loading-card__desc">正在同步已发布版本与更新说明，请稍候。</text>
            </view>

            <view class="release-empty" wx:elif="{{!releases.length}}">
              <text class="release-empty__icon">📦</text>
              <text class="release-empty__text">暂无发布版本</text>
            </view>

            <view class="release-list" wx:else>
              <view
                class="release-card motion-fade-up"
                wx:for="{{releases}}"
                wx:key="id"
                style="animation-delay: {{140 + (index % 8) * 35}}ms;"
              >
                <view class="release-card__head">
                  <view class="release-card__meta">
                    <view class="release-card__icon">
                      <image class="release-card__icon-img" src="/images/icons/phone-brown.svg" mode="aspectFit" />
                    </view>
                    <view class="release-card__title-wrap">
                      <view class="release-card__title-row">
                        <text class="release-card__title">版本 {{item.version}}</text>
                        <text class="release-chip release-chip--platform {{item.platformClass}}">{{item.platform}}</text>
                        <text class="release-chip release-chip--force" wx:if="{{item.forceUpdate}}">🔒 强制更新</text>
                      </view>
                      <text class="release-card__date">发布于{{item.createdAtDisplay}}</text>
                    </view>
                  </view>
                  <button
                    class="release-icon-btn release-icon-btn--danger"
                    data-id="{{item.id}}"
                    bindtap="onOpenReleaseDeleteModal"
                    disabled="{{releaseDeletingId}}"
                  >
                    <image class="release-icon-btn__img" src="/images/icons/trash-red.svg" mode="aspectFit" />
                  </button>
                </view>

                <view class="release-log" wx:if="{{item.updateLog}}">
                  <text class="release-log__text">{{item.updateLog}}</text>
                </view>

                <button
                  class="release-primary-btn release-primary-btn--full"
                  data-id="{{item.id}}"
                  bindtap="onCopyReleaseDownload"
                >
                  <image class="release-primary-btn__icon" src="/images/icons/download-brown.svg" mode="aspectFit" />
                  <text class="release-primary-btn__text">下载安装包</text>
                </button>
              </view>
            </view>

          </view>
      </block>
      </view>
    </view>
  </scroll-view>

  <view
    class="release-modal-mask motion-fade-in"
    wx:if="{{activeSection === 'releases' && releaseDeleteModalOpen}}"
    bindtap="onCloseReleaseDeleteModal"
  >
    <view class="release-modal motion-pop-in" catchtap="onReleaseModalTap">
      <view class="release-modal__icon">
        <image class="release-modal__icon-img" src="/images/icons/trash-red.svg" mode="aspectFit" />
      </view>
      <text class="release-modal__title">删除版本</text>
      <text class="release-modal__desc">
        确定要删除版本号<text class="release-modal__highlight">{{releaseDeleteTargetVersion}}</text> ({{releaseDeleteTargetPlatform}}) 吗？
      </text>
      <view class="release-modal__actions">
        <button
          class="release-ghost-btn"
          bindtap="onCloseReleaseDeleteModal"
          disabled="{{releaseDeletingId}}"
        >
          取消
        </button>
        <button
          class="release-danger-btn"
          bindtap="onConfirmDeleteRelease"
          disabled="{{releaseDeletingId}}"
        >
          {{releaseDeletingId ? "删除中..." : "确认删除"}}
        </button>
      </view>
    </view>
  </view>

  <view class="booking-modal-mask" wx:if="{{activeSection === 'releases' && releaseMode === 'create'}}" bindtap="onBackReleaseList">
    <view class="booking-modal booking-modal--form album-modal album-create-modal release-create-modal motion-pop-in" catchtap="onReleaseModalTap">
      <view class="booking-modal__head">
        <text class="booking-modal__title">发布版本 📦</text>
        <view class="booking-modal__close" bindtap="onBackReleaseList">
          <text>✕</text>
        </view>
      </view>
      <view class="booking-modal__body album-create-modal__body release-create-modal__body">
        <view class="album-create-section">
          <text class="album-create-section__title">基础信息</text>
          <view class="booking-modal__field">
            <text class="booking-modal__label">
              版本号 <text class="booking-modal__required">*</text>
            </text>
            <input
              class="booking-modal__input"
              value="{{releaseVersion}}"
              placeholder="例如：1.0.0"
              placeholder-class="booking-modal__placeholder"
              bindinput="onReleaseVersionInput"
            />
          </view>

          <view class="booking-modal__field">
            <text class="booking-modal__label">
              平台 <text class="booking-modal__required">*</text>
            </text>
            <picker
              mode="selector"
              range="{{releasePlatformOptions}}"
              value="{{releasePlatformIndex}}"
              bindchange="onReleasePlatformChange"
            >
              <view class="booking-city-picker release-create-select">
                <view class="booking-city-picker__main">
                  <text class="booking-city-picker__value">{{releasePlatformOptions[releasePlatformIndex]}}</text>
                </view>
                <image class="release-create-select__chevron" src="/images/icons/chevron-down-brown.svg" mode="aspectFit" />
              </view>
            </picker>
          </view>
          <text class="album-create-section__tip">版本号建议使用 x.y.z 形式，平台会决定这次发布对应的客户端。</text>
        </view>

        <view class="album-create-section">
          <text class="album-create-section__title">更新日志</text>
          <view class="album-create-plain-tip">填写本次发布的主要更新点，用户更新时会看到这段说明。</view>
          <view class="booking-modal__field">
            <textarea
              class="booking-modal__textarea release-create-textarea"
              value="{{releaseUpdateLog}}"
              placeholder="描述本次更新的内容..."
              placeholder-class="booking-modal__placeholder"
              maxlength="1000"
              bindinput="onReleaseUpdateLogInput"
            />
          </view>
        </view>

        <view class="album-create-section album-create-section--soft">
          <view class="switch-row">
            <view class="switch-row__main">
