              <view class="pose-loading" wx:if="{{bookingTypesLoading}}">
                <view class="pose-loading__spinner"></view>
                <text class="pose-loading__text">加载中...</text>
              </view>

              <view class="empty booking-empty-card" wx:elif="{{!bookingTypes.length}}">
