                </button>
                <button
                  class="booking-pill-btn booking-pill-btn--primary"
                  bindtap="onOpenBookingTypeCreateModal"
                  hover-class="booking-pill-btn--primary-active"
                  disabled="{{bookingTypeSaving || bookingTypeDeletingId !== 0 || bookingTypeTogglingId !== 0 || bookingTypeBatchDeleting}}"
