                    <image class="gallery-card__delete-icon" src="/images/icons/trash-red.svg" mode="aspectFit" />
                  </button>
                </view>

                <view class="gallery-card__meta">
                  <view class="gallery-card__stats">
                    <view class="gallery-card__stat">
                      <text class="gallery-card__stat-icon">❤</text>
                      <text>{{item.likeCount}}</text>
                    </view>
                    <view class="gallery-card__stat">
                      <text class="gallery-card__stat-icon">👁</text>
                      <text>{{item.viewCount}}</text>
                    </view>
                    <view class="gallery-visibility {{item.visibilityClass}}">
                      <text>{{item.visibilityText}}</text>
                    </view>
                  </view>
                  <text class="gallery-card__date">{{item.createdDateText}}</text>
                </view>
              </view>
            </view>

            <view class="gallery-pagination">
