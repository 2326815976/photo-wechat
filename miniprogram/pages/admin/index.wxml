              placeholder-class="booking-modal__placeholder"
            />
            <text class="album-expiry-tip">预计到期：{{albumCreateExpiryDate}} 23:59:59</text>
          </view>

          <picker
            wx:else
            mode="date"
            value="{{albumCreateExpiryDate}}"
            start="{{todayDateText}}"
            bindchange="onAlbumCreateExpiryDateChange"
          >
            <view class="schedule-modal-picker">{{albumCreateExpiryDate}}</view>
          </picker>
        </view>

        <view class="album-create-section">
          <view class="switch-row">
            <view class="switch-row__main">
              <text class="switch-row__title">打赏功能</text>
              <text class="switch-row__desc">开启后可上传赞赏码</text>
            </view>
            <switch
              checked="{{albumCreateEnableTipping}}"
              bindchange="onAlbumCreateEnableTippingChange"
              color="#FFC857"
            />
          </view>

          <view class="booking-modal__field">
            <text class="booking-modal__label">封面图片</text>
            <view class="album-create-cover-upload" wx:if="{{!albumCreateCoverPreview}}">
              <button
                class="album-create-upload-btn"
                catchtap="onChooseAlbumCreateCover"
                hover-class="album-create-upload-btn--active"
                disabled="{{albumCreating}}"
              >
                <image class="album-create-upload-icon" src="/images/icons/plus-brown.svg" mode="aspectFit" />
                <text>点击上传封面（可选）</text>
              </button>
              <text class="album-create-upload-hint">建议 16:9 横图，用于空间列表展示</text>
            </view>
            <view class="album-create-cover-preview" wx:else>
              <image class="album-create-cover-image" src="{{albumCreateCoverPreview}}" mode="aspectFill" />
              <view class="album-create-cover-remove" bindtap="onRemoveAlbumCreateCover">
                <image class="album-create-remove-icon" src="/images/icons/x-white.svg" mode="aspectFit" />
              </view>
            </view>
          </view>

          <view class="booking-modal__field" wx:if="{{albumCreateEnableTipping}}">
            <text class="booking-modal__label">赞赏码（可选）</text>
            <view class="album-create-qr-upload" wx:if="{{!albumCreateDonationQrPreview}}">
              <button
                class="album-create-upload-btn album-create-upload-btn--small"
                catchtap="onChooseAlbumCreateDonationQr"
                hover-class="album-create-upload-btn--active"
                disabled="{{albumCreating}}"
              >
                <image class="album-create-upload-icon" src="/images/icons/heart-orange.svg" mode="aspectFit" />
                <text>上传赞赏码</text>
              </button>
            </view>
            <view class="album-create-qr-preview" wx:else>
              <image class="album-create-qr-image" src="{{albumCreateDonationQrPreview}}" mode="aspectFit" />
              <view class="album-create-qr-remove" bindtap="onRemoveAlbumCreateDonationQr">
                <image class="album-create-remove-icon" src="/images/icons/x-white.svg" mode="aspectFit" />
              </view>
            </view>
          </view>
        </view>

      </view>
      <button
        class="booking-modal__submit album-create-modal__submit"
        bindtap="onSubmitCreateAlbum"
        hover-class="booking-modal__submit--active"
        loading="{{albumCreating}}"
        disabled="{{albumCreating}}"
      >
        {{albumCreating ? "创建中..." : "创建空间"}}
      </button>
    </view>
  </view>

