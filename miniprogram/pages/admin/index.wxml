                  bindchange="onAlbumCreateAutoKeyChange"
                  color="#FFC857"
                />
              </view>
            </view>

            <view class="album-create-key-card__hint" wx:if="{{albumCreateAutoKey}}">
              <text>系统会在创建时生成 8 位密钥</text>
            </view>

            <view class="album-create-key-card__input-row" wx:else>
              <input
                class="booking-modal__input album-key-input"
                value="{{albumCreateAccessKey}}"
                data-field="access_key"
                bindinput="onAlbumCreateInput"
                placeholder="输入 8 位密钥"
                placeholder-class="booking-modal__placeholder"
                maxlength="8"
              />
              <button
                class="album-generate-key-btn"
                bindtap="onGenerateAlbumCreateKey"
                hover-class="album-generate-key-btn--active"
                disabled="{{albumCreating}}"
              >
                生成
              </button>
            </view>
          </view>
        </view>

