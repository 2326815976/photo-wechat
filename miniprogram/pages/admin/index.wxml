                    class="booking-pill-btn booking-pill-btn--danger booking-pill-btn--compact"
                    bindtap="onBatchDeleteBookingTypes"
                    hover-class="booking-pill-btn--danger-active"
                    disabled="{{bookingTypeBatchDeleting || !bookingTypeSelectedCount}}"
                    loading="{{bookingTypeBatchDeleting}}"
                  >
                    删除选中 ({{bookingTypeSelectedCount}})
                  </button>
                  <button
                    class="booking-pill-btn booking-pill-btn--ghost booking-pill-btn--compact"
                    bindtap="onCancelBookingTypeSelectionMode"
                    hover-class="booking-pill-btn--ghost-active"
                    disabled="{{bookingTypeBatchDeleting}}"
                  >
                    取消
                  </button>
                </view>
              </view>

              <view class="admin-loading-card admin-loading-card--inline" wx:if="{{bookingTypesLoading}}">
                <view class="admin-loading-card__orb">
                  <view class="admin-loading-card__spinner"></view>
                </view>
                <text class="admin-loading-card__title">拾光中...</text>
                <text class="admin-loading-card__desc">正在同步预约类型配置，请稍候。</text>
              </view>

              <view class="empty booking-empty-card" wx:elif="{{!bookingTypes.length}}">
                <text class="booking-empty-card__icon">📷</text>
                <text>暂无约拍类型</text>
              </view>

              <view class="booking-config-grid" wx:else>
                <view class="booking-config-card {{bookingTypeSelectionMode ? (item.selected ? 'booking-config-card--selected' : 'booking-config-card--selectable') : ''}}" wx:for="{{bookingTypes}}" wx:key="id" data-id="{{item.id}}" bindtap="onToggleBookingTypeSelection">
                  <view class="booking-config-card__head">
                    <view class="booking-config-card__main">
                      <view class="booking-config-card__title-row">
                        <view class="booking-config-card__check {{item.selected ? 'booking-config-card__check--active' : ''}}" wx:if="{{bookingTypeSelectionMode}}">
                          <text wx:if="{{item.selected}}">✓</text>
                        </view>
                        <text class="booking-config-card__title">{{item.name}}</text>
                      </view>
                      <text class="booking-config-card__desc" wx:if="{{item.description}}">{{item.description}}</text>
                    </view>
                    <view class="booking-config-state {{item.is_active ? 'booking-config-state--active' : 'booking-config-state--inactive'}}">
                      <text>{{item.activeText}}</text>
                    </view>
