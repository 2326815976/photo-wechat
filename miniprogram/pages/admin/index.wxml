        <view class="album-modal__actions">
          <button class="booking-confirm-modal__btn booking-confirm-modal__btn--ghost" bindtap="onCloseAlbumKeyModal" disabled="{{albumKeySaving}}">
            取消
          </button>
          <button
            class="booking-confirm-modal__btn album-modal__btn--primary"
            bindtap="onSubmitAlbumKey"
            loading="{{albumKeySaving}}"
            disabled="{{albumKeySaving}}"
          >
            {{albumKeySaving ? "保存中..." : "确认修改"}}
          </button>
        </view>
      </view>
    </view>
