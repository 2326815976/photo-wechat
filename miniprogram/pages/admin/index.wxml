                <view class="pose-loading__spinner"></view>
                <text class="pose-loading__text">加载中...</text>
              </view>

              <view class="empty pose-empty-card" wx:elif="{{!poseFilteredList.length}}">
                <text class="pose-empty-card__icon">📷</text>
