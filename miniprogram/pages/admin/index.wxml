              <button class="album-expiry-quick-btn {{albumExpiryDays === 7 ? 'album-expiry-quick-btn--active' : ''}}" data-days="7" bindtap="onAlbumExpiryQuickSelect" hover-class="album-expiry-quick-btn--press" disabled="{{albumExpirySaving}}">7天</button>
              <button class="album-expiry-quick-btn {{albumExpiryDays === 30 ? 'album-expiry-quick-btn--active' : ''}}" data-days="30" bindtap="onAlbumExpiryQuickSelect" hover-class="album-expiry-quick-btn--press" disabled="{{albumExpirySaving}}">30天</button>
              <button class="album-expiry-quick-btn {{albumExpiryDays === 90 ? 'album-expiry-quick-btn--active' : ''}}" data-days="90" bindtap="onAlbumExpiryQuickSelect" hover-class="album-expiry-quick-btn--press" disabled="{{albumExpirySaving}}">90天</button>
