                <text class="pose-loading__text">加载中...</text>
              </view>

              <view class="empty pose-empty-card" wx:elif="{{!poseTagStats.length}}">
                <text class="pose-empty-card__icon">🏷️</text>
                <text>暂无标签数据</text>
              </view>

              <view class="pose-tags-grid" wx:else>
                <view
                  class="pose-tag-card {{poseTagSelectionMode && item.selectedTag ? 'pose-tag-card--selected' : ''}}"
                  wx:for="{{poseTagStats}}"
                  wx:key="id"
                  data-id="{{item.id}}"
