  <view class="booking-modal-mask" wx:if="{{activeSection === 'albums' && albumExpiryModalOpen}}" bindtap="onCloseAlbumExpiryModal">
    <view class="booking-modal booking-modal--form album-modal album-expiry-modal" catchtap="onPoseModalTap">
      <view class="booking-modal__head">
        <text class="booking-modal__title">修改有效期</text>
        <view class="booking-modal__close" bindtap="onCloseAlbumExpiryModal">
          <text>✕</text>
        </view>
      </view>
      <view class="booking-modal__body">
        <text class="album-modal__subtitle">空间：{{albumEditingExpiryTitle}}</text>
        <view class="booking-modal__field">
          <text class="booking-modal__label">有效期模式</text>
          <view class="album-expiry-mode-row">
            <button
              class="album-expiry-mode-btn {{albumExpiryMode === 'days' ? 'album-expiry-mode-btn--active' : ''}}"
              data-mode="days"
              bindtap="onAlbumExpiryModeChange"
              hover-class="album-expiry-mode-btn--press"
              disabled="{{albumExpirySaving}}"
            >
              按天数
            </button>
            <button
              class="album-expiry-mode-btn {{albumExpiryMode === 'date' ? 'album-expiry-mode-btn--active' : ''}}"
              data-mode="date"
              bindtap="onAlbumExpiryModeChange"
              hover-class="album-expiry-mode-btn--press"
              disabled="{{albumExpirySaving}}"
            >
              指定日期
            </button>
          </view>

          <view wx:if="{{albumExpiryMode === 'days'}}">
            <view class="album-expiry-quick-row">
              <button class="album-expiry-quick-btn {{albumExpiryDays === 7 ? 'album-expiry-quick-btn--active' : ''}}" data-days="7" bindtap="onAlbumExpiryQuickSelect" hover-class="album-expiry-quick-btn--press" disabled="{{albumExpirySaving}}">7天</button>
              <button class="album-expiry-quick-btn {{albumExpiryDays === 30 ? 'album-expiry-quick-btn--active' : ''}}" data-days="30" bindtap="onAlbumExpiryQuickSelect" hover-class="album-expiry-quick-btn--press" disabled="{{albumExpirySaving}}">30天</button>
              <button class="album-expiry-quick-btn {{albumExpiryDays === 90 ? 'album-expiry-quick-btn--active' : ''}}" data-days="90" bindtap="onAlbumExpiryQuickSelect" hover-class="album-expiry-quick-btn--press" disabled="{{albumExpirySaving}}">90天</button>
              <button class="album-expiry-quick-btn {{albumExpiryDays === 180 ? 'album-expiry-quick-btn--active' : ''}}" data-days="180" bindtap="onAlbumExpiryQuickSelect" hover-class="album-expiry-quick-btn--press" disabled="{{albumExpirySaving}}">180天</button>
            </view>
            <input
              class="booking-modal__input"
              type="number"
              value="{{albumExpiryDays}}"
              bindinput="onAlbumExpiryDaysInput"
              placeholder="请输入有效天数"
              placeholder-class="booking-modal__placeholder"
            />
            <text class="album-expiry-tip">新的过期时间：{{albumExpiryDate}} 23:59:59</text>
          </view>

          <picker
            wx:else
            mode="date"
            value="{{albumExpiryDate}}"
            start="{{todayDateText}}"
            bindchange="onAlbumExpiryDateChange"
          >
            <view class="schedule-modal-picker">{{albumExpiryDate}}</view>
          </picker>
        </view>

        <view class="album-modal__actions">
          <button class="booking-confirm-modal__btn booking-confirm-modal__btn--ghost" bindtap="onCloseAlbumExpiryModal" disabled="{{albumExpirySaving}}">
            取消
          </button>
          <button
            class="booking-confirm-modal__btn album-modal__btn--primary"
            bindtap="onSubmitAlbumExpiry"
            loading="{{albumExpirySaving}}"
            disabled="{{albumExpirySaving}}"
          >
            {{albumExpirySaving ? "保存中..." : "确认修改"}}
          </button>
        </view>
      </view>
    </view>
  </view>

  <view class="booking-modal-mask" wx:if="{{activeSection === 'albums' && albumCoverModalOpen}}" bindtap="onCloseAlbumCoverModal">
