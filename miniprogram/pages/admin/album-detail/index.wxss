  padding: 12rpx;
  background: rgba(251, 146, 60, 0.14);
}

.warning-box--danger {
  background: rgba(239, 68, 68, 0.14);
}

.warning-box__text {
  font-size: 20rpx;
  color: #c2410c;
}

.warning-box__text--danger {
  color: #b91c1c;
}

.text-strong {
  font-weight: 700;
}

.text-danger {
  color: #b91c1c;
}

.preview-container {
  width: 100%;
  max-width: 700rpx;
  background: #fffbf0;
  border-radius: 24rpx;
  border: 2rpx solid rgba(93, 64, 55, 0.1);
  overflow: hidden;
  position: relative;
}

.preview-tape {
  position: absolute;
  top: -10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 140rpx;
  height: 34rpx;
  border-radius: 8rpx;
  background: rgba(255, 200, 87, 0.4);
}

.preview-close {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 999rpx;
  background: rgba(93, 64, 55, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 5;
}

.preview-close__icon {
  width: 18rpx;
  height: 18rpx;
}

.preview-image-wrap {
  padding: 14rpx;
}

.preview-image {
  width: 100%;
  max-height: 68vh;
  background: #ffffff;
  border-radius: 14rpx;
}

.preview-info {
  border-top: 2rpx dashed rgba(93, 64, 55, 0.12);
  padding: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.preview-info__icon {
  width: 16rpx;
  height: 16rpx;
}

.preview-info__text {
  font-size: 19rpx;
  color: #5d4037;
}

.toast {
  position: fixed;
  right: 20rpx;
  bottom: 110rpx;
  z-index: 1300;
  border-radius: 999rpx;
  padding: 12rpx 16rpx;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
}

.toast--success {
  background: rgba(34, 197, 94, 0.94);
}

.toast--warning {
  background: rgba(249, 115, 22, 0.94);
}

.toast--error {
  background: rgba(239, 68, 68, 0.94);
}

.toast__icon {
  font-size: 20rpx;
  font-weight: 700;
}

.toast__text {
  font-size: 19rpx;
  max-width: 420rpx;
}
