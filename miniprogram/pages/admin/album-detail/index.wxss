.selected-list__item {
  display: block;
  font-size: 18rpx;
  color: rgba(93, 64, 55, 0.62);
  padding: 4rpx 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.upload-progress {
  margin-top: 12rpx;
  padding: 10rpx 12rpx;
  border-radius: 12rpx;
  background: #fffbf0;
}

.upload-progress__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 19rpx;
  color: #5d4037;
}

.upload-progress__bar {
  margin-top: 8rpx;
  width: 100%;
  height: 10rpx;
  border-radius: 999rpx;
  background: #ffffff;
