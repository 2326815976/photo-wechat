<view class="page {{pageIsStandalone ? 'page--preview' : ''}}">
  <app-header
  managedPageKey="profile"
    title="{{showAuditAboutMode ? '鍏充簬鎴? : '鎴戠殑灏忓ぉ鍦?}}"
    subtitle="{{showAuditAboutMode ? '鉁?浣滆€呯殑澶╁湴 鉁? : '馃搾 绠＄悊浣犵殑鎷惧厜灏忕瀵?馃搾'}}"
    safeTop="{{safeTop}}"
    showBack="{{pageIsStandalone}}"
    fallbackRoute="{{pageFallbackRoute}}"
    fallbackTab="{{pageFallbackTab}}"
    preferFallback="{{pageIsStandalone}}"
  />

  <view class="content {{pageIsStandalone ? 'content--preview' : ''}}">
    <view class="config-tip motion-fade-up motion-delay-1" wx:if="{{serviceMissing}}">
      <text class="config-tip__title">闇€瑕侀厤缃簯鎵樼鏈嶅姟鍚?/text>
      <text class="config-tip__desc">璇峰湪 miniprogram/config.js 涓～鍐?cloudRunService锛堢敤浜?X-WX-SERVICE锛?/text>
    </view>

    <block wx:if="{{showAuditAboutMode}}">
      <view class="admin-loading-card admin-loading-card--page motion-fade-up motion-delay-2" wx:if="{{aboutLoading}}">
        <view class="admin-loading-card__orb">
          <view class="admin-loading-card__spinner"></view>
        </view>
        <text class="admin-loading-card__title">{{pageLoadingTitle}}</text>
        <text class="admin-loading-card__desc">{{pageLoadingDescription}}</text>
      </view>

      <view wx:if="{{!aboutLoading}}">
        <view class="error motion-pop-in" wx:if="{{aboutError}}">
          <text class="error-text">{{aboutError}}</text>
        </view>

        <view class="paper-card motion-fade-up motion-delay-2" wx:if="{{about.author_name || about.author_message}}">
          <view class="author-head" wx:if="{{about.author_name}}">
            <view class="author-avatar">鍏?/view>
            <view class="author-main">
              <text class="author-name">{{about.author_name}}</text>
              <text class="author-sub">鎷惧厜璋ｄ綔鑰?/text>
            </view>
          </view>

          <view class="message-box" wx:if="{{about.author_message}}">
            <text class="message-title">浣滆€呯暀瑷€</text>
            <text class="message-text" space="ensp">{{about.author_message}}</text>
          </view>
        </view>

        <view class="paper-card motion-fade-up motion-delay-3" wx:if="{{about.phone || about.wechat || about.email}}">
          <text class="section-title">鑱旂郴鏂瑰紡</text>

          <view
            class="contact-item"
            wx:if="{{about.phone}}"
            data-label="鎵嬫満鍙?
            data-value="{{about.phone}}"
            bindtap="onCopyField"
          >
            <image class="contact-icon" src="/images/icons/phone-brown.svg" mode="aspectFit" />
            <view class="contact-main">
              <text class="contact-label">鎵嬫満鍙?/text>
              <text class="contact-value">{{about.phone}}</text>
            </view>
            <text class="contact-copy">澶嶅埗</text>
          </view>

          <view
            class="contact-item"
            wx:if="{{about.wechat}}"
            data-label="寰俊鍙?
            data-value="{{about.wechat}}"
            bindtap="onCopyField"
          >
            <image class="contact-icon" src="/images/icons/message-square-brown.svg" mode="aspectFit" />
            <view class="contact-main">
              <text class="contact-label">寰俊鍙?/text>
              <text class="contact-value">{{about.wechat}}</text>
            </view>
            <text class="contact-copy">澶嶅埗</text>
          </view>

          <view
            class="contact-item"
            wx:if="{{about.email}}"
            data-label="閭"
            data-value="{{about.email}}"
            bindtap="onCopyField"
          >
            <image class="contact-icon" src="/images/icons/customer-service.svg" mode="aspectFit" />
            <view class="contact-main">
              <text class="contact-label">閭</text>
              <text class="contact-value contact-value--break">{{about.email}}</text>
            </view>
            <text class="contact-copy">澶嶅埗</text>
          </view>
        </view>

        <view class="paper-card motion-fade-up motion-delay-4" wx:if="{{hasDonationQrCode && donationQrCodeEnabled}}">
          <text class="section-title">璧炶祻鐮?/text>
          <view class="qr-wrap" bindtap="onPreviewDonationQr">
            <image
              class="qr-image"
              src="{{about.donation_qr_code}}"
              mode="widthFix"
              binderror="onDonationQrLoadError"
            />
          </view>
          <text class="qr-tip">鐐瑰嚮鍙斁澶ч瑙?/text>
          <button
            class="qr-save-btn {{savingDonationQr ? 'qr-save-btn--disabled' : ''}}"
            bindtap="onSaveDonationQr"
            hover-class="qr-save-btn--active"
            loading="{{savingDonationQr}}"
            disabled="{{savingDonationQr}}"
          >
            {{savingDonationQr ? "淇濆瓨涓?.." : "淇濆瓨璧炶祻鐮?}}
          </button>
        </view>

      </view>
    </block>

    <block wx:else>
      <view class="admin-loading-card admin-loading-card--page motion-fade-up motion-delay-2" wx:if="{{loading}}">
        <view class="admin-loading-card__orb">
          <view class="admin-loading-card__spinner"></view>
        </view>
        <text class="admin-loading-card__title">{{pageLoadingTitle}}</text>
        <text class="admin-loading-card__desc">{{pageLoadingDescription}}</text>
      </view>

      <!-- 鏈櫥褰?-->
      <view wx:if="{{!loading && !isLoggedIn}}" class="guest motion-fade-up motion-delay-2">
        <view class="guest-icon">
          <image class="guest-icon-img" src="/images/icons/lock-yellow.svg" mode="aspectFit" />
        </view>
        <text class="guest-title">寮€鍚綘鐨勪笓灞炵┖闂?鉁?/text>
        <text class="guest-desc">鐧诲綍鍚庤В閿佹洿澶氬姛鑳?/text>

        <view class="guest-actions" wx:if="{{guestMenuItems.length > 0}}">
          <button
            wx:for="{{guestMenuItems}}"
            wx:key="key"
            class="{{item.buttonClass}}"
            hover-class="{{item.hoverClass}}"
            bindtap="onProfileMenuTap"
            data-action="{{item.action}}"
          >
            {{item.title}}
          </button>
        </view>
      </view>

      <!-- 宸茬櫥褰?-->
      <view wx:if="{{!loading && isLoggedIn}}">
        <view class="id-card motion-fade-up motion-delay-2">
          <!-- Web 绔浐瀹氬睍绀猴細鍏?-->
          <view class="avatar">鍏?/view>
          <view class="id-info">
            <text class="id-name">{{userName}}</text>
            <text class="id-sub" wx:if="{{userPhone}}">{{userPhone}}</text>
            <text class="id-sub id-sub--register" wx:if="{{!userPhone && userRegisterDateText}}">{{userRegisterDateText}}</text>
          </view>
        </view>

        <view class="menu">          <view
            wx:for="{{profileMenuItems}}"
            wx:key="key"
            class="{{item.itemClass}}"
            hover-class="{{item.hoverClass}}"
            bindtap="onProfileMenuTap"
            data-action="{{item.action}}"
            style="animation-delay: {{item.delayMs}}ms;"
          >
            <view class="{{item.iconClass}}">
              <image class="menu-icon-img" src="{{item.iconSrc}}" mode="aspectFit" />
            </view>
            <view class="menu-texts">
              <text class="{{item.titleClass}}">{{item.title}}</text>
              <text class="menu-desc">{{item.description}}</text>
            </view>
          </view>

          <view class="menu-item motion-fade-up motion-delay-6" hover-class="menu-item--active" bindtap="goBetaFeatures" wx:if="{{isWechatLogin}}">
            <view class="menu-icon">
              <image class="menu-icon-img" src="/images/icons/sparkles-yellow.svg" mode="aspectFit" />
            </view>
            <view class="menu-texts">
              <text class="menu-title">瑙ｉ攣鍐呮祴鍔熻兘</text>
              <text class="menu-desc">杈撳叆鍐呮祴鐮侊紝瑙ｉ攣涓撳睘鍔熻兘</text>
            </view>
          </view>

          <view class="menu-item motion-fade-up motion-delay-7" hover-class="menu-item--active" bindtap="goAdmin" wx:if="{{isAdmin}}">
            <view class="menu-icon">
              <image class="menu-icon-img" src="/images/icons/setting.svg" mode="aspectFit" />
            </view>
            <view class="menu-texts">
              <text class="menu-title">鍚庡彴绠＄悊</text>
              <text class="menu-desc" wx:if="{{hideAudit}}">鏌ョ湅缁熻銆佺淮鎶ょ郴缁熴€佺鐞嗛攣妗?/text>
              <text class="menu-desc" wx:else>鏌ョ湅缁熻銆佺淮鎶ょ郴缁熴€佺鐞嗛绾︿笌閿佹。</text>
            </view>
          </view>
          <view class="menu-item menu-item--plain motion-fade-up motion-delay-10" hover-class="menu-item--plain-active" bindtap="logout">
            <view class="menu-icon menu-icon--logout">
              <image class="menu-icon-img" src="/images/icons/log-out-brown.svg" mode="aspectFit" />
            </view>
            <view class="menu-texts">
              <text class="menu-title">閫€鍑虹櫥褰?/text>
              <text class="menu-desc">瀹夊叏閫€鍑哄綋鍓嶈处鎴?/text>
            </view>
          </view>
        </view>
      </view>
    </block>
  </view>

  <view class="audit-fixed-login motion-fade-up" wx:if="{{showAuditAboutMode && !aboutLoading && (phoneLoginEnabled || wechatLoginEnabled)}}">
    <view class="audit-fixed-login__panel">
      <button
        wx:if="{{phoneLoginEnabled}}"
        class="audit-fixed-login__btn"
        hover-class="audit-fixed-login__btn--active"
        bindtap="goLogin"
        disabled="{{serviceMissing}}"
      >
        鍓嶅線鐧诲綍
      </button>
      <button
        wx:if="{{!phoneLoginEnabled && wechatLoginEnabled}}"
        class="audit-fixed-login__btn"
        hover-class="audit-fixed-login__btn--active"
        bindtap="onOpenAuditWechatLogin"
        loading="{{auditWechatSubmitting}}"
        disabled="{{auditWechatSubmitting || serviceMissing}}"
      >
        {{auditWechatSubmitting ? "寰俊鐧诲綍涓?.." : "寰俊鐧诲綍"}}
      </button>
    </view>
  </view>

  <view
    wx:if="{{showAuditAboutMode && showAuditLegalModal}}"
    class="legal-modal-mask"
    bindtap="onCloseAuditLegalModal"
    catchtouchmove="onStopPropagation"
  >
    <view class="legal-modal" catchtap="onStopPropagation" catchtouchmove="onStopPropagation">
      <view class="legal-modal__head">
        <text class="legal-modal__title">{{auditActiveLegalTitle}}</text>
        <view class="legal-modal__close" bindtap="onCloseAuditLegalModal">
          <image class="legal-modal__close-icon" src="/images/icons/x-gray.svg" mode="aspectFit" />
        </view>
      </view>

      <scroll-view class="legal-modal__tabs" scroll-x="{{true}}" enable-flex="{{true}}" show-scrollbar="{{false}}">
        <view class="legal-modal__tabs-inner">
          <view
            wx:for="{{auditLegalDocTabs}}"
            wx:for-item="tab"
            wx:for-index="tabIndex"
            wx:key="key"
            class="legal-modal__tab {{auditActiveLegalKey === tab.key ? 'legal-modal__tab--active' : ''}}"
            data-doc-key="{{tab.key}}"
            bindtap="onSwitchAuditLegalDoc"
          >
            {{tab.shortTitle || tab.title}}
          </view>
        </view>
      </scroll-view>

      <scroll-view class="legal-modal__body" scroll-y="{{true}}" enable-flex="{{true}}">
        <text class="legal-modal__version">{{auditActiveLegalVersion}}</text>

        <view wx:for="{{auditActiveLegalSections}}" wx:for-item="section" wx:for-index="sectionIndex" wx:key="sectionIndex" class="legal-section">
          <text class="legal-section__title">{{section.title}}</text>
          <text
            wx:for="{{section.paragraphs}}"
            wx:for-item="line"
            wx:for-index="lineIndex"
            wx:key="lineIndex"
            class="legal-section__paragraph"
          >
            {{line}}
          </text>
        </view>

        <view class="legal-footer" wx:if="{{auditActiveLegalFooter.length > 0}}">
          <text
            wx:for="{{auditActiveLegalFooter}}"
            wx:for-item="line"
            wx:for-index="lineIndex"
            wx:key="lineIndex"
            class="legal-footer__line"
          >
            {{line}}
          </text>
        </view>
      </scroll-view>

      <view class="legal-modal__foot legal-modal__foot--dual">
        <button class="legal-modal__btn legal-modal__btn--reject" hover-class="legal-modal__btn--reject-active" bindtap="onRejectAuditWechatLogin">鎷掔粷</button>
        <button class="legal-modal__btn legal-modal__btn--agree" hover-class="legal-modal__btn--agree-active" bindtap="onAgreeAuditWechatLogin">鍚屾剰</button>
      </view>
    </view>
  </view>
  <app-bottom-nav show="{{hasBottomTabbar}}" currentPath="pages/profile/index" />
</view>

