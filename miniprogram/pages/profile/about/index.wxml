<view>
  <secondary-page-shell
    shell-class="page"
    managedPageKey="about"
    title="关于"
    subtitle=""
    fallbackTab="pages/profile/index"
    content-class="content"
    useScrollView="{{true}}"
    enableFlex="{{true}}"
  >
    <view class="config-tip motion-fade-up motion-delay-1" wx:if="{{serviceMissing}}">
      <text class="config-tip__title">需要配置云托管服务名</text>
      <text class="config-tip__desc">请在 miniprogram/config.js 中填写 cloudRunService（用于 X-WX-SERVICE）。</text>
    </view>

    <view class="admin-loading-card admin-loading-card--page motion-fade-up motion-delay-2" wx:if="{{loading}}">
      <view class="admin-loading-card__orb">
        <view class="admin-loading-card__spinner"></view>
      </view>
      <text class="admin-loading-card__title">拾光中...</text>
      <text class="admin-loading-card__desc">正在加载关于页面</text>
    </view>

    <view wx:if="{{!loading}}">
      <view class="notice notice--error motion-fade-up motion-delay-2" wx:if="{{loadError}}">
        <text class="notice-text">{{loadError}}</text>
      </view>

      <view class="notice notice--{{actionNoticeType}} motion-pop-in" wx:if="{{actionNoticeMessage}}">
        <text class="notice-text">{{actionNoticeMessage}}</text>
      </view>

      <view class="card card--author motion-fade-up motion-delay-3">
        <view class="author-head">
          <view class="author-avatar">{{authorInitial}}</view>
          <view class="author-main">
            <text class="author-name">{{authorName}}</text>
            <text class="author-sub">感谢你来到这里，愿每次相遇都能留下温柔的回响。</text>
          </view>
        </view>

        <view class="message-box" wx:if="{{about.author_message}}">
          <text class="message-title">作者留言</text>
          <text class="message-text">{{about.author_message}}</text>
        </view>
      </view>

      <view class="card motion-fade-up motion-delay-4">
        <text class="section-title">联系方式</text>
        <view wx:if="{{contactItems.length > 0}}">
          <view class="contact-item" wx:for="{{contactItems}}" wx:key="key">
            <image class="contact-icon" src="{{item.iconSrc}}" mode="aspectFit" />
            <view class="contact-main">
              <text class="contact-label">{{item.label}}</text>
              <text class="contact-value {{item.breakAll ? 'contact-value--break' : ''}}">{{item.value}}</text>
            </view>
            <view
              class="contact-copy"
              hover-class="contact-copy--active"
              hover-stay-time="80"
              data-label="{{item.label}}"
              data-value="{{item.value}}"
              bindtap="onCopyContact"
            >
              复制
            </view>
          </view>
        </view>
        <view class="empty-card" wx:else>
          <text class="empty-card__text">暂未填写联系方式</text>
        </view>
      </view>

      <view class="card motion-fade-up motion-delay-5">
        <view class="section-head">
          <image class="section-head__icon" src="/images/icons/heart-orange.svg" mode="aspectFit" />
          <text class="section-head__title">赞赏支持</text>
        </view>

        <view wx:if="{{about.donation_qr_code}}">
          <view class="qr-wrap" bindtap="onPreviewDonationQr">
            <image
              class="qr-image"
              src="{{about.donation_qr_code}}"
              mode="widthFix"
              show-menu-by-longpress="{{true}}"
            />
          </view>
          <text class="qr-tip">如果这份内容对你有帮助，欢迎扫码支持一下 ✨</text>
        </view>
        <view class="empty-card" wx:else>
          <text class="empty-card__text">暂未上传赞赏码</text>
        </view>
      </view>

      <view class="empty-card empty-card--standalone motion-fade-up motion-delay-6" wx:if="{{showEmptyState}}">
        <text class="empty-card__text">当前关于页内容仍在完善中</text>
      </view>
    </view>
  </secondary-page-shell>
</view>
