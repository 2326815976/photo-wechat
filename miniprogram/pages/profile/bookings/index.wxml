<view class="page">
  <app-header
    managedPageKey="profile-bookings"
    title="鎴戠殑棰勭害璁板綍"
    safeTop="{{safeTop}}"
    showBack="{{true}}"
    fallbackTab="pages/profile/index"
  />

  <view class="content">
    <view class="config-tip motion-fade-up motion-delay-1" wx:if="{{serviceMissing}}">
      <text class="config-tip__title">闇€瑕侀厤缃簯鎵樼鏈嶅姟鍚?/text>
      <text class="config-tip__desc">璇峰湪 miniprogram/config.js 涓～鍐?cloudRunService锛堢敤浜?X-WX-SERVICE锛?/text>
    </view>

    <view class="admin-loading-card admin-loading-card--page motion-fade-up motion-delay-2" wx:if="{{loading}}">
      <view class="admin-loading-card__orb">
        <view class="admin-loading-card__spinner"></view>
      </view>
      <text class="admin-loading-card__title">鎷惧厜涓?..</text>
      <text class="admin-loading-card__desc">姝ｅ湪鑾峰彇棰勭害璁板綍</text>
    </view>

    <view wx:if="{{!loading}}">
      <view class="notice notice--{{actionNoticeType}} motion-pop-in" wx:if="{{actionNoticeMessage}}">
        <text class="notice-text">{{actionNoticeMessage}}</text>
      </view>

      <view class="empty motion-fade-up motion-delay-3" wx:if="{{bookings.length === 0}}">
        <image class="empty-icon" src="/images/icons/calendar-yellow.svg" mode="aspectFit" />
        <text class="empty-text">鏆傛棤棰勭害璁板綍</text>
      </view>

      <view class="list" wx:else>
        <view class="card motion-fade-up" wx:for="{{bookings}}" wx:key="id" style="animation-delay: {{100 + (index % 8) * 35}}ms;">
          <view class="card-header">
            <view class="badge badge-{{item.status}}">
              <text class="badge-emoji">{{item.status_emoji}}</text>
              <text class="badge-text">{{item.status_label}}</text>
            </view>
            <text class="card-date">{{item.created_at_text}}</text>
          </view>

          <view class="infos">
            <view class="info-row">
              <image class="info-icon" src="/images/icons/calendar-yellow.svg" mode="aspectFit" />
              <view class="info-texts">
                <text class="info-label">绾︽媿绫诲瀷</text>
                <text class="info-value">{{item.type_name}}</text>
              </view>
            </view>

            <view class="info-row">
              <image class="info-icon" src="/images/icons/map-pin-yellow.svg" mode="aspectFit" />
              <view class="info-texts">
                <text class="info-label">绾︽媿鍦扮偣</text>
                <text class="info-value">{{item.location}}</text>
                <text class="info-sub" wx:if="{{item.city_name}}">馃搷 {{item.city_name}}</text>
              </view>
            </view>

            <view class="grid2">
              <view class="info-row">
                <image class="info-icon" src="/images/icons/phone-yellow.svg" mode="aspectFit" />
                <view class="info-texts">
                  <text class="info-label">鎵嬫満鍙?/text>
                  <text class="info-value">{{item.phone}}</text>
                </view>
              </view>
              <view class="info-row">
                <image class="info-icon" src="/images/icons/message-square-yellow.svg" mode="aspectFit" />
                <view class="info-texts">
                  <text class="info-label">寰俊鍙?/text>
                  <text class="info-value">{{item.wechat}}</text>
                </view>
              </view>
            </view>

            <view class="notes" wx:if="{{item.notes}}">
              <text class="notes-label">澶囨敞</text>
              <text class="notes-text">{{item.notes}}</text>
            </view>
          </view>

          <view class="actions" wx:if="{{item.can_cancel || item.can_delete}}">
            <button
              class="btn-cancel"
              hover-class="btn-cancel--active"
              wx:if="{{item.can_cancel}}"
              data-id="{{item.id}}"
              bindtap="onCancel"
              disabled="{{cancelingId === item.id}}"
            >
              {{cancelingId === item.id ? '鍙栨秷涓?..' : '鍙栨秷棰勭害'}}
            </button>

            <button
              class="btn-delete"
              hover-class="btn-delete--active"
              wx:if="{{item.can_delete}}"
              data-id="{{item.id}}"
              bindtap="openDeleteConfirm"
              disabled="{{deletingId === item.id}}"
            >
              <image class="btn-delete-icon" src="/images/icons/trash-red.svg" mode="aspectFit" />
              <text>{{deletingId === item.id ? '鍒犻櫎涓?..' : '鍒犻櫎璁板綍'}}</text>
            </button>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 鍒犻櫎纭寮圭獥 -->
  <view class="modal-mask motion-fade-in" wx:if="{{showDeleteConfirmId}}" bindtap="closeDeleteConfirm"></view>
  <view class="modal motion-fade-in" wx:if="{{showDeleteConfirmId}}">
    <view class="modal-card motion-pop-in" catchtap="noop">
      <view class="modal-header">
        <text class="modal-title">纭鍒犻櫎</text>
        <view class="modal-close" hover-class="modal-close--active" bindtap="closeDeleteConfirm">
          <image class="modal-close-icon" src="/images/icons/x-brown.svg" mode="aspectFit" />
        </view>
      </view>
      <text class="modal-desc">鍒犻櫎鍚庡皢鏃犳硶鎭㈠姝ら绾﹁褰曪紝纭畾瑕佸垹闄ゅ悧锛?/text>
      <view class="modal-actions">
        <button class="modal-btn modal-btn--ghost" hover-class="modal-btn--ghost-active" bindtap="closeDeleteConfirm">鍙栨秷</button>
        <button class="modal-btn modal-btn--danger" hover-class="modal-btn--danger-active" bindtap="confirmDelete">纭鍒犻櫎</button>
      </view>
    </view>
  </view>
</view>

