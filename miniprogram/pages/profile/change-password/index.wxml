<view class="page">
  <view wx:if="{{!showSuccess}}" style="height: {{safeTop}}px;"></view>

  <!-- Web: top-6 -->
  <view class="back motion-fade-up motion-delay-1" wx:if="{{!showSuccess}}" style="top: {{safeTop + 24}}px;">
    <view class="back-btn" hover-class="back-btn--active" hover-stay-time="80" bindtap="goBack">
      <image class="back-icon" src="/images/icons/arrow-left.svg" mode="aspectFit" />
    </view>
  </view>

  <view class="content motion-fade-up motion-delay-2" wx:if="{{!showSuccess}}">
    <view class="title-wrap motion-fade-up motion-delay-2">
      <text class="title">{{managedTitle}}</text>
      <text class="sub">璇疯緭鍏ュ綋鍓嶅瘑鐮佸拰鏂板瘑鐮?/text>
    </view>

    <view class="config-tip motion-fade-up motion-delay-3" wx:if="{{serviceMissing}}">
      <text class="config-tip__title">闇€瑕侀厤缃簯鎵樼鏈嶅姟鍚?/text>
      <text class="config-tip__desc">璇峰湪 miniprogram/config.js 涓～鍐?cloudRunService锛堢敤浜?X-WX-SERVICE锛?/text>
    </view>

    <view class="form motion-fade-up motion-delay-3">
      <view class="field {{focusField === 'currentPassword' ? 'field--focus' : ''}}">
        <image class="field-icon" src="/images/icons/lock-muted.svg" mode="aspectFit" />
        <input
          class="input"
          password="{{!showCurrentPassword}}"
          placeholder="褰撳墠瀵嗙爜"
          placeholder-style="color: rgba(93, 64, 55, 0.4);"
          value="{{formData.currentPassword}}"
          data-field="currentPassword"
          bindinput="onInput"
          bindfocus="onFieldFocus"
          bindblur="onFieldBlur"
        />
        <view class="toggle" hover-class="toggle--active" data-key="showCurrentPassword" bindtap="togglePassword">
          <image class="toggle-icon" src="{{showCurrentPassword ? '/images/icons/eye-off-muted.svg' : '/images/icons/eye-muted.svg'}}" mode="aspectFit" />
        </view>
      </view>

      <view class="field {{focusField === 'newPassword' ? 'field--focus' : ''}}">
        <image class="field-icon" src="/images/icons/lock-muted.svg" mode="aspectFit" />
        <input
          class="input"
          password="{{!showNewPassword}}"
          placeholder="鏂板瘑鐮侊紙鑷冲皯6浣嶏級"
          placeholder-style="color: rgba(93, 64, 55, 0.4);"
          value="{{formData.newPassword}}"
          data-field="newPassword"
          bindinput="onInput"
          bindfocus="onFieldFocus"
          bindblur="onFieldBlur"
        />
        <view class="toggle" hover-class="toggle--active" data-key="showNewPassword" bindtap="togglePassword">
          <image class="toggle-icon" src="{{showNewPassword ? '/images/icons/eye-off-muted.svg' : '/images/icons/eye-muted.svg'}}" mode="aspectFit" />
        </view>
      </view>

      <view class="field {{focusField === 'confirmPassword' ? 'field--focus' : ''}}">
        <image class="field-icon" src="/images/icons/lock-muted.svg" mode="aspectFit" />
        <input
          class="input"
          password="{{!showConfirmPassword}}"
          placeholder="纭鏂板瘑鐮?
          placeholder-style="color: rgba(93, 64, 55, 0.4);"
          value="{{formData.confirmPassword}}"
          data-field="confirmPassword"
          bindinput="onInput"
          bindfocus="onFieldFocus"
          bindblur="onFieldBlur"
        />
        <view class="toggle" hover-class="toggle--active" data-key="showConfirmPassword" bindtap="togglePassword">
          <image class="toggle-icon" src="{{showConfirmPassword ? '/images/icons/eye-off-muted.svg' : '/images/icons/eye-muted.svg'}}" mode="aspectFit" />
        </view>
      </view>

      <view class="error motion-pop-in" wx:if="{{error}}">
        <text class="error-text">{{error}}</text>
      </view>

      <button class="submit" hover-class="submit--active" bindtap="submit" disabled="{{isLoading || serviceMissing}}">
        {{isLoading ? '淇敼涓?..' : '馃攼 纭淇敼'}}
      </button>
    </view>
  </view>

  <view class="success-page motion-fade-in" wx:if="{{showSuccess}}">
    <view class="success-wrap motion-pop-in">
      <view class="success-icon-wrap">
        <image class="success-icon" src="/images/icons/circle-check-yellow.svg" mode="aspectFit" />
      </view>
      <text class="success-title">瀵嗙爜淇敼鎴愬姛锛佲湪</text>
      <text class="success-desc">宸插己鍒跺叏閮ㄨ澶囦笅绾匡紝姝ｅ湪鍓嶅線鐧诲綍...</text>
    </view>
  </view>
</view>

