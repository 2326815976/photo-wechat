@import "../../../styles/secondary-page-frame.wxss";

.delete-shell {
  width: 100%;
  max-width: 720rpx;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.config-tip {
  background: rgba(255, 255, 255, 0.75);
  border: 4rpx dashed rgba(93, 64, 55, 0.15);
  border-radius: 28rpx;
  padding: 20rpx 24rpx;
}

.config-tip__title {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: #5D4037;
  margin-bottom: 6rpx;
}

.config-tip__desc {
  display: block;
  font-size: 22rpx;
  color: rgba(93, 64, 55, 0.60);
  line-height: 1.45;
}

.warn-card {
  position: relative;
  overflow: hidden;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(255, 252, 245, 0.98) 100%);
  border-radius: 32rpx;
  border: 2rpx solid rgba(93, 64, 55, 0.10);
  padding: 36rpx 34rpx;
  box-sizing: border-box;
  box-shadow: 0 14rpx 36rpx rgba(93, 64, 55, 0.10);
}

.warn-card__glow {
  position: absolute;
  border-radius: 999rpx;
  filter: blur(24rpx);
  opacity: 0.7;
  pointer-events: none;
}

.warn-card__glow--red {
  width: 180rpx;
  height: 180rpx;
  right: -48rpx;
  top: -42rpx;
  background: rgba(239, 68, 68, 0.10);
}

.warn-card__glow--gold {
  width: 220rpx;
  height: 220rpx;
  left: -60rpx;
  bottom: -70rpx;
  background: rgba(255, 200, 87, 0.12);
}

.warn-head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.warn-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, rgba(239, 68, 68, 0.14) 0%, rgba(239, 68, 68, 0.08) 100%);
  box-shadow: inset 0 0 0 2rpx rgba(239, 68, 68, 0.10);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.warn-icon {
  width: 52rpx;
  height: 52rpx;
}

.warn-head__main {
  flex: 1;
  min-width: 0;
}

.danger-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(239, 68, 68, 0.10);
  border: 2rpx solid rgba(239, 68, 68, 0.12);
  margin-bottom: 8rpx;
}

.danger-pill__dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #EF4444;
}

.danger-pill__text {
  font-size: 18rpx;
  font-weight: 700;
  color: #C2410C;
  line-height: 1;
  letter-spacing: 0.8rpx;
}

.warn-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #5D4037;
  line-height: 1.2;
  white-space: nowrap;
  letter-spacing: 1.4rpx;
}

.warn-subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: rgba(93, 64, 55, 0.62);
  line-height: 1.35;
  white-space: nowrap;
  letter-spacing: 0.8rpx;
}

.warn-divider {
  position: relative;
  z-index: 1;
  margin: 32rpx 0 28rpx;
  height: 2rpx;
  background: linear-gradient(90deg, rgba(255, 200, 87, 0.0) 0%, rgba(255, 200, 87, 0.45) 20%, rgba(93, 64, 55, 0.10) 50%, rgba(255, 200, 87, 0.45) 80%, rgba(255, 200, 87, 0.0) 100%);
}

.risk-list {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.risk-item {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 24rpx 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 2rpx solid rgba(93, 64, 55, 0.08);
  box-shadow: 0 6rpx 16rpx rgba(93, 64, 55, 0.05);
}

.risk-item--danger {
  background: linear-gradient(180deg, rgba(254, 242, 242, 0.98) 0%, rgba(255, 248, 248, 0.98) 100%);
  border-color: rgba(239, 68, 68, 0.14);
}

.risk-item__icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 999rpx;
  background: rgba(255, 200, 87, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.risk-item__icon-wrap--danger {
  background: rgba(239, 68, 68, 0.12);
}

.risk-item__icon {
  width: 28rpx;
  height: 28rpx;
}

.risk-item__main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.risk-item__title {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: #5D4037;
  line-height: 1.5;
}

.risk-item__desc {
  display: block;
  font-size: 22rpx;
  color: rgba(93, 64, 55, 0.62);
  line-height: 1.6;
}

.tip-box {
  position: relative;
  z-index: 1;
  margin-top: 24rpx;
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 24rpx 22rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, rgba(255, 248, 225, 0.98) 0%, rgba(255, 251, 235, 0.98) 100%);
  border: 2rpx solid rgba(255, 200, 87, 0.24);
}

.tip-box__icon {
  width: 28rpx;
  height: 28rpx;
  margin-top: 2rpx;
  flex: none;
}

.tip-box__text {
  flex: 1;
  font-size: 22rpx;
  color: rgba(93, 64, 55, 0.70);
  line-height: 1.65;
}

.error {
  background: #FEF2F2;
  border: 2rpx solid #FECACA;
  border-radius: 28rpx;
  padding: 22rpx 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(220, 38, 38, 0.06);
}

.error-text {
  display: block;
  font-size: 24rpx;
  color: #DC2626;
  line-height: 1.5;
  text-align: center;
}

.btn-next {
  width: calc(100% + 28rpx);
  margin-left: -14rpx;
  margin-right: -14rpx;
  height: 108rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #FF6158 0%, #EF4444 100%);
  color: #FFFFFF;
  border: 4rpx solid #5D4037;
  box-shadow: 8rpx 8rpx 0 #5D4037;
  font-size: 32rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  transition: transform 0.2s ease, box-shadow 0.2s ease, opacity 0.2s ease;
}

.btn-next::after,
.btn-ghost::after,
.btn-danger::after {
  border: none;
}

.btn-next[disabled] {
  opacity: 0.60;
}

.btn-next--active {
  transform: translate(4rpx, 4rpx);
  box-shadow: 4rpx 4rpx 0 #5D4037;
}

.confirm-box {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.confirm-tip {
  background: linear-gradient(180deg, rgba(255, 200, 87, 0.20) 0%, rgba(255, 245, 214, 0.72) 100%);
  border-radius: 28rpx;
  padding: 24rpx 22rpx;
  text-align: center;
  border: 2rpx solid rgba(255, 200, 87, 0.18);
}

.confirm-tip__eyebrow {
  display: block;
  margin-bottom: 8rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: rgba(180, 83, 9, 0.88);
  letter-spacing: 2rpx;
}

.confirm-tip-text {
  font-size: 24rpx;
  font-weight: 700;
  color: #5D4037;
  line-height: 1.5;
}

.confirm-actions {
  display: flex;
  gap: 12rpx;
}

.btn-ghost,
.btn-danger {
  flex: 1;
  height: 96rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  transition: background-color 0.2s ease, opacity 0.2s ease;
}

.btn-ghost {
  background: rgba(93, 64, 55, 0.10);
  border: 2rpx solid rgba(93, 64, 55, 0.08);
  color: #5D4037;
}

.btn-danger {
  background: linear-gradient(180deg, #FF6158 0%, #EF4444 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 16rpx rgba(239, 68, 68, 0.18);
}

.btn-danger[disabled] {
  opacity: 0.60;
}

.btn-ghost--active {
  background: rgba(93, 64, 55, 0.20);
}

.btn-danger--active {
  background: #DC2626;
}

.success-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.success-wrap {
  width: 100%;
  max-width: 640rpx;
  text-align: center;
  padding: 0 12rpx;
}

.success-icon-wrap {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 200, 87, 0.20);
  display: flex;
  align-items: center;
  justify-content: center;
}

.success-icon {
  width: 80rpx;
  height: 80rpx;
}

.success-title {
  display: block;
  margin-bottom: 12rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #5D4037;
  font-family: "ZQKNNY", "YouYuan", "幼圆", "Microsoft YaHei", sans-serif;
}

.success-desc {
  display: block;
  font-size: 28rpx;
  color: rgba(93, 64, 55, 0.70);
  line-height: 1.6;
}

.success-warning {
  display: block;
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 20rpx;
  border: 2rpx solid #FDE68A;
  background: #FFFBEB;
  color: #B45309;
  font-size: 22rpx;
  line-height: 1.6;
}
