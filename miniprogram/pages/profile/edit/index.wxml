<view class="page">
  <app-header
    managedPageKey="profile-edit"
    title="缂栬緫涓汉璧勬枡"
    safeTop="{{safeTop}}"
    showBack="{{true}}"
    fallbackTab="pages/profile/index"
  />

  <view class="content">
    <view class="config-tip motion-fade-up motion-delay-1" wx:if="{{serviceMissing}}">
      <text class="config-tip__title">闇€瑕侀厤缃簯鎵樼鏈嶅姟鍚?/text>
      <text class="config-tip__desc">璇峰湪 miniprogram/config.js 涓～鍐?cloudRunService锛堢敤浜?X-WX-SERVICE锛?/text>
    </view>

    <view class="admin-loading-card admin-loading-card--page motion-fade-up motion-delay-2" wx:if="{{loading}}">
      <view class="admin-loading-card__orb">
        <view class="admin-loading-card__spinner"></view>
      </view>
      <text class="admin-loading-card__title">鎷惧厜涓?..</text>
      <text class="admin-loading-card__desc">姝ｅ湪鍔犺浇涓汉璧勬枡</text>
    </view>

    <view wx:if="{{!loading}}">
      <view class="success-card motion-pop-in" wx:if="{{success}}">
        <view class="success-icon">
          <image class="success-icon-img" src="/images/icons/save-yellow.svg" mode="aspectFit" />
        </view>
        <text class="success-title">淇濆瓨鎴愬姛锛?/text>
        <text class="success-desc">涓汉璧勬枡宸叉洿鏂?鉁?/text>
      </view>

      <view class="paper-card motion-fade-up motion-delay-2" wx:else>
        <view class="doodle">
          <image class="doodle-icon" src="/images/icons/user-brown.svg" mode="aspectFit" />
        </view>

        <view class="form">
          <view class="form-item">
            <view class="label">
              <image class="label-icon" src="/images/icons/user-brown.svg" mode="aspectFit" />
              <text class="label-text">鐢ㄦ埛鍚?*</text>
            </view>
            <input
              class="input {{focusField === 'name' ? 'input--focus' : ''}}"
              placeholder="璇疯緭鍏ョ敤鎴峰悕"
              placeholder-style="color: rgba(93, 64, 55, 0.4);"
              value="{{formData.name}}"
              data-field="name"
              bindinput="onInput"
              bindfocus="onFieldFocus"
              bindblur="onFieldBlur"
              maxlength="20"
            />
          </view>

          <view class="form-item">
            <view class="label">
              <image class="label-icon" src="/images/icons/phone-brown.svg" mode="aspectFit" />
              <text class="label-text">鎵嬫満鍙?/text>
            </view>
            <input
              class="input {{focusField === 'phone' ? 'input--focus' : ''}}"
              type="number"
              placeholder="璇疯緭鍏ユ墜鏈哄彿锛堥€夊～锛?
              placeholder-style="color: rgba(93, 64, 55, 0.4);"
              value="{{formData.phone}}"
              data-field="phone"
              bindinput="onInput"
              bindfocus="onFieldFocus"
              bindblur="onFieldBlur"
              maxlength="11"
            />
          </view>

          <view class="form-item">
            <view class="label">
              <image class="label-icon" src="/images/icons/message-square-brown.svg" mode="aspectFit" />
              <text class="label-text">寰俊鍙?/text>
            </view>
            <input
              class="input {{focusField === 'wechat' ? 'input--focus' : ''}}"
              placeholder="璇疯緭鍏ュ井淇″彿锛堥€夊～锛?
              placeholder-style="color: rgba(93, 64, 55, 0.4);"
              value="{{formData.wechat}}"
              data-field="wechat"
              bindinput="onInput"
              bindfocus="onFieldFocus"
              bindblur="onFieldBlur"
              maxlength="32"
            />
          </view>

          <view class="tip-box" wx:if="{{!hideAudit}}">
            <text class="tip-text">馃挕 濉啓鎵嬫満鍙峰拰寰俊鍚庯紝棰勭害鏃朵細鑷姩濉厖</text>
          </view>

          <view class="error motion-pop-in" wx:if="{{error}}">
            <text class="error-text">{{error}}</text>
          </view>

          <button class="btn-submit" bindtap="submit" disabled="{{saving || serviceMissing}}">
            <view class="btn-row">
              <image class="btn-icon" src="/images/icons/save-brown.svg" mode="aspectFit" wx:if="{{!saving}}" />
              <text class="btn-text">{{saving ? '淇濆瓨涓?..' : '淇濆瓨淇敼'}}</text>
            </view>
          </button>
        </view>
      </view>
    </view>
  </view>
</view>

