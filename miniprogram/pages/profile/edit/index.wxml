<view>
  <secondary-page-shell
    shell-class="page"
    managedPageKey="profile-edit"
    title="编辑个人资料"
    subtitle=""
    fallbackTab="pages/profile/index"
    content-class="content"
    useScrollView="{{true}}"
    enableFlex="{{true}}"
  >
    <view class="config-tip motion-fade-up motion-delay-1" wx:if="{{serviceMissing}}">
      <text class="config-tip__title">需要配置云托管服务名</text>
      <text class="config-tip__desc">请在 miniprogram/config.js 中填写 cloudRunService（用于 X-WX-SERVICE）。</text>
    </view>

    <view class="admin-loading-card admin-loading-card--page motion-fade-up motion-delay-2" wx:elif="{{loading}}">
      <view class="admin-loading-card__orb">
        <view class="admin-loading-card__spinner"></view>
      </view>
      <text class="admin-loading-card__title">拾光中...</text>
      <text class="admin-loading-card__desc">正在加载个人资料</text>
    </view>

    <view wx:elif="{{success}}" class="edit-shell">
      <view class="state-card success-card motion-pop-in">
        <view class="state-icon-wrap">
          <image class="state-icon" src="/images/icons/save-yellow.svg" mode="aspectFit" />
        </view>
        <text class="state-title">保存成功！</text>
        <text class="state-desc">个人资料已更新，正在返回上一页</text>
      </view>
    </view>

    <view wx:else class="edit-shell">
      <view class="form-card motion-fade-up motion-delay-2">
        <view class="form-card__accent"></view>

        <view class="form-grid">
          <view class="form-item">
            <view class="label">
              <image class="label-icon" src="/images/icons/user-brown.svg" mode="aspectFit" />
              <text class="label-text">用户名 *</text>
            </view>
            <input
              class="input {{focusField === 'name' ? 'input--focus' : ''}}"
              placeholder="请输入用户名"
              placeholder-class="input-placeholder"
              value="{{formData.name}}"
              data-field="name"
              bindinput="onInput"
              bindfocus="onFieldFocus"
              bindblur="onFieldBlur"
              maxlength="20"
            />
          </view>

          <view class="form-item">
            <view class="label">
              <image class="label-icon" src="/images/icons/phone-brown.svg" mode="aspectFit" />
              <text class="label-text">手机号</text>
            </view>
            <input
              class="input {{focusField === 'phone' ? 'input--focus' : ''}}"
              type="number"
              placeholder="请输入手机号（选填）"
              placeholder-class="input-placeholder"
              value="{{formData.phone}}"
              data-field="phone"
              bindinput="onInput"
              bindfocus="onFieldFocus"
              bindblur="onFieldBlur"
              maxlength="11"
            />
          </view>

          <view class="form-item">
            <view class="label">
              <image class="label-icon" src="/images/icons/message-square-brown.svg" mode="aspectFit" />
              <text class="label-text">微信号</text>
            </view>
            <input
              class="input {{focusField === 'wechat' ? 'input--focus' : ''}}"
              placeholder="请输入微信号（选填）"
              placeholder-class="input-placeholder"
              value="{{formData.wechat}}"
              data-field="wechat"
              bindinput="onInput"
              bindfocus="onFieldFocus"
              bindblur="onFieldBlur"
              maxlength="32"
            />
          </view>
        </view>

        <view class="tip-box">
          <image class="tip-icon" src="/images/icons/sparkles-yellow.svg" mode="aspectFit" />
          <text class="tip-text">填写手机号和微信号后，预约时会自动填充</text>
        </view>

        <view class="error-card motion-pop-in" wx:if="{{error}}">
          <text class="error-text">{{error}}</text>
        </view>

        <button
          class="submit-btn {{saving || serviceMissing ? 'submit-btn--disabled' : ''}}"
          hover-class="{{saving || serviceMissing ? '' : 'submit-btn--active'}}"
          bindtap="submit"
          loading="{{false}}"
          disabled="{{saving || serviceMissing}}"
        >
          <view class="submit-row">
            <image class="submit-icon" src="/images/icons/save-brown.svg" mode="aspectFit" wx:if="{{!saving}}" />
            <text>{{saving ? '保存中...' : '保存修改'}}</text>
          </view>
        </button>
      </view>
    </view>
  </secondary-page-shell>
</view>
