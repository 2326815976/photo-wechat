@import "../../../styles/admin-loading.wxss";
@import "../../../styles/secondary-page-frame.wxss";

.edit-shell {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.config-tip {
  background: rgba(255, 255, 255, 0.75);
  border: 4rpx dashed rgba(93, 64, 55, 0.15);
  border-radius: 28rpx;
  padding: 20rpx 24rpx;
}

.config-tip__title {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: #5D4037;
  margin-bottom: 6rpx;
}

.config-tip__desc {
  display: block;
  font-size: 22rpx;
  color: rgba(93, 64, 55, 0.60);
  line-height: 1.45;
}

.state-card,
.form-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  border: 2rpx solid rgba(93, 64, 55, 0.10);
  box-shadow: 0 12rpx 32rpx rgba(93, 64, 55, 0.10);
}

.success-card {
  padding: 64rpx 32rpx;
  text-align: center;
}

.state-icon-wrap {
  width: 140rpx;
  height: 140rpx;
  margin: 0 auto 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 200, 87, 0.20);
  display: flex;
  align-items: center;
  justify-content: center;
}

.state-icon {
  width: 72rpx;
  height: 72rpx;
}

.state-title {
  display: block;
  font-size: 36rpx;
  font-weight: 900;
  color: #5D4037;
  margin-bottom: 12rpx;
  font-family: "ZQKNNY", "YouYuan", "幼圆", "Microsoft YaHei", sans-serif;
}

.state-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(93, 64, 55, 0.66);
  line-height: 1.5;
}

.form-card {
  position: relative;
  padding: 24rpx;
  overflow: hidden;
  background-color: #FFFEF8;
  background-image:
    linear-gradient(0deg, transparent 48rpx, rgba(93, 64, 55, 0.04) 50rpx, transparent 52rpx),
    linear-gradient(90deg, transparent 48rpx, rgba(93, 64, 55, 0.04) 50rpx, transparent 52rpx);
  background-size: 50rpx 50rpx;
}

.form-card__accent {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  height: 8rpx;
  background: linear-gradient(90deg, #FFC857 0%, #FFB347 100%);
}

.form-grid {
  display: flex;
  flex-direction: column;
  gap: 26rpx;
  margin-top: 0;
}

.form-item {
  display: flex;
  flex-direction: column;
}

.label {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.label-icon {
  width: 30rpx;
  height: 30rpx;
}

.label-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #5D4037;
}

.input {
  width: 100%;
  height: 88rpx;
  padding: 0 22rpx;
  border-radius: 18rpx;
  border: 2rpx solid rgba(93, 64, 55, 0.14);
  background: rgba(255, 255, 255, 0.98);
  box-sizing: border-box;
  color: #5D4037;
  font-size: 28rpx;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

.input-placeholder {
  color: rgba(93, 64, 55, 0.40);
  font-size: 26rpx;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

.input--focus {
  border-color: rgba(255, 200, 87, 0.86);
  box-shadow: 0 0 0 6rpx rgba(255, 200, 87, 0.16);
}

.tip-box {
  margin-top: 24rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  border: 2rpx solid rgba(255, 200, 87, 0.26);
  background: rgba(255, 200, 87, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.tip-icon {
  width: 24rpx;
  height: 24rpx;
  flex: none;
}

.tip-text {
  font-size: 22rpx;
  color: rgba(93, 64, 55, 0.66);
  line-height: 1.45;
}

.error-card {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  border: 2rpx solid #FECACA;
  background: #FEF2F2;
}

.error-text {
  display: block;
  font-size: 24rpx;
  color: #DC2626;
  line-height: 1.45;
  text-align: center;
}

.submit-btn {
  margin-top: 28rpx;
  width: 100%;
  height: 86rpx;
  border-radius: 22rpx;
  border: 2rpx solid #F2D28E;
  background: linear-gradient(180deg, #FFE08F 0%, #FFC857 100%);
  color: #5D4037;
  box-shadow: 0 8rpx 0 rgba(93, 64, 55, 0.92);
  font-size: 28rpx;
  font-weight: 900;
  transition: transform 0.18s ease, box-shadow 0.18s ease, opacity 0.18s ease;
}

.submit-btn::after {
  border: none;
}

.submit-btn--active {
  transform: translateY(4rpx);
  box-shadow: 0 4rpx 0 rgba(93, 64, 55, 0.92);
}

.submit-btn--disabled {
  opacity: 0.6;
}

.submit-row {
  height: 86rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.submit-icon {
  width: 36rpx;
  height: 36rpx;
}
