.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #FFFBF0;
}

.audit-guard {
  flex: 1;
  background: #FFFBF0;
}

.boot-loading {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  background: #FFFBF0;
}

.boot-loading-ring {
  position: relative;
  width: 192rpx;
  height: 192rpx;
}

.boot-ring {
  position: absolute;
  border-radius: 999rpx;
  border-style: solid;
  box-sizing: border-box;
}

.boot-ring--outer {
  inset: 0;
  border-width: 10rpx;
  border-color: rgba(255, 200, 87, 0.30);
  border-top-color: #FFC857;
  animation: boot-spin 3s linear infinite;
}

.boot-ring--inner {
  inset: 24rpx;
  border-width: 10rpx;
  border-color: rgba(93, 64, 55, 0.20);
  border-bottom-color: #5D4037;
  animation: boot-spin-reverse 2s linear infinite;
}

.boot-ring-center {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.boot-center-icon {
  width: 64rpx;
  height: 64rpx;
}

.boot-loading-text {
  text-align: center;
}

.boot-loading-title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #5D4037;
  margin-bottom: 6rpx;
}

.boot-loading-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(93, 64, 55, 0.60);
}

@keyframes boot-spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

@keyframes boot-spin-reverse {
  0% { transform: rotate(360deg); }
  100% { transform: rotate(0deg); }
}

.content {
  flex: 1;
  /* Web: px-5 pt-3 pb-3 */
  padding: 24rpx 40rpx 24rpx;
  box-sizing: border-box;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 400 400' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.03'/%3E%3C/svg%3E");
  display: flex;
  flex-direction: column;
  min-height: 0;
}

.content--standalone,
.content--audit-compact {
  padding-top: 12rpx;
  padding-bottom: 8rpx;
}

.config-tip {
  background: rgba(255, 255, 255, 0.75);
  border: 4rpx dashed rgba(93, 64, 55, 0.15);
  border-radius: 28rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 18rpx;
}

.config-tip__title {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: #5D4037;
  margin-bottom: 6rpx;
}

.config-tip__desc {
  display: block;
  font-size: 22rpx;
  color: rgba(93, 64, 55, 0.60);
}

.tagbar {
  position: -webkit-sticky;
  position: sticky;
  top: 0;
  z-index: 880;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 8rpx 0 12rpx;
  background: #FFFBF0;
  border-bottom: 2rpx solid rgba(93, 64, 55, 0.05);
  margin-bottom: 14rpx;
}

.tagbar--enter {
  animation: tagbar-in 260ms ease-out both;
}

.tagbar-scroll {
  width: 100%;
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
}

.tagbar-row {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding-bottom: 4rpx;
}

.tag-btn {
  flex: none;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  background: rgba(255, 255, 255, 0.60);
  color: rgba(93, 64, 55, 0.60);
  border: 4rpx dashed rgba(93, 64, 55, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  min-height: auto;
  min-width: auto;
  white-space: nowrap;
  transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
}

.tag-btn--active {
  background: #FFC857;
  color: #5D4037;
  border: 4rpx solid rgba(93, 64, 55, 0.20);
  box-shadow: 4rpx 4rpx 0 rgba(93, 64, 55, 0.15);
}

.tag-btn--touch {
  border-color: rgba(93, 64, 55, 0.30);
}

.tag-all-btn {
  flex: none;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  background: #5D4037;
  color: #FFFFFF;
  border: 4rpx solid #5D4037;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  min-height: auto;
  min-width: auto;
  white-space: nowrap;
  transition: background-color 0.2s ease, opacity 0.2s ease;
}

.tag-all-btn--active {
  opacity: 0.92;
  background: #6A4B41;
}

/* Web 同款骨架屏（SkeletonTags + SkeletonPose） */
.skeleton-wrap {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.skeleton-tags-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.skeleton-tags-scroll {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.skeleton-tags-inner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-bottom: 8rpx;
}

.skeleton-tag {
  flex: none;
  height: 56rpx; /* h-7 */
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.40);
  animation: pulse 1.6s ease-in-out infinite;
}

.skeleton-all {
  flex: none;
  width: 128rpx; /* w-16 */
  height: 56rpx;
  border-radius: 999rpx;
  background: rgba(93, 64, 55, 0.10);
  animation: pulse 1.6s ease-in-out infinite;
}

.skeleton-pose {
  position: relative;
  display: flex;
  flex: 1;
  min-height: 0;
  width: 100%;
  margin-bottom: 32rpx;
}

.skeleton-tape {
  position: absolute;
  top: -24rpx; /* -top-3 */
  left: 50%;
  width: 160rpx; /* w-20 */
  height: 48rpx; /* h-6 */
  background: rgba(255, 200, 87, 0.20);
  border-radius: 4rpx; /* rounded-sm */
  transform: translateX(-50%) rotate(-2deg);
  z-index: 2;
  animation: pulse 1.6s ease-in-out infinite;
}

.skeleton-card {
  background: #FFFFFF;
  padding: 24rpx; /* p-3 */
  padding-bottom: 40rpx; /* pb-5 */
  border-radius: 32rpx; /* rounded-2xl */
  box-shadow: 0 16rpx 60rpx rgba(93, 64, 55, 0.12);
  position: relative;
  display: flex;
  flex-direction: column;
  flex: 1;
  width: 100%;
  min-height: 0;
}

.skeleton-doodle {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  font-size: 40rpx; /* text-xl */
  opacity: 0.10;
}

.skeleton-img {
  position: relative;
  flex: 1;
  min-height: 0;
  border-radius: 4rpx; /* rounded-sm */
  overflow: hidden;
  background: linear-gradient(135deg, #FFFBF0, #FFF4E0);
}

.skeleton-shimmer {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.60) 50%, transparent 100%);
  transform: translateX(-100%);
  animation: shimmer 2s infinite;
}

.skeleton-chips {
  margin-top: 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: center;
  flex-shrink: 0;
}

.skeleton-chip {
  width: 128rpx; /* w-16 */
  height: 56rpx; /* h-7 */
  border-radius: 32rpx; /* rounded-2xl */
  background: linear-gradient(90deg, rgba(255, 229, 229, 0.40), rgba(255, 244, 224, 0.40));
  animation: pulse 1.6s ease-in-out infinite;
}

@keyframes shimmer {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}

@keyframes pulse {
  0% { opacity: 1; }
  50% { opacity: 0.6; }
  100% { opacity: 1; }
}

.pose-wrap {
  position: relative;
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
  transform-origin: center;
}

.content--standalone .pose-wrap,
.content--standalone .skeleton-pose,
.content--audit-compact .pose-wrap,
.content--audit-compact .skeleton-pose {
  margin-bottom: 12rpx;
}

.tape {
  position: absolute;
  top: -24rpx; /* -top-3 */
  left: 50%;
  width: 160rpx;
  height: 48rpx;
  background: rgba(255, 200, 87, 0.40);
  /* Web: backdrop-blur-sm（4px） */
  backdrop-filter: blur(4px);
  border-radius: 4rpx; /* rounded-sm */
  transform: translateX(-50%) rotate(-2deg);
  z-index: 2;
  box-shadow: 0 2rpx 8rpx rgba(93, 64, 55, 0.15);
}

.pose-card {
  background: #FFFFFF;
  padding: 24rpx; /* p-3 */
  padding-bottom: 40rpx; /* pb-5 */
  border-radius: 32rpx;
  box-shadow: 0 16rpx 60rpx rgba(93, 64, 55, 0.12);
  position: relative;
  display: flex;
  flex-direction: column;
  flex: 1;
  min-height: 0;
}

.pose-doodle {
  position: absolute;
  top: 10rpx;
  right: 12rpx;
  font-size: 40rpx;
  opacity: 0.20;
  transform: rotate(12deg);
}

.pose-img-wrap {
  flex: 1;
  min-height: 0;
  border-radius: 4rpx; /* rounded-sm */
  overflow: hidden;
  background: #FFFFFF;
}

.pose-img {
  width: 100%;
  height: 100%;
}

.pose-tags {
  margin-top: 24rpx; /* mt-3 */
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: center;
  flex-shrink: 0;
}

.pose-chip {
  padding: 8rpx 20rpx; /* px-2.5 py-1 */
  border-radius: 32rpx; /* rounded-2xl */
  font-size: 24rpx; /* text-xs */
  font-weight: 700;
  border: 4rpx solid rgba(93, 64, 55, 0.10);
  box-shadow: 4rpx 4rpx 0 rgba(93, 64, 55, 0.10);
}

.pose-chip--enter {
  animation-duration: 300ms;
  animation-timing-function: ease-out;
  animation-fill-mode: both;
}

.pose-chip:nth-child(odd).pose-chip--enter {
  animation-name: pose-chip-in-odd;
}

.pose-chip:nth-child(even).pose-chip--enter {
  animation-name: pose-chip-in-even;
}

/* 标签随机倾斜 - 奇数向左，偶数向右 */
.pose-chip:nth-child(odd) {
  transform: rotate(-1.5deg);
}

.pose-chip:nth-child(even) {
  transform: rotate(1.5deg);
}

.chip-0 { background: #FFE5E5; color: #8B4545; border-color: #D4A5A5; }
.chip-1 { background: #FFF4E0; color: #8B6F47; border-color: #D4B896; }
.chip-2 { background: #F0E6FF; color: #6B4B8B; border-color: #B89FD4; }
.chip-3 { background: #E8F5E9; color: #4B7C4F; border-color: #9FC5A1; }
.chip-4 { background: #FFF0F5; color: #8B5A6B; border-color: #D4A5B5; }

.bottom {
  flex-shrink: 0;
  /* 对齐 Web：pb-14（56px），并叠加安全区 */
  padding: 0 0 calc(120rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.content--standalone .bottom,
.content--audit-compact .bottom {
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  gap: 18rpx;
}

.bottom--enter {
  animation: bottom-in 320ms ease-out both;
}

.shuffle-btn {
  width: 112rpx;
  height: 112rpx;
  border-radius: 999rpx;
  background: #FFC857;
  border: 4rpx solid #5D4037;
  box-shadow: 8rpx 8rpx 0 #5D4037;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.shuffle-btn:active {
  transform: scale(0.95);
  box-shadow: 4rpx 4rpx 0 #5D4037;
}

.shuffle-btn--active {
  transform: scale(0.95);
  box-shadow: 4rpx 4rpx 0 #5D4037;
}

.shuffle-btn--disabled {
  opacity: 0.55;
}

.shuffle-icon {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.7;
}

.shuffle-icon--spin {
  animation: shuffle-spin 1s linear infinite;
}

@keyframes shuffle-spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.shuffle-text {
  font-size: 28rpx; /* text-sm */
  font-weight: 500;
  color: rgba(93, 64, 55, 0.70);
}

/* Web 同款：标签选择器定位到页头下方 */
.tag-selector-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.30);
  z-index: 998;
}

.tag-selector-mask--enter {
  animation: tag-selector-mask-in 300ms ease-out both;
}

.tag-selector {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 999;
  padding: 0 40rpx;
  box-sizing: border-box;
}

.tag-selector--enter .tag-selector-card {
  animation: tag-selector-card-in 300ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.tag-selector-card {
  width: 100%;
  max-height: 60vh;
  background: #FFFBF0;
  border-radius: 32rpx;
  border: 4rpx solid rgba(93, 64, 55, 0.10);
  box-shadow: 0 16rpx 60rpx rgba(93, 64, 55, 0.20);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.tag-selector-header {
  padding: 32rpx; /* p-4 */
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 4rpx dashed rgba(93, 64, 55, 0.15);
}

.tag-selector-title {
  font-size: 36rpx; /* text-lg */
  font-weight: 700;
  color: #5D4037;
}

.tag-selector-close {
  width: 64rpx;
  min-width: 0;
  height: 64rpx;
  border-radius: 999rpx;
  background: rgba(93, 64, 55, 0.10);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  line-height: 1;
  transition: background-color 0.2s ease;
}

.tag-selector-close--active {
  background: rgba(93, 64, 55, 0.20);
}

.tag-selector-close-icon {
  width: 40rpx;
  height: 40rpx;
}

.tag-selector-body {
  flex: 1;
  padding: 32rpx;
  box-sizing: border-box;
}

.tag-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-content: flex-start;
  row-gap: 16rpx;
  width: 100%;
  box-sizing: border-box;
}

.grid-btn {
  flex: 0 0 31.5%;
  max-width: 31.5%;
  min-width: 31.5%;
  box-sizing: border-box;
  margin-bottom: 0;
  padding: 14rpx 10rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  font-weight: 700;
  background: #FFFFFF;
  color: rgba(93, 64, 55, 0.60);
  border: 4rpx dashed rgba(93, 64, 55, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  transition: border-color 0.2s ease, background-color 0.2s ease;
}

.grid-btn--active {
  background: #FFC857;
  color: #5D4037;
  border: 4rpx solid rgba(93, 64, 55, 0.20);
  box-shadow: 4rpx 4rpx 0 rgba(93, 64, 55, 0.15);
}

.grid-btn--touch {
  border-color: rgba(93, 64, 55, 0.30);
}

.tag-selector-footer {
  padding: 32rpx;
  border-top: 4rpx dashed rgba(93, 64, 55, 0.15);
  background: rgba(255, 255, 255, 0.50);
}

.shake-box {
  padding: 24rpx; /* p-3 */
  border-radius: 24rpx;
  background: linear-gradient(90deg, rgba(255, 200, 87, 0.20), rgba(255, 179, 71, 0.20));
  border: 4rpx dashed rgba(255, 200, 87, 0.40);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 32rpx; /* mb-4 */
}

.shake-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}

.shake-emoji {
  font-size: 42rpx;
}

.shake-emoji--on {
  animation: shake-bounce 0.9s ease-in-out infinite;
}

@keyframes shake-bounce {
  0% { transform: translateY(0); }
  50% { transform: translateY(-6rpx); }
  100% { transform: translateY(0); }
}

.shake-texts {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.shake-title {
  font-size: 28rpx; /* text-sm */
  font-weight: 700;
  color: #5D4037;
}

.shake-desc {
  margin-top: 2rpx;
  font-size: 24rpx; /* text-xs */
  color: rgba(93, 64, 55, 0.60);
}

.tag-selector-actions {
  display: flex;
  gap: 16rpx;
}

.btn-clear {
  flex: 1;
  padding: 24rpx 0; /* py-3 */
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #5D4037;
  border: 4rpx solid rgba(93, 64, 55, 0.20);
  font-weight: 700;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  transition: background-color 0.2s ease;
}

.btn-ok {
  flex: 1;
  padding: 24rpx 0;
  border-radius: 999rpx;
  background: #FFC857;
  color: #5D4037;
  border: 4rpx solid rgba(93, 64, 55, 0.20);
  font-weight: 700;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  transition: box-shadow 0.2s ease, transform 0.2s ease;
}

.btn-clear--active {
  background: rgba(93, 64, 55, 0.08);
}

.btn-ok--active {
  transform: scale(0.98);
  box-shadow: 0 8rpx 20rpx rgba(93, 64, 55, 0.12);
}

@keyframes tagbar-in {
  0% {
    opacity: 0;
    transform: translateY(-8rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes pose-card-in {
  0% {
    opacity: 0;
    transform: translateY(18rpx) scale(0.95);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes pose-chip-in-odd {
  0% {
    opacity: 0;
    transform: scale(0.8) rotate(-5deg);
  }
  100% {
    opacity: 1;
    transform: scale(1) rotate(-1.5deg);
  }
}

@keyframes pose-chip-in-even {
  0% {
    opacity: 0;
    transform: scale(0.8) rotate(-5deg);
  }
  100% {
    opacity: 1;
    transform: scale(1) rotate(1.5deg);
  }
}

@keyframes bottom-in {
  0% {
    opacity: 0;
    transform: translateY(40rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes tag-selector-mask-in {
  0% {
    opacity: 0;
  }
  100% {
    opacity: 1;
  }
}

@keyframes tag-selector-card-in {
  0% {
    opacity: 0;
    transform: translateY(-40rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}
