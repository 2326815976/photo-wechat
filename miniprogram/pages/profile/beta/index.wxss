@import "../../../styles/admin-loading.wxss";

.page {
  min-height: 100vh;
  background: #fffbf0;
  display: flex;
  flex-direction: column;
}

.content {
  flex: 1;
  padding: 28rpx 28rpx calc(88rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background-image:
    radial-gradient(circle at 6% 0%, rgba(255, 200, 87, 0.15), transparent 38%),
    radial-gradient(circle at 94% 16%, rgba(255, 153, 102, 0.1), transparent 36%);
}

.beta-shell {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.loading {
  padding-top: 150rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.loading-ring {
  position: relative;
  width: 164rpx;
  height: 164rpx;
}

.ring {
  position: absolute;
  border-radius: 999rpx;
  border-style: solid;
  box-sizing: border-box;
}

.ring--outer {
  inset: 0;
  border-width: 8rpx;
  border-color: rgba(255, 200, 87, 0.28);
  border-top-color: #ffc857;
  animation: spin 3s linear infinite;
}

.ring--inner {
  inset: 22rpx;
  border-width: 8rpx;
  border-color: rgba(93, 64, 55, 0.2);
  border-bottom-color: #5d4037;
  animation: spin-reverse 2s linear infinite;
}

.ring-center {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.center-icon {
  width: 56rpx;
  height: 56rpx;
}

.loading-text {
  font-size: 24rpx;
  color: rgba(93, 64, 55, 0.62);
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

@keyframes spin-reverse {
  0% { transform: rotate(360deg); }
  100% { transform: rotate(0deg); }
}

.bind-card,
.empty-card,
.feature-card {
  background: #ffffff;
  border-radius: 28rpx;
  border: 2rpx solid rgba(93, 64, 55, 0.1);
  box-shadow: 0 12rpx 32rpx rgba(93, 64, 55, 0.1);
}

.bind-card {
  position: relative;
  padding: 22rpx;
  overflow: hidden;
}

.bind-accent {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  height: 8rpx;
  background: linear-gradient(90deg, #ffc857 0%, #ffb347 100%);
}

.bind-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.bind-icon-wrap {
  width: 62rpx;
  height: 62rpx;
  border-radius: 999rpx;
  background: rgba(255, 200, 87, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.bind-icon {
  width: 34rpx;
  height: 34rpx;
}

.bind-head-main {
  flex: 1;
  min-width: 0;
}

.bind-title {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: #5d4037;
}

.bind-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: rgba(93, 64, 55, 0.58);
  line-height: 1.4;
}

.bind-row {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 10rpx;
}

.bind-input-box {
  flex: 1;
  min-width: 0;
  position: relative;
}

.bind-input {
  width: 100%;
  height: 72rpx;
  border-radius: 16rpx;
  border: 2rpx solid rgba(93, 64, 55, 0.16);
  background: #fffdf7;
  color: #5d4037;
  font-size: 24rpx;
  padding: 0 66rpx 0 18rpx;
  box-sizing: border-box;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

.bind-input-placeholder {
  color: rgba(93, 64, 55, 0.42);
  font-size: 23rpx;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

.paste-btn {
  position: absolute;
  right: 10rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 48rpx;
  height: 48rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 200, 87, 0.18);
}

.paste-btn--active {
  background: rgba(255, 200, 87, 0.3);
}

.paste-icon {
  width: 26rpx;
  height: 26rpx;
}

.bind-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 20rpx;
  color: rgba(93, 64, 55, 0.48);
}

.section-head {
  margin-top: 2rpx;
  margin-bottom: 2rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.section-main {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.section-icon-wrap {
  width: 44rpx;
  height: 44rpx;
  border-radius: 999rpx;
  background: rgba(255, 200, 87, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.section-icon {
  width: 22rpx;
  height: 22rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 900;
  color: #5d4037;
}

.section-count {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(93, 64, 55, 0.08);
  font-size: 21rpx;
  color: rgba(93, 64, 55, 0.62);
}

.empty-card {
  padding: 68rpx 20rpx;
  text-align: center;
}

.empty-icon-wrap {
  width: 92rpx;
  height: 92rpx;
  border-radius: 999rpx;
  background: rgba(255, 200, 87, 0.18);
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-icon {
  width: 46rpx;
  height: 46rpx;
  opacity: 0.72;
}

.empty-title {
  display: block;
  margin-top: 14rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #5d4037;
}

.empty-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: rgba(93, 64, 55, 0.58);
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.feature-card {
  padding: 20rpx;
}

.feature-head {
  display: flex;
  align-items: flex-start;
}

.feature-main {
  flex: 1;
  min-width: 0;
}

.feature-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

.feature-title {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: #5d4037;
}

.feature-badge {
  flex: none;
  height: 36rpx;
  min-width: 78rpx;
  border-radius: 999rpx;
  background: rgba(255, 200, 87, 0.22);
  color: #5d4037;
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 10rpx;
}

.feature-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
  color: rgba(93, 64, 55, 0.72);
  line-height: 1.45;
}

.feature-divider {
  height: 2rpx;
  margin-top: 14rpx;
  background: rgba(93, 64, 55, 0.08);
}

.feature-foot {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

.feature-meta-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.feature-meta-icon {
  width: 24rpx;
  height: 24rpx;
  flex: none;
}

.feature-meta {
  display: block;
  font-size: 21rpx;
  color: rgba(93, 64, 55, 0.56);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.feature-actions {
  flex: none;
}

.submit-btn {
  width: 100%;
  height: 56rpx;
  border-radius: 16rpx;
  background: linear-gradient(180deg, #ffd86c 0%, #ffc857 100%);
  color: #5d4037;
  font-size: 22rpx;
  font-weight: 800;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  line-height: 1;
  box-shadow: 0 6rpx 14rpx rgba(255, 200, 87, 0.38);
}

.submit-btn--compact {
  width: 132rpx;
  min-width: 132rpx;
  flex: 0 0 132rpx;
}

.submit-btn--bind {
  height: 72rpx;
  width: 100%;
  min-width: 0;
  align-self: stretch;
  border-radius: 16rpx;
  font-size: 23rpx;
  font-weight: 700;
}

.submit-btn--feature {
  width: 156rpx;
  min-width: 156rpx;
  height: 54rpx;
  border-radius: 14rpx;
  font-size: 20rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 10rpx rgba(255, 200, 87, 0.32);
}

.submit-row {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.submit-icon {
  width: 22rpx;
  height: 22rpx;
  flex: none;
}

.primary-btn {
  width: 220rpx;
  height: 58rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #ffd86c 0%, #ffc857 100%);
  color: #5d4037;
  font-size: 23rpx;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin: 16rpx auto 0;
}

button::after {
  border: none;
}

button[disabled] {
  opacity: 0.58;
}
