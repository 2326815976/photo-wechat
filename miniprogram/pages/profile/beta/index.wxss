.page {
  min-height: 100vh;
  background: #fffbf0;
  display: flex;
  flex-direction: column;
}

.content {
  flex: 1;
  padding: 36rpx 28rpx calc(120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.loading {
  padding-top: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}

.loading-spinner {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 8rpx solid rgba(255, 200, 87, 0.26);
  border-top-color: #ffc857;
  animation: spin 0.9s linear infinite;
}

.loading-text {
  font-size: 24rpx;
  color: rgba(93, 64, 55, 0.62);
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.bind-card,
.empty-card,
.feature-card {
  background: #ffffff;
  border-radius: 28rpx;
  border: 2rpx solid rgba(93, 64, 55, 0.1);
  box-shadow: 0 10rpx 28rpx rgba(93, 64, 55, 0.1);
}

.bind-card {
  padding: 22rpx;
}

.bind-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.bind-icon-wrap {
  width: 62rpx;
  height: 62rpx;
  border-radius: 999rpx;
  background: rgba(255, 200, 87, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.bind-icon {
  width: 34rpx;
  height: 34rpx;
}

.bind-head-main {
  flex: 1;
  min-width: 0;
}

.bind-title {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: #5d4037;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

.bind-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: rgba(93, 64, 55, 0.58);
  line-height: 1.4;
}

.bind-row {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.bind-input-box {
  flex: 1;
  min-width: 0;
  position: relative;
}

.bind-input {
  width: 100%;
  height: 64rpx;
  border-radius: 16rpx;
  border: 2rpx solid rgba(93, 64, 55, 0.16);
  background: #fffdf7;
  color: #5d4037;
  font-size: 24rpx;
  padding: 0 56rpx 0 16rpx;
  box-sizing: border-box;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

.bind-input-placeholder {
  color: rgba(93, 64, 55, 0.42);
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 24rpx;
}

.paste-btn {
  position: absolute;
  right: 10rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 42rpx;
  height: 42rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 200, 87, 0.18);
}

.paste-btn--active {
  background: rgba(255, 200, 87, 0.3);
}

.paste-icon {
  width: 24rpx;
  height: 24rpx;
}

.section-head {
  margin-top: 20rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.section-title {
  font-size: 34rpx;
  font-weight: 900;
  color: #5d4037;
}

.section-sub {
  font-size: 22rpx;
  color: rgba(93, 64, 55, 0.56);
}

.empty-card {
  padding: 72rpx 20rpx;
  text-align: center;
}

.empty-icon-wrap {
  width: 92rpx;
  height: 92rpx;
  border-radius: 999rpx;
  background: rgba(255, 200, 87, 0.18);
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-icon {
  width: 46rpx;
  height: 46rpx;
  opacity: 0.72;
}

.empty-title {
  display: block;
  margin-top: 14rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #5d4037;
}

.empty-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: rgba(93, 64, 55, 0.58);
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.feature-card {
  padding: 20rpx;
}

.feature-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10rpx;
}

.feature-main {
  flex: 1;
  min-width: 0;
}

.feature-title {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: #5d4037;
}

.feature-route {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(93, 64, 55, 0.56);
  word-break: break-all;
}

.feature-badge {
  flex: none;
  height: 36rpx;
  min-width: 78rpx;
  border-radius: 999rpx;
  background: rgba(255, 200, 87, 0.22);
  color: #5d4037;
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 10rpx;
}

.feature-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
  color: rgba(93, 64, 55, 0.72);
  line-height: 1.45;
}

.feature-meta {
  display: block;
  font-size: 21rpx;
  color: rgba(93, 64, 55, 0.52);
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.feature-foot {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.feature-actions {
  flex: none;
}

.submit-btn {
  width: 100%;
  height: 56rpx;
  border-radius: 16rpx;
  background: #ffc857;
  color: #5d4037;
  font-size: 22rpx;
  font-weight: 800;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  line-height: 1;
}

.submit-btn--compact {
  width: 124rpx;
  min-width: 124rpx;
  flex: 0 0 124rpx;
}

.submit-btn--bind {
  height: 56rpx;
  border-radius: 14rpx;
  font-size: 21rpx;
  font-weight: 700;
}

.submit-btn--feature {
  width: 136rpx;
  min-width: 136rpx;
  height: 52rpx;
  border-radius: 14rpx;
  font-size: 19rpx;
  font-weight: 700;
}

.submit-row {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.submit-icon {
  width: 24rpx;
  height: 24rpx;
  flex: none;
}

.primary-btn {
  width: 220rpx;
  height: 58rpx;
  border-radius: 999rpx;
  background: #ffc857;
  color: #5d4037;
  font-size: 23rpx;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin: 16rpx auto 0;
}

button[disabled] {
  opacity: 0.58;
}
