<view>
  <secondary-page-shell
    shell-class="page"
    managedPageKey="profile-beta"
    title="内测功能"
    subtitle=""
    fallbackTab="pages/profile/index"
    content-class="content"
    useScrollView="{{true}}"
    enableFlex="{{true}}"
  >
    <view class="admin-loading-card admin-loading-card--page motion-fade-up motion-delay-2" wx:if="{{loading}}">
      <view class="admin-loading-card__orb">
        <view class="admin-loading-card__spinner"></view>
      </view>
      <text class="admin-loading-card__title">拾光中...</text>
      <text class="admin-loading-card__desc">正在加载内测功能</text>
    </view>

    <view wx:elif="{{!isLoggedIn}}" class="empty-card motion-fade-up motion-delay-2">
      <view class="empty-icon-wrap">
        <image class="empty-icon" src="/images/icons/lock-yellow.svg" mode="aspectFit" />
      </view>
      <text class="empty-title">请先登录</text>
      <text class="empty-desc">登录后可输入管理员提供的内测码</text>
      <button class="primary-btn" bindtap="onGoLogin">前往登录</button>
    </view>

    <view wx:else class="beta-shell">
      <view class="bind-card motion-fade-up motion-delay-2">
        <view class="bind-accent"></view>
        <view class="bind-head">
          <view class="bind-icon-wrap">
            <image class="bind-icon" src="/images/icons/sparkles-yellow.svg" mode="aspectFit" />
          </view>
          <view class="bind-head-main">
            <text class="bind-title">输入内测码</text>
            <text class="bind-desc">绑定后会在下方列表显示你可使用的内测功能</text>
          </view>
        </view>

        <view class="bind-row">
          <view class="bind-input-box">
            <input
              class="bind-input"
              value="{{codeInput}}"
              bindinput="onCodeInput"
              placeholder="请输入管理员提供的内测码"
              placeholder-class="bind-input-placeholder"
              maxlength="8"
            />
            <view class="paste-btn" hover-class="paste-btn--active" hover-stay-time="80" bindtap="onPasteCode">
              <image class="paste-icon" src="/images/icons/clipboard-brown.svg" mode="aspectFit" />
            </view>
          </view>
          <button
            class="submit-btn submit-btn--compact submit-btn--bind"
            bindtap="onBindCode"
            loading="{{submitting}}"
            disabled="{{submitting}}"
          >
            {{submitting ? '绑定中...' : '绑定'}}
          </button>
        </view>
        <text class="bind-hint">仅支持 8 位大写字母或数字</text>
      </view>

      <view class="section-head motion-fade-up motion-delay-3">
        <view class="section-main">
          <view class="section-icon-wrap">
            <image class="section-icon" src="/images/icons/sparkles-yellow.svg" mode="aspectFit" />
          </view>
          <text class="section-title">已解锁功能</text>
        </view>
        <view class="section-count">共 {{featureRows.length}} 个</view>
      </view>

      <view class="empty-card motion-fade-up motion-delay-4" wx:if="{{!featureRows.length}}">
        <view class="empty-icon-wrap">
          <image class="empty-icon" src="/images/icons/sparkles-brown.svg" mode="aspectFit" />
        </view>
        <text class="empty-title">暂无已解锁功能</text>
        <text class="empty-desc">输入有效内测码后，这里会展示功能入口</text>
      </view>

      <view class="feature-list" wx:else>
        <view
          class="feature-card motion-fade-up"
          wx:for="{{featureRows}}"
          wx:key="id"
          style="animation-delay: {{100 + (index % 8) * 35}}ms;"
        >
          <view class="feature-head">
            <view class="feature-main">
              <view class="feature-title-row">
                <text class="feature-title">{{item.feature_name}}</text>
                <view class="feature-badge">内测</view>
              </view>
              <text class="feature-desc">{{item.feature_description}}</text>
            </view>
          </view>

          <view class="feature-divider"></view>
          <view class="feature-foot">
            <view class="feature-meta-wrap">
              <image class="feature-meta-icon" src="/images/icons/calendar-muted.svg" mode="aspectFit" />
              <text class="feature-meta">{{item.expires_text}}</text>
              <view class="feature-actions">
                <view
                  class="feature-action-btn feature-action-btn--secondary {{(unbindingFeatureId === item.id) || (enteringFeatureId !== '') ? 'feature-action-btn--disabled' : ''}}"
                  data-id="{{item.id}}"
                  hover-class="feature-action-btn--hover"
                  hover-stay-time="80"
                  bindtap="onUnbindFeature"
                >
                  <text>{{unbindingFeatureId === item.id ? unbindingButtonText : unbindButtonText}}</text>
                </view>
                <view
                  class="feature-action-btn feature-action-btn--primary feature-action-btn--enter {{(enteringFeatureId === item.id) || (unbindingFeatureId !== '') ? 'feature-action-btn--disabled' : ''}}"
                  data-id="{{item.id}}"
                  hover-class="feature-action-btn--hover"
                  hover-stay-time="80"
                  bindtap="onEnterFeature"
                >
                  <view class="feature-action-btn__content">
                    <text>{{enteringFeatureId === item.id ? enteringButtonText : enterButtonText}}</text>
                    <image
                      wx:if="{{enteringFeatureId !== item.id}}"
                      class="feature-action-btn__icon"
                      src="/images/icons/chevrons-right-brown.svg"
                      mode="aspectFit"
                    />
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </secondary-page-shell>

  <view class="modal-mask motion-fade-in" wx:if="{{unbindTargetFeature}}" bindtap="cancelUnbindFeature"></view>
  <view class="confirm-modal motion-fade-in" wx:if="{{unbindTargetFeature}}">
    <view class="confirm-card motion-pop-in" catchtap="noop">
      <view class="confirm-icon-wrap">
        <image class="confirm-icon" src="/images/icons/sparkles-yellow.svg" mode="aspectFit" />
      </view>
      <text class="confirm-title">解除内测绑定？</text>
      <text class="confirm-text">解除后不会删除内测内容，你仍可通过内测码重新进入并再次绑定。</text>
      <text class="confirm-tip">当前功能：{{unbindTargetFeature.feature_name || '未命名功能'}}</text>

      <view class="confirm-actions">
        <button
          class="confirm-btn confirm-btn--ghost"
          hover-class="confirm-btn--ghost-active"
          bindtap="cancelUnbindFeature"
          disabled="{{unbindingFeatureId !== ''}}"
        >
          再想想
        </button>
        <button
          class="confirm-btn confirm-btn--primary"
          hover-class="confirm-btn--primary-active"
          bindtap="confirmUnbindFeature"
          disabled="{{unbindingFeatureId !== ''}}"
        >
          {{unbindingFeatureId ? '解绑中...' : '确认解除'}}
        </button>
      </view>
    </view>
  </view>
</view>
