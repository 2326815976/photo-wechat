<view class="page">
  <app-header
    title="功能内测"
    subtitle="🔓 输入内测码解锁功能"
    safeTop="{{safeTop}}"
    showBack="{{true}}"
    fallbackTab="pages/profile/index"
  />

  <scroll-view class="content" scroll-y="true" enable-flex="true">
    <view class="loading" wx:if="{{loading}}">
      <view class="loading-spinner"></view>
      <text class="loading-text">正在加载内测功能...</text>
    </view>

    <view wx:elif="{{!isLoggedIn}}" class="empty-card">
      <view class="empty-icon-wrap">
        <image class="empty-icon" src="/images/icons/lock-yellow.svg" mode="aspectFit" />
      </view>
      <text class="empty-title">请先登录</text>
      <text class="empty-desc">{{hideAudit ? '请先在关于页使用微信登录' : '登录后可输入管理员提供的内测码'}}</text>
      <button class="primary-btn" bindtap="onGoLogin">{{hideAudit ? '返回关于' : '前往登录'}}</button>
    </view>

    <view wx:else>
      <view class="bind-card">
        <view class="bind-head">
          <view class="bind-icon-wrap">
            <image class="bind-icon" src="/images/icons/sparkles-yellow.svg" mode="aspectFit" />
          </view>
          <view class="bind-head-main">
            <text class="bind-title">输入内测码</text>
            <text class="bind-desc">绑定后会在下方列表显示你可使用的内测功能</text>
          </view>
        </view>

        <view class="bind-row">
          <view class="bind-input-box">
            <input
              class="bind-input"
              value="{{codeInput}}"
              bindinput="onCodeInput"
              placeholder="请输入管理员提供的内测码"
              placeholder-class="bind-input-placeholder"
              maxlength="64"
            />
            <view class="paste-btn" hover-class="paste-btn--active" hover-stay-time="80" bindtap="onPasteCode">
              <image class="paste-icon" src="/images/icons/clipboard-brown.svg" mode="aspectFit" />
            </view>
          </view>
          <button
            class="submit-btn submit-btn--compact submit-btn--bind"
            bindtap="onBindCode"
            loading="{{submitting}}"
            disabled="{{submitting}}"
          >
            {{submitting ? '绑定中...' : '绑定'}}
          </button>
        </view>
      </view>

      <view class="section-head">
        <text class="section-title">已解锁功能</text>
        <text class="section-sub">共 {{featureRows.length}} 个</text>
      </view>

      <view class="empty-card" wx:if="{{!featureRows.length}}">
        <view class="empty-icon-wrap">
          <image class="empty-icon" src="/images/icons/sparkles-brown.svg" mode="aspectFit" />
        </view>
        <text class="empty-title">暂无已解锁功能</text>
        <text class="empty-desc">输入有效内测码后，这里会展示功能入口</text>
      </view>

      <view class="feature-list" wx:else>
        <view class="feature-card" wx:for="{{featureRows}}" wx:key="id">
          <view class="feature-head">
            <view class="feature-main">
              <text class="feature-title">{{item.feature_name}}</text>
              <text class="feature-route">{{item.route_title || '功能入口'}} · {{item.route_path || '未配置路径'}}</text>
            </view>
            <view class="feature-badge">内测</view>
          </view>

          <text class="feature-desc" wx:if="{{item.feature_description}}">{{item.feature_description}}</text>
          <text class="feature-meta">{{item.expires_text}}</text>

          <view class="feature-actions">
            <button
              class="submit-btn"
              data-id="{{item.id}}"
              bindtap="onEnterFeature"
              loading="{{enteringFeatureId === item.id}}"
              disabled="{{enteringFeatureId === item.id}}"
            >
              <view class="submit-row">
                <image class="submit-icon" src="/images/icons/sparkles-brown.svg" mode="aspectFit" />
                <text>{{enteringFeatureId === item.id ? '进入中...' : '进入功能'}}</text>
              </view>
            </button>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
