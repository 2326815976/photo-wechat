@import "../../styles/admin-loading.wxss";

.page {
  min-height: 100vh;
  background: #FFFBF0;
}

.page--preview {
  min-height: 100vh;
}

.content {
  /* Web: px-6 pt-6 pb-20 */
  padding: 48rpx 48rpx calc(160rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.content--preview {
  padding-bottom: calc(8rpx + env(safe-area-inset-bottom));
}

.list-notice {
  margin-bottom: 16rpx;
  border-radius: 20rpx;
  border: 2rpx solid transparent;
  padding: 18rpx 24rpx;
  font-size: 22rpx;
  line-height: 1.45;
}

.list-notice--success {
  background: #f0fdf4;
  border-color: #bbf7d0;
  color: #15803d;
}

.list-notice--error {
  background: #fef2f2;
  border-color: #fecaca;
  color: #b91c1c;
}

.config-tip {
  background: rgba(255, 255, 255, 0.75);
  border: 4rpx dashed rgba(93, 64, 55, 0.15);
  border-radius: 28rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 18rpx;
}

.config-tip__title {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: #5D4037;
  margin-bottom: 6rpx;
}

.config-tip__desc {
  display: block;
  font-size: 22rpx;
  color: rgba(93, 64, 55, 0.60);
}

.loading {
  padding-top: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
}

.loading-ring {
  position: relative;
  width: 192rpx;
  height: 192rpx;
}

.ring {
  position: absolute;
  border-radius: 999rpx;
  border-style: solid;
  box-sizing: border-box;
}

.ring--outer {
  inset: 0;
  border-width: 10rpx;
  border-color: rgba(255, 200, 87, 0.30);
  border-top-color: #FFC857;
  animation: spin 3s linear infinite;
}

.ring--inner {
  inset: 24rpx;
  border-width: 10rpx;
  border-color: rgba(93, 64, 55, 0.20);
  border-bottom-color: #5D4037;
  animation: spin-reverse 2s linear infinite;
}

.ring-center {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.center-icon {
  width: 64rpx;
  height: 64rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

@keyframes spin-reverse {
  0% { transform: rotate(360deg); }
  100% { transform: rotate(0deg); }
}

.loading-text {
  text-align: center;
}

.loading-title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #5D4037;
  margin-bottom: 6rpx;
}

.loading-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(93, 64, 55, 0.60);
}

.album-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.album-card {
  background: rgba(255, 255, 255, 0.96);
  border-radius: 32rpx;
  border: 2rpx solid rgba(93, 64, 55, 0.10);
  box-shadow: 0 12rpx 28rpx rgba(93, 64, 55, 0.10);
  padding: 26rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.album-card--active {
  transform: scale(0.99);
  box-shadow: 0 16rpx 42rpx rgba(93, 64, 55, 0.14);
}

.album-cover-img {
  width: 152rpx;
  height: 152rpx;
  display: block;
  flex: none;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 18rpx rgba(93, 64, 55, 0.12);
}

.album-cover-placeholder {
  width: 152rpx;
  height: 152rpx;
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  color: rgba(93, 64, 55, 0.30);
  border-radius: 28rpx;
  background: #F6EFE3;
  box-shadow: 0 8rpx 18rpx rgba(93, 64, 55, 0.08);
}

.album-cover-placeholder-icon {
  width: 52rpx;
  height: 52rpx;
  opacity: 0.22;
}

.album-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 16rpx;
  min-height: 152rpx;
}

.album-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.album-title-wrap {
  flex: 1;
  min-width: 0;
  min-height: 60rpx;
  display: flex;
  align-items: center;
}

.album-title {
  display: block;
  font-size: 34rpx;
  font-weight: 900;
  color: #5D4037;
  line-height: 1.18;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.album-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  min-height: 48rpx;
}

.album-meta-text {
  display: block;
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
  color: rgba(93, 64, 55, 0.50);
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.album-expiry-pill {
  flex: none;
  max-width: 100%;
  min-height: 48rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  border: 2rpx solid rgba(229, 216, 194, 0.9);
  background: linear-gradient(180deg, #FFFDF9 0%, #F8EEE0 100%);
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.92),
    0 6rpx 16rpx rgba(93, 64, 55, 0.05);
}

.album-expiry-pill__text {
  display: block;
  white-space: nowrap;
  color: #7A5A4A;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1;
  letter-spacing: 0.6rpx;
}

.album-expiry-pill--expired {
  border-color: rgba(243, 186, 186, 0.9);
  background: linear-gradient(180deg, #FFF8F8 0%, #FDEEEE 100%);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.92),
    0 6rpx 16rpx rgba(239, 68, 68, 0.05);
}

.album-expiry-pill--expired .album-expiry-pill__text {
  color: #D85A5A;
}

.add-btn {
  margin-top: 22rpx;
  width: 100%;
  padding: 32rpx 0;
  border-radius: 32rpx;
  background: transparent;
  border: 4rpx dashed rgba(93, 64, 55, 0.30);
  color: rgba(93, 64, 55, 0.70);
  font-weight: 800;
  font-size: 26rpx;
  transition: border-color 0.2s ease, color 0.2s ease;
}

.add-btn--active {
  border-color: rgba(93, 64, 55, 0.50);
  color: #5D4037;
}

.add-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.add-icon {
  width: 34rpx;
  height: 34rpx;
  opacity: 0.75;
}

.key-wrap {
  padding-top: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.key-icon {
  width: 152rpx;
  height: 152rpx;
  border-radius: 999rpx;
  background: rgba(255, 200, 87, 0.18);
  box-shadow: 0 12rpx 28rpx rgba(255, 200, 87, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
  animation: key-icon-float 3.2s ease-in-out infinite;
}

.key-icon-img {
  width: 76rpx;
  height: 76rpx;
  animation: key-lock-breathe 2.6s ease-in-out infinite;
}

.key-card {
  width: 100%;
  background: #FFFFFF;
  border-radius: 34rpx;
  border: 2rpx solid rgba(93, 64, 55, 0.08);
  box-shadow: 0 18rpx 44rpx rgba(93, 64, 55, 0.10);
  padding: 30rpx 28rpx 26rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

.key-bg {
  position: absolute;
  top: -80rpx;
  right: -80rpx;
  width: 260rpx;
  height: 260rpx;
  background: rgba(255, 200, 87, 0.12);
  border-radius: 999rpx;
  /* Web: blur-3xl（64px） */
  filter: blur(64px);
}

/* Web 同款：相对容器，粘贴按钮使用 absolute */
.key-input-box {
  position: relative;
  z-index: 1;
  width: 100%;
  padding: 8rpx;
  border-radius: 38rpx;
  background: linear-gradient(180deg, rgba(255, 208, 107, 0.26), rgba(255, 200, 87, 0.08));
  border: 2rpx solid rgba(255, 200, 87, 0.40);
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.92), 0 6rpx 16rpx rgba(255, 200, 87, 0.08);
  box-sizing: border-box;
}

.key-input {
  width: 100%;
  /* Web 输入框视觉高度约 52px；小程序使用固定高度对齐 */
  height: 98rpx;
  /* Web: px-4 + pr-12（右侧为粘贴按钮预留） */
  padding-left: 30rpx;
  padding-right: 108rpx;
  border-radius: 30rpx;
  background: linear-gradient(180deg, #FFFEFA 0%, #FFF9EE 100%);
  border: 3rpx solid rgba(93, 64, 55, 0.16);
  font-family: "ZQKNNY", "YouYuan", "Microsoft YaHei", sans-serif;
  font-size: 29rpx;
  font-weight: 700;
  text-align: center;
  letter-spacing: 1.8rpx;
  box-sizing: border-box;
}

.key-input-placeholder {
  font-family: "ZQKNNY", "YouYuan", "Microsoft YaHei", sans-serif;
}

.paste-btn {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 60rpx;
  min-width: 0;
  height: 60rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #FFE79C 0%, #FFD978 100%);
  border: 2rpx solid rgba(93, 64, 55, 0.10);
  box-shadow: 0 6rpx 14rpx rgba(93, 64, 55, 0.10);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  line-height: 1;
  z-index: 2;
  transition: background-color 0.2s ease;
}

.paste-btn--active {
  background: #FFD989;
}

.paste-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.9;
}

.paste-btn::after {
  border: none;
}

.error-slot {
  position: relative;
  z-index: 1;
  min-height: 36rpx;
  margin-top: 10rpx;
}

.error {
  width: 100%;
  display: block;
  margin-top: 0;
  text-align: center;
  color: #EF4444;
  font-size: 21rpx;
  line-height: 1.45;
}

.submit-btn-wrap {
  position: relative;
  z-index: 1;
  width: 100%;
  margin-top: 14rpx;
  padding: 0 34rpx;
  box-sizing: border-box;
}

.submit-btn {
  position: relative;
  z-index: 1;
  width: 100%;
  min-width: 0;
  max-width: none;
  height: 96rpx;
  margin: 0;
  border-radius: 30rpx;
  background: linear-gradient(180deg, #FFD86A 0%, #FFC857 100%);
  color: #5D4037;
  border: 3rpx solid rgba(93, 64, 55, 0.78);
  box-shadow: 0 8rpx 0 #7A5843, 0 14rpx 24rpx rgba(255, 200, 87, 0.20);
  font-weight: 900;
  font-size: 29rpx;
  letter-spacing: 1rpx;
  /* 小程序 button 在固定高度下默认不会垂直居中，这里对齐 Web 的 flex 居中按钮 */
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  box-sizing: border-box;
  flex: none;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.submit-btn:active {
  transform: translateY(4rpx);
  box-shadow: 0 4rpx 0 #7A5843, 0 10rpx 18rpx rgba(255, 200, 87, 0.16);
}

.submit-btn--active {
  transform: translateY(4rpx);
  box-shadow: 0 4rpx 0 #7A5843, 0 10rpx 18rpx rgba(255, 200, 87, 0.16);
}

.submit-btn--disabled {
  opacity: 0.60;
}

.submit-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  transform: translateY(-1rpx);
}

.submit-icon {
  width: 32rpx;
  height: 32rpx;
}

.submit-icon--spin {
  animation: spin 1s linear infinite;
}

.key-tips {
  position: relative;
  z-index: 1;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid rgba(93, 64, 55, 0.10);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.key-tip {
  font-size: 20rpx;
  color: rgba(93, 64, 55, 0.50);
  text-align: center;
  line-height: 1.65;
}

.back-btn {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: rgba(93, 64, 55, 0.60);
  transition: color 0.2s ease, opacity 0.2s ease;
}

.back-btn--active {
  color: #5D4037;
  opacity: 0.9;
}

.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 998;
}

.confirm-modal {
  position: fixed;
  inset: 0;
  z-index: 999;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.confirm-card {
  width: 100%;
  max-width: 620rpx;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 34rpx 30rpx;
  box-sizing: border-box;
  box-shadow: 0 24rpx 70rpx rgba(93, 64, 55, 0.26);
}

.confirm-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 999rpx;
  margin: 0 auto 18rpx;
  background: rgba(255, 200, 87, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.confirm-icon {
  width: 54rpx;
  height: 54rpx;
}

.confirm-title {
  display: block;
  text-align: center;
  font-size: 36rpx;
  font-weight: 900;
  color: #5d4037;
  margin-bottom: 14rpx;
}

.confirm-text {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: rgba(93, 64, 55, 0.75);
  line-height: 1.6;
}

.confirm-tip {
  display: block;
  text-align: center;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(93, 64, 55, 0.55);
  line-height: 1.5;
}

.confirm-actions {
  margin-top: 24rpx;
  display: flex;
  gap: 12rpx;
}

.confirm-btn {
  flex: 1;
  height: 82rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 0.2s ease, transform 0.2s ease;
}

.confirm-btn--ghost {
  background: rgba(93, 64, 55, 0.1);
  color: #5d4037;
}

.confirm-btn--primary {
  background: #ffc857;
  color: #5d4037;
}

.confirm-btn--ghost-active {
  background: rgba(93, 64, 55, 0.2);
}

.confirm-btn--primary-active {
  transform: scale(0.98);
}

@keyframes key-icon-float {
  0%, 100% {
    transform: translateY(0);
    box-shadow: 0 10rpx 22rpx rgba(255, 200, 87, 0.20);
  }
  50% {
    transform: translateY(-6rpx);
    box-shadow: 0 16rpx 28rpx rgba(255, 200, 87, 0.30);
  }
}

@keyframes key-lock-breathe {
  0%, 100% {
    transform: scale(1);
    opacity: 0.96;
  }
  50% {
    transform: scale(1.06);
    opacity: 1;
  }
}

.album-actions {
  flex: none;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.album-icon-btn {
  margin: 0;
  box-sizing: border-box;
  flex: none;
  width: 60rpx;
  height: 60rpx;
  min-width: 60rpx;
  min-height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  border-radius: 999rpx;
  overflow: hidden;
  transition: transform 0.18s ease, opacity 0.18s ease, background-color 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
}

.album-icon-btn--danger {
  padding: 0;
  border: 2rpx solid transparent;
  background: rgba(239, 68, 68, 0.07);
  box-shadow: inset 0 0 0 2rpx rgba(239, 68, 68, 0.08);
}

.album-icon-btn--enter {
  padding: 0;
  border-color: rgba(109, 84, 74, 0.12);
  background: #FFF9EC;
  box-shadow: inset 0 0 0 2rpx rgba(255, 208, 100, 0.12);
}

.album-icon-btn--danger-active {
  transform: scale(0.96);
  background: rgba(239, 68, 68, 0.12);
}

.album-icon-btn--enter-active {
  transform: scale(0.96);
  background: #FFF3D6;
}

.album-icon-btn--disabled {
  opacity: 0.42;
}

.album-icon-btn__icon,
.album-icon-btn__loading {
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.album-icon-btn__icon {
  width: 26rpx;
  height: 26rpx;
}

.album-icon-btn__icon--danger {
  width: 24rpx;
  height: 24rpx;
}

.album-icon-btn__icon--enter {
  width: 22rpx;
  height: 22rpx;
}

.album-icon-btn__loading {
  font-size: 28rpx;
  color: #DC2626;
}

