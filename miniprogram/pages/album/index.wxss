.page {
  min-height: 100vh;
  background: #FFFBF0;
}

.content {
  /* Web: px-6 pt-6 pb-20 */
  padding: 48rpx 48rpx calc(160rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.list-notice {
  margin-bottom: 16rpx;
  border-radius: 20rpx;
  border: 2rpx solid transparent;
  padding: 18rpx 24rpx;
  font-size: 22rpx;
  line-height: 1.45;
}

.list-notice--success {
  background: #f0fdf4;
  border-color: #bbf7d0;
  color: #15803d;
}

.list-notice--error {
  background: #fef2f2;
  border-color: #fecaca;
  color: #b91c1c;
}

.config-tip {
  background: rgba(255, 255, 255, 0.75);
  border: 4rpx dashed rgba(93, 64, 55, 0.15);
  border-radius: 28rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 18rpx;
}

.config-tip__title {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: #5D4037;
  margin-bottom: 6rpx;
}

.config-tip__desc {
  display: block;
  font-size: 22rpx;
  color: rgba(93, 64, 55, 0.60);
}

.loading {
  padding-top: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
}

.loading-ring {
  position: relative;
  width: 192rpx;
  height: 192rpx;
}

.ring {
  position: absolute;
  border-radius: 999rpx;
  border-style: solid;
  box-sizing: border-box;
}

.ring--outer {
  inset: 0;
  border-width: 10rpx;
  border-color: rgba(255, 200, 87, 0.30);
  border-top-color: #FFC857;
  animation: spin 3s linear infinite;
}

.ring--inner {
  inset: 24rpx;
  border-width: 10rpx;
  border-color: rgba(93, 64, 55, 0.20);
  border-bottom-color: #5D4037;
  animation: spin-reverse 2s linear infinite;
}

.ring-center {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.center-icon {
  width: 64rpx;
  height: 64rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

@keyframes spin-reverse {
  0% { transform: rotate(360deg); }
  100% { transform: rotate(0deg); }
}

.loading-text {
  text-align: center;
}

.loading-title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #5D4037;
  margin-bottom: 6rpx;
}

.loading-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(93, 64, 55, 0.60);
}

.album-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.album-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  border: 2rpx solid rgba(93, 64, 55, 0.10);
  box-shadow: 0 12rpx 36rpx rgba(93, 64, 55, 0.10);
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.album-card--active {
  transform: scale(0.99);
  box-shadow: 0 16rpx 42rpx rgba(93, 64, 55, 0.14);
}

.album-cover {
  width: 192rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background: rgba(93, 64, 55, 0.06);
  flex: none;
}

.album-cover-img {
  width: 100%;
  display: block;
  height: auto;
}

.album-cover-placeholder {
  width: 192rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(93, 64, 55, 0.30);
}

.album-cover-placeholder-icon {
  width: 56rpx;
  height: 56rpx;
  opacity: 0.22;
}

.album-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.album-title {
  font-size: 30rpx;
  font-weight: 900;
  color: #5D4037;
}

.album-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.album-meta-icon {
  width: 24rpx;
  height: 24rpx;
}

.album-meta-text {
  font-size: 22rpx;
  color: rgba(93, 64, 55, 0.50);
}

.album-expiry {
  font-size: 22rpx;
  color: rgba(93, 64, 55, 0.50);
}

.album-expiry--soon {
  color: #F59E0B;
}

.album-expiry--expired {
  color: #EF4444;
}

.album-arrow {
  width: 64rpx;
  height: 64rpx;
  border-radius: 999rpx;
  background: rgba(255, 200, 87, 0.20);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFC857;
  font-size: 32rpx;
  flex: none;
}

.album-actions {
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12rpx;
}

.unbind-btn {
  flex: none;
  width: auto;
  min-width: 0;
  max-width: 200rpx;
  height: 44rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  border: 2rpx solid #FECACA;
  background: #FEF2F2;
  color: #DC2626;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  white-space: nowrap;
  align-self: flex-end;
}

.unbind-btn-icon {
  width: 26rpx;
  height: 26rpx;
  flex: none;
}

.unbind-btn--active {
  opacity: 0.8;
}

.unbind-btn--disabled {
  opacity: 0.6;
}

.add-btn {
  margin-top: 22rpx;
  width: 100%;
  padding: 32rpx 0;
  border-radius: 32rpx;
  background: transparent;
  border: 4rpx dashed rgba(93, 64, 55, 0.30);
  color: rgba(93, 64, 55, 0.70);
  font-weight: 800;
  font-size: 26rpx;
  transition: border-color 0.2s ease, color 0.2s ease;
}

.add-btn--active {
  border-color: rgba(93, 64, 55, 0.50);
  color: #5D4037;
}

.add-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.add-icon {
  width: 34rpx;
  height: 34rpx;
  opacity: 0.75;
}

.key-wrap {
  padding-top: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.key-icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 999rpx;
  background: rgba(255, 200, 87, 0.20);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.key-icon-img {
  width: 80rpx;
  height: 80rpx;
}

.key-card {
  width: 100%;
  background: #FFFFFF;
  border-radius: 32rpx;
  border: 2rpx solid rgba(93, 64, 55, 0.10);
  box-shadow: 0 12rpx 36rpx rgba(93, 64, 55, 0.12);
  padding: 28rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

.key-bg {
  position: absolute;
  top: -80rpx;
  right: -80rpx;
  width: 260rpx;
  height: 260rpx;
  background: rgba(255, 200, 87, 0.12);
  border-radius: 999rpx;
  /* Web: blur-3xl（64px） */
  filter: blur(64px);
}

/* Web 同款：相对容器，粘贴按钮 absolute */
.key-input-box {
  position: relative;
  z-index: 1;
}

.key-input {
  width: 100%;
  /* Web 输入框视觉高度约 52px（py-3 + text-lg + border）；小程序用固定高度对齐 */
  height: 104rpx;
  /* Web: px-4 + pr-12（右侧为粘贴按钮预留） */
  padding-left: 32rpx;
  padding-right: 112rpx;
  border-radius: 32rpx; /* rounded-2xl */
  background: #FFFBF0;
  border: 4rpx solid rgba(93, 64, 55, 0.20);
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
  letter-spacing: 2rpx;
  box-sizing: border-box;
}

.key-input-placeholder {
  font-family: "ZQKNNY", "YouYuan", "幼圆", "Microsoft YaHei", sans-serif;
}

.paste-btn {
  position: absolute;
  right: 16rpx; /* right-2 */
  top: 50%;
  transform: translateY(-50%);
  width: 64rpx; /* w-8 */
  min-width: 0;
  height: 64rpx; /* h-8 */
  border-radius: 999rpx;
  background: rgba(255, 200, 87, 0.20);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  line-height: 1;
  z-index: 2;
  transition: background-color 0.2s ease;
}

.paste-btn--active {
  background: rgba(255, 200, 87, 0.32);
}

.paste-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.9;
}

.paste-btn::after {
  border: none;
}

.error {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 12rpx;
  text-align: center;
  color: #EF4444;
  font-size: 24rpx;
}

.submit-btn {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 96rpx;
  margin-top: 22rpx;
  border-radius: 32rpx;
  background: #FFC857;
  color: #5D4037;
  border: 4rpx solid #5D4037;
  box-shadow: 8rpx 8rpx 0 #5D4037;
  font-weight: 900;
  font-size: 28rpx;
  /* 小程序 button 在固定高度下默认不做垂直居中：对齐 Web 端 flex 居中按钮 */
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.submit-btn:active {
  transform: translate(4rpx, 4rpx);
  box-shadow: 4rpx 4rpx 0 #5D4037;
}

.submit-btn--active {
  transform: translate(4rpx, 4rpx);
  box-shadow: 4rpx 4rpx 0 #5D4037;
}

.submit-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.submit-icon {
  width: 34rpx;
  height: 34rpx;
}

.submit-icon--spin {
  animation: spin 1s linear infinite;
}

.submit-btn[disabled] {
  opacity: 0.60;
}

.key-tips {
  position: relative;
  z-index: 1;
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid rgba(93, 64, 55, 0.10);
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.key-tip {
  font-size: 22rpx;
  color: rgba(93, 64, 55, 0.50);
  text-align: center;
}

.back-btn {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: rgba(93, 64, 55, 0.60);
  transition: color 0.2s ease, opacity 0.2s ease;
}

.back-btn--active {
  color: #5D4037;
  opacity: 0.9;
}

.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 998;
}

.confirm-modal {
  position: fixed;
  inset: 0;
  z-index: 999;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.confirm-card {
  width: 100%;
  max-width: 620rpx;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 34rpx 30rpx;
  box-sizing: border-box;
  box-shadow: 0 24rpx 70rpx rgba(93, 64, 55, 0.26);
}

.confirm-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 999rpx;
  margin: 0 auto 18rpx;
  background: rgba(255, 200, 87, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.confirm-icon {
  width: 54rpx;
  height: 54rpx;
}

.confirm-title {
  display: block;
  text-align: center;
  font-size: 36rpx;
  font-weight: 900;
  color: #5d4037;
  margin-bottom: 14rpx;
}

.confirm-text {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: rgba(93, 64, 55, 0.75);
  line-height: 1.6;
}

.confirm-tip {
  display: block;
  text-align: center;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(93, 64, 55, 0.55);
  line-height: 1.5;
}

.confirm-actions {
  margin-top: 24rpx;
  display: flex;
  gap: 12rpx;
}

.confirm-btn {
  flex: 1;
  height: 82rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 0.2s ease, transform 0.2s ease;
}

.confirm-btn--ghost {
  background: rgba(93, 64, 55, 0.1);
  color: #5d4037;
}

.confirm-btn--primary {
  background: #ffc857;
  color: #5d4037;
}

.confirm-btn--ghost-active {
  background: rgba(93, 64, 55, 0.2);
}

.confirm-btn--primary-active {
  transform: scale(0.98);
}
