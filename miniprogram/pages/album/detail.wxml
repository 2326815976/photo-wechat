<page-meta page-style="{{(switchingFolderLoading || pendingFolderPhotoIds.length > 0) ? 'overflow: hidden;' : ''}}" />
<view wx:if="{{!pageScaffoldReady}}" class="page">
  <view class="page-loading-shell page-loading-shell--full">
    <view class="admin-loading-card admin-loading-card--page motion-fade-up motion-delay-2">
      <view class="admin-loading-card__orb">
        <view class="admin-loading-card__spinner"></view>
      </view>
      <text class="admin-loading-card__title">拾光中...</text>
      <text class="admin-loading-card__desc">正在加载页面</text>
    </view>
  </view>
</view>

<view wx:if="{{pageScaffoldReady}}" class="page">
  <app-header
    id="albumHeader"
    class="album-header-host"
    title="{{headerTitle}}"
    subtitle="✨ 趁魔法消失前，把美好定格 ✨"
    safeTop="{{safeTop}}"
    showBack="{{true}}"
    fallbackTab="pages/album/index"
    preferFallback="{{false}}"
  />

  <view class="content">
    <view class="config-tip motion-fade-up motion-delay-1" wx:if="{{serviceMissing}}">
      <text class="config-tip__title">需要配置云托管服务名</text>
      <text class="config-tip__desc">请在 miniprogram/config.js 中填写 cloudRunService（用于 X-WX-SERVICE）</text>
    </view>

    <view class="page-loading-shell page-loading-shell--with-header" wx:if="{{loading && !album}}">
      <view class="admin-loading-card admin-loading-card--page motion-fade-up motion-delay-2">
        <view class="admin-loading-card__orb">
          <view class="admin-loading-card__spinner"></view>
        </view>
        <text class="admin-loading-card__title">拾光中...</text>
        <text class="admin-loading-card__desc">正在加载页面</text>
      </view>
    </view>

    <view wx:if="{{album}}">
      <view class="notice motion-fade-up motion-delay-2" wx:if="{{showNotice && expiryNotice}}">
        <view class="notice-marquee">
          <view class="notice-track">
            <text class="notice-text">{{expiryNotice}}</text>
            <text class="notice-text notice-text--gap">{{expiryNotice}}</text>
          </view>
        </view>
        <view class="notice-close" hover-class="notice-close--active" bindtap="hideNotice">
          <text class="notice-close-char">×</text>
        </view>
      </view>

      <view class="toolbar motion-fade-up motion-delay-3" style="top: {{toolbarStickyTop}}px;">
        <view class="toolbar-folders-wrap {{showFolderGuide ? 'toolbar-folders-wrap--with-guide' : ''}}">
          <view class="folder-guide-tip motion-pop-in" wx:if="{{showFolderGuide}}" bindtap="dismissFolderGuide">
            <text class="folder-guide-tip__text">左右滑动 / 点击标签可切换</text>
            <view class="folder-guide-tip__arrow"></view>
          </view>

          <scroll-view class="toolbar-folders" scroll-x="{{!(switchingFolderLoading || pendingFolderPhotoIds.length > 0)}}" enable-flex="{{true}}" show-scrollbar="{{false}}">
            <view class="folders-row">
              <button
                class="folder-btn {{selectedFolder === item.id ? 'folder-btn--active' : ''}} {{folderWaveActiveIndex === index ? (folderWaveTick === 1 ? 'folder-btn--wave-a' : 'folder-btn--wave-b') : ''}}"
                hover-class="folder-btn--touch"
                hover-stay-time="80"
                wx:for="{{folders}}"
                wx:key="id"
                data-id="{{item.id}}"
                bindtap="selectFolder"
                disabled="{{switchingFolderLoading || pendingFolderPhotoIds.length > 0}}"
              >
                {{item.name}}
              </button>
            </view>
          </scroll-view>
        </view>

        <view class="toolbar-tools" wx:if="{{photos.length > 0}}">
          <button class="tool-btn tool-btn--select {{isSelectAll ? 'tool-btn--active' : ''}}" hover-class="tool-btn--touch" bindtap="toggleSelectAll" disabled="{{batchLoading || switchingFolderLoading}}">
            <image
              class="tool-icon"
              src="{{isSelectAll ? '/images/icons/check-square-brown.svg' : '/images/icons/square-muted.svg'}}"
              mode="aspectFit"
            />
            <text>全选</text>
          </button>

          <button
            class="tool-btn tool-btn--primary {{selectedCount > 0 ? 'tool-btn--primary-selected' : ''}}"
            hover-class="tool-btn--touch"
            bindtap="handleBatchDownload"
            disabled="{{downloadProgressRunning || batchLoading || switchingFolderLoading}}"
          >
            <image class="tool-icon" src="/images/icons/download-brown.svg" mode="aspectFit" />
            <text wx:if="{{selectedCount > 0}}">下载</text>
            <text wx:else>全部下载</text>
            <text class="tool-badge" wx:if="{{selectedCount > 0}}">{{selectedCount > 99 ? '99+' : selectedCount}}</text>
          </button>

          <button
            class="tool-btn tool-btn--danger"
            hover-class="tool-btn--touch"
            wx:if="{{selectedCount > 0}}"
            bindtap="handleBatchDelete"
            disabled="{{downloadProgressRunning || batchLoading || switchingFolderLoading}}"
          >
            <image class="tool-icon tool-icon--danger" src="/images/icons/trash-red.svg" mode="aspectFit" />
          </button>
        </view>
      </view>

      <view class="gallery-content-shell">
        <view class="album-overlay-loading motion-fade-in" wx:if="{{switchingFolderLoading || pendingFolderPhotoIds.length > 0}}" catchtouchmove="noop" style="top: {{folderSwitchOverlayTopPx}}px;">
          <view class="admin-loading-card admin-loading-card--compact">
            <view class="admin-loading-card__orb">
              <view class="admin-loading-card__spinner"></view>
            </view>
            <text class="admin-loading-card__title">拾光中...</text>
            <text class="admin-loading-card__desc">正在加载页面</text>
          </view>
        </view>

      <view class="grid {{rightPhotos.length === 0 ? 'grid--single' : ''}} motion-fade-up motion-delay-4" wx:if="{{photos.length > 0}}">
        <view class="grid-col album-grid-col album-grid-col--left">
          <view class="photo-card {{item.story_highlight ? 'photo-card--story-highlight' : ''}}" wx:for="{{leftPhotos}}" wx:key="id" style="animation-delay: {{140 + (index % 8) * 30}}ms;">
            <view class="photo-img-wrap {{item.story_visible ? 'photo-img-wrap--story-open' : ''}}" data-id="{{item.id}}" bindtap="openPhotoFullscreen">
              <block wx:if="{{item.story_visible && item.has_story}}">
                <view class="photo-story-panel {{item.story_phase === 'closing' ? 'photo-story-panel--closing' : item.story_phase === 'opening' ? 'photo-story-panel--opening' : ''}}" data-id="{{item.id}}" catchtap="toggleStory">
                  <view class="photo-story-panel__paper">
                    <text class="photo-story-panel__title">关于此刻</text>
                    <text class="photo-story-panel__text">{{item.story_text}}</text>
                  </view>
                </view>
              </block>
              <block wx:else>
                <view class="photo-img-stage {{item.story_image_phase === 'entering' ? 'photo-img-stage--entering' : ''}}">
                  <view wx:if="{{item.card_url_resolved}}" class="photo-img-box" style="padding-top: {{item.__media_padding_top || '133.3333%'}};">
                    <image
                      class="photo-img {{item._imageLoaded ? 'photo-img--loaded' : ''}}"
                      src="{{item.card_url_resolved}}"
                      mode="aspectFill"
                      lazy-load="{{true}}"
                      bindload="onPhotoLoad"
                      binderror="onPhotoError"
                      data-id="{{item.id}}"
                    />
                    <view class="photo-img-loading-card {{item._imageLoaded ? 'photo-img-loading-card--hidden' : ''}} {{item._imageLoadFailed ? 'photo-img-loading-card--error' : ''}}">
                      <block wx:if="{{item._imageLoadFailed}}">
                        <view class="photo-img-loading-card__center photo-img-loading-card__center--error">
                          <view class="photo-img-loading-card__camera-wrap photo-img-loading-card__camera-wrap--error">
                            <image class="photo-img-loading-card__camera" src="/images/icons/camera-brown.svg" mode="aspectFit" />
                          </view>
                          <text class="photo-img-loading-card__title">图片开小差了</text>
                          <text class="photo-img-loading-card__desc">稍后再试试</text>
                        </view>
                      </block>
                      <block wx:else>
                        <view class="photo-img-loading-card__glow"></view>
                        <view class="photo-img-loading-card__spark photo-img-loading-card__spark--left">
                          <image class="photo-img-loading-card__spark-icon" src="/images/icons/sparkles-yellow.svg" mode="aspectFit" />
                        </view>
                        <view class="photo-img-loading-card__spark photo-img-loading-card__spark--right">
                          <image class="photo-img-loading-card__spark-icon" src="/images/icons/sparkles-brown.svg" mode="aspectFit" />
                        </view>
                        <view class="photo-img-loading-card__center">
                          <view class="photo-img-loading-card__camera-wrap">
                            <image class="photo-img-loading-card__camera" src="/images/icons/camera-brown.svg" mode="aspectFit" />
                          </view>
                          <text class="photo-img-loading-card__title">拾光中...</text>
                          <view class="photo-img-loading-card__dots">
                            <view class="photo-img-loading-card__dot photo-img-loading-card__dot--1"></view>
                            <view class="photo-img-loading-card__dot photo-img-loading-card__dot--2"></view>
                            <view class="photo-img-loading-card__dot photo-img-loading-card__dot--3"></view>
                          </view>
                        </view>
                      </block>
                    </view>
                  </view>
                  <view wx:else class="photo-img photo-img--empty"></view>
                </view>
              </block>

              <view
                class="select-badge {{item._selected ? 'select-badge--checked' : ''}}"
                hover-class="select-badge--active"
                catchtap="togglePhotoSelection"
                data-id="{{item.id}}"
              >
                <view class="select-badge-core">
                  <text class="select-badge-check" wx:if="{{item._selected}}">✓</text>
                </view>
              </view>

              <view class="story-toggle {{item.story_highlight ? 'story-toggle--highlight' : ''}} {{item.story_open ? 'story-toggle--open' : ''}}" wx:if="{{item.has_story}}" hover-class="story-toggle--touch" hover-stay-time="80" data-id="{{item.id}}" catchtap="toggleStory">
                <text class="story-toggle__icon {{item.story_open ? 'story-toggle__icon--open' : ''}}">↻</text>
              </view>

            </view>

            <view class="photo-actions" wx:if="{{freezeEnabled}}">
              <button class="pin-btn {{item.is_public ? 'pin-btn--active' : ''}}" hover-class="pin-btn--touch" catchtap="togglePin" data-id="{{item.id}}" loading="{{item._pinning}}" disabled="{{item._pinning}}">
                <image class="pin-icon" src="/images/icons/sparkles-brown.svg" mode="aspectFit" />
                <text>{{item.is_public ? '已定格' : '定格'}}</text>
              </button>
            </view>
          </view>
          <view class="photo-card photo-card--paging-skeleton" wx:for="{{pagingSkeletonLeftPhotos}}" wx:key="id">
            <view class="photo-img-wrap">
              <view class="photo-img-box photo-img-box--paging-skeleton" style="padding-top: {{item.__media_padding_top || '133.3333%'}};">
                <view class="paging-skeleton-shimmer"></view>
              </view>
            </view>
            <view class="photo-actions photo-actions--paging-skeleton">
              <view class="paging-meta-line paging-meta-line--wide"></view>
            </view>
          </view>
        </view>

        <view class="grid-col album-grid-col album-grid-col--right">
          <view class="photo-card {{item.story_highlight ? 'photo-card--story-highlight' : ''}}" wx:for="{{rightPhotos}}" wx:key="id" style="animation-delay: {{160 + (index % 8) * 30}}ms;">
            <view class="photo-img-wrap {{item.story_visible ? 'photo-img-wrap--story-open' : ''}}" data-id="{{item.id}}" bindtap="openPhotoFullscreen">
              <block wx:if="{{item.story_visible && item.has_story}}">
                <view class="photo-story-panel {{item.story_phase === 'closing' ? 'photo-story-panel--closing' : item.story_phase === 'opening' ? 'photo-story-panel--opening' : ''}}" data-id="{{item.id}}" catchtap="toggleStory">
                  <view class="photo-story-panel__paper">
                    <text class="photo-story-panel__title">关于此刻</text>
                    <text class="photo-story-panel__text">{{item.story_text}}</text>
                  </view>
                </view>
              </block>
              <block wx:else>
                <view class="photo-img-stage {{item.story_image_phase === 'entering' ? 'photo-img-stage--entering' : ''}}">
                  <view wx:if="{{item.card_url_resolved}}" class="photo-img-box" style="padding-top: {{item.__media_padding_top || '133.3333%'}};">
                    <image
                      class="photo-img {{item._imageLoaded ? 'photo-img--loaded' : ''}}"
                      src="{{item.card_url_resolved}}"
                      mode="aspectFill"
                      lazy-load="{{true}}"
                      bindload="onPhotoLoad"
                      binderror="onPhotoError"
                      data-id="{{item.id}}"
                    />
                    <view class="photo-img-loading-card {{item._imageLoaded ? 'photo-img-loading-card--hidden' : ''}} {{item._imageLoadFailed ? 'photo-img-loading-card--error' : ''}}">
                      <block wx:if="{{item._imageLoadFailed}}">
                        <view class="photo-img-loading-card__center photo-img-loading-card__center--error">
                          <view class="photo-img-loading-card__camera-wrap photo-img-loading-card__camera-wrap--error">
                            <image class="photo-img-loading-card__camera" src="/images/icons/camera-brown.svg" mode="aspectFit" />
                          </view>
                          <text class="photo-img-loading-card__title">图片开小差了</text>
                          <text class="photo-img-loading-card__desc">稍后再试试</text>
                        </view>
                      </block>
                      <block wx:else>
                        <view class="photo-img-loading-card__glow"></view>
                        <view class="photo-img-loading-card__spark photo-img-loading-card__spark--left">
                          <image class="photo-img-loading-card__spark-icon" src="/images/icons/sparkles-yellow.svg" mode="aspectFit" />
                        </view>
                        <view class="photo-img-loading-card__spark photo-img-loading-card__spark--right">
                          <image class="photo-img-loading-card__spark-icon" src="/images/icons/sparkles-brown.svg" mode="aspectFit" />
                        </view>
                        <view class="photo-img-loading-card__center">
                          <view class="photo-img-loading-card__camera-wrap">
                            <image class="photo-img-loading-card__camera" src="/images/icons/camera-brown.svg" mode="aspectFit" />
                          </view>
                          <text class="photo-img-loading-card__title">拾光中...</text>
                          <view class="photo-img-loading-card__dots">
                            <view class="photo-img-loading-card__dot photo-img-loading-card__dot--1"></view>
                            <view class="photo-img-loading-card__dot photo-img-loading-card__dot--2"></view>
                            <view class="photo-img-loading-card__dot photo-img-loading-card__dot--3"></view>
                          </view>
                        </view>
                      </block>
                    </view>
                  </view>
                  <view wx:else class="photo-img photo-img--empty"></view>
                </view>
              </block>

              <view
                class="select-badge {{item._selected ? 'select-badge--checked' : ''}}"
                hover-class="select-badge--active"
                catchtap="togglePhotoSelection"
                data-id="{{item.id}}"
              >
                <view class="select-badge-core">
                  <text class="select-badge-check" wx:if="{{item._selected}}">✓</text>
                </view>
              </view>

              <view class="story-toggle {{item.story_highlight ? 'story-toggle--highlight' : ''}} {{item.story_open ? 'story-toggle--open' : ''}}" wx:if="{{item.has_story}}" hover-class="story-toggle--touch" hover-stay-time="80" data-id="{{item.id}}" catchtap="toggleStory">
                <text class="story-toggle__icon {{item.story_open ? 'story-toggle__icon--open' : ''}}">↻</text>
              </view>

            </view>

            <view class="photo-actions" wx:if="{{freezeEnabled}}">
              <button class="pin-btn {{item.is_public ? 'pin-btn--active' : ''}}" hover-class="pin-btn--touch" catchtap="togglePin" data-id="{{item.id}}" loading="{{item._pinning}}" disabled="{{item._pinning}}">
                <image class="pin-icon" src="/images/icons/sparkles-brown.svg" mode="aspectFit" />
                <text>{{item.is_public ? '已定格' : '定格'}}</text>
              </button>
            </view>
          </view>
          <view class="photo-card photo-card--paging-skeleton" wx:for="{{pagingSkeletonRightPhotos}}" wx:key="id">
            <view class="photo-img-wrap">
              <view class="photo-img-box photo-img-box--paging-skeleton" style="padding-top: {{item.__media_padding_top || '133.3333%'}};">
                <view class="paging-skeleton-shimmer"></view>
              </view>
            </view>
            <view class="photo-actions photo-actions--paging-skeleton">
              <view class="paging-meta-line paging-meta-line--wide"></view>
            </view>
          </view>
        </view>
      </view>

      <view class="empty motion-fade-up motion-delay-5" wx:if="{{photos.length === 0}}">
        <text class="empty-text">暂无照片</text>
      </view>

      <view class="donation-entry motion-fade-up motion-delay-6" wx:if="{{album.enable_tipping && album.donation_qr_code_url}}">
        <button class="donation-btn" hover-class="donation-btn--active" bindtap="openDonationModal">
          <image class="donation-icon" src="/images/icons/heart-orange.svg" mode="aspectFit" />
          <text>留下一份心意</text>
        </button>
      </view>

      <view class="more" wx:if="{{loadingMore}}">
        <view class="small-spinner"></view>
        <text class="more-text">拾光中...</text>
      </view>
      <view class="end" wx:if="{{!hasMore && photos.length > 0}}">
        <text class="end-text">✨ 已经到底啦 ✨</text>
      </view>
      </view>
    </view>
  </view>
  <view class="modal-mask motion-fade-in" wx:if="{{freezeEnabled && confirmPhotoId}}" bindtap="closePinConfirm"></view>
  <view class="confirm-modal motion-fade-in" wx:if="{{freezeEnabled && confirmPhotoId}}">
    <view class="confirm-card motion-pop-in" catchtap="noop">
      <view class="confirm-icon-wrap">
        <image class="confirm-icon" src="/images/icons/sparkles-yellow.svg" mode="aspectFit" />
      </view>
      <text class="confirm-title">✨ 施展定格魔法</text>
      <view class="confirm-text">
        定格后，这张照片会展示在 <text class="confirm-highlight">【照片墙】</text> 中，与更多人分享这份美好；同时不再受 {{expiryDays}} 天时效限制。
      </view>

      <view class="confirm-actions">
        <button class="confirm-btn confirm-btn--ghost" hover-class="confirm-btn--ghost-active" bindtap="closePinConfirm">再想想</button>
        <button class="confirm-btn confirm-btn--primary" hover-class="confirm-btn--primary-active" bindtap="confirmPin">✨ 确认定格</button>
      </view>
    </view>
  </view>

  <view class="modal-mask motion-fade-in" wx:if="{{showDeleteConfirm}}" bindtap="closeDeleteConfirm"></view>
  <view class="confirm-modal motion-fade-in" wx:if="{{showDeleteConfirm}}">
    <view class="confirm-card motion-pop-in" catchtap="noop">
      <view class="confirm-icon-wrap confirm-icon-wrap--danger">
        <image class="confirm-icon" src="/images/icons/trash-red.svg" mode="aspectFit" />
      </view>
      <text class="confirm-title">确定要删除吗？</text>
      <text class="confirm-text">你即将删除 {{selectedCount}} 张照片，此操作不可撤销。</text>

      <view class="confirm-actions">
        <button class="confirm-btn confirm-btn--ghost" hover-class="confirm-btn--ghost-active" bindtap="closeDeleteConfirm">取消</button>
        <button class="confirm-btn confirm-btn--danger" hover-class="confirm-btn--danger-active" bindtap="confirmBatchDelete">确认删除</button>
      </view>
    </view>
  </view>

  <view class="download-progress-card motion-pop-in {{downloadProgressDone ? 'download-progress-card--done' : ''}}" wx:if="{{downloadProgressVisible}}">
    <view class="download-progress-card__header">
      <text class="download-progress-card__title">{{downloadProgressTitle || '正在保存照片'}}</text>
      <text class="download-progress-card__percent" wx:if="{{downloadProgressTotal > 0}}">{{downloadProgressPercent}}%</text>
    </view>
    <text class="download-progress-card__message">{{downloadProgressMessage}}</text>
    <view class="download-progress-card__meta">
      <text>已完成 {{downloadProgressCurrent}} / {{downloadProgressTotal > 0 ? downloadProgressTotal : '--'}}</text>
      <text>成功 {{downloadProgressSuccess}} · 失败 {{downloadProgressFail}}</text>
    </view>
    <view class="download-progress-card__bar">
      <view
        class="download-progress-card__bar-fill {{downloadProgressRunning && downloadProgressTotal === 0 ? 'download-progress-card__bar-fill--indeterminate' : ''}}"
        style="width: {{downloadProgressTotal > 0 ? downloadProgressPercent : 22}}%;"
      ></view>
    </view>
  </view>

  <view class="toast toast--{{toast.type}} motion-pop-in" wx:if="{{toast}}">
    <text class="toast-text">{{toast.message}}</text>
  </view>

  <view
    class="welcome-easter-egg"
    wx:if="{{showWelcomeEasterEgg && !showWelcomeLetter}}"
    hover-class="welcome-easter-egg--active"
    hover-stay-time="80"
    bindtap="onOpenWelcomeEasterEgg"
  >
    <view class="welcome-easter-egg__inner">
      <image class="welcome-easter-egg__icon" src="/images/icons/sparkles-white.svg" mode="aspectFit" />
    </view>
  </view>

  <!-- 欢迎信：支持拆信封模式与印章入口模式 -->
  <view class="letter-mask motion-fade-in" wx:if="{{showWelcomeLetter}}" bindtap="onLetterMaskTap"></view>
  <view class="letter-modal motion-fade-in" wx:if="{{showWelcomeLetter}}">
    <!-- 信封阶段 -->
    <view class="envelope-wrap" wx:if="{{letterStage === 'envelope' || letterStage === 'opening-envelope'}}" catchtap="noop">
      <view class="envelope-float {{letterStage === 'opening-envelope' ? 'envelope-float--exit' : ''}}">
        <view class="envelope-card">
          <view class="envelope-stitch"></view>
          <view class="envelope-noise"></view>

          <view class="envelope-flap"></view>

          <view class="envelope-stamp">
            <text class="envelope-stamp-emoji">📷</text>
          </view>
          <view class="envelope-postmark"></view>

          <view class="envelope-to">
            <text class="envelope-to-text">To: {{album.recipient_name || '拾光者'}}</text>
            <view class="envelope-to-line"></view>
          </view>

          <text class="envelope-sticker">✨</text>
        </view>

      <view class="seal" hover-class="seal--active" bindtap="onOpenLetter">
        <view class="seal-inner">
          <image class="seal-icon" src="/images/icons/sparkles-white.svg" mode="aspectFit" />
        </view>
      </view>

        <text class="envelope-hint">轻触拆封解锁相册</text>
      </view>
    </view>

    <!-- 打开过渡 -->
    <view class="opening-wrap" wx:if="{{letterStage === 'opening'}}" catchtap="noop">
      <view class="opening-card"></view>
    </view>

    <!-- 信纸阶段（含关闭动画） -->
    <view
      class="paper-card {{letterStage === 'closing' ? 'paper-card--closing' : 'paper-card--open'}}"
      wx:if="{{letterStage === 'letter' || letterStage === 'closing'}}"
      catchtap="noop"
    >
      <view class="paper-close" hover-class="paper-close--active" bindtap="closeWelcomeLetterAnimated">
        <image class="paper-close-icon" src="/images/icons/x-brown.svg" mode="aspectFit" />
      </view>

      <scroll-view class="paper-scroll" scroll-y>
        <text class="paper-text">{{welcomeText}}</text>
      </scroll-view>
    </view>
  </view>

  <view class="modal-mask motion-fade-in" wx:if="{{showDonationModal}}" bindtap="closeDonationModal"></view>
  <view class="confirm-modal motion-fade-in" wx:if="{{showDonationModal}}">
    <view class="donation-card motion-pop-in" catchtap="noop">
      <text class="donation-title">感谢你的心意</text>
      <text class="donation-desc">长按二维码保存后，可在微信扫码赞赏</text>
      <image class="donation-qr" src="{{album.donation_qr_code_url}}" mode="widthFix" show-menu-by-longpress="{{true}}" />
      <button
        class="letter-btn {{donationSaving ? 'letter-btn--disabled' : ''}}"
        hover-class="letter-btn--active"
        bindtap="handleSaveDonationQr"
        disabled="{{donationSaving}}"
      >
        {{donationSaving ? '保存中...' : '保存赞赏码'}}
      </button>
    </view>
  </view>

</view>
