  0% { transform: translateY(0) scale(1); opacity: 1; }
  100% { transform: translateY(200rpx) scale(0.8) rotate(-5deg); opacity: 0; }
}

.paper-close {
  position: absolute;
  top: 32rpx;
  right: 32rpx;
  width: 80rpx;
  height: 80rpx;
  padding: 0;
  margin: 0;
  border-radius: 999rpx;
  background: rgba(93, 64, 55, 0.10);
