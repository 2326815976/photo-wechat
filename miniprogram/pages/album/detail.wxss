@import "../../styles/admin-loading.wxss";
@import "../../styles/secondary-page-frame.wxss";

.page {
  min-height: 100vh;
  background: #fffbf0;
  display: block;
}

.content {
  /* 对齐旧版相册详情页：使用页面原生滚动，避免 flex 容器干扰 sticky 头部与标签栏 */
  flex: none;
  padding: 0 16rpx calc(256rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background-image: none;
}

.page-loading-shell {
  width: 100%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
}

.page-loading-shell--full {
  min-height: 100vh;
}

.page-loading-shell--with-header {
  min-height: calc(100vh - 220rpx - env(safe-area-inset-bottom));
}

/* 重置小程序 button 默认样式，避免与 Web 对标样式出现偏差 */
button {
  margin: 0;
  padding: 0;
  line-height: 1;
  background: transparent;
  border: none;
}

button::after {
  border: none;
}

.config-tip {
  background: rgba(255, 255, 255, 0.75);
  border: 4rpx dashed rgba(93, 64, 55, 0.15);
  border-radius: 28rpx;
  padding: 20rpx 24rpx;
  margin-top: 24rpx;
  margin-bottom: 18rpx;
}

.config-tip__title {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: #5d4037;
  margin-bottom: 6rpx;
}

.config-tip__desc {
  display: block;
  font-size: 22rpx;
  color: rgba(93, 64, 55, 0.6);
}

.loading {
  margin-top: 24rpx;
  padding-top: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
}

.loading-ring {
  position: relative;
  width: 192rpx;
  height: 192rpx;
}

.ring {
  position: absolute;
  border-radius: 999rpx;
  border-style: solid;
  box-sizing: border-box;
}

.ring--outer {
  inset: 0;
  border-width: 10rpx;
  border-color: rgba(255, 200, 87, 0.30);
  border-top-color: #FFC857;
  animation: spin 3s linear infinite;
}

.ring--inner {
  inset: 24rpx;
  border-width: 10rpx;
  border-color: rgba(93, 64, 55, 0.20);
  border-bottom-color: #5D4037;
  animation: spin-reverse 2s linear infinite;
}

.ring-center {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.center-icon {
  width: 64rpx;
  height: 64rpx;
}

@keyframes spin {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

@keyframes spin-reverse {
  0% { transform: rotate(360deg); }
  100% { transform: rotate(0deg); }
}

.loading-text {
  text-align: center;
}

.loading-title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #5d4037;
  margin-bottom: 6rpx;
}

.loading-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(93, 64, 55, 0.6);
}

.notice {
  position: relative;
  height: 48rpx;
  border-radius: 999rpx;
  padding: 0 56rpx 0 14rpx;
  background: rgba(255, 200, 87, 0.15);
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  margin-bottom: 14rpx;
  overflow: hidden;
}

.notice-marquee {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.notice-track {
  width: max-content;
  display: flex;
  align-items: center;
  animation: marquee 18s linear infinite;
}

@keyframes marquee {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(-50%);
  }
}

.notice-text {
  flex: none;
  font-size: 20rpx;
  color: rgba(93, 64, 55, 0.7);
  white-space: nowrap;
}

.notice-text--gap {
  margin-left: 30rpx;
}

.notice-close {
  position: absolute;
  right: 12rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 30rpx;
  height: 30rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(93, 64, 55, 0.45);
  transition: color 0.2s ease;
}

.notice-close--active {
  color: rgba(93, 64, 55, 0.72);
}

.notice-close-char {
  font-size: 24rpx;
  line-height: 1;
}

.toolbar {
  position: -webkit-sticky;
  position: sticky;
  top: 0;
  z-index: 880;
  min-height: 92rpx;
  margin-bottom: 16rpx;
  padding: 0 6rpx;
  background: #fffbf0;
  border-bottom: 2rpx solid rgba(93, 64, 55, 0.05);
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.toolbar-folders {
  width: 100%;
  flex: none;
  min-width: 0;
  white-space: nowrap;
  margin-bottom: 0;
}

.toolbar-folders-wrap {
  position: relative;
  flex: 1;
  min-width: 0;
}

.toolbar-folders-wrap--with-guide {
  padding-top: 72rpx;
}

.folders-row {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding-bottom: 2rpx;
}

.folder-guide-tip {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 3;
  max-width: 380rpx;
  height: 52rpx;
  padding: 0 18rpx;
  border-radius: 14rpx;
  display: inline-flex;
  align-items: center;
  background: #5d4037;
  box-shadow: 0 10rpx 24rpx rgba(93, 64, 55, 0.28);
}

.folder-guide-tip__text {
  font-size: 19rpx;
  font-weight: 600;
  color: #fffaf0;
  white-space: nowrap;
}

.folder-guide-tip__arrow {
  position: absolute;
  left: 22rpx;
  bottom: -8rpx;
  width: 16rpx;
  height: 16rpx;
  background: #5d4037;
  transform: rotate(45deg);
}

.folder-btn {
  flex: none;
  min-height: 60rpx;
  width: auto !important;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  background: rgba(255, 255, 255, 0.6);
  color: rgba(93, 64, 55, 0.6);
  border: 3rpx dashed rgba(93, 64, 55, 0.15);
  transition: border-color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
}

.folder-btn--active {
  background: #ffc857;
  color: #5d4037;
  border: 3rpx solid rgba(93, 64, 55, 0.2);
  box-shadow: 3rpx 3rpx 0 rgba(93, 64, 55, 0.15);
}

.folder-btn--touch {
  border-color: rgba(93, 64, 55, 0.3);
}

.folder-btn--wave-a,
.folder-btn--wave-b {
  animation: folder-btn-wave 360ms ease-out 1;
  will-change: transform;
}

@keyframes folder-btn-wave {
  0% {
    transform: translateY(0) scale(1);
  }
  35% {
    transform: translateY(-10rpx) scale(1.02);
  }
  70% {
    transform: translateY(0) scale(1);
  }
  100% {
    transform: translateY(0) scale(1);
  }
}

.toolbar-tools {
  flex: none;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.tool-btn {
  position: relative;
  min-width: 0;
  height: 60rpx;
  border-radius: 999rpx;
  padding: 0 18rpx;
  font-size: 23rpx;
  font-weight: 700;
  background: rgba(255, 255, 255, 0.6);
  color: rgba(93, 64, 55, 0.7);
  border: 3rpx dashed rgba(93, 64, 55, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  line-height: 1;
  box-sizing: border-box;
  overflow: visible;
  transition: transform 0.2s ease, box-shadow 0.2s ease, opacity 0.2s ease, border-color 0.2s ease;
}

.tool-btn--select {
  flex: none;
  width: auto !important;
  padding: 0 18rpx;
}

.tool-btn--active {
  background: #ffc857;
  border: 3rpx solid rgba(93, 64, 55, 0.2);
  box-shadow: 3rpx 3rpx 0 rgba(93, 64, 55, 0.15);
  color: #5d4037;
}

.tool-btn--primary {
  flex: 1;
  min-width: 148rpx;
  background: #ffc857;
  color: #5d4037;
  border: 3rpx solid rgba(93, 64, 55, 0.2);
  box-shadow: 3rpx 3rpx 0 rgba(93, 64, 55, 0.15);
  width: auto !important;
}

.tool-btn--primary-selected {
  flex: none;
  min-width: 126rpx;
}

.tool-btn--danger {
  flex: none;
  width: 60rpx !important;
  min-width: 60rpx;
  padding: 0;
  background: rgba(239, 68, 68, 0.12);
  border: 2rpx solid rgba(239, 68, 68, 0.25);
}

.tool-btn[disabled] {
  opacity: 0.55;
}

.tool-btn--touch {
  transform: scale(0.96);
}

.tool-icon {
  width: 26rpx;
  height: 26rpx;
}

.tool-icon--danger {
  width: 30rpx;
  height: 30rpx;
}

.tool-badge {
  position: absolute;
  top: -10rpx;
  right: -8rpx;
  min-width: 34rpx;
  height: 34rpx;
  border-radius: 999rpx;
  padding: 0 8rpx;
  background: #5d4037;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 34rpx;
  text-align: center;
  box-shadow: 0 4rpx 10rpx rgba(93, 64, 55, 0.25);
  box-sizing: border-box;
  z-index: 2;
}

.grid {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.gallery-content-shell {
  position: relative;
  min-height: 360rpx;
}

.album-overlay-loading {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 920;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  padding: 36rpx 24rpx;
  box-sizing: border-box;
  background: rgba(255, 251, 240, 0.78);
  -webkit-backdrop-filter: blur(8rpx);
  backdrop-filter: blur(8rpx);
}

.grid--single {
  display: block;
}

.grid--single .grid-col:first-child {
  width: 100%;
}

.grid--single .grid-col:last-child {
  display: none;
}

.grid-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.photo-card {
  width: 100%;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(93, 64, 55, 0.14);
}

.photo-card--story-highlight {
  border: 4rpx solid #FFB703;
  background: #fffdf7;
  box-shadow: 0 0 0 2rpx rgba(255, 229, 156, 0.92), 0 14rpx 32rpx rgba(255, 183, 3, 0.48), 0 8rpx 20rpx rgba(93, 64, 55, 0.20);
  transform: translateY(-2rpx);
}

.photo-card--paging-skeleton {
  background: rgba(255, 255, 255, 0.88);
  border: 2rpx solid rgba(93, 64, 55, 0.06);
  box-shadow: 0 8rpx 22rpx rgba(93, 64, 55, 0.08);
}

.photo-img-wrap {
  position: relative;
  overflow: hidden;
  transition: transform 220ms ease, filter 220ms ease, background 220ms ease;
}

.photo-img-wrap--story-open {
  background: linear-gradient(150deg, #fffdf7 0%, #fff5dc 52%, #fcebc5 100%);
}

.photo-img-box {
  position: relative;
  width: 100%;
  overflow: hidden;
  background: linear-gradient(135deg, #f8f2e6, #efe5d2);
}

.photo-img-box--paging-skeleton {
  background: linear-gradient(135deg, rgba(255, 251, 240, 0.98) 0%, rgba(255, 247, 233, 0.98) 100%);
}

.paging-skeleton-shimmer {
  position: absolute;
  inset: 0;
  overflow: hidden;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.24) 0%, rgba(255, 248, 232, 0.92) 52%, rgba(255, 244, 224, 0.96) 100%);
}

.paging-skeleton-shimmer::after {
  content: "";
  position: absolute;
  top: 0;
  bottom: 0;
  left: -42%;
  width: 42%;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.52) 48%, rgba(255, 255, 255, 0) 100%);
  animation: paging-skeleton-shimmer 1.45s ease-in-out infinite;
}

.photo-img-stage {
  transform-origin: center top;
}

.photo-img-stage--entering {
  animation: album-story-image-in 220ms ease-out both;
}

.photo-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: block;
  opacity: 0;
  transform: scale(1.035);
  filter: saturate(0.92) brightness(1.03);
  transition: opacity 320ms ease, transform 460ms ease, filter 460ms ease;
}

.photo-img--loaded {
  opacity: 1;
  transform: scale(1);
  filter: none;
}

.photo-img-loading-card {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  overflow: hidden;
  background: linear-gradient(180deg, rgba(255, 252, 244, 0.98) 0%, rgba(255, 247, 231, 0.98) 56%, rgba(247, 237, 218, 0.98) 100%);
  transition: opacity 260ms ease, transform 260ms ease;
}

.photo-img-loading-card::before {
  content: "";
  position: absolute;
  top: -18%;
  left: -36%;
  width: 48%;
  height: 136%;
  background: linear-gradient(90deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.45) 50%, rgba(255,255,255,0) 100%);
  transform: rotate(14deg);
  animation: album-photo-loading-shimmer 1.8s ease-in-out infinite;
}

.photo-img-loading-card--hidden {
  opacity: 0;
  transform: scale(1.03);
  pointer-events: none;
}

.photo-img-loading-card--error {
  background: linear-gradient(180deg, rgba(255, 251, 246, 0.98) 0%, rgba(252, 243, 234, 0.98) 100%);
}

.photo-img-loading-card--error::before {
  display: none;
}

.photo-img-loading-card__glow {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 170rpx;
  height: 170rpx;
  border-radius: 999rpx;
  background: radial-gradient(circle, rgba(255, 200, 87, 0.26) 0%, rgba(255, 200, 87, 0.10) 48%, rgba(255, 200, 87, 0) 76%);
  transform: translate(-50%, -50%);
  animation: album-photo-loading-glow-pulse 1.8s ease-in-out infinite;
}

.photo-img-loading-card__spark {
  position: absolute;
  width: 40rpx;
  height: 40rpx;
  opacity: 0.9;
}

.photo-img-loading-card__spark--left {
  left: 56rpx;
  top: 42rpx;
  animation: album-photo-loading-float 1.8s ease-in-out infinite;
}

.photo-img-loading-card__spark--right {
  right: 52rpx;
  top: 76rpx;
  animation: album-photo-loading-float 2.1s ease-in-out infinite 120ms;
}

.photo-img-loading-card__spark-icon {
  width: 100%;
  height: 100%;
}

.photo-img-loading-card__center {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
}

.photo-img-loading-card__center--error {
  gap: 10rpx;
}

.photo-img-loading-card__camera-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(93, 64, 55, 0.08);
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.68), 0 10rpx 24rpx rgba(93, 64, 55, 0.12);
  animation: album-photo-loading-card-pulse 1.8s ease-in-out infinite;
}

.photo-img-loading-card__camera-wrap--error {
  background: rgba(93, 64, 55, 0.06);
  animation: none;
}

.photo-img-loading-card__camera {
  width: 52rpx;
  height: 52rpx;
}

.photo-img-loading-card__title {
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 700;
  color: rgba(93, 64, 55, 0.62);
}

.photo-img-loading-card__desc {
  font-size: 20rpx;
  line-height: 1.2;
  color: rgba(93, 64, 55, 0.48);
}

.photo-img-loading-card__dots {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.photo-img-loading-card__dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 200, 87, 0.9);
  box-shadow: 0 4rpx 10rpx rgba(255, 200, 87, 0.28);
  animation: album-photo-loading-dot 1.2s ease-in-out infinite;
}

.photo-img-loading-card__dot--2 {
  animation-delay: 120ms;
}

.photo-img-loading-card__dot--3 {
  animation-delay: 240ms;
}

@keyframes album-photo-loading-shimmer {
  0% {
    transform: translateX(0) rotate(14deg);
    opacity: 0;
  }
  20% {
    opacity: 1;
  }
  100% {
    transform: translateX(340rpx) rotate(14deg);
    opacity: 0;
  }
}

@keyframes album-photo-loading-glow-pulse {
  0%, 100% {
    transform: translate(-50%, -50%) scale(0.96);
    opacity: 0.86;
  }
  50% {
    transform: translate(-50%, -50%) scale(1.04);
    opacity: 1;
  }
}

@keyframes album-photo-loading-card-pulse {
  0%, 100% {
    transform: scale(0.96);
    opacity: 0.9;
  }
  50% {
    transform: scale(1.04);
    opacity: 1;
  }
}

@keyframes album-photo-loading-float {
  0%, 100% {
    transform: translateY(0) scale(1);
  }
  50% {
    transform: translateY(-8rpx) scale(1.06);
  }
}

@keyframes album-photo-loading-dot {
  0%, 80%, 100% {
    transform: translateY(0) scale(0.92);
    opacity: 0.55;
  }
  40% {
    transform: translateY(-5rpx) scale(1.05);
    opacity: 1;
  }
}

.photo-img--empty {
  position: static;
  min-height: 220rpx;
  height: 220rpx;
  background: linear-gradient(135deg, #f8f2e6, #efe5d2);
}

.photo-story-panel {
  min-height: 280rpx;
  padding: 84rpx 18rpx 18rpx;
  box-sizing: border-box;
  background: linear-gradient(160deg, #fffdf7 0%, #fff5dc 52%, #fcebc5 100%);
  transform-origin: center top;
}

.photo-story-panel--opening {
  animation: album-story-panel-in 280ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.photo-story-panel--closing {
  animation: album-story-panel-out 220ms ease-in both;
}

.photo-story-panel__paper {
  position: relative;
  width: 100%;
  min-height: 248rpx;
  border-radius: 18rpx;
  padding: 16rpx 18rpx 20rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(166, 126, 82, 0.24);
  background:
    linear-gradient(180deg, rgba(255, 251, 242, 0.98) 0%, rgba(255, 246, 231, 0.98) 100%),
    repeating-linear-gradient(
      180deg,
      rgba(255, 255, 255, 0) 0rpx,
      rgba(255, 255, 255, 0) 46rpx,
      rgba(93, 64, 55, 0.055) 46rpx,
      rgba(93, 64, 55, 0.055) 48rpx
    );
  box-shadow:
    inset 0 0 0 2rpx rgba(255, 255, 255, 0.72),
    0 8rpx 20rpx rgba(93, 64, 55, 0.14);
}

.photo-story-panel__title {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 34rpx;
  padding: 0 14rpx;
  margin-bottom: 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 200, 87, 0.22);
  border: 2rpx solid rgba(93, 64, 55, 0.16);
  color: rgba(93, 64, 55, 0.86);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
}

.photo-story-panel__text {
  display: block;
  width: 100%;
  color: rgba(93, 64, 55, 0.93);
  font-size: 25rpx;
  line-height: 1.78;
  font-weight: 600;
  letter-spacing: 0.4rpx;
  white-space: pre-wrap;
  word-break: break-word;
}

@keyframes album-story-panel-in {
  0% {
    opacity: 0;
    transform: translateY(12rpx) scale(0.985);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes album-story-panel-out {
  0% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
  100% {
    opacity: 0;
    transform: translateY(-10rpx) scale(0.985);
  }
}

@keyframes album-story-image-in {
  0% {
    opacity: 0;
    transform: translateY(10rpx) scale(0.992);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.select-badge {
  position: absolute;
  top: 15rpx;
  right: 15rpx;
  z-index: 3;
  padding: 0;
  width: 42rpx;
  min-width: 42rpx;
  height: 42rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 2rpx solid rgba(93, 64, 55, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 0;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.18);
  transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
}

.select-badge::after {
  border: none;
}

.select-badge--active {
  transform: scale(0.94);
  box-shadow: 0 6rpx 14rpx rgba(0, 0, 0, 0.2);
}

.select-badge--checked {
