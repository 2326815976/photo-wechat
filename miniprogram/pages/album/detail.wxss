}

.seal-icon {
  width: 48rpx;
  height: 48rpx;
  opacity: 0.9;
}

.envelope-hint {
  position: absolute;
  left: 50%;
  bottom: -64rpx; /* -32px */
  transform: translateX(-50%);
  font-size: 20rpx; /* 10px */
  color: rgba(141, 110, 99, 0.60);
  letter-spacing: 2rpx;
  white-space: nowrap;
  font-family: "Letter Font", "LetterFont", "YouYuan", "幼圆", cursive, sans-serif;
  animation: envelope-hint 2s ease-in-out infinite;
