  line-height: 64rpx; /* 32px */
}

.letter-card,
.donation-card {
  width: 100%;
  max-width: 640rpx;
  background: #fffbf0;
  border-radius: 32rpx;
  padding: 30rpx;
  box-sizing: border-box;
  box-shadow: 0 24rpx 70rpx rgba(93, 64, 55, 0.24);
}

.letter-title-wrap {
  margin-bottom: 14rpx;
}

.letter-title {
  display: block;
  text-align: center;
  font-size: 34rpx;
  font-weight: 900;
  color: #5d4037;
}

.letter-recipient {
  display: block;
  text-align: center;
  font-size: 23rpx;
  color: rgba(93, 64, 55, 0.65);
  margin-bottom: 12rpx;
}

.letter-content-wrap {
  max-height: 360rpx;
  margin-bottom: 16rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 2rpx dashed rgba(93, 64, 55, 0.16);
}

.letter-content {
  display: block;
  white-space: pre-wrap;
  font-size: 24rpx;
  line-height: 1.72;
  color: rgba(93, 64, 55, 0.78);
}

.letter-btn {
  width: 100%;
  height: 78rpx;
  border-radius: 999rpx;
  background: #ffc857;
  color: #5d4037;
  font-size: 26rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.letter-btn--active {
  transform: scale(0.98);
  box-shadow: 0 8rpx 20rpx rgba(93, 64, 55, 0.12);
}

.letter-btn--disabled {
  opacity: 0.72;
}

.donation-title {
  display: block;
  text-align: center;
  font-size: 34rpx;
  font-weight: 900;
  color: #5d4037;
  margin-bottom: 10rpx;
}

.donation-desc {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: rgba(93, 64, 55, 0.65);
  margin-bottom: 14rpx;
}

.donation-qr {
  width: 100%;
  border-radius: 18rpx;
  margin-bottom: 16rpx;
  background: #ffffff;
}

@keyframes paging-skeleton-shimmer {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(340%);
  }
}

@keyframes paging-skeleton-line {
  0% {
    background-position: 0% 50%;
    opacity: 0.72;
  }
  50% {
    background-position: 100% 50%;
    opacity: 1;
  }
  100% {
    background-position: 0% 50%;
    opacity: 0.72;
  }
}
