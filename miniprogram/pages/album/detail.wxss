  transform: rotate(12deg);
  z-index: 3;
}

.seal {
  position: absolute;
  top: 128rpx; /* 64px */
  left: 50%;
  width: 112rpx;
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  transform: translateX(-50%);
  background: transparent;
  z-index: 20;
