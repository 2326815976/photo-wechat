}

@keyframes paper-in {
  0% {
    transform: translateY(200rpx) scale(0.9);
    opacity: 0;
  }
  70% {
    transform: translateY(-16rpx) scale(1.02);
    opacity: 1;
  }
  100% {
    transform: translateY(0) scale(1);
    opacity: 1;
  }
}

