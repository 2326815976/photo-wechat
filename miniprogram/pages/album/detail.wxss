 * Web 同款：拆信交互（LetterOpeningModal）
 * ========================= */
.letter-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.50);
  /* Web: backdrop-blur-sm（4px） */
  backdrop-filter: blur(4px);
  z-index: 1500;
}

.letter-modal {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1501;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
}

.envelope-wrap,
.opening-wrap {
  width: 640rpx; /* 320px */
  height: 520rpx;
  position: relative;
}

.envelope-float {
  width: 640rpx;
  height: 520rpx;
  position: relative;
  animation:
    envelope-enter 0.2s ease-out both,
    envelope-float 3s ease-in-out 0.2s infinite;
}

.envelope-float--exit {
  animation: envelope-exit 0.2s ease-out forwards;
}

@keyframes envelope-enter {
  0% {
    transform: scale(0.8);
    opacity: 0;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

@keyframes envelope-float {
  0% { transform: translateY(0); }
  50% { transform: translateY(-16rpx); } /* -8px */
  100% { transform: translateY(0); }
}

@keyframes envelope-exit {
  0% {
    transform: scale(1);
    opacity: 1;
  }
  100% {
    transform: scale(1.2);
    opacity: 0;
  }
}

.envelope-card {
  position: absolute;
  left: 0;
  top: 0;
  width: 640rpx;
  height: 416rpx; /* 208px */
  border-radius: 24rpx; /* rounded-xl */
  overflow: hidden;
  box-shadow: 0 48rpx 120rpx -24rpx rgba(93, 64, 55, 0.35);
  background: radial-gradient(ellipse at center, #fdfbf7 0%, #f9f6f0 50%, #f5f0e8 100%);
}

.envelope-stitch {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  right: 16rpx;
  bottom: 16rpx;
  border: 4rpx dashed #e6d5b8;
  border-radius: 20rpx;
  pointer-events: none;
  z-index: 2;
}

.envelope-noise {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  opacity: 0.08;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
  pointer-events: none;
  z-index: 1;
}

.envelope-flap {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 256rpx; /* 128px */
  background: linear-gradient(to bottom, #f7f1e3 0%, #f0e8d8 100%);
  clip-path: polygon(0 0, 100% 0, 50% 100%);
  box-shadow: 0 8rpx 24rpx rgba(93, 64, 55, 0.15);
  z-index: 10;
}

.envelope-stamp {
  position: absolute;
  top: 32rpx;
  right: 32rpx;
  width: 96rpx;
  height: 112rpx;
  background: #ffffff;
  border: 8rpx dotted #e0e0e0;
  border-radius: 8rpx;
  box-shadow: 0 4rpx 12rpx rgba(93, 64, 55, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(6deg);
  z-index: 20;
}

.envelope-stamp-emoji {
  font-size: 48rpx; /* 24px */
}

.envelope-postmark {
  position: absolute;
  top: 48rpx;
  right: 160rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 999rpx;
  border: 4rpx dashed rgba(208, 208, 208, 0.40);
  z-index: 20;
}

.envelope-to {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 64rpx;
  z-index: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
