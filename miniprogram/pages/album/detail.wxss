@keyframes opening-pop {
  0% { transform: scale(1); opacity: 1; }
  100% { transform: scale(1.2); opacity: 0; }
}

.paper-card {
  position: relative;
  width: 90%;
  max-width: 1000rpx; /* 500px */
  max-height: 80vh;
  background: #fffef9;
  border-radius: 32rpx; /* rounded-2xl */
  box-shadow: 0 48rpx 120rpx rgba(93, 64, 55, 0.35);
  overflow: hidden;
  background-image: repeating-linear-gradient(
    transparent,
    transparent 62rpx,
    rgba(93, 64, 55, 0.10) 62rpx,
    rgba(93, 64, 55, 0.10) 64rpx
  );
}

.paper-card--open {
  animation: paper-in 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.paper-card--closing {
