.page {
  min-height: 100vh;
  background: #FFFBF0;
}

.content {
  /* Web: px-2 pt-3 pb-20 */
  padding: 24rpx 16rpx calc(160rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.config-tip {
  background: rgba(255, 255, 255, 0.75);
  border: 4rpx dashed rgba(93, 64, 55, 0.15);
  border-radius: 28rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 18rpx;
}

.config-tip__title {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: #5D4037;
  margin-bottom: 6rpx;
}

.config-tip__desc {
  display: block;
  font-size: 22rpx;
  color: rgba(93, 64, 55, 0.60);
}

.loading {
  padding-top: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
}

.loading-ring {
  position: relative;
  width: 192rpx;
  height: 192rpx;
}

.ring {
  position: absolute;
  border-radius: 999rpx;
  border-style: solid;
  box-sizing: border-box;
}

.ring--outer {
  inset: 0;
  border-width: 10rpx;
  border-color: rgba(255, 200, 87, 0.30);
  border-top-color: #FFC857;
  animation: spin 3s linear infinite;
}

.ring--inner {
  inset: 24rpx;
  border-width: 10rpx;
  border-color: rgba(93, 64, 55, 0.20);
  border-bottom-color: #5D4037;
  animation: spin-reverse 2s linear infinite;
}

.ring-center {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.center-icon {
  width: 64rpx;
  height: 64rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

@keyframes spin-reverse {
  0% { transform: rotate(360deg); }
  100% { transform: rotate(0deg); }
}

.loading-text {
  text-align: center;
}

.loading-title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #5D4037;
  margin-bottom: 6rpx;
}

.loading-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(93, 64, 55, 0.60);
}

.tagbar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.tagbar-scroll {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
}

.tagbar-row {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding-bottom: 4rpx;
}

.tag-btn {
  flex: none;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  background: rgba(255, 255, 255, 0.60);
  color: rgba(93, 64, 55, 0.60);
  border: 4rpx dashed rgba(93, 64, 55, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  min-height: auto;
  min-width: auto;
  white-space: nowrap;
  transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
}

.tag-btn--active {
  background: #FFC857;
  color: #5D4037;
  border: 4rpx solid rgba(93, 64, 55, 0.20);
  box-shadow: 4rpx 4rpx 0 rgba(93, 64, 55, 0.15);
}

.tag-btn--touch {
  border-color: rgba(93, 64, 55, 0.30);
}

.tag-all-btn {
  flex: none;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  background: #5D4037;
  color: #FFFFFF;
  border: 4rpx solid #5D4037;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  min-height: auto;
  min-width: auto;
  white-space: nowrap;
  transition: background-color 0.2s ease, opacity 0.2s ease;
}

.tag-all-btn--active {
  opacity: 0.92;
  background: #6A4B41;
}

.masonry {
  display: flex;
  gap: 16rpx;
}

.masonry--single {
  display: block;
}

.masonry--single .col:first-child {
  width: 100%;
}

.masonry--single .col:last-child {
  display: none;
}

.col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.card {
  width: 100%;
  box-sizing: border-box;
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 30rpx rgba(93, 64, 55, 0.10);
}

.card--highlight {
  border: 4rpx solid #FFB703;
  background: #fffdf7;
  box-shadow: 0 0 0 2rpx rgba(255, 229, 156, 0.92), 0 14rpx 32rpx rgba(255, 183, 3, 0.48), 0 8rpx 20rpx rgba(93, 64, 55, 0.20);
  transform: translateY(-2rpx);
}

.img-wrap {
  position: relative;
  transition: transform 0.2s ease, filter 0.2s ease;
}

.img-wrap--story-open {
  background: linear-gradient(150deg, #fffdf7 0%, #fff5dc 52%, #fcebc5 100%);
}

.img-wrap--active {
  transform: scale(0.995);
  filter: brightness(0.98);
}

.img {
  width: 100%;
}

.story-panel {
  min-height: 280rpx;
  padding: 16rpx;
  box-sizing: border-box;
}

.story-panel__paper {
  position: relative;
  width: 100%;
  min-height: 248rpx;
  border-radius: 18rpx;
  padding: 18rpx 18rpx 20rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(166, 126, 82, 0.24);
  background:
    linear-gradient(180deg, rgba(255, 251, 242, 0.98) 0%, rgba(255, 246, 231, 0.98) 100%),
    repeating-linear-gradient(
      180deg,
      rgba(255, 255, 255, 0) 0rpx,
      rgba(255, 255, 255, 0) 46rpx,
      rgba(93, 64, 55, 0.055) 46rpx,
      rgba(93, 64, 55, 0.055) 48rpx
    );
  box-shadow:
    inset 0 0 0 2rpx rgba(255, 255, 255, 0.72),
    0 8rpx 20rpx rgba(93, 64, 55, 0.14);
}

.story-panel__title {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 34rpx;
  padding: 0 14rpx;
  margin-bottom: 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 200, 87, 0.22);
  border: 2rpx solid rgba(93, 64, 55, 0.16);
  color: rgba(93, 64, 55, 0.86);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
}

.story-panel__text {
  display: block;
  font-size: 25rpx;
  line-height: 1.78;
  color: rgba(93, 64, 55, 0.93);
  font-weight: 600;
  letter-spacing: 0.4rpx;
  text-align: left;
  white-space: pre-wrap;
  word-break: break-word;
}

.views {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.40);
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
}

.views-icon {
  width: 24rpx;
  height: 24rpx;
}

.views-num {
  font-size: 20rpx;
  color: #FFFFFF;
  font-weight: 700;
}

.story-toggle {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.38);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(255, 255, 255, 0.45);
}

.story-toggle--highlight {
  background: linear-gradient(135deg, #FFD76E 0%, #FFC857 100%);
  border: 3rpx solid rgba(93, 64, 55, 0.45);
  box-shadow: 0 0 0 2rpx rgba(255, 229, 156, 0.9), 0 10rpx 24rpx rgba(255, 183, 3, 0.55);
  animation: highlight-breathe 1.8s ease-in-out infinite;
}

.story-toggle__icon {
  font-size: 28rpx;
  color: #fff;
  font-weight: 700;
  line-height: 1;
  transition: transform 0.2s ease;
}

.story-toggle--highlight .story-toggle__icon {
  color: #5D4037;
  text-shadow: 0 1rpx 0 rgba(255, 255, 255, 0.55);
}

.story-toggle__icon--open {
  transform: rotate(180deg);
}

.highlight-badge {
  position: absolute;
  left: 12rpx;
  bottom: 12rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #FFE39B 0%, #FFC857 100%);
  border: 3rpx solid rgba(93, 64, 55, 0.32);
  box-shadow: 0 0 0 2rpx rgba(255, 236, 179, 0.9), 0 10rpx 24rpx rgba(255, 183, 3, 0.62);
}

.highlight-badge__text {
  font-size: 22rpx;
  color: #5D4037;
  font-weight: 800;
  line-height: 1.2;
}

@keyframes highlight-breathe {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}

.meta {
  padding: 12rpx 14rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.date {
  font-size: 20rpx;
  color: rgba(141, 110, 99, 0.70);
  margin-left: auto;
  text-align: right;
}

.like {
  display: flex;
  align-items: center;
  gap: 6rpx;
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.like--active {
  opacity: 0.9;
  transform: scale(0.95);
}

.like-icon {
  width: 26rpx;
  height: 26rpx;
}

.like-count {
  font-size: 20rpx;
  color: rgba(141, 110, 99, 0.90);
}

.empty {
  padding: 120rpx 0;
  text-align: center;
}

.empty-text {
  color: rgba(93, 64, 55, 0.50);
  font-size: 26rpx;
}

.more {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.small-spinner {
  width: 40rpx;
  height: 40rpx;
  border-radius: 999rpx;
  border: 6rpx solid rgba(255, 200, 87, 0.40);
  border-top-color: #FFC857;
  animation: spin 1.0s linear infinite;
}

.more-text {
  font-size: 22rpx;
  color: rgba(93, 64, 55, 0.60);
  font-weight: 700;
}

.end {
  margin-top: 24rpx;
  text-align: center;
}

.end-text {
  font-size: 22rpx;
  color: rgba(93, 64, 55, 0.40);
}

.tag-selector-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.30);
  z-index: 998;
}

.tag-selector-mask--enter {
  animation: tag-selector-mask-in 300ms ease-out both;
}

.tag-selector {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 999;
  padding: 0 40rpx;
  box-sizing: border-box;
}

.tag-selector--enter .tag-selector-card {
  animation: tag-selector-card-in 300ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.tag-selector-card {
  width: 100%;
  max-height: 66vh;
  background: #FFFBF0;
  border-radius: 32rpx;
  border: 4rpx solid rgba(93, 64, 55, 0.10);
  box-shadow: 0 16rpx 60rpx rgba(93, 64, 55, 0.20);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.tag-selector-header {
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 4rpx dashed rgba(93, 64, 55, 0.15);
}

.tag-selector-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #5D4037;
}

.tag-selector-close {
  width: 64rpx;
  min-width: 0;
  height: 64rpx;
  border-radius: 999rpx;
  background: rgba(93, 64, 55, 0.10);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  line-height: 1;
  transition: background-color 0.2s ease;
}

.tag-selector-close--active {
  background: rgba(93, 64, 55, 0.20);
}

.tag-selector-close-icon {
  width: 40rpx;
  height: 40rpx;
}

.tag-selector-body {
  flex: 1;
  padding: 28rpx 32rpx;
  box-sizing: border-box;
}

.selector-group + .selector-group {
  margin-top: 26rpx;
}

.selector-group__title {
  display: block;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: rgba(93, 64, 55, 0.82);
}

.tag-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-content: flex-start;
  row-gap: 16rpx;
  width: 100%;
  box-sizing: border-box;
}

.grid-btn {
  flex: 0 0 31.5%;
  max-width: 31.5%;
  min-width: 31.5%;
  box-sizing: border-box;
  margin-bottom: 0;
  padding: 14rpx 10rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  font-weight: 700;
  background: #FFFFFF;
  color: rgba(93, 64, 55, 0.60);
  border: 4rpx dashed rgba(93, 64, 55, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  transition: border-color 0.2s ease, background-color 0.2s ease;
}

.grid-btn--active {
  background: #FFC857;
  color: #5D4037;
  border: 4rpx solid rgba(93, 64, 55, 0.20);
  box-shadow: 4rpx 4rpx 0 rgba(93, 64, 55, 0.15);
}

.grid-btn--touch {
  border-color: rgba(93, 64, 55, 0.30);
}

.tag-selector-footer {
  padding: 26rpx 32rpx 32rpx;
  border-top: 4rpx dashed rgba(93, 64, 55, 0.15);
  background: rgba(255, 255, 255, 0.50);
}

.tag-selector-actions {
  display: flex;
  gap: 16rpx;
}

.btn-clear {
  flex: 1;
  padding: 24rpx 0;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #5D4037;
  border: 4rpx solid rgba(93, 64, 55, 0.20);
  font-weight: 700;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  transition: background-color 0.2s ease;
}

.btn-ok {
  flex: 1;
  padding: 24rpx 0;
  border-radius: 999rpx;
  background: #FFC857;
  color: #5D4037;
  border: 4rpx solid rgba(93, 64, 55, 0.20);
  font-weight: 700;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  transition: box-shadow 0.2s ease, transform 0.2s ease;
}

.btn-clear--active {
  background: rgba(93, 64, 55, 0.08);
}

.btn-ok--active {
  transform: scale(0.98);
  box-shadow: 0 8rpx 20rpx rgba(93, 64, 55, 0.12);
}

.modal-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.60);
  z-index: 998;
}

.preview-modal,
.login-modal {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.preview-card {
  width: 100%;
  max-width: 680rpx;
  max-height: 90vh;
  background: #FFFBF0;
  border-radius: 32rpx;
  border: 4rpx solid rgba(93, 64, 55, 0.10);
  box-shadow: 0 24rpx 80rpx rgba(93, 64, 55, 0.25);
  overflow: hidden;
  position: relative;
}

.preview-tape {
  position: absolute;
  top: -12rpx;
  left: 50%;
  width: 180rpx;
  height: 42rpx;
  transform: translateX(-50%) rotate(-1deg);
  background: rgba(255, 200, 87, 0.40);
  border-radius: 8rpx;
  z-index: 2;
}

.preview-image-wrap {
  padding: 20rpx 20rpx 14rpx;
}

.preview-image {
  width: 100%;
  border-radius: 16rpx;
  background: #FFFFFF;
}

.preview-meta {
  padding: 16rpx 20rpx 20rpx;
  border-top: 4rpx dashed rgba(93, 64, 55, 0.10);
  background: rgba(255, 255, 255, 0.50);
}

.preview-stats {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  margin-bottom: 16rpx;
}

.preview-stat,
.preview-like {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: transparent;
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.preview-like--active {
  transform: scale(0.96);
  opacity: 0.9;
}

.preview-stat-icon {
  width: 32rpx;
  height: 32rpx;
}

.preview-stat-text {
  font-size: 24rpx;
  color: #5D4037;
  font-weight: 600;
}

.preview-close {
  width: 100%;
  height: 74rpx;
  border-radius: 16rpx;
  background: rgba(93, 64, 55, 0.10);
  color: #5D4037;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  transition: background-color 0.2s ease;
}

.preview-close--active {
  background: rgba(93, 64, 55, 0.20);
}

.login-card {
  width: 100%;
  max-width: 620rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 36rpx 30rpx;
  box-sizing: border-box;
}

.login-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 999rpx;
  background: rgba(255, 200, 87, 0.20);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20rpx;
}

.login-icon-img {
  width: 64rpx;
  height: 64rpx;
}

.login-title {
  display: block;
  text-align: center;
  font-size: 34rpx;
  color: #5D4037;
  font-weight: 900;
  margin-bottom: 14rpx;
}

.login-desc {
  display: block;
  text-align: center;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(93, 64, 55, 0.75);
  margin-bottom: 10rpx;
}

.login-sub {
  display: block;
  text-align: center;
  font-size: 22rpx;
  line-height: 1.5;
  color: rgba(93, 64, 55, 0.55);
  margin-bottom: 18rpx;
}

.login-highlight {
  font-weight: 900;
  color: #FFC857;
}

.login-actions {
  display: flex;
  gap: 12rpx;
}

.login-btn-ghost,
.login-btn-primary {
  flex: 1;
  height: 86rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  transition: background-color 0.2s ease, box-shadow 0.2s ease;
}

.login-btn-ghost {
  background: rgba(93, 64, 55, 0.10);
  color: #5D4037;
}

.login-btn-primary {
  background: #FFC857;
  color: #5D4037;
}

.login-btn-ghost--active {
  background: rgba(93, 64, 55, 0.20);
}

.login-btn-primary--active {
  box-shadow: 0 6rpx 18rpx rgba(93, 64, 55, 0.18);
}

@keyframes tag-selector-mask-in {
  0% {
    opacity: 0;
  }
  100% {
    opacity: 1;
  }
}

@keyframes tag-selector-card-in {
  0% {
    transform: translateY(-12rpx) scale(0.96);
    opacity: 0;
  }
  100% {
    transform: translateY(0) scale(1);
    opacity: 1;
  }
}
