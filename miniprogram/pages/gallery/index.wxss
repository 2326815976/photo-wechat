.page {
  min-height: 100vh;
  background: #FFFBF0;
}

.content {
  /* Web: px-2 pt-3 pb-20 */
  padding: 24rpx 16rpx calc(160rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.config-tip {
  background: rgba(255, 255, 255, 0.75);
  border: 4rpx dashed rgba(93, 64, 55, 0.15);
  border-radius: 28rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 18rpx;
}

.config-tip__title {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: #5D4037;
  margin-bottom: 6rpx;
}

.config-tip__desc {
  display: block;
  font-size: 22rpx;
  color: rgba(93, 64, 55, 0.60);
}

.loading {
  padding-top: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
}

.loading-ring {
  position: relative;
  width: 192rpx;
  height: 192rpx;
}

.ring {
  position: absolute;
  border-radius: 999rpx;
  border-style: solid;
  box-sizing: border-box;
}

.ring--outer {
  inset: 0;
  border-width: 10rpx;
  border-color: rgba(255, 200, 87, 0.30);
  border-top-color: #FFC857;
  animation: spin 3s linear infinite;
}

.ring--inner {
  inset: 24rpx;
  border-width: 10rpx;
  border-color: rgba(93, 64, 55, 0.20);
  border-bottom-color: #5D4037;
  animation: spin-reverse 2s linear infinite;
}

.ring-center {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.center-icon {
  width: 64rpx;
  height: 64rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

@keyframes spin-reverse {
  0% { transform: rotate(360deg); }
  100% { transform: rotate(0deg); }
}

.loading-text {
  text-align: center;
}

.loading-title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #5D4037;
  margin-bottom: 6rpx;
}

.loading-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(93, 64, 55, 0.60);
}

.masonry {
  display: flex;
  gap: 16rpx;
}

.col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 30rpx rgba(93, 64, 55, 0.10);
}

.img-wrap {
  position: relative;
  transition: transform 0.2s ease, filter 0.2s ease;
}

.img-wrap--active {
  transform: scale(0.995);
  filter: brightness(0.98);
}

.img {
  width: 100%;
}

.views {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.40);
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
}

.views-icon {
  width: 24rpx;
  height: 24rpx;
}

.views-num {
  font-size: 20rpx;
  color: #FFFFFF;
  font-weight: 700;
}

.meta {
  padding: 12rpx 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.date {
  font-size: 20rpx;
  color: rgba(141, 110, 99, 0.70);
}

.like {
  display: flex;
  align-items: center;
  gap: 6rpx;
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.like--active {
  opacity: 0.9;
  transform: scale(0.95);
}

.like-icon {
  width: 26rpx;
  height: 26rpx;
}

.like-count {
  font-size: 20rpx;
  color: rgba(141, 110, 99, 0.90);
}

.empty {
  padding: 120rpx 0;
  text-align: center;
}

.empty-text {
  color: rgba(93, 64, 55, 0.50);
  font-size: 26rpx;
}

.more {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.small-spinner {
  width: 40rpx;
  height: 40rpx;
  border-radius: 999rpx;
  border: 6rpx solid rgba(255, 200, 87, 0.40);
  border-top-color: #FFC857;
  animation: spin 1.0s linear infinite;
}

.more-text {
  font-size: 22rpx;
  color: rgba(93, 64, 55, 0.60);
  font-weight: 700;
}

.end {
  margin-top: 24rpx;
  text-align: center;
}

.end-text {
  font-size: 22rpx;
  color: rgba(93, 64, 55, 0.40);
}

.modal-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.60);
  z-index: 998;
}

.preview-modal,
.login-modal {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.preview-card {
  width: 100%;
  max-width: 680rpx;
  max-height: 90vh;
  background: #FFFBF0;
  border-radius: 32rpx;
  border: 4rpx solid rgba(93, 64, 55, 0.10);
  box-shadow: 0 24rpx 80rpx rgba(93, 64, 55, 0.25);
  overflow: hidden;
  position: relative;
}

.preview-tape {
  position: absolute;
  top: -12rpx;
  left: 50%;
  width: 180rpx;
  height: 42rpx;
  transform: translateX(-50%) rotate(-1deg);
  background: rgba(255, 200, 87, 0.40);
  border-radius: 8rpx;
  z-index: 2;
}

.preview-image-wrap {
  padding: 20rpx 20rpx 14rpx;
}

.preview-image {
  width: 100%;
  border-radius: 16rpx;
  background: #FFFFFF;
}

.preview-meta {
  padding: 16rpx 20rpx 20rpx;
  border-top: 4rpx dashed rgba(93, 64, 55, 0.10);
  background: rgba(255, 255, 255, 0.50);
}

.preview-stats {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  margin-bottom: 16rpx;
}

.preview-stat,
.preview-like {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: transparent;
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.preview-like--active {
  transform: scale(0.96);
  opacity: 0.9;
}

.preview-stat-icon {
  width: 32rpx;
  height: 32rpx;
}

.preview-stat-text {
  font-size: 24rpx;
  color: #5D4037;
  font-weight: 600;
}

.preview-close {
  width: 100%;
  height: 74rpx;
  border-radius: 16rpx;
  background: rgba(93, 64, 55, 0.10);
  color: #5D4037;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  transition: background-color 0.2s ease;
}

.preview-close--active {
  background: rgba(93, 64, 55, 0.20);
}

.login-card {
  width: 100%;
  max-width: 620rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 36rpx 30rpx;
  box-sizing: border-box;
}

.login-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 999rpx;
  background: rgba(255, 200, 87, 0.20);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20rpx;
}

.login-icon-img {
  width: 64rpx;
  height: 64rpx;
}

.login-title {
  display: block;
  text-align: center;
  font-size: 34rpx;
  color: #5D4037;
  font-weight: 900;
  margin-bottom: 14rpx;
}

.login-desc {
  display: block;
  text-align: center;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(93, 64, 55, 0.75);
  margin-bottom: 10rpx;
}

.login-sub {
  display: block;
  text-align: center;
  font-size: 22rpx;
  line-height: 1.5;
  color: rgba(93, 64, 55, 0.55);
  margin-bottom: 18rpx;
}

.login-highlight {
  font-weight: 900;
  color: #FFC857;
}

.login-actions {
  display: flex;
  gap: 12rpx;
}

.login-btn-ghost,
.login-btn-primary {
  flex: 1;
  height: 86rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  transition: background-color 0.2s ease, box-shadow 0.2s ease;
}

.login-btn-ghost {
  background: rgba(93, 64, 55, 0.10);
  color: #5D4037;
}

.login-btn-primary {
  background: #FFC857;
  color: #5D4037;
}

.login-btn-ghost--active {
  background: rgba(93, 64, 55, 0.20);
}

.login-btn-primary--active {
  box-shadow: 0 6rpx 18rpx rgba(93, 64, 55, 0.18);
}
