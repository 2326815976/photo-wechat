<page-meta page-style="{{(switchingFolderLoading || pendingSwitchPhotoIds.length > 0) ? 'overflow: hidden;' : ''}}" />
<view class="page {{pageIsStandalone ? 'page--preview' : ''}}">
  <app-header
  managedPageKey="gallery"
    title="{{hideAudit ? '拾光谣' : '照片墙'}}"
    subtitle="{{hideAudit ? '✨ 定格美好瞬间 ✨' : '📸 贩卖人间路过的温柔 📸'}}"
    safeTop="{{safeTop}}"
    showBack="{{pageIsStandalone}}"
    fallbackRoute="{{pageFallbackRoute}}"
    fallbackTab="{{pageFallbackTab}}"
    preferFallback="{{pageIsStandalone}}"
  />

  <view class="content {{pageIsStandalone ? 'content--preview' : ''}}">
    <view class="config-tip motion-fade-up motion-delay-1" wx:if="{{serviceMissing}}">
      <text class="config-tip__title">需要配置云托管服务名</text>
      <text class="config-tip__desc">请在 miniprogram/config.js 中填写 cloudRunService（用于 X-WX-SERVICE）</text>
    </view>

    <view class="loading motion-fade-up motion-delay-2" wx:if="{{loading && folders.length === 0 && left.length === 0 && right.length === 0}}">
      <view class="loading-ring">
        <view class="ring ring--outer"></view>
        <view class="ring ring--inner"></view>
        <view class="ring-center">
          <image class="center-icon" src="/images/icons/camera-yellow.svg" mode="aspectFit" />
        </view>
      </view>
      <view class="loading-text">
        <text class="loading-title">加载中...</text>
        <text class="loading-desc">正在加载照片墙</text>
      </view>
    </view>

    <view>
      <view class="tagbar {{tagbarPinned ? 'tagbar--pinned' : ''}} {{showTagGuide ? 'tagbar--with-guide' : ''}} motion-fade-up motion-delay-2" style="top: {{tagbarStickyTop}}px;">
        <view class="tagbar-main {{showTagGuide ? 'tagbar-main--with-guide' : ''}}">
          <view class="tag-guide-tip motion-pop-in" wx:if="{{showTagGuide}}" bindtap="dismissTagGuide">
            <text class="tag-guide-tip__text">左右滑动 / 点击标签可切换</text>
            <view class="tag-guide-tip__arrow"></view>
          </view>
          <scroll-view class="tagbar-scroll" scroll-x="{{!(switchingFolderLoading || pendingSwitchPhotoIds.length > 0)}}" show-scrollbar="{{false}}" enable-flex="{{true}}">
            <view class="tagbar-row">
              <button
                class="tag-btn {{selectedFolder === item.id ? 'tag-btn--active' : ''}} {{tagWaveActiveIndex === index ? (tagWaveTick === 1 ? 'tag-btn--wave-a' : 'tag-btn--wave-b') : ''}}"
                hover-class="tag-btn--touch"
                hover-stay-time="80"
                wx:for="{{folders}}"
                wx:key="id"
                data-id="{{item.id}}"
                bindtap="onSelectFolder"
                disabled="{{switchingFolderLoading || pendingSwitchPhotoIds.length > 0}}"
              >
                {{item.name}}
              </button>
            </view>
          </scroll-view>
        </view>
        <button class="tag-all-btn" hover-class="tag-all-btn--active" hover-stay-time="80" bindtap="onTapFilter" disabled="{{switchingFolderLoading || pendingSwitchPhotoIds.length > 0}}">全部</button>
      </view>

      <view class="gallery-content-shell">
        <view class="gallery-overlay-loading motion-fade-in" wx:if="{{switchingFolderLoading || pendingSwitchPhotoIds.length > 0}}" catchtouchmove="noop">
          <view class="loading-ring gallery-overlay-loading__ring">
            <view class="ring ring--outer"></view>
            <view class="ring ring--inner"></view>
            <view class="ring-center">
              <image class="center-icon" src="/images/icons/sparkles-yellow.svg" mode="aspectFit" />
            </view>
          </view>
          <view class="loading-text">
            <text class="loading-title">拾光中...</text>
            <text class="loading-desc">正在切换照片标签</text>
          </view>
        </view>

        <view class="masonry {{right.length === 0 ? 'masonry--single' : ''}} motion-fade-up motion-delay-2" wx:if="{{left.length > 0 || right.length > 0}}">
        <view class="col gallery-col gallery-col--left">
          <view class="card {{item.story_highlight ? 'card--highlight' : ''}} motion-fade-up" wx:for="{{left}}" wx:key="id" style="animation-delay: {{100 + (index % 8) * 30}}ms;">
            <view class="img-wrap {{item.story_open ? 'img-wrap--story-open' : ''}}" hover-class="img-wrap--active" hover-stay-time="80">
              <block wx:if="{{item.story_open && item.has_story}}">
                <view class="story-panel" data-id="{{item.id}}" bindtap="toggleStory">
                  <view class="story-panel__paper">
                    <text class="story-panel__title">关于此刻</text>
                    <text class="story-panel__text">{{item.story_text}}</text>
                  </view>
                </view>
              </block>
              <block wx:else>
                <view class="img-box" style="padding-top: {{item.__media_padding_top || '100%'}};" data-id="{{item.id}}" bindtap="previewPhoto">
                  <image class="img {{item._imageLoaded ? 'img--loaded' : ''}}" src="{{item.thumbnail_url_resolved}}" mode="aspectFill" lazy-load="{{true}}" bindload="onPhotoLoad" binderror="onPhotoError" data-id="{{item.id}}" />
                  <view class="img-loading-card {{item._imageLoaded ? 'img-loading-card--hidden' : ''}} {{item._imageLoadFailed ? 'img-loading-card--error' : ''}}">
                    <block wx:if="{{item._imageLoadFailed}}">
                      <view class="img-loading-card__center img-loading-card__center--error">
                        <view class="img-loading-card__camera-wrap img-loading-card__camera-wrap--error">
                          <image class="img-loading-card__camera" src="/images/icons/camera-brown.svg" mode="aspectFit" />
                        </view>
                        <text class="img-loading-card__title">图片开小差了</text>
                        <text class="img-loading-card__desc">稍后再试试</text>
                      </view>
                    </block>
                    <block wx:else>
                      <view class="img-loading-card__glow"></view>
                      <view class="img-loading-card__spark img-loading-card__spark--left">
                        <image class="img-loading-card__spark-icon" src="/images/icons/sparkles-yellow.svg" mode="aspectFit" />
                      </view>
                      <view class="img-loading-card__spark img-loading-card__spark--right">
                        <image class="img-loading-card__spark-icon" src="/images/icons/sparkles-brown.svg" mode="aspectFit" />
                      </view>
                      <view class="img-loading-card__center">
                        <view class="img-loading-card__camera-wrap">
                          <image class="img-loading-card__camera" src="/images/icons/camera-brown.svg" mode="aspectFit" />
                        </view>
                        <text class="img-loading-card__title">拾光中...</text>
                        <view class="img-loading-card__dots">
                          <view class="img-loading-card__dot img-loading-card__dot--1"></view>
                          <view class="img-loading-card__dot img-loading-card__dot--2"></view>
                          <view class="img-loading-card__dot img-loading-card__dot--3"></view>
                        </view>
                      </view>
                    </block>
                  </view>
                </view>
              </block>

              <view class="views" wx:if="{{!hideAudit && !item.story_open}}">
                <image class="views-icon" src="/images/icons/eye-white.svg" mode="aspectFit" />
                <text class="views-num">{{item.view_count}}</text>
              </view>

              <view class="story-toggle {{item.story_highlight ? 'story-toggle--highlight' : ''}}" wx:if="{{item.has_story}}" data-id="{{item.id}}" catchtap="toggleStory">
                <text class="story-toggle__icon {{item.story_open ? 'story-toggle__icon--open' : ''}}">↻</text>
              </view>

            </view>
            <view class="meta">
              <view class="meta-row">
                <view class="location-spacer">
                  <view class="location">
                    <image class="location-icon" src="/images/icons/map-pin-yellow.svg" mode="aspectFit" />
                    <text class="location-text">{{item.location_text || '未知'}}</text>
                  </view>
                </view>
                <text class="date">{{item.created_at_text}}</text>
              </view>
              <view class="meta-row meta-row--actions" wx:if="{{!hideAudit}}">
                <view class="like" hover-class="like--active" hover-stay-time="80" catchtap="toggleLike" data-id="{{item.id}}">
                  <image class="like-icon" src="{{item.is_liked ? '/images/icons/heart-fill-yellow.svg' : '/images/icons/heart-outline-muted.svg'}}" mode="aspectFit" />
                  <text class="like-count">{{item.like_count}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
        <view class="col gallery-col gallery-col--right">
          <view class="card {{item.story_highlight ? 'card--highlight' : ''}} motion-fade-up" wx:for="{{right}}" wx:key="id" style="animation-delay: {{120 + (index % 8) * 30}}ms;">
            <view class="img-wrap {{item.story_open ? 'img-wrap--story-open' : ''}}" hover-class="img-wrap--active" hover-stay-time="80">
              <block wx:if="{{item.story_open && item.has_story}}">
                <view class="story-panel" data-id="{{item.id}}" bindtap="toggleStory">
                  <view class="story-panel__paper">
                    <text class="story-panel__title">关于此刻</text>
                    <text class="story-panel__text">{{item.story_text}}</text>
                  </view>
                </view>
              </block>
              <block wx:else>
                <view class="img-box" style="padding-top: {{item.__media_padding_top || '100%'}};" data-id="{{item.id}}" bindtap="previewPhoto">
                  <image class="img {{item._imageLoaded ? 'img--loaded' : ''}}" src="{{item.thumbnail_url_resolved}}" mode="aspectFill" lazy-load="{{true}}" bindload="onPhotoLoad" binderror="onPhotoError" data-id="{{item.id}}" />
                  <view class="img-loading-card {{item._imageLoaded ? 'img-loading-card--hidden' : ''}} {{item._imageLoadFailed ? 'img-loading-card--error' : ''}}">
                    <block wx:if="{{item._imageLoadFailed}}">
                      <view class="img-loading-card__center img-loading-card__center--error">
                        <view class="img-loading-card__camera-wrap img-loading-card__camera-wrap--error">
                          <image class="img-loading-card__camera" src="/images/icons/camera-brown.svg" mode="aspectFit" />
                        </view>
                        <text class="img-loading-card__title">图片开小差了</text>
                        <text class="img-loading-card__desc">稍后再试试</text>
                      </view>
                    </block>
                    <block wx:else>
                      <view class="img-loading-card__glow"></view>
                      <view class="img-loading-card__spark img-loading-card__spark--left">
                        <image class="img-loading-card__spark-icon" src="/images/icons/sparkles-yellow.svg" mode="aspectFit" />
                      </view>
                      <view class="img-loading-card__spark img-loading-card__spark--right">
                        <image class="img-loading-card__spark-icon" src="/images/icons/sparkles-brown.svg" mode="aspectFit" />
                      </view>
                      <view class="img-loading-card__center">
                        <view class="img-loading-card__camera-wrap">
                          <image class="img-loading-card__camera" src="/images/icons/camera-brown.svg" mode="aspectFit" />
                        </view>
                        <text class="img-loading-card__title">拾光中...</text>
                        <view class="img-loading-card__dots">
                          <view class="img-loading-card__dot img-loading-card__dot--1"></view>
                          <view class="img-loading-card__dot img-loading-card__dot--2"></view>
                          <view class="img-loading-card__dot img-loading-card__dot--3"></view>
                        </view>
                      </view>
                    </block>
                  </view>
                </view>
              </block>

              <view class="views" wx:if="{{!hideAudit && !item.story_open}}">
                <image class="views-icon" src="/images/icons/eye-white.svg" mode="aspectFit" />
                <text class="views-num">{{item.view_count}}</text>
              </view>

              <view class="story-toggle {{item.story_highlight ? 'story-toggle--highlight' : ''}}" wx:if="{{item.has_story}}" data-id="{{item.id}}" catchtap="toggleStory">
                <text class="story-toggle__icon {{item.story_open ? 'story-toggle__icon--open' : ''}}">↻</text>
              </view>

            </view>
            <view class="meta">
              <view class="meta-row">
                <view class="location-spacer">
                  <view class="location">
                    <image class="location-icon" src="/images/icons/map-pin-yellow.svg" mode="aspectFit" />
                    <text class="location-text">{{item.location_text || '未知'}}</text>
                  </view>
                </view>
                <text class="date">{{item.created_at_text}}</text>
              </view>
              <view class="meta-row meta-row--actions" wx:if="{{!hideAudit}}">
                <view class="like" hover-class="like--active" hover-stay-time="80" catchtap="toggleLike" data-id="{{item.id}}">
                  <image class="like-icon" src="{{item.is_liked ? '/images/icons/heart-fill-yellow.svg' : '/images/icons/heart-outline-muted.svg'}}" mode="aspectFit" />
                  <text class="like-count">{{item.like_count}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>

        <view class="empty motion-fade-up motion-delay-3" wx:if="{{!loading && left.length === 0 && right.length === 0}}">
        <text class="empty-text">暂无照片</text>
      </view>

      <view class="more" wx:if="{{loadingMore}}">
        <view class="small-spinner"></view>
        <text class="more-text">拾光中...</text>
      </view>
      <view class="end" wx:if="{{!hasMore && (left.length + right.length) > 0}}">
        <text class="end-text">✨ 已经到底啦 ✨</text>
      </view>
    </view>
  </view>

  <view class="tag-selector-mask tag-selector-mask--enter motion-fade-in" wx:if="{{showFilterModal}}" bindtap="closeFilterModal"></view>
  <view class="tag-selector tag-selector--enter" wx:if="{{showFilterModal}}" style="top: {{safeTop + 72}}px;">
    <view class="tag-selector-card motion-pop-in" catchtap="noop">
      <view class="tag-selector-header">
        <text class="tag-selector-title">全部筛选</text>
        <view class="tag-selector-close" hover-class="tag-selector-close--active" hover-stay-time="80" bindtap="closeFilterModal">
          <image class="tag-selector-close-icon" src="/images/icons/x-brown.svg" mode="aspectFit" />
        </view>
      </view>

      <scroll-view class="tag-selector-body" scroll-y>
        <view class="selector-group">
          <text class="selector-group__title">标签</text>
          <view class="tag-grid">
            <view
              class="grid-btn {{tempFolderId === item.id ? 'grid-btn--active' : ''}}"
              hover-class="grid-btn--touch"
              hover-stay-time="80"
              wx:for="{{folders}}"
              wx:key="id"
              data-id="{{item.id}}"
              bindtap="onSelectModalFolder"
            >
              {{item.name}}
            </view>
          </view>
        </view>

        <view class="selector-group">
          <text class="selector-group__title">条件筛选</text>
          <view class="tag-grid">
            <view
              class="grid-btn {{tempFilterPreset === 'default_desc' ? 'grid-btn--active' : ''}}"
              hover-class="grid-btn--touch"
              hover-stay-time="80"
              data-preset="default_desc"
              bindtap="onSelectFilterPreset"
            >
              时间降序
            </view>

            <view
              class="grid-btn {{tempFilterPreset === 'time_asc' ? 'grid-btn--active' : ''}}"
              hover-class="grid-btn--touch"
              hover-stay-time="80"
              data-preset="time_asc"
              bindtap="onSelectFilterPreset"
            >
              时间升序
            </view>

            <view
              class="grid-btn {{tempFilterPreset === 'highlight' ? 'grid-btn--active' : ''}}"
              hover-class="grid-btn--touch"
              hover-stay-time="80"
              data-preset="highlight"
              bindtap="onSelectFilterPreset"
            >
              高亮
            </view>

            <view
              class="grid-btn {{tempFilterPreset === 'story' ? 'grid-btn--active' : ''}}"
              hover-class="grid-btn--touch"
              hover-stay-time="80"
              data-preset="story"
              bindtap="onSelectFilterPreset"
            >
              故事
            </view>
          </view>
        </view>

        <view class="selector-group">
          <view class="selector-group__head">
            <text class="selector-group__title selector-group__title--compact">日期范围</text>
            <view class="date-range-clear" hover-class="date-range-clear--active" hover-stay-time="80" bindtap="onClearFilterDateRange">
              清空日期
            </view>
          </view>
          <view class="date-range-row">
            <picker class="date-range-picker" mode="date" value="{{tempFilterDateStart}}" end="{{maxFilterDate}}" bindchange="onChangeFilterDateStart">
              <view class="date-picker {{tempFilterDateStart ? 'date-picker--active' : ''}}">
                <text>{{tempFilterDateStart || '开始日期'}}</text>
              </view>
            </picker>
            <text class="date-range-sep">至</text>
            <picker class="date-range-picker" mode="date" value="{{tempFilterDateEnd}}" end="{{maxFilterDate}}" bindchange="onChangeFilterDateEnd">
              <view class="date-picker {{tempFilterDateEnd ? 'date-picker--active' : ''}}">
                <text>{{tempFilterDateEnd || '结束日期'}}</text>
              </view>
            </picker>
          </view>
        </view>
      </scroll-view>

      <view class="tag-selector-footer">
        <view class="tag-selector-actions">
          <view class="btn-clear" hover-class="btn-clear--active" bindtap="onResetFilterSelector">重置</view>
          <view class="btn-ok" hover-class="btn-ok--active" bindtap="onApplyFilterSelector">确定</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 便利贴风格预览弹窗 -->
  <view class="modal-mask motion-fade-in" wx:if="{{!hideAudit && previewPhoto}}" bindtap="closePreview"></view>
  <view class="preview-modal motion-fade-in" wx:if="{{!hideAudit && previewPhoto}}">
    <view class="preview-card motion-pop-in" catchtap="noop">
      <view class="preview-tape"></view>

      <view class="preview-image-wrap" bindtap="openFullscreen">
        <image class="preview-image" src="{{previewPhoto.preview_url_resolved}}" mode="widthFix" />
      </view>

      <view class="preview-meta">
        <view class="preview-stats">
          <view class="preview-stat">
            <image class="preview-stat-icon" src="/images/icons/eye-brown.svg" mode="aspectFit" />
            <text class="preview-stat-text">{{previewPhoto.view_count}} 次浏览</text>
          </view>
          <button class="preview-like" hover-class="preview-like--active" data-id="{{previewPhoto.id}}" bindtap="toggleLike">
            <image class="preview-stat-icon" src="{{previewPhoto.is_liked ? '/images/icons/heart-fill-yellow.svg' : '/images/icons/heart-outline-muted.svg'}}" mode="aspectFit" />
            <text class="preview-stat-text">{{previewPhoto.like_count}} 次点赞</text>
          </button>
        </view>
        <button class="preview-close" hover-class="preview-close--active" bindtap="closePreview">关闭</button>
      </view>
    </view>
  </view>

  <!-- 登录提示弹窗 -->
  <view class="modal-mask motion-fade-in" wx:if="{{!hideAudit && showLoginPrompt}}" bindtap="closeLoginPrompt"></view>
  <view class="login-modal motion-fade-in" wx:if="{{!hideAudit && showLoginPrompt}}">
    <view class="login-card motion-pop-in" catchtap="noop">
      <view class="login-icon">
        <image class="login-icon-img" src="/images/icons/heart-fill-yellow.svg" mode="aspectFit" />
      </view>
      <text class="login-title">✨ 想施展赞美魔法？</text>
      <text class="login-desc">
        登录后，你就能成为 <text class="login-highlight">【魔法使】</text>，为喜欢的照片施展 <text class="login-highlight">【赞美魔法】</text>
        啦！每一个赞都是一道温暖的光，让美好的瞬间更加闪耀~ ✨
      </text>
      <text class="login-sub">💡 Tips：魔法使还可以在【返图空间】施展【定格魔法】，让照片永久保存哦！✨</text>

      <view class="login-actions">
        <button class="login-btn-ghost" hover-class="login-btn-ghost--active" hover-stay-time="80" bindtap="closeLoginPrompt">随便看看</button>
        <button class="login-btn-primary" hover-class="login-btn-primary--active" hover-stay-time="80" bindtap="goLogin">💛 去登录</button>
      </view>
    </view>
  </view>

  <app-bottom-nav show="{{hasBottomTabbar}}" currentPath="pages/gallery/index" />
</view>


