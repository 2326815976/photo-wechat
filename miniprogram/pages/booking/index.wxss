@import "../../styles/admin-loading.wxss";

.page {
  min-height: 100vh;
  background: #FFFBF0;
}

.page--preview {
  min-height: 100vh;
}

.content {
  /* Web: px-6 pt-4 pb-20 */
  padding: 32rpx 48rpx calc(160rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.content--preview {
  padding-bottom: calc(8rpx + env(safe-area-inset-bottom));
}

/* 配置提示 */
.config-tip {
  background: rgba(255, 255, 255, 0.75);
  border: 4rpx dashed rgba(93, 64, 55, 0.15);
  border-radius: 28rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.config-tip__title {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: #5D4037;
  margin-bottom: 6rpx;
}

.config-tip__desc {
  display: block;
  font-size: 22rpx;
  color: rgba(93, 64, 55, 0.60);
}

/* 加载状态 */
.loading {
  padding-top: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
}

.loading-ring {
  position: relative;
  width: 192rpx;
  height: 192rpx;
}

.ring {
  position: absolute;
  border-radius: 999rpx;
  border-style: solid;
  box-sizing: border-box;
}

.ring--outer {
  inset: 0;
  border-width: 10rpx;
  border-color: rgba(255, 200, 87, 0.30);
  border-top-color: #FFC857;
  animation: spin 3s linear infinite;
}

.ring--inner {
  inset: 24rpx;
  border-width: 10rpx;
  border-color: rgba(93, 64, 55, 0.20);
  border-bottom-color: #5D4037;
  animation: spin-reverse 2s linear infinite;
}

.ring-center {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.center-icon {
  width: 64rpx;
  height: 64rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

@keyframes spin-reverse {
  0% { transform: rotate(360deg); }
  100% { transform: rotate(0deg); }
}

.loading-text {
  text-align: center;
}

.loading-title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #5D4037;
  margin-bottom: 6rpx;
}

.loading-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(93, 64, 55, 0.60);
}

/* 票据（对齐 Web 端 ActiveBookingTicket） */
.ticket-wrap {
  width: 100%;
  max-width: 680rpx;
  margin: 0 auto;
}

.ticket-card {
  position: relative;
  background: #fffdf5;
  border-radius: 32rpx;
  overflow: hidden;
  border: 4rpx solid rgba(93, 64, 55, 0.20);
  box-shadow: 0 16rpx 48rpx rgba(93, 64, 55, 0.15);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.ticket-card:active {
  transform: scale(0.992);
  box-shadow: 0 10rpx 30rpx rgba(93, 64, 55, 0.18);
}

.ticket-stripe {
  height: 24rpx;
  background: linear-gradient(90deg, #FFC857, #FFD700, #FFC857);
}

.ticket-body {
  padding: 64rpx;
}

.ticket-head {
  text-align: center;
  margin-bottom: 48rpx;
}

.ticket-head-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.ticket-camera {
  width: 96rpx;
  height: 96rpx;
  animation: ticket-wiggle 2.8s ease-in-out infinite;
}

@keyframes ticket-wiggle {
  0% { transform: rotate(0deg); }
  25% { transform: rotate(10deg); }
  50% { transform: rotate(-10deg); }
  75% { transform: rotate(0deg); }
  100% { transform: rotate(0deg); }
}

.ticket-title {
  display: block;
  font-size: 48rpx;
  font-weight: 900;
  color: #5D4037;
  margin-bottom: 10rpx;
}

.ticket-status {
  display: block;
  font-size: 28rpx;
  color: rgba(93, 64, 55, 0.60);
}

.ticket-divider {
  border-top: 4rpx dashed rgba(93, 64, 55, 0.20);
  margin: 48rpx 0;
}

.ticket-info {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.ticket-row {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
}

.ticket-row-icon {
  width: 40rpx;
  height: 40rpx;
  flex: none;
  margin-top: 4rpx;
}

.ticket-row-texts {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.ticket-label {
  font-size: 22rpx;
  color: rgba(93, 64, 55, 0.60);
}

.ticket-value {
  font-size: 30rpx;
  font-weight: 700;
  color: #5D4037;
  word-break: break-all;
}

.sticky {
  width: 95%;
  margin: 0 auto;
  background: #FFF9C4;
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(93, 64, 55, 0.10);
  transform: rotate(1deg);
  border: 2rpx solid #FEF08A;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.sticky:active {
  transform: rotate(0deg) scale(0.995);
  box-shadow: 0 6rpx 16rpx rgba(93, 64, 55, 0.14);
}

.sticky-row {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
}

.sticky-icon {
  width: 40rpx;
  height: 40rpx;
  flex: none;
  margin-top: 4rpx;
}

.sticky-texts {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.sticky-title {
  display: block;
  font-size: 28rpx;
  font-weight: 900;
  color: #5D4037;
  margin-bottom: 0;
  font-family: "ZQKNNY", "YouYuan", "幼圆", "Microsoft YaHei", sans-serif;
}

.sticky-desc {
  display: block;
  font-size: 24rpx;
  color: #8D6E63;
  line-height: 1.7;
  word-break: break-word;
  font-family: "ZQKNNY", "YouYuan", "幼圆", "Microsoft YaHei", sans-serif;
}

.sticky-contact {
  font-size: 30rpx;
  font-weight: 900;
  color: #5D4037;
}

.sticky-wechat {
  display: block;
  margin: 2rpx 0;
  font-size: 42rpx;
  font-weight: 900;
  color: #5D4037;
  text-decoration: underline;
  line-height: 1.15;
  word-break: break-all;
  font-family: "ZQKNNY", "YouYuan", "幼圆", "Microsoft YaHei", sans-serif;
}

.ticket-cancel {
  width: 100%;
  padding: 24rpx 0;
  border-radius: 32rpx;
  background: rgba(93, 64, 55, 0.10);
  color: #5D4037;
  font-weight: 700;
  font-size: 26rpx;
  margin-top: 48rpx;
  transition: transform 0.2s ease, background-color 0.2s ease;
}

.ticket-cancel:active {
  transform: scale(0.985);
  background: rgba(93, 64, 55, 0.16);
}

.ticket-cancel-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.ticket-cancel-icon {
  width: 32rpx;
  height: 32rpx;
}

.ticket-cancel--disabled {
  opacity: 0.55;
}

.ticket-cancel-disabled {
  margin-top: 48rpx;
  width: 100%;
  padding: 24rpx 0;
  border-radius: 32rpx;
  background: rgba(93, 64, 55, 0.05);
  color: rgba(93, 64, 55, 0.40);
  font-weight: 700;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.ticket-tear {
  height: 48rpx;
  background: #FFFBF0;
  position: relative;
}

.ticket-tear-row {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  justify-content: space-around;
}

.tear-dot {
  width: 32rpx;
  height: 32rpx;
  border-radius: 999rpx;
  background: #fffdf5;
  transform: translateY(-16rpx);
}

/* 约拍表单 */
.booking-form {
  margin-top: 10rpx;
}

.success-card {
  background: #fffdf5;
  border-radius: 32rpx;
  padding: 64rpx 32rpx;
  text-align: center;
  box-shadow: 0 12rpx 36rpx rgba(93, 64, 55, 0.12);
}

.success-icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 999rpx;
  background: rgba(255, 200, 87, 0.20);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
}

.success-icon-image {
  width: 80rpx;
  height: 80rpx;
}

.success-title {
  display: block;
  font-size: 40rpx;
  font-weight: 900;
  color: #5D4037;
  margin-bottom: 14rpx;
  font-family: "ZQKNNY", "YouYuan", "幼圆", "Microsoft YaHei", sans-serif;
}

.success-desc {
  display: block;
  font-size: 28rpx;
  color: rgba(93, 64, 55, 0.70);
  line-height: 1.6;
  font-family: "ZQKNNY", "YouYuan", "幼圆", "Microsoft YaHei", sans-serif;
}

.paper-wrap {
  position: relative;
  padding-top: 18rpx;
}

.paper-tape {
  position: absolute;
  top: -32rpx;
  left: 64rpx;
  right: 64rpx;
  height: 64rpx;
  background: rgba(255, 200, 87, 0.30);
  border-radius: 8rpx;
  box-shadow: 0 10rpx 30rpx rgba(93, 64, 55, 0.10);
  transform: rotate(-0.5deg);
  z-index: 2;
}

.paper-card {
  position: relative;
  background: #fffdf5;
  border-radius: 32rpx;
  padding: 48rpx;
  box-shadow: 0 12rpx 36rpx rgba(93, 64, 55, 0.12);
  /* 对齐 Web：允许日期选择器等下拉面板溢出显示 */
  overflow: visible;

  background-image:
    linear-gradient(0deg, transparent 48rpx, rgba(93, 64, 55, 0.05) 50rpx, transparent 52rpx),
    linear-gradient(90deg, transparent 48rpx, rgba(93, 64, 55, 0.05) 50rpx, transparent 52rpx);
  background-size: 50rpx 50rpx;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.paper-card:active {
  transform: scale(0.996);
  box-shadow: 0 8rpx 24rpx rgba(93, 64, 55, 0.14);
}

.doodle {
  position: absolute;
  top: 28rpx;
  right: 28rpx;
  opacity: 0.40;
}

.doodle-icon {
  width: 64rpx;
  height: 64rpx;
}

.form {
  display: flex;
  flex-direction: column;
  gap: 52rpx;
}

.form-item {
  width: 100%;
}

.label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.label-icon {
  width: 32rpx;
  height: 32rpx;
}

.label-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #5D4037;
}

.label-text--block {
  display: block;
  margin-bottom: 16rpx;
}

.label-hint {
  font-size: 22rpx;
  color: rgba(93, 64, 55, 0.50);
  font-weight: 400;
}

.location-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: #FFFFFF;
  border: 4rpx solid rgba(93, 64, 55, 0.20);
  border-radius: 32rpx;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.location-btn--active {
  border-color: #FFC857;
  box-shadow: 0 0 0 6rpx rgba(255, 200, 87, 0.20);
  transform: scale(0.995);
}

.location-left {
  flex: 1;
  min-width: 0;
}

.location-main {
  display: block;
  font-size: 28rpx;
  color: #5D4037;
  font-weight: 600;
  line-height: 1.5;
}

.location-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(93, 64, 55, 0.60);
}

.location-placeholder {
  display: block;
  font-size: 28rpx;
  color: rgba(93, 64, 55, 0.40);
}

.location-right-icon {
  width: 40rpx;
  height: 40rpx;
  flex: none;
}

.location-entry {
  margin-top: 14rpx;
  display: flex;
  gap: 12rpx;
}

.location-entry-btn {
  flex: 1;
  height: 58rpx;
  border-radius: 999rpx;
  border: 2rpx solid rgba(93, 64, 55, 0.16);
  background: #ffffff;
  color: #5D4037;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
  transition: transform 0.2s ease, opacity 0.2s ease, box-shadow 0.2s ease;
}

.location-entry-btn:active {
  transform: scale(0.98);
}

.location-entry-btn--clear {
  background: #fff1f2;
  border-color: #fecdd3;
  color: #dc2626;
}

.location-entry-icon {
  width: 24rpx;
  height: 24rpx;
  flex: none;
}

.location-entry-text {
  line-height: 1;
}

.form-grid2 {
  display: flex;
  gap: 32rpx;
}

.form-half {
  flex: 1;
  min-width: 0;
}

.line-input {
  width: 100%;
  padding: 16rpx 0;
  border: none;
  border-bottom: 4rpx solid rgba(93, 64, 55, 0.20);
  background: transparent;
  color: #5D4037;
  font-size: 28rpx;
  transition: border-color 0.2s ease, border-bottom-width 0.2s ease;
}

.line-input--focus {
  border-bottom-color: #FFC857;
  border-bottom-width: 6rpx;
}

.line-textarea {
  width: 100%;
  padding: 10rpx 0;
  border: none;
  border-bottom: 4rpx solid rgba(93, 64, 55, 0.20);
  background: transparent;
  color: #5D4037;
  font-size: 28rpx;
  min-height: 112rpx;
  max-height: 180rpx;
  transition: border-color 0.2s ease, border-bottom-width 0.2s ease;
}

.line-textarea--focus {
  border-bottom-color: #FFC857;
  border-bottom-width: 6rpx;
}

.error {
  background: #FEF2F2;
  border: 2rpx solid #FECACA;
  border-radius: 28rpx;
  padding: 18rpx 20rpx;
}

.error-text {
  color: #DC2626;
  text-align: center;
  font-size: 24rpx;
  display: block;
}

.btn-submit {
  width: 100%;
  padding: 32rpx 0;
  background: #FFC857;
  color: #5D4037;
  font-weight: 900;
  font-size: 30rpx;
  border-radius: 32rpx;
  border: none;
  box-shadow: 0 8rpx 0 #5D4037;
  transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
}

.btn-submit:active {
  transform: translateY(4rpx) scale(0.99);
  box-shadow: 0 4rpx 0 #5D4037;
  filter: saturate(1.03);
}

.btn-submit--disabled {
  opacity: 0.60;
}

.form-tips {
  padding-top: 32rpx;
  border-top: 2rpx solid rgba(93, 64, 55, 0.10);
}

.tip {
  display: block;
  font-size: 22rpx;
  color: rgba(93, 64, 55, 0.50);
  text-align: center;
  margin-top: 8rpx;
}

/* 登录提示弹窗（对齐 Web 端） */
.modal-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.50);
  z-index: 998;
}

.modal-mask--confirm {
  background: rgba(0, 0, 0, 0.60);
}

.confirm-modal {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 32rpx;
  box-sizing: border-box;
  z-index: 999;
}

.confirm-card {
  width: 100%;
  max-width: 620rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 34rpx 30rpx;
  box-sizing: border-box;
  box-shadow: 0 24rpx 70rpx rgba(93, 64, 55, 0.26);
}

.confirm-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 999rpx;
  margin: 0 auto 18rpx;
  background: rgba(255, 200, 87, 0.20);
  display: flex;
  align-items: center;
  justify-content: center;
}

.confirm-icon {
  width: 54rpx;
  height: 54rpx;
}

.confirm-title {
  display: block;
  text-align: center;
  font-size: 36rpx;
  font-weight: 900;
  color: #5D4037;
  margin-bottom: 14rpx;
}

.confirm-text {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: rgba(93, 64, 55, 0.75);
  line-height: 1.6;
}

.confirm-highlight {
  font-weight: 900;
  color: #FFC857;
}

.confirm-tip {
  display: block;
  text-align: center;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(93, 64, 55, 0.55);
  line-height: 1.5;
}

.confirm-actions {
  margin-top: 24rpx;
  display: flex;
  gap: 12rpx;
}

.confirm-btn {
  flex: 1;
  height: 82rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 0.2s ease, transform 0.2s ease;
}

.confirm-btn--ghost {
  background: rgba(93, 64, 55, 0.10);
  color: #5D4037;
}

.confirm-btn--primary {
  background: #FFC857;
  color: #5D4037;
}

.confirm-btn--ghost-active {
  background: rgba(93, 64, 55, 0.20);
}

.confirm-btn--primary-active {
  transform: scale(0.98);
}

.login-modal {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
  box-sizing: border-box;
}

.login-card {
  width: 100%;
  max-width: 640rpx;
  background: #FFFBF0;
  border-radius: 32rpx;
  padding: 48rpx;
  box-sizing: border-box;
  box-shadow: 0 24rpx 80rpx rgba(93, 64, 55, 0.28);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.login-card:active {
  transform: scale(0.996);
  box-shadow: 0 16rpx 52rpx rgba(93, 64, 55, 0.28);
}

.login-icon {
  width: 128rpx;
  height: 128rpx;
  border-radius: 999rpx;
  background: rgba(255, 200, 87, 0.20);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
}

.login-icon-img {
  width: 64rpx;
  height: 64rpx;
}

.login-title {
  display: block;
  text-align: center;
  font-size: 34rpx;
  color: #5D4037;
  font-weight: 900;
  margin-bottom: 14rpx;
  font-family: "ZQKNNY", "YouYuan", "幼圆", "Microsoft YaHei", sans-serif;
}

.login-desc {
  display: block;
  text-align: center;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(93, 64, 55, 0.75);
  margin-bottom: 22rpx;
}

.login-actions {
  display: flex;
  gap: 12rpx;
}

.login-btn-ghost,
.login-btn-primary {
  flex: 1;
  height: 86rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 800;
  /* 对齐 Web：按钮文字垂直/水平居中 */
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  transition: background-color 0.2s ease, box-shadow 0.2s ease;
}

.login-btn-ghost {
  background: rgba(93, 64, 55, 0.10);
  color: #5D4037;
}

.login-btn-primary {
  background: #FFC857;
  color: #5D4037;
}

.login-btn-ghost--active {
  background: rgba(93, 64, 55, 0.20);
  transform: scale(0.98);
}

.login-btn-primary--active {
  box-shadow: 0 6rpx 18rpx rgba(93, 64, 55, 0.18);
  transform: scale(0.98);
}
