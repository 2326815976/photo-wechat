<view class="page">
  <view style="height: {{safeTop}}px;"></view>

  <!-- Web: top-6 -->
  <view class="back motion-fade-up motion-delay-1" style="top: {{safeTop + 24}}px;" bindtap="goBack">
    <view class="back-btn" hover-class="back-btn--active" hover-stay-time="80">
      <image class="back-icon" src="/images/icons/arrow-left.svg" mode="aspectFit" />
    </view>
  </view>

  <view class="content">
    <view class="title-wrap motion-fade-up motion-delay-2">
      <text class="title">欢迎回来 👋</text>
      <text class="sub">继续你的拾光之旅</text>
    </view>

    <view class="config-tip motion-fade-up motion-delay-3" wx:if="{{serviceMissing}}">
      <text class="config-tip__title">需要配置云托管服务名</text>
      <text class="config-tip__desc">请在 miniprogram/config.js 中填写 cloudRunService（用于 X-WX-SERVICE）</text>
    </view>

    <view class="form motion-fade-up motion-delay-3">
      <view class="field {{focusField === 'phone' ? 'field--focus' : ''}}">
        <image class="field-icon" src="/images/icons/phone-muted.svg" mode="aspectFit" />
        <input
          class="input"
          type="number"
          placeholder="手机号"
          placeholder-style="color: rgba(93, 64, 55, 0.4);"
          maxlength="11"
          value="{{phone}}"
          data-field="phone"
          bindinput="onPhoneInput"
          bindfocus="onFieldFocus"
          bindblur="onFieldBlur"
        />
      </view>

      <view class="field {{focusField === 'password' ? 'field--focus' : ''}}">
        <image class="field-icon" src="/images/icons/lock-muted.svg" mode="aspectFit" />
        <input
          class="input"
          password="{{!showPassword}}"
          placeholder="密码"
          placeholder-style="color: rgba(93, 64, 55, 0.4);"
          value="{{password}}"
          data-field="password"
          bindinput="onPasswordInput"
          bindfocus="onFieldFocus"
          bindblur="onFieldBlur"
        />
        <view class="toggle" hover-class="toggle--active" hover-stay-time="80" bindtap="togglePassword">
          <image class="toggle-icon" src="{{showPassword ? '/images/icons/eye-off-muted.svg' : '/images/icons/eye-muted.svg'}}" mode="aspectFit" />
        </view>
      </view>

      <view class="legal-entry motion-fade-in motion-delay-4">
        <view class="legal-agree" bindtap="onToggleLegalAgreement">
          <image
            class="legal-agree__icon"
            src="{{agreedToLegal ? '/images/icons/check-square-brown.svg' : '/images/icons/square-muted.svg'}}"
            mode="aspectFit"
          />
          <text class="legal-agree__text">我已阅读并同意以下协议</text>
        </view>
        <view class="legal-entry__links">
          <text class="legal-link" hover-class="legal-link--active" data-doc-key="terms" bindtap="onOpenLegalDoc">《用户协议》</text>
          <text class="legal-sep">、</text>
          <text class="legal-link" hover-class="legal-link--active" data-doc-key="privacy" bindtap="onOpenLegalDoc">《隐私政策》</text>
          <text class="legal-sep">、</text>
          <text class="legal-link" hover-class="legal-link--active" data-doc-key="collection" bindtap="onOpenLegalDoc">《用户信息收集说明》</text>
        </view>
      </view>

      <view class="error motion-pop-in" wx:if="{{error}}">{{error}}</view>

      <button class="submit" hover-class="submit--active" bindtap="submit" disabled="{{submitting || serviceMissing}}">
        <text wx:if="{{submitting}}">解锁中...</text>
        <text wx:else>🔑 解锁空间</text>
      </button>

      <view class="wechat-divider">
        <view class="wechat-divider__line"></view>
        <text class="wechat-divider__text">或</text>
        <view class="wechat-divider__line"></view>
      </view>

      <button
        class="wechat-submit"
        hover-class="wechat-submit--active"
        bindtap="submitWechatLogin"
        disabled="{{submitting || wechatSubmitting || serviceMissing}}"
      >
        <text wx:if="{{wechatSubmitting}}">连接微信中...</text>
        <text wx:else>💬 微信一键登录</text>
      </button>

      <view class="footer motion-fade-in motion-delay-4">
        <text class="footer-text">还没有账号？</text>
        <text class="footer-link" hover-class="footer-link--active" bindtap="goRegister">去注册</text>
      </view>
    </view>
  </view>

  <view wx:if="{{showLegalModal}}" class="legal-modal-mask" bindtap="onCloseLegalModal" catchtouchmove="onStopPropagation">
    <view class="legal-modal" catchtap="onStopPropagation" catchtouchmove="onStopPropagation">
      <view class="legal-modal__head">
        <text class="legal-modal__title">{{activeLegalTitle}}</text>
        <view class="legal-modal__close" bindtap="onCloseLegalModal">
          <image class="legal-modal__close-icon" src="/images/icons/x-gray.svg" mode="aspectFit" />
        </view>
      </view>

      <scroll-view class="legal-modal__tabs" scroll-x="{{true}}" enable-flex="{{true}}" show-scrollbar="{{false}}">
        <view class="legal-modal__tabs-inner">
          <view
            wx:for="{{legalDocTabs}}"
            wx:for-item="tab"
            wx:for-index="tabIndex"
            wx:key="key"
            class="legal-modal__tab {{activeLegalKey === tab.key ? 'legal-modal__tab--active' : ''}}"
            data-doc-key="{{tab.key}}"
            bindtap="onSwitchLegalDoc"
          >
            {{tab.shortTitle || tab.title}}
          </view>
        </view>
      </scroll-view>

      <scroll-view class="legal-modal__body" scroll-y="{{true}}" enable-flex="{{true}}">
        <text class="legal-modal__version">{{activeLegalVersion}}</text>

        <view wx:for="{{activeLegalSections}}" wx:for-item="section" wx:for-index="sectionIndex" wx:key="sectionIndex" class="legal-section">
          <text class="legal-section__title">{{section.title}}</text>
          <text
            wx:for="{{section.paragraphs}}"
            wx:for-item="line"
            wx:for-index="lineIndex"
            wx:key="lineIndex"
            class="legal-section__paragraph"
          >
            {{line}}
          </text>
        </view>

        <view class="legal-footer" wx:if="{{activeLegalFooter.length > 0}}">
          <text
            wx:for="{{activeLegalFooter}}"
            wx:for-item="line"
            wx:for-index="lineIndex"
            wx:key="lineIndex"
            class="legal-footer__line"
          >
            {{line}}
          </text>
        </view>
      </scroll-view>

      <view class="legal-modal__foot">
        <button class="legal-modal__btn" hover-class="legal-modal__btn--active" bindtap="onAcknowledgeLegal">我已知悉</button>
      </view>
    </view>
  </view>
</view>
