<view class="tab-bootstrap-mask" wx:if="{{!runtimeConfigReady}}">
  <view class="tab-bootstrap-mask__card">
    <view class="tab-bootstrap-mask__orb">
      <view class="tab-bootstrap-mask__spinner"></view>
    </view>
    <text class="tab-bootstrap-mask__title">正在同步页面配置</text>
    <text class="tab-bootstrap-mask__desc">菜单准备完成后，再显示当前页面内容</text>
  </view>
</view>

<view class="tab-bar" wx:if="{{visible}}">
  <view class="tab-inner">
    <view
      class="tab-item {{selectedPath === item.pagePath ? 'tab-item--selected' : ''}}"
      hover-class="tab-item--active"
      hover-stay-time="80"
      wx:for="{{list}}"
      wx:key="pagePath"
      data-path="{{item.pagePath}}"
      catchtap="switchTab"
    >
      <view class="tab-glow" wx:if="{{selectedPath === item.pagePath}}"></view>
      <view class="tab-icon-wrap {{selectedPath === item.pagePath ? 'tab-icon-wrap--active' : ''}}">
        <image
          class="tab-icon {{selectedPath === item.pagePath ? 'tab-icon--active' : ''}}"
          src="{{selectedPath === item.pagePath ? item.selectedIconPath : item.iconPath}}"
          mode="aspectFit"
        />
      </view>
      <text class="tab-text {{selectedPath === item.pagePath ? 'tab-text--active' : ''}}">{{item.text}}</text>
    </view>
  </view>
</view>
