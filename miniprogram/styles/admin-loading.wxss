.admin-loading-card {
  width: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 52rpx 36rpx;
  border-radius: 28rpx;
  border: 2rpx solid rgba(255, 200, 87, 0.16);
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.99), rgba(255, 249, 238, 0.96));
  box-shadow: 0 14rpx 30rpx rgba(93, 64, 55, 0.08);
  text-align: center;
}

.admin-loading-card--page {
  max-width: 640rpx;
  min-height: 420rpx;
  margin: 0 auto;
  padding: 88rpx 40rpx;
}

.admin-loading-card--inline {
  min-height: 220rpx;
}

.admin-loading-card--compact {
  min-height: 200rpx;
  padding: 48rpx 34rpx;
}

.admin-loading-card__orb {
  width: 112rpx;
  height: 112rpx;
  border-radius: 999rpx;
  background: radial-gradient(circle at 30% 30%, rgba(255, 241, 200, 0.92), rgba(255, 200, 87, 0.22) 58%, rgba(255, 200, 87, 0.05) 100%);
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.76), 0 10rpx 24rpx rgba(255, 200, 87, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.admin-loading-card__spinner {
  width: 62rpx;
  height: 62rpx;
  border-radius: 999rpx;
  border: 6rpx solid rgba(255, 200, 87, 0.18);
  border-top-color: #ffc857;
  border-right-color: #ffb84d;
  box-sizing: border-box;
  animation: admin-loading-spin 0.9s linear infinite;
}

.admin-loading-card__title {
  display: block;
  font-size: 28rpx;
  line-height: 1.4;
  font-weight: 700;
  color: #5d4037;
}

.admin-loading-card__desc {
  display: block;
  max-width: 520rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: rgba(93, 64, 55, 0.62);
}

.admin-loading-inline {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.admin-loading-inline__spinner {
  width: 24rpx;
  height: 24rpx;
  border-radius: 999rpx;
  border: 3rpx solid rgba(255, 200, 87, 0.18);
  border-top-color: #ffc857;
  border-right-color: #ffb84d;
  box-sizing: border-box;
  animation: admin-loading-spin 0.9s linear infinite;
}

@keyframes admin-loading-spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}
