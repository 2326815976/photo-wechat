.admin-loading-card {
  width: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 64rpx 40rpx;
  background: transparent;
  text-align: center;
}

.admin-loading-card--page {
  max-width: 640rpx;
  min-height: 420rpx;
  margin: 0 auto;
  padding: 96rpx 40rpx;
}

.admin-loading-card--inline {
  min-height: 220rpx;
}

.admin-loading-card--compact {
  min-height: 200rpx;
  padding: 52rpx 34rpx;
}

.admin-loading-card__orb {
  position: relative;
  width: 192rpx;
  height: 192rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.admin-loading-card__spinner {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border-radius: 999rpx;
  border: 8rpx solid rgba(255, 200, 87, 0.3);
  border-top-color: #ffc857;
  box-sizing: border-box;
  animation: admin-loading-spin 3s linear infinite;
}

.admin-loading-card__spinner::before {
  content: "";
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  left: 24rpx;
  border-radius: 999rpx;
  border: 8rpx solid rgba(93, 64, 55, 0.2);
  border-bottom-color: #5d4037;
  box-sizing: border-box;
  animation: admin-loading-spin-reverse 2s linear infinite;
  z-index: 2;
}

.admin-loading-card__spinner::after {
  content: "";
  position: absolute;
  top: 64rpx;
  right: 64rpx;
  bottom: 64rpx;
  left: 64rpx;
  background-image: url("/images/icons/sparkles-yellow.svg");
  background-repeat: no-repeat;
  background-position: center;
  background-size: 64rpx 64rpx;
  z-index: 3;
}

.admin-loading-card__title {
  display: block;
  font-size: 36rpx;
  line-height: 1.4;
  font-weight: 500;
  color: #5d4037;
}

.admin-loading-card__desc {
  display: block;
  max-width: 520rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: rgba(93, 64, 55, 0.62);
}

.admin-loading-card--compact .admin-loading-card__orb {
  width: 160rpx;
  height: 160rpx;
}

.admin-loading-card--compact .admin-loading-card__spinner::before {
  top: 20rpx;
  right: 20rpx;
  bottom: 20rpx;
  left: 20rpx;
}

.admin-loading-card--compact .admin-loading-card__spinner::after {
  top: 52rpx;
  right: 52rpx;
  bottom: 52rpx;
  left: 52rpx;
  background-size: 56rpx 56rpx;
}

.admin-loading-inline {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.admin-loading-inline__spinner {
  width: 24rpx;
  height: 24rpx;
  border-radius: 999rpx;
  border: 3rpx solid rgba(255, 200, 87, 0.18);
  border-top-color: #ffc857;
  border-right-color: #ffb84d;
  box-sizing: border-box;
  animation: admin-loading-spin 0.9s linear infinite;
}

@keyframes admin-loading-spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

@keyframes admin-loading-spin-reverse {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(-360deg);
  }
}
