.admin-loading-card {
  width: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  padding: 64rpx 40rpx;
  background: transparent;
  text-align: center;
}

.admin-loading-card--page {
  max-width: 640rpx;
  min-height: 420rpx;
  margin: 0 auto;
  padding: 96rpx 40rpx;
}

.admin-loading-card--inline {
  min-height: 220rpx;
}

.admin-loading-card--compact {
  min-height: 200rpx;
  padding: 52rpx 34rpx;
}

.admin-loading-card__orb {
  position: relative;
  width: 192rpx;
  height: 192rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.admin-loading-card__spinner {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border-radius: 999rpx;
  border: 10rpx solid rgba(255, 200, 87, 0.3);
  border-top-color: #ffc857;
  box-sizing: border-box;
  animation: admin-loading-spin 3s linear infinite;
}

.admin-loading-card__spinner::before {
  content: "";
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  left: 24rpx;
  border-radius: 999rpx;
  border: 10rpx solid rgba(93, 64, 55, 0.2);
  border-bottom-color: #5d4037;
  box-sizing: border-box;
  animation: admin-loading-spin-reverse 2s linear infinite;
  z-index: 2;
}

.admin-loading-card__spinner::after {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  width: 64rpx;
  height: 64rpx;
  transform: translate(-50%, -50%);
  background: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2224%22%20height%3D%2224%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%23FFC857%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%0A%20%20%3Cpath%20d%3D%22M9.937%2015.5A2%202%200%200%200%208.5%2014.063l-6.135-1.582a.5.5%200%200%201%200-.962L8.5%209.936A2%202%200%200%200%209.937%208.5l1.582-6.135a.5.5%200%200%201%20.963%200L14.063%208.5A2%202%200%200%200%2015.5%209.937l6.135%201.581a.5.5%200%200%201%200%20.964L15.5%2014.063a2%202%200%200%200-1.437%201.437l-1.582%206.135a.5.5%200%200%201-.963%200z%22%2F%3E%0A%20%20%3Cpath%20d%3D%22M20%203v4%22%2F%3E%0A%20%20%3Cpath%20d%3D%22M22%205h-4%22%2F%3E%0A%20%20%3Cpath%20d%3D%22M4%2017v2%22%2F%3E%0A%20%20%3Cpath%20d%3D%22M5%2018H3%22%2F%3E%0A%3C%2Fsvg%3E") center / contain no-repeat;
  z-index: 3;
}

.admin-loading-card__title {
  display: block;
  font-size: 32rpx;
  line-height: 1.4;
  font-weight: 800;
  color: #5d4037;
}

.admin-loading-card__desc {
  display: block;
  max-width: 520rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(93, 64, 55, 0.62);
}

.admin-loading-card--compact .admin-loading-card__orb {
  width: 160rpx;
  height: 160rpx;
}

.admin-loading-card--compact .admin-loading-card__spinner::before {
  top: 20rpx;
  right: 20rpx;
  bottom: 20rpx;
  left: 20rpx;
}

.admin-loading-card--compact .admin-loading-card__spinner::after {
  width: 56rpx;
  height: 56rpx;
}

.admin-loading-inline {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.admin-loading-inline__spinner {
  width: 24rpx;
  height: 24rpx;
  border-radius: 999rpx;
  border: 3rpx solid rgba(255, 200, 87, 0.18);
  border-top-color: #ffc857;
  border-right-color: #ffb84d;
  box-sizing: border-box;
  animation: admin-loading-spin 0.9s linear infinite;
}

@keyframes admin-loading-spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

@keyframes admin-loading-spin-reverse {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(-360deg);
  }
}
